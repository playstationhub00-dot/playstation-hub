<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Customer — <%= settings.title %></title>
  <link rel="icon" href="<%= settings.favicon_path %>" type="image/svg+xml">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav>
  <a href="/" class="logo"><img src="<%= settings.logo_path %>" alt="<%= settings.title %>" /></a>
  <div class="nav-links">
    <a href="/admin" class="admin-btn">Admin Panel</a>
  </div>
</nav>

<div class="edit-container">
  <a href="/admin?tab=customers" class="back-link">← Back to Customers</a>
  <h1>Edit Customer</h1>

  <div class="form-card" style="border-color:rgba(34,197,94,0.3);">
    <form method="POST" action="/admin/customers/edit/<%= customer.id %>">
      <div class="form-grid">

        <div class="form-group full">
          <label>Customer Name *</label>
          <input type="text" name="customer_name" value="<%= customer.customer_name %>" required>
        </div>

        <div class="form-group full">
          <label id="cust_game_label"><%= customer.status === 'reservation' ? 'Upcoming Game Reserved *' : 'Game Rented *' %></label>
          <select name="game_id" id="cust_game" onchange="updateCustPrice()" required>
            <option value="">— Select a game —</option>
            <optgroup label="Available Games" id="cust_optgroup_regular" style="<%= customer.status === 'reservation' ? 'display:none' : '' %>">
              <% games.forEach(g => { %>
              <option value="<%= g.id %>"
                data-title="<%= g.title.replace(/"/g,'&quot;') %>"
                data-nt10="<%= g.nt_price_10d %>" data-nt15="<%= g.nt_price_15d %>" data-nt30="<%= g.nt_price_30d %>"
                data-tr10="<%= g.tr_price_10d %>" data-tr15="<%= g.tr_price_15d %>" data-tr30="<%= g.tr_price_30d %>"
                data-buynt="<%= g.buy_nt_price || 0 %>" data-buytr="<%= g.buy_tr_price || 0 %>"
                <%= g.id === customer.game_id ? 'selected' : '' %>>
                <%= g.title %> (<%= g.platform %>)
              </option>
              <% }) %>
            </optgroup>
            <optgroup label="Upcoming Games" id="cust_optgroup_upcoming" style="<%= customer.status !== 'reservation' ? 'display:none' : '' %>">
              <% upcoming.forEach(g => { %>
              <option value="upcoming_<%= g.id %>"
                <%= String(customer.game_id) === 'upcoming_'+g.id ? 'selected' : '' %>>
                <%= g.title %> (<%= g.platform %>) — <%= g.release_date === 'TBA' ? 'TBA' : g.release_date %>
              </option>
              <% }) %>
            </optgroup>
          </select>
        </div>

        <div class="form-group full" id="cust_swap_panel" hidden>
          <div class="cust-swap-box">
            <div class="cust-swap-title">🔄 Game Swap</div>
            <div class="cust-swap-rows">
              <div class="cust-swap-row"><span>From</span><strong id="cust_swap_from"></strong></div>
              <div class="cust-swap-row"><span>To</span><strong id="cust_swap_to"></strong></div>
            </div>
            <div id="cust_swap_result"></div>
          </div>
        </div>

        <div class="form-group" id="cust_days_group" <%= (customer.status === 'bought' || customer.status === 'reservation') ? 'hidden' : '' %>>
          <label>Rental Duration</label>
          <select name="days" id="cust_days" onchange="toggleCustCustomDays(this.value);updateCustPrice()">
            <option value="7" <%= customer.days === 7 ? 'selected' : '' %>>Weekly</option>
            <option value="30" <%= customer.days === 30 ? 'selected' : '' %>>Monthly</option>
            <option value="custom" <%= (customer.days !== 7 && customer.days !== 30) ? 'selected' : '' %>>✏️ Custom...</option>
          </select>
          <input type="number" id="cust_custom_days" name="custom_days" min="1" max="365"
            placeholder="Enter number of days"
            value="<%= (customer.days !== 7 && customer.days !== 30) ? customer.days : '' %>"
            <%= (customer.days !== 7 && customer.days !== 30) ? '' : 'hidden' %>
            oninput="updateCustEndDate()">
        </div>

        <div class="form-group">
          <label>Account Type</label>
          <select name="account_type" id="cust_type" onchange="updateCustPrice()">
            <option value="nt" <%= customer.account_type === 'nt' ? 'selected' : '' %>>🎮 Non-Trophy</option>
            <option value="tr" <%= customer.account_type === 'tr' ? 'selected' : '' %>>🏆 Trophy Account</option>
            <option value="ps4" <%= customer.account_type === 'ps4' ? 'selected' : '' %>>🕹️ PS4 Primary</option>
          </select>
        </div>

        <div class="form-group">
          <label>Start Date</label>
          <input type="date" name="start_date" id="cust_start" value="<%= customer.start_date || '' %>" onchange="updateCustEndDate()">
        </div>

        <div class="form-group">
          <label>End Date</label>
          <input type="date" name="end_date" id="cust_end" value="<%= customer.end_date || '' %>">
        </div>

        <div class="form-group">
          <label>Price (₱)</label>
          <input type="number" name="price" id="cust_price" value="<%= customer.price || 0 %>" min="0">
        </div>

        <div class="form-group">
          <label>Status</label>
          <select name="status" id="cust_status" onchange="toggleCustStatus(this.value)">
            <option value="renting" <%= customer.status === 'renting' ? 'selected' : '' %>>🟢 Currently Renting</option>
            <option value="reservation" <%= customer.status === 'reservation' ? 'selected' : '' %>>🔖 Reservation</option>
            <option value="done" <%= customer.status === 'done' ? 'selected' : '' %>>✅ Done</option>
            <option value="bought" <%= customer.status === 'bought' ? 'selected' : '' %>>🛒 Bought</option>
          </select>
        </div>

        <div class="form-group full">
          <label>🗂️ Assign to Account Slot <span style="color:#555;font-size:0.72rem;">(controls the Accounts dashboard — leave as-is if unsure)</span></label>
          <% const SLOT_LBL = { trophy:'🏆 Trophy', non_trophy:'🎮 Non-Trophy', ps4_primary:'🕹️ PS4 Primary' }; %>
          <select name="account_assign">
            <option value="">— None —</option>
            <% (accounts||[]).forEach(a => { ['trophy','non_trophy','ps4_primary'].forEach(t => {
                 const s = a.slots[t];
                 const key = a.id + ':' + t;
                 const isCurrent = currentAssign === key;
                 if (s && s.enabled && (s.status === 'open' || isCurrent)) { %>
              <option value="<%= key %>" <%= isCurrent ? 'selected' : '' %>><%= a.label %> — <%= SLOT_LBL[t] %><%= isCurrent ? ' (current)' : '' %></option>
            <% } }) }) %>
          </select>
        </div>

        <div class="form-group full">
          <label>Notes</label>
          <input type="text" name="notes" value="<%= customer.notes || '' %>" placeholder="Optional notes...">
        </div>

      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary" style="background:#166534;">Save Changes</button>
        <a href="/admin?tab=customers" class="btn btn-outline">Cancel</a>
      </div>
    </form>
  </div>
</div>

<script>
const CUST_ORIGINAL_GAME_ID = <%- JSON.stringify(String(customer.game_id)) %>;
const CUST_ORIGINAL_PRICE = <%= customer.price || 0 %>;
const CUST_PROMO = {
  enabled: <%- settings.promo && settings.promo.enabled ? 'true' : 'false' %>,
  discounts: { 10: <%= (settings.promo && settings.promo.discounts && settings.promo.discounts[10]) || 0 %>, 15: <%= (settings.promo && settings.promo.discounts && settings.promo.discounts[15]) || 0 %>, 30: <%= (settings.promo && settings.promo.discounts && settings.promo.discounts[30]) || 0 %> },
  buyEnabled: <%- settings.promo && settings.promo.buy_promo_enabled ? 'true' : 'false' %>,
  buyPct: <%= (settings.promo && settings.promo.buy_promo_pct) || 0 %>
};

function toggleCustCustomDays(val) {
  const inp = document.getElementById('cust_custom_days');
  if (val === 'custom') { inp.removeAttribute('hidden'); inp.focus(); }
  else inp.setAttribute('hidden', '');
}
function toggleCustStatus(status) {
  const daysGroup = document.getElementById('cust_days_group');
  const gameLabel = document.getElementById('cust_game_label');
  const grpRegular = document.getElementById('cust_optgroup_regular');
  const grpUpcoming = document.getElementById('cust_optgroup_upcoming');
  const gameSel = document.getElementById('cust_game');
  const currentIsUpcoming = gameSel.value.startsWith('upcoming_');
  if (status === 'reservation') {
    daysGroup.setAttribute('hidden', '');
    grpRegular.style.display = 'none';
    grpUpcoming.style.display = '';
    gameLabel.textContent = 'Upcoming Game Reserved *';
    // Only reset if the current selection isn't already an upcoming game —
    // switching between non-reservation statuses (e.g. renting -> done)
    // shouldn't blank out a selection that's still valid.
    if (!currentIsUpcoming) gameSel.value = '';
  } else {
    grpRegular.style.display = '';
    grpUpcoming.style.display = 'none';
    gameLabel.textContent = 'Game Rented *';
    if (currentIsUpcoming) gameSel.value = '';
    if (status === 'bought') daysGroup.setAttribute('hidden', '');
    else { daysGroup.removeAttribute('hidden'); updateCustEndDate(); }
  }
  updateCustPrice();
}
function getCustDays() {
  const sel = document.getElementById('cust_days');
  if (sel.value === 'custom') return parseInt(document.getElementById('cust_custom_days').value) || 0;
  return parseInt(sel.value) || 0;
}
function updateCustPrice() {
  updateCustEndDate();
  renderCustSwapPanel();
}

// If the selected game differs from the customer's original game, price the new
// game at the current duration/type (promo-adjusted) and show what the customer
// owes on top of what they already paid — never less than what they paid, no
// refunds on a downgrade. Mirrors computeSwapReferencePrice() in server.js.
function renderCustSwapPanel() {
  const panel = document.getElementById('cust_swap_panel');
  const gameSel = document.getElementById('cust_game');
  const selectedId = gameSel.value;

  if (!selectedId || selectedId.startsWith('upcoming_') || CUST_ORIGINAL_GAME_ID.startsWith('upcoming_') || selectedId === CUST_ORIGINAL_GAME_ID) {
    panel.hidden = true;
    return;
  }

  const opt = gameSel.options[gameSel.selectedIndex];
  const toTitle = (opt.dataset.title || opt.textContent).trim();
  let fromTitle = <%- JSON.stringify(customer.game_title) %>;
  Array.from(gameSel.options).forEach(o => { if (o.value === CUST_ORIGINAL_GAME_ID && o.dataset.title) fromTitle = o.dataset.title; });
  document.getElementById('cust_swap_from').textContent = fromTitle;
  document.getElementById('cust_swap_to').textContent = toTitle;

  const status = document.getElementById('cust_status').value;
  const isBought = status === 'bought';
  const accountType = document.getElementById('cust_type').value;
  const ps4Fallback = accountType === 'ps4';
  const usingType = ps4Fallback ? 'nt' : accountType;
  const days = document.getElementById('cust_days').value;

  let refPrice = null;
  if (isBought) {
    const raw = parseFloat(opt.dataset[usingType === 'tr' ? 'buytr' : 'buynt']) || 0;
    if (raw > 0) refPrice = (CUST_PROMO.buyEnabled && CUST_PROMO.buyPct > 0) ? Math.round(raw * (1 - CUST_PROMO.buyPct / 100)) : raw;
  } else if (days === '10' || days === '15' || days === '30') {
    const raw = parseFloat(opt.dataset[usingType + days]) || 0;
    if (raw > 0) {
      const pct = CUST_PROMO.enabled ? (CUST_PROMO.discounts[days] || 0) : 0;
      refPrice = pct > 0 ? raw - Math.round(raw * pct / 100) : raw;
    }
  }

  const resultEl = document.getElementById('cust_swap_result');
  const priceInput = document.getElementById('cust_price');

  if (refPrice == null) {
    resultEl.innerHTML = '<div class="cust-swap-note">⚠️ Custom duration or no price set for this type — enter the new total manually.</div>';
    panel.hidden = false;
    return;
  }

  const topUp = Math.max(0, refPrice - CUST_ORIGINAL_PRICE);
  const newTotal = Math.max(refPrice, CUST_ORIGINAL_PRICE);
  let html = topUp > 0
    ? '<div class="cust-swap-topup">➕ Customer pays <strong>₱' + topUp + '</strong> more<div class="cust-swap-sub">New total on record: ₱' + newTotal + '</div></div>'
    : '<div class="cust-swap-ok">✅ No additional payment — no refund on downgrades<div class="cust-swap-sub">Total stays ₱' + newTotal + '</div></div>';
  if (ps4Fallback) html += '<div class="cust-swap-note">🕹️ PS4 Primary has no separate price — using Non-Trophy pricing.</div>';
  resultEl.innerHTML = html;
  priceInput.value = newTotal;
  panel.hidden = false;
}
function updateCustEndDate() {
  const start = document.getElementById('cust_start').value;
  const days = getCustDays();
  if (!start || !days) return;
  const d = new Date(start + 'T00:00:00');
  d.setDate(d.getDate() + days);
  document.getElementById('cust_end').value = d.toISOString().slice(0, 10);
}
</script>

<script src="/js/admin-searchable-select.js"></script>
<%- include('partials/footer') %>
</body>
</html>
