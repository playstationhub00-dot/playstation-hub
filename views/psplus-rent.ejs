<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { page: 'ps-plus', canonicalPath: '/ps-plus/rent', title: 'Rent PS Plus Deluxe | PlayStation Hub' }) %>
  <link rel="stylesheet" href="/css/style.css?v=<%= assetV %>">
  <link rel="stylesheet" href="/css/game-psn.css?v=<%= assetV %>">
  <link rel="stylesheet" href="/css/game-page.css?v=<%= assetV %>">
  <link rel="stylesheet" href="/css/psplus-detail.css?v=<%= assetV %>">
</head>
<body class="gd-page-booking-v2 gp-redesign hub gd-compact psp-rent">
<%- include('partials/announcement') %>
<%- include('partials/nav', { active: 'psplus' }) %>

<%#
  PS Plus Deluxe, in the new game-page frame (gp-redesign). Checkout stays
  /order/create-psplus, prices stay the PS Plus prices, and the waiting line
  stays game_id 'psplus'. Rent only: no Buy panel. The same element ids drive
  public/js/game-detail.js.
%>
<%
  const ntSlots  = slots.nt_slots || 0;
  const trSlots  = slots.tr_slots || 0;
  const ps4Slots = slots.ps4_slots || 0;
  const trAvail  = trSlots > 0;
  const ntAvail  = ntSlots > 0;
  const ps4Avail = ps4Slots > 0;
  const allUnavail = !trAvail && !ntAvail && !ps4Avail;
  const psNext = (typeof nextDays !== 'undefined' && nextDays) ? nextDays : {};
  const trNext = psNext.tr != null ? psNext.tr : null;
  const ntNext = psNext.nt != null ? psNext.nt : null;
  const ps4Next = psNext.ps4 != null ? psNext.ps4 : null;
  const psPairs = [
    [prices.nt_price_7d, 7], [prices.nt_price_30d, 30], [prices.tr_price_7d, 7], [prices.tr_price_30d, 30]
  ].filter(([base]) => base > 0).map(([base, d]) => {
    const pct = gameDiscountPct(prices, d, promo);
    return pct > 0 ? base - Math.round(base * pct / 100) : base;
  });
  const psFromPrice = psPairs.length ? Math.min(...psPairs) : 0;
  const weekFrom = prices.nt_price_7d || psFromPrice;
  const deluxeList = Array.isArray(deluxeGames) ? deluxeGames : [];
  const deluxeCount = deluxeList.length;
  const deluxePreview = deluxeList.slice(0, 6);
  const lateFee = promo.late_fee_per_day != null ? promo.late_fee_per_day : 20;
  const deposit = promo.deposit || 0;
%>

<div class="gd-page">
  <div class="gd-back gp-crumb">
    <a href="/browse">Browse</a>
    <span> / </span>
    <a href="/ps-plus">PS Plus</a>
    <span> / </span>
    <b>PS Plus Deluxe</b>
  </div>

  <div class="gp-grid">
    <div class="gp-hero psp-hero">
      <div class="gd-cover-col">
        <% if (psplusCover) { %>
        <img src="<%= psplusCover %>" alt="PS Plus Deluxe" class="gd-cover gdh-poster" width="760" height="1140"
          onerror="this.style.display='none';document.getElementById('psCoverFallback').style.display='flex'">
        <% } %>
        <div id="psCoverFallback" class="gd-cover gd-cover-placeholder" style="display:<%= psplusCover ? 'none' : 'flex' %>;">
          <span>PS Plus Deluxe</span>
        </div>
        <span class="psp-plat">PS4/PS5</span>
      </div>
      <div class="gp-title psp-title-top">
        <div class="gd-kicker">PS4/PS5 · From ₱<%= weekFrom %> a week · <%= allUnavail ? 'Full' : 'Available' %></div>
        <span class="psp-badge">PS Plus Deluxe</span>
        <h1 class="usd-title gd-title">PS Plus Deluxe</h1>
      </div>
      <div class="psp-title-rest">
        <div class="gd-specs">
          <span class="gd-spec"><b>Platform</b>PS4/PS5</span>
          <span class="gd-spec"><b>Type</b>Subscription</span>
          <span class="gd-spec"><b>Tier</b>Deluxe</span>
        </div>
        <div class="gd-about">
          <p>One rental, every game in the Deluxe catalogue. Play weekly or monthly on Trophy, Non-Trophy or PS4 Primary. Unlimited game swaps while your rental is active, with a 2-day cooldown. Online play is included.</p>
        </div>
        <button type="button" class="psp-see" id="pspSeeOpen">See all games in PS Plus Deluxe</button>
      </div>
    </div>

    <div class="gd-detail-col gp-panel">
      <div class="gdh-card bp-card">
      <div id="rentPanel">
        <div class="gd-price-header">
          <div>
            <div class="gd-ph-amount">
              <span id="phAmount" data-default-amount="<%= psFromPrice %>" data-default-buy-amount="0">₱<%= psFromPrice %></span>
            </div>
            <div class="gd-ph-kicker" id="phKicker" data-default-kicker="From">From</div>
            <div class="gd-ph-rider" id="phRider" style="display:none;"></div>
          </div>
          <div class="gd-ph-save-wrap">
            <span class="gd-ph-was" id="phWas" style="display:none;"></span>
            <span class="gd-ph-save" id="phSave" style="display:none;"></span>
          </div>
        </div>

        <div class="bp-label">Account</div>
        <div class="gd-type-options" id="typeOptions">
          <label class="gd-type-card gd-type-pill" id="label-tr">
            <input type="radio" name="rentalType" value="tr" class="gd-type-radio" onchange="onTypeChange(this)">
            <span class="gd-type-icon">🏆</span>
            <span class="bp-type-copy">
              <span class="gd-type-name">Trophy</span>
              <span class="bp-type-sub">Your profile · ₱<%= deposit %> refundable deposit</span>
            </span>
            <% if (trAvail) { %><span class="gd-wait is-now">Available</span>
            <% } else { %><span class="gd-type-status gd-status-rented">Full</span><% if (trNext != null && trNext > 0) { %><span class="gd-wait">Available in <%= trNext %> day<%= trNext !== 1 ? 's' : '' %></span><% } %><% } %>
          </label>
          <label class="gd-type-card gd-type-pill" id="label-nt">
            <input type="radio" name="rentalType" value="nt" class="gd-type-radio" onchange="onTypeChange(this)">
            <span class="gd-type-icon">🎮</span>
            <span class="bp-type-copy">
              <span class="gd-type-name">Non-Trophy</span>
              <span class="bp-type-sub">Our account · no deposit</span>
            </span>
            <% if (ntAvail) { %><span class="gd-wait is-now">Available</span>
            <% } else { %><span class="gd-type-status gd-status-rented">Full</span><% if (ntNext != null && ntNext > 0) { %><span class="gd-wait">Available in <%= ntNext %> day<%= ntNext !== 1 ? 's' : '' %></span><% } %><% } %>
          </label>
          <label class="gd-type-card gd-type-pill" id="label-ps4">
            <input type="radio" name="rentalType" value="ps4" class="gd-type-radio" onchange="onTypeChange(this)">
            <span class="gd-type-icon">🕹️</span>
            <span class="bp-type-copy">
              <span class="gd-type-name">PS4 Primary</span>
              <span class="bp-type-sub">Your PS4 · ₱<%= deposit %> refundable deposit</span>
            </span>
            <% if (ps4Avail) { %><span class="gd-wait is-now">Available</span>
            <% } else { %><span class="gd-type-status gd-status-rented">Full</span><% if (ps4Next != null && ps4Next > 0) { %><span class="gd-wait">Available in <%= ps4Next %> day<%= ps4Next !== 1 ? 's' : '' %></span><% } %><% } %>
          </label>
        </div>
        <%- include('partials/account-guide-link') %>
        <button type="button" class="gd-fold bp-setup" id="setupToggle" aria-expanded="false" onclick="toggleSetupPanel()">How setup works</button>

        <div class="bp-label">Plan</div>
        <div class="gd-duration-grid" id="durationGrid" style="margin-top:0.75rem;">
          <% RENTAL_DURATIONS.forEach(({ days: d }) => { const pct = gameDiscountPct(prices, d, promo); %>
          <button class="gd-dur-btn" data-days="<%= d %>" onclick="onDurChange(this)">
            <span class="gd-dur-days"><%= d === 7 ? 'Weekly' : 'Monthly' %></span>
            <span class="gd-dur-price" id="price-<%= d %>"><%- rentPriceHtml(prices, 'nt', d, promo) %></span>
            <% if (d === 30) { %><span class="gd-dur-save" id="durSave" hidden></span><% } %>
            <% if (pct > 0) { %><span class="gd-dur-promo"><%= pct %>% OFF</span><% } %>
          </button>
          <% }) %>
        </div>

        <% if (ntAvail) { %>
        <p class="gd-muted" id="gdTrial">Non-Trophy: free 3-hour trial, no deposit.</p>
        <% } %>

        <% const gdPromoLines = (typeof promoCheckoutLines === 'function') ? promoCheckoutLines(null, null) : []; %>
        <div class="gd-perks">
          <% if (gdPromoLines.length) { %>
          <div class="gd-promo-note" id="gdPromoNote">
            <%- include('partials/promo-lines', { items: gdPromoLines, compact: true }) %>
          </div>
          <% } %>
          <% if (typeof voucherHint !== 'undefined' && voucherHint) { %>
          <button type="button" class="gd-perk gd-perk-code" id="voucherHint" onclick="var b=document.getElementById('voucherBox'); if(b) b.hidden=false; var i=document.getElementById('voucherInput'); if(i && !i.value) i.value='<%= voucherHint.code %>';"><%= voucherHint.code %> −<%= voucherHint.pct %>%</button>
          <% } %>
        </div>

        <button type="button" class="bp-voucher-toggle" id="voucherToggle" <%= allUnavail ? 'hidden' : '' %> onclick="var b=document.getElementById('voucherBox'); b.hidden=!b.hidden;">Have a voucher?</button>
        <div class="vc" id="voucherBox" hidden>
          <div class="lb" id="voucherLabel">Promo code</div>
          <div class="vrow" id="voucherEntry">
            <span class="vin-wrap">
              <input class="vin" id="voucherInput" maxlength="24" placeholder="Promo code" autocomplete="off" aria-label="Promo code">
            </span>
            <button type="button" class="vbtn dis" id="voucherApply" disabled>Apply</button>
          </div>
          <div class="vfine" id="voucherFine">One code per order. The monthly price already includes the live monthly promo.</div>
        </div>

        <div class="gd-total-box" id="totalBox">
          <div class="gd-total-rows" id="totalRows"></div>
          <div class="gd-total-final">
            <span>Total to send</span>
            <span id="totalFinal"></span>
          </div>
          <div class="gd-total-refund" id="totalRefund" style="display:none;"></div>
          <div class="gd-total-hint" id="totalHint" style="display:none;"></div>
        </div>

        <div id="ctaMsgWrap"<%= allUnavail ? ' hidden' : '' %>>
        <a href="http://m.me/PlaystationHub00" target="_blank" rel="noopener" class="gd-msg-primary" id="ctaMsgPrimary" data-track-source="game">
          <span class="gd-msg-main" id="ctaMsgMain"><%= allUnavail ? '💬 Ask us about this game' : 'Rent now' %></span>
          <span class="gd-msg-sub" id="ctaMsgSub"><%= allUnavail ? "We'll tell you when it frees up — or suggest a similar one" : 'Opens Messenger · we reply fastest there' %></span>
        </a>
        <div class="gd-msg-preview">
          <div class="gd-msg-preview-label">YOUR MESSAGE WILL SAY</div>
          <div class="gd-msg-preview-text" id="ctaMsgPreview"></div>
        </div>
        </div>

        <div class="gd-folds">
          <button type="button" class="gd-fold" id="feesToggle" aria-expanded="<%= order_error ? 'true' : 'false' %>" onclick="toggleFeesPanel()">Fees &amp; payment</button>
        </div>

        <div class="gd-type-setup" id="typeSetupWrap" data-open="0">
          <div class="gd-setup-block" id="setup-tr">
            <p>✅ Play on <strong>YOUR OWN account</strong> and earn trophies on your profile.</p>
            <p>Setup: Settings → Users and Accounts → Other → Console Sharing and Offline Play → <strong>Enable</strong></p>
            <% if (!trAvail && trNext != null && trNext > 0) { %>
            <p class="gd-avail-soon">Next available in <strong><%= trNext %> day<%= trNext !== 1 ? 's' : '' %></strong></p>
            <% } %>
          </div>
          <div class="gd-setup-block" id="setup-nt">
            <p>🎮 Play on <strong>OUR account</strong> only. Trophies <strong>won't</strong> count on your own profile.</p>
            <p>Setup: Settings → Users and Accounts → Other → Console Sharing and Offline Play → <strong>leave disabled</strong></p>
            <p>On PS4, choose <strong>Do Not Activate</strong> if you are prompted.</p>
            <% if (!ntAvail && ntNext != null && ntNext > 0) { %>
            <p class="gd-avail-soon">Next available in <strong><%= ntNext %> day<%= ntNext !== 1 ? 's' : '' %></strong></p>
            <% } %>
          </div>
          <div class="gd-setup-block" id="setup-ps4">
            <p>🕹️ Set our account as <strong>PS4 primary</strong> — play on your PS4 and earn trophies on your own profile.</p>
            <p>Setup: Settings → Account Management → Activate as Your Primary PS4 → <strong>Activate</strong></p>
            <% if (!ps4Avail && ps4Next != null && ps4Next > 0) { %>
            <p class="gd-avail-soon">Next available in <strong><%= ps4Next %> day<%= ps4Next !== 1 ? 's' : '' %></strong></p>
            <% } %>
          </div>
        </div>

        <div id="feesPanel"<%= order_error ? '' : ' hidden' %>>
          <p class="gd-fine">Trophy and PS4 Primary: ₱<%= deposit %> refundable deposit · ₱<%= lateFee %> per late day, taken from the deposit. Return on time and you get the deposit back. Non-Trophy has no deposit and no late fee.</p>
          <p class="gd-fine gd-payline"><%- include('partials/pay-note').trim() %></p>
        </div>

        <% if (!allUnavail) { %>
        <div id="gdOrderBlock">
        <form method="POST" action="/order/create-psplus" class="gd-order-form" id="gdOrderForm" data-order-once>
          <%- include('partials/order-token') %>
          <input type="hidden" name="account_type" id="orderType" value="">
          <input type="hidden" name="days" id="orderDays" value="">
          <input type="hidden" name="promo_code" id="orderPromoCode" value="">
          <input type="text" name="fb_name" id="orderFbName" class="gd-order-name" placeholder="Your Facebook name" autocomplete="off" aria-label="Your Facebook name">
          <button type="button" class="gd-order-btn gd-cta-wait" id="ctaBtn" disabled onclick="pspReserve()">Pick an account type</button>
          <div class="gd-order-sub" id="ctaSub" style="display:none;"><%- include('partials/pay-note').trim() %></div>
        </form>
        </div>
        <a href="http://m.me/PlaystationHub00" target="_blank" rel="noopener" class="gd-ask" id="ctaMsgAsk" data-track-source="game">or message us on Facebook instead</a>
        <%- include('partials/bp-trust') %>
        <div id="ctaValidationMsg" style="display:none;text-align:center;margin-top:0.5rem;font-size:0.82rem;color:#ef4444;font-weight:600;"></div>
        <% if (order_error === '1') { %>
        <div class="gd-order-error">⚠️ Please pick an account type and duration, and enter your Facebook name, before continuing.</div>
        <% } %>
        <div id="reserveSection" style="display:none;">
          <%- include('partials/queue-line', { queues: queues, activeType: 'tr', selfRef: null, suffix: '', hideStrip: true }) %>
          <%- include('partials/noslot-options', { game_id: 'psplus', suffix: '', resValMsgId: 'reserveValidationMsg2', variant: 'card' }) %>
        </div>
        <% } else { %>
        <div id="reserveSectionAll">
        <%- include('partials/queue-line', { queues: queues, activeType: 'tr', selfRef: null, suffix: 'All', hideStrip: true }) %>
        <%- include('partials/noslot-options', { game_id: 'psplus', suffix: 'All', resValMsgId: 'reserveValidationMsg1', variant: 'card' }) %>
        </div>
        <% } %>
      </div>
      </div>
    </div>

    <div class="gp-tabs" id="gpTabs">
      <div class="gp-tablist gd-tabs" role="tablist">
        <button type="button" class="gp-tab gd-tab on" role="tab" aria-selected="true" onclick="gpTab('gpPaneBefore', this)">Why rent it</button>
        <button type="button" class="gp-tab gd-tab" role="tab" aria-selected="false" onclick="gpTab('gpPaneGames', this)">Included games</button>
        <button type="button" class="gp-tab gd-tab" role="tab" aria-selected="false" onclick="gpTab('gpPaneSignin', this)">Sign-in</button>
        <button type="button" class="gp-tab gd-tab" role="tab" aria-selected="false" onclick="gpTab('gpPaneFaq', this)">FAQ</button>
        <button type="button" class="gp-tab gd-tab" role="tab" aria-selected="false" onclick="gpTab('gpPaneReviews', this)">Reviews</button>
      </div>
      <div class="gp-pane gd-panel" id="gpPaneBefore">
        <p class="gp-online"><span aria-hidden="true">🌐</span> <b>Online play</b> is included with this Deluxe rental.</p>
        <div class="gp-why">
          <article class="gp-why-card">
            <header><span aria-hidden="true">🏆</span> <b>Trophy</b> <em>YOUR ACCOUNT</em></header>
            <p>Play on your own profile and earn trophies. ₱<%= deposit %> refundable deposit.</p>
            <ol>
              <li><span>1</span><div>On your console, open the PSN sign-in screen and send us the QR or code on Messenger. We never ask for a password.</div></li>
              <li><span>2</span><div>Go to <span class="gp-path"><span>Settings</span><span>Users and Accounts</span><span>Other</span><span>Console Sharing and Offline Play</span><span class="is-on">Enable</span></span></div></li>
              <li><span>3</span><div>Download a Deluxe game, switch back to your own profile, and play.</div></li>
            </ol>
            <p class="gp-why-note">Keep Console Sharing on for the whole rental.</p>
          </article>
          <article class="gp-why-card">
            <header><span aria-hidden="true">🎮</span> <b>Non-Trophy</b> <em>OUR ACCOUNT</em></header>
            <p>Play on our account. Trophies won't show on your profile. No deposit.</p>
            <ol>
              <li><span>1</span><div>Open the PSN sign-in screen and send us the QR or code on Messenger.</div></li>
              <li><span>2</span><div>Go to <span class="gp-path"><span>Settings</span><span>Users and Accounts</span><span>Other</span><span>Console Sharing and Offline Play</span><span class="is-off">Leave disabled</span></span></div></li>
              <li><span>3</span><div>Download a Deluxe game and play on our account.</div></li>
            </ol>
            <p class="gp-why-note">On PS4, choose Do Not Activate if you're asked.</p>
          </article>
        </div>
        <p class="gp-why-ps4"><span aria-hidden="true">🕹️</span> <b>PS4 Primary</b> Your PS4. Activate as primary. ₱<%= deposit %> refundable deposit.</p>
      </div>
      <div class="gp-pane gd-panel" id="gpPaneGames" hidden>
        <div class="psp-inc-head">
          <div>
            <h2>Included in this rental</h2>
            <p><%= deluxeCount %> games in the Deluxe catalogue, including this month’s titles. Titles below are from the live PS Plus page.</p>
          </div>
          <button type="button" class="psp-see" id="pspSeeTab">See all <%= deluxeCount %> games</button>
        </div>
        <div class="psp-preview">
          <% deluxePreview.forEach(g => { %>
          <div class="psp-tile">
            <% if (g.c) { %><img src="<%= g.c %>" alt="" loading="lazy"><% } else { %><div class="psp-ph"></div><% } %>
            <b><%= g.n %></b>
          </div>
          <% }) %>
        </div>
      </div>
      <div class="gp-pane gd-panel" id="gpPaneSignin" hidden>
        <div class="how-mini">
          <div class="how-step"><div class="num">STEP 1</div><h3>Place the order</h3><p>Pick Trophy, Non-Trophy or PS4 Primary, and Weekly or Monthly.</p></div>
          <div class="how-step"><div class="num">STEP 2</div><h3>Pay</h3><p><%- include('partials/pay-note').trim() %>.</p></div>
          <div class="how-step"><div class="num">STEP 3</div><h3>Scan the QR</h3><p>Bring up the sign-in screen on your console and send the QR or code. We never ask for your PSN password.</p></div>
          <div class="how-step"><div class="num">STEP 4</div><h3>Play or swap</h3><p>Unlimited game swaps while the rental is active, with a 2-day cooldown, when a slot is free.</p></div>
        </div>
        <p class="how-note"><a href="/how-to-sign-in">Full sign-in steps</a></p>
      </div>
      <div class="gp-pane gd-panel" id="gpPaneFaq" hidden>
        <p class="gp-details-copy">Deposit, payment, and how to sign in are on the <a href="/faq">FAQ</a>. Game swaps stay unlimited while the rental is active, with a 2-day cooldown.</p>
      </div>
      <div class="gp-pane gd-panel" id="gpPaneReviews" hidden>
        <% if (typeof reviews !== 'undefined') { %>
        <%- include('partials/review-block', { reviews: reviews, reviewStats: reviewStats, recommend: (typeof recommend !== 'undefined' ? recommend : null), reviewBadge: reviewBadge, reviewDisplayName: reviewDisplayName }) %>
        <% } else { %>
        <p class="gp-details-copy">Reviews for this rental show here once renters leave them.</p>
        <% } %>
      </div>
    </div>
  </div>

  <div class="gd-sticky-bar" id="gdStickyBar">
    <div class="gd-sb-info">
      <div class="gd-sb-kicker" id="gdSbKicker">From</div>
      <div class="gd-sb-amount" id="gdSbAmount">₱<%= psFromPrice %></div>
    </div>
    <button type="button" class="gd-sb-btn" id="gdSbBtn" onclick="handleStickyBarClick()"><%= allUnavail ? '💬 Ask us' : 'Rent now' %></button>
  </div>
</div>

<div class="psp-modal" id="pspModal" hidden>
  <button type="button" class="psp-back" id="pspBack" aria-label="Close"></button>
  <div class="psp-sheet" role="dialog" aria-modal="true" aria-labelledby="pspModalTitle">
    <button type="button" class="psp-x" id="pspClose" aria-label="Close">✕</button>
    <h2 id="pspModalTitle">Games in PS Plus Deluxe</h2>
    <p class="psp-count"><span id="pspCount"><%= deluxeCount %></span> games</p>
    <input type="search" id="pspSearch" placeholder="Search the Deluxe catalogue" aria-label="Search the Deluxe catalogue" autocomplete="off">
    <div class="psp-grid" id="pspGrid"></div>
    <button type="button" class="psp-more" id="pspMore" hidden>Show more</button>
    <p class="psp-foot" id="pspFoot"></p>
  </div>
</div>
<script type="application/json" id="pspData"><%- JSON.stringify(deluxeList).replace(/</g, '\\u003c') %></script>

<%- include('partials/footer') %>

<script>const RENTAL_DURATIONS = <%- JSON.stringify(RENTAL_DURATIONS.map(d => d.days)) %>;</script>
<script>
const PRICES = {
  nt: { 7: <%= prices.nt_price_7d %>, 30: <%= prices.nt_price_30d %> },
  tr: { 7: <%= prices.tr_price_7d %>, 30: <%= prices.tr_price_30d %> },
  ps4: { 7: <%= prices.tr_price_7d %>, 30: <%= prices.tr_price_30d %> }
};
const BUY_PRICES = { nt: 0, tr: 0 };
const PROMO = {
  enabled: true,
  discounts: { 7: <%= gameDiscountPct(prices, 7, promo) %>, 30: <%= gameDiscountPct(prices, 30, promo) %> },
  deposit: <%= promo.deposit %>
};
const AVAIL = { nt: <%= ntAvail ? 'true' : 'false' %>, tr: <%= trAvail ? 'true' : 'false' %>, ps4: <%= ps4Avail ? 'true' : 'false' %> };
const ALL_UNAVAIL = <%= allUnavail ? 'true' : 'false' %>;
const NEXT_DAYS = <%- JSON.stringify({ tr: trNext, nt: ntNext, ps4: ps4Next }) %>;
const gameTitle = 'PS Plus Deluxe';
const gdSlideCount = 0;
function gpTab(id, btn) {
  document.querySelectorAll('#gpTabs .gp-pane').forEach(function (p) { p.hidden = p.id !== id; });
  document.querySelectorAll('#gpTabs .gp-tab').forEach(function (b) {
    var on = b === btn;
    b.classList.toggle('on', on);
    b.setAttribute('aria-selected', on ? 'true' : 'false');
  });
}
</script>
<script src="/js/messenger-text.js?v=<%= assetV %>"></script>
<script src="/js/game-detail.js?v=<%= assetV %>"></script>
<script>
function pspReserve() {
  var btn = document.getElementById('ctaBtn');
  var name = document.getElementById('orderFbName');
  var form = document.getElementById('gdOrderForm');
  if (!btn || btn.disabled || !form) return;
  if (!name || name.value.trim().length < 2) {
    if (name) {
      name.style.setProperty('display', 'block', 'important');
      name.focus();
    }
    return;
  }
  form.submit();
}
</script>
