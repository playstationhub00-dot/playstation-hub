<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Panel — <%= settings.title %></title>
  <link rel="icon" href="<%= settings.favicon_path %>" type="image/svg+xml">
  <link rel="stylesheet" href="/css/style.css?v=<%= assetV %>">
  <style>
    /* ── App shell: fixed full-height sidebar + fluid content ──
       The content area is deliberately unconstrained (no max-width): this is a
       back office on a desktop, and tables are the main thing on it. */
    :root { --sbw: 236px; }
    body.admin-body { margin:0; background:#0b0b0c; }
    body.sb-collapsed { --sbw: 68px; }

    /* Every layout property is declared explicitly, including ones that look
       like defaults: style.css's site-wide `nav {}` rule is a 64px flex row,
       and anything left undeclared here would leak in from it. */
    .admin-sidebar { position:fixed; top:0; left:0; bottom:0; z-index:200; width:var(--sbw);
      display:flex; flex-direction:column; align-items:stretch; justify-content:flex-start;
      height:100vh; background:#0a0a0a; border-right:1px solid #191919; padding:0;
      transition:width 0.18s ease, transform 0.2s ease; }
    .asb-brand { display:flex; align-items:center; gap:0.55rem; padding:0 0.85rem; height:56px; flex-shrink:0; border-bottom:1px solid #161616; box-sizing:border-box; overflow:hidden; }
    .asb-brand img { height:28px; width:auto; display:block; flex-shrink:0; }
    .asb-brand-txt { font-size:0.8rem; font-weight:800; color:#fff; white-space:nowrap; letter-spacing:0.2px; }
    .asb-scroll { flex:1 1 auto; overflow-y:auto; overflow-x:hidden; padding:0.55rem 0.5rem 1rem; }
    .asb-foot { flex-shrink:0; border-top:1px solid #161616; padding:0.45rem 0.5rem; display:flex; flex-direction:column; gap:0.2rem; }
    .sidebar-group-label { font-size:0.63rem; text-transform:uppercase; letter-spacing:0.7px; color:#4d4d4d; font-weight:800; padding:0.75rem 0.65rem 0.35rem; white-space:nowrap; }
    .admin-tab { display:flex; align-items:center; gap:0.65rem; width:100%; text-align:left; padding:0.55rem 0.65rem; border-radius:9px; font-size:0.82rem; font-weight:700; cursor:pointer; color:#8b8b8b; border:none; background:none; transition:background 0.14s, color 0.14s; letter-spacing:0.2px; white-space:nowrap; text-decoration:none; overflow:hidden; box-sizing:border-box; }
    .admin-tab .tab-icon { flex-shrink:0; width:18px; text-align:center; }
    .admin-tab .tab-label { overflow:hidden; text-overflow:ellipsis; }
    .admin-tab:hover { color:#e6e6e6; background:#131313; }
    .admin-tab.active { background:var(--ps-blue); color:#000; box-shadow:0 2px 12px rgba(240,165,0,0.28); }
    .admin-tab .oq-count { margin-left:auto; }

    /* Collapsed: icons only. The group words wrap at this width, so they become
       a divider instead — the grouping stays legible without the text. */
    body.sb-collapsed .asb-brand { justify-content:center; padding:0 0.4rem; }
    body.sb-collapsed .asb-brand-txt { display:none; }
    body.sb-collapsed .admin-tab { justify-content:center; padding:0.55rem 0; gap:0; }
    body.sb-collapsed .admin-tab .tab-label, body.sb-collapsed .admin-tab .oq-count { display:none; }
    body.sb-collapsed .sidebar-group-label { font-size:0; line-height:0; padding:0.3rem 0; }
    body.sb-collapsed .admin-tab + .sidebar-group-label { border-top:1px solid #202020; margin:0.4rem 0.35rem 0.15rem; }

    /* Content column */
    .admin-body-main { margin-left:var(--sbw); min-height:100vh; transition:margin-left 0.18s ease; }
    .admin-topbar { position:sticky; top:0; z-index:150; display:flex; align-items:center; gap:0.85rem; height:56px; padding:0 1.35rem; background:rgba(10,10,10,0.94); backdrop-filter:blur(10px); border-bottom:1px solid #191919; box-sizing:border-box; }
    .atb-toggle { flex-shrink:0; display:flex; align-items:center; justify-content:center; width:32px; height:32px; border-radius:8px; border:1px solid #232323; background:#111; color:#9a9a9a; font-size:0.9rem; cursor:pointer; line-height:1; }
    .atb-toggle:hover { color:#fff; border-color:#333; }
    .atb-crumb { font-size:0.95rem; font-weight:800; color:#fff; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .atb-right { margin-left:auto; display:flex; align-items:center; gap:0.6rem; flex-shrink:0; }
    .admin-content { padding:1.35rem 1.5rem 4rem; }
    .sb-backdrop { display:none; position:fixed; inset:0; z-index:190; background:rgba(0,0,0,0.6); }

    .tab-panel { display:none; }
    .tab-panel.active { display:block; }

    /* Light mode has to follow the shell, or the sidebar stays a black slab. */
    body.light-mode.admin-body { background:#f0f2f5; }
    body.light-mode .admin-sidebar { background:#fff; border-right-color:#e4e7eb; }
    body.light-mode .asb-brand, body.light-mode .asb-foot { border-color:#eceff2; }
    body.light-mode .asb-brand-txt, body.light-mode .atb-crumb { color:#14171a; }
    body.light-mode .sidebar-group-label { color:#8b939c; }
    body.light-mode .admin-tab { color:#4b5259; }
    body.light-mode .admin-tab:hover { background:#f2f4f7; color:#14171a; }
    /* style.css paints the active tab #f0f2f5 in light mode — written for the
       old horizontal bar, where a gold border carried the highlight. This is a
       borderless rail on a white sidebar, so that grey would vanish. */
    body.light-mode .admin-tab.active { background:var(--ps-blue); color:#000; }
    body.light-mode .admin-topbar { background:rgba(255,255,255,0.95); border-bottom-color:#e4e7eb; }
    body.light-mode .atb-toggle { background:#f2f4f7; border-color:#e0e4e8; color:#4b5259; }

    /* Phone: the sidebar slides in over the content instead of squeezing it. */
    @media (max-width: 860px) {
      .admin-sidebar { transform:translateX(-100%); width:250px; box-shadow:0 0 40px rgba(0,0,0,0.6); }
      body.sb-collapsed .admin-sidebar { width:250px; }
      body.sb-open .admin-sidebar { transform:none; }
      body.sb-open .sb-backdrop { display:block; }
      /* Icons-only never applies in the drawer — there is room for labels. */
      body.sb-collapsed .admin-tab { justify-content:flex-start; padding:0.55rem 0.65rem; gap:0.65rem; }
      body.sb-collapsed .admin-tab .tab-label, body.sb-collapsed .admin-tab .oq-count { display:inline; }
      body.sb-collapsed .sidebar-group-label { font-size:0.63rem; line-height:normal; padding:0.75rem 0.65rem 0.35rem; }
      body.sb-collapsed .admin-tab + .sidebar-group-label { border-top:none; margin:0; }
      body.sb-collapsed .asb-brand { justify-content:flex-start; padding:0 0.85rem; }
      body.sb-collapsed .asb-brand-txt { display:inline; }
      .admin-body-main { margin-left:0; }
      .admin-content { padding:1rem 0.9rem 3rem; }
      .admin-topbar { padding:0 0.9rem; }
    }
    /* ── Panels ──
       These were collapsible accordions. Everything is open now: on a back
       office the cost of a click to find a form outweighs the cost of scrolling
       past it, and a closed panel hides state the owner needs to notice. */
    .adm-card { border:1px solid #1c1c1c; border-radius:14px; overflow:hidden; margin-bottom:1rem; background:#0a0a0a; }
    .adm-card-head { display:flex; align-items:center; gap:0.75rem; padding:0.8rem 1.15rem; background:#111; border-bottom:1px solid #1a1a1a; border-left:3px solid #333; }
    .adm-card-head .sa-left { display:flex; align-items:center; gap:0.75rem; }
    .adm-card-head .sa-icon { font-size:1rem; width:30px; height:30px; border-radius:7px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .adm-card-head .sa-title { font-weight:700; font-size:0.9rem; color:#fff; line-height:1.2; }
    .adm-card-head .sa-desc { font-size:0.72rem; color:#666; margin-top:0.1rem; }
    .adm-card-body { display:block; background:#0a0a0a; }
    .adm-card-body > .form-card,
    .adm-card-body > .table-card,
    .adm-card-body > div > .form-card,
    .adm-card-body > div > .table-card { border:none !important; border-radius:0 !important; margin:0 !important; box-shadow:none !important; }

    /* Jump strip for the long tabs, so a flat page stays navigable. */
    .adm-jump { display:flex; flex-wrap:wrap; gap:0.4rem; margin-bottom:1rem; padding-bottom:0.85rem; border-bottom:1px solid #171717; }
    .adm-jump a { font-size:0.75rem; font-weight:700; color:#9a9a9a; text-decoration:none; background:#111; border:1px solid #222; border-radius:20px; padding:0.35rem 0.8rem; }
    .adm-jump a:hover { color:#fff; border-color:var(--ps-blue); }
    body.light-mode .adm-card { background:#fff; border-color:#e4e7eb; }
    body.light-mode .adm-card-head { background:#f7f9fa; border-bottom-color:#e9ecef; }
    body.light-mode .adm-card-head .sa-title { color:#14171a; }
    body.light-mode .adm-card-body { background:#fff; }
    body.light-mode .adm-jump a { background:#f2f4f7; border-color:#e0e4e8; color:#4b5259; }

    .add-choice-overlay { display:none;position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,0.7);backdrop-filter:blur(6px);align-items:center;justify-content:center; }
    .add-choice-overlay.open { display:flex; }
    .add-choice-box { background:#111;border:1px solid #222;border-radius:20px;padding:2rem;width:min(480px,92vw);animation:popIn 0.18s ease; }
    @keyframes popIn { from{transform:scale(0.93);opacity:0} to{transform:scale(1);opacity:1} }
    .add-choice-grid { display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;margin-top:1.25rem; }
    .add-choice-card { background:#0a0a0a;border:1px solid #222;border-radius:14px;padding:1.25rem 0.75rem;text-align:center;cursor:pointer;transition:all 0.15s;text-decoration:none;display:flex;flex-direction:column;align-items:center;gap:0.5rem; }
    .add-choice-card:hover { border-color:var(--ps-blue);background:#1a1500;transform:translateY(-2px); }
    .add-choice-card .icon { font-size:2rem;line-height:1; }
    .add-choice-card .label { font-weight:700;font-size:0.82rem;color:#fff; }
    .add-choice-card .desc { font-size:0.7rem;color:#555;line-height:1.4; }
  </style>
</head>
<body class="admin-body">

<%# Sidebar is a div, not a <nav>: style.css's site-wide `nav {}` rule is a
    64px flex row for the storefront's top bar, and it would restyle this. %>
<div class="admin-sidebar" id="adminSidebar" role="navigation" aria-label="Admin sections">
  <div class="asb-brand">
    <a href="/" title="View site"><img src="<%= settings.logo_path %>" alt="<%= settings.title %>"></a>
    <span class="asb-brand-txt">Admin</span>
  </div>

  <div class="asb-scroll">
    <div class="sidebar-group-label">Manage</div>
    <button class="admin-tab" data-tab="dashboard" onclick="switchTab('dashboard')"><span class="tab-icon">📊</span><span class="tab-label">Dashboard</span></button>
    <button class="admin-tab" data-tab="orders" onclick="switchTab('orders')"><span class="tab-icon">🧾</span><span class="tab-label">Orders</span><% if (orderQueue.length) { %><span class="oq-count"><%= orderQueue.length %></span><% } %></button>
    <button class="admin-tab" data-tab="customers" onclick="switchTab('customers')"><span class="tab-icon">👥</span><span class="tab-label">Customers</span></button>
    <button class="admin-tab" data-tab="games" onclick="switchTab('games')"><span class="tab-icon">🎮</span><span class="tab-label">Games</span></button>
    <button class="admin-tab" data-tab="accounts" onclick="switchTab('accounts')"><span class="tab-icon">🗂️</span><span class="tab-label">Accounts</span></button>

    <div class="sidebar-group-label">Set up</div>
    <button class="admin-tab" data-tab="content" onclick="switchTab('content')"><span class="tab-icon">🖥️</span><span class="tab-label">Site content</span></button>
    <button class="admin-tab" data-tab="messaging" onclick="switchTab('messaging')"><span class="tab-icon">💬</span><span class="tab-label">Messaging</span></button>
    <button class="admin-tab" data-tab="psplus" onclick="switchTab('psplus')"><span class="tab-icon">⭐</span><span class="tab-label">PS Plus</span></button>
    <button class="admin-tab" data-tab="posters" onclick="switchTab('posters')"><span class="tab-icon">📸</span><span class="tab-label">Posters</span></button>
    <button class="admin-tab" data-tab="settings" onclick="switchTab('settings')"><span class="tab-icon">⚙️</span><span class="tab-label">Settings</span></button>
  </div>

  <div class="asb-foot">
    <a class="admin-tab" href="/" title="View site"><span class="tab-icon">🌐</span><span class="tab-label">View site</span></a>
    <a class="admin-tab" href="/admin/logout" title="Logout"><span class="tab-icon">🔒</span><span class="tab-label">Logout</span></a>
  </div>
</div>
<div class="sb-backdrop" id="sbBackdrop" onclick="closeSidebarDrawer()"></div>

<div class="admin-body-main">
  <div class="admin-topbar">
    <button class="atb-toggle" onclick="toggleSidebar()" title="Collapse/expand sidebar" aria-label="Toggle sidebar">▤</button>
    <span class="atb-crumb" id="adminCrumb">Dashboard</span>
    <div class="atb-right">
      <%- include('partials/admin/notif-bell') %>
      <div id="mongoIndicator" style="display:flex;align-items:center;gap:0.45rem;background:#111;border:1px solid #222;border-radius:20px;padding:0.3rem 0.75rem;font-size:0.74rem;font-weight:600;color:#555;">
        <span id="mongoDot" style="width:8px;height:8px;border-radius:50%;background:#333;display:inline-block;"></span>
        <span id="mongoLabel">Checking DB…</span>
      </div>
      <button id="themeToggle" onclick="toggleTheme()" title="Toggle light/dark mode"
        style="background:#111;border:1px solid #222;border-radius:20px;padding:0.3rem 0.75rem;font-size:0.78rem;font-weight:600;color:#aaa;cursor:pointer;display:flex;align-items:center;gap:0.4rem;">
        <span id="themeIcon">☀️</span><span id="themeLabel">Light</span>
      </button>
    </div>
  </div>

  <script>
  // Theme toggle
  (function() {
    const saved = localStorage.getItem('adminTheme');
    if (saved === 'light') applyLight();
  })();
  function applyLight() {
    document.body.classList.add('light-mode');
    const btn = document.getElementById('themeToggle');
    if (btn) { btn.style.background='#f2f4f7'; btn.style.borderColor='#e0e4e8'; btn.style.color='#333'; }
    const icon = document.getElementById('themeIcon'), lbl = document.getElementById('themeLabel');
    if (icon) icon.textContent = '🌙';
    if (lbl) lbl.textContent = 'Dark';
  }
  function applyDark() {
    document.body.classList.remove('light-mode');
    const btn = document.getElementById('themeToggle');
    if (btn) { btn.style.background='#111'; btn.style.borderColor='#222'; btn.style.color='#aaa'; }
    const icon = document.getElementById('themeIcon'), lbl = document.getElementById('themeLabel');
    if (icon) icon.textContent = '☀️';
    if (lbl) lbl.textContent = 'Light';
  }
  function toggleTheme() {
    if (document.body.classList.contains('light-mode')) {
      applyDark(); localStorage.setItem('adminTheme', 'dark');
    } else {
      applyLight(); localStorage.setItem('adminTheme', 'light');
    }
  }
  fetch('/admin/mongo-status').then(r=>r.json()).then(d=>{
    const dot=document.getElementById('mongoDot'),label=document.getElementById('mongoLabel'),wrap=document.getElementById('mongoIndicator');
    if(d.status&&d.status.includes('✅')){dot.style.background='#22c55e';dot.style.boxShadow='0 0 6px #22c55e';label.textContent='MongoDB Connected';label.style.color='#22c55e';wrap.style.borderColor='#14532d';}
    else if(d.status&&d.status.includes('no MONGODB_URI')){dot.style.background='#f59e0b';label.textContent='No MONGODB_URI';label.style.color='#f59e0b';wrap.style.borderColor='#78350f';}
    else{dot.style.background='#ef4444';dot.style.boxShadow='0 0 6px #ef4444';label.textContent='DB Disconnected';label.style.color='#ef4444';wrap.style.borderColor='#7f1d1d';}
  }).catch(()=>{ document.getElementById('mongoLabel').textContent='DB Unknown'; });
  </script>

  <div class="admin-content">
      <!-- ═══════════════ DASHBOARD TAB ═══════════════ -->
      <%- include('partials/admin/dashboard') %>

      <!-- ═══════════════ SETTINGS TAB ═══════════════ -->
      <%- include('partials/admin/settings') %>

      <!-- ═══════════════ MESSAGING TAB ═══════════════ -->
      <%- include('partials/admin/messaging') %>

      <!-- ═══════════════ SITE CONTENT TAB ═══════════════ -->
      <%- include('partials/admin/content') %>

      <!-- ═══════════════ GAMES TAB ═══════════════ -->
      <%- include('partials/admin/games') %>

      <!-- ═══════════════ PS PLUS TAB ═══════════════ -->
      <%- include('partials/admin/psplus') %>

      <!-- ═══════════════ CUSTOMERS TAB ═══════════════ -->
      <%- include('partials/admin/customers') %>

      <!-- ═══════════════ ORDERS TAB ═══════════════ -->
      <%- include('partials/admin/orders') %>

      <!-- ═══════════════ ACCOUNTS TAB ═══════════════ -->
      <%- include('partials/admin/accounts') %>

      <!-- ═══════════════ POSTERS TAB ═══════════════ -->
      <%- include('partials/admin/posters') %>
  </div><!-- /admin-content -->
</div><!-- /admin-body-main -->

<%# Quick Add lives here, not inside a tab: a .tab-panel is display:none
    unless its tab is active, and a fixed-position modal inside a hidden
    ancestor renders nothing. One instance also means one set of ids, so
    whichever tab's button you press reaches the same modal. %>
<%- include('partials/admin/quick-add') %>

<!-- LOADING OVERLAY -->
<div id="loadingOverlay" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.75);backdrop-filter:blur(4px);flex-direction:column;align-items:center;justify-content:center;gap:1.25rem;">
  <div style="width:52px;height:52px;border:4px solid #222;border-top-color:var(--ps-blue);border-radius:50%;animation:spin 0.7s linear infinite;"></div>
  <div id="loadingText" style="color:#fff;font-weight:700;font-size:1rem;letter-spacing:0.5px;">Saving changes...</div>
</div>
<style>@keyframes spin { to { transform: rotate(360deg); } }</style>

<script>
// ── Tab system ──
const TAB_KEY = 'adminTab';
const tabs = ['dashboard','orders','customers','games','accounts','content','messaging','psplus','posters','settings'];
// Tab ids retired in later phases of the admin reorganisation. A browser that
// still has one of these in localStorage, or a bookmark carrying one in
// ?tab=, must land somewhere real instead of a tab that no longer exists.
const LEGACY_TABS = { announcements: 'content', visitors: 'dashboard', security: 'settings' };

// ── Sidebar ──
// One width variable on <body> drives both the sidebar and the content margin,
// so they can never disagree about how much room the sidebar is taking.
const SIDEBAR_KEY = 'adminSidebarCollapsed';
const MOBILE_Q = '(max-width: 860px)';
function isMobile() { return window.matchMedia(MOBILE_Q).matches; }

function applySidebar(collapsed) {
  document.body.classList.toggle('sb-collapsed', collapsed);
}
function closeSidebarDrawer() {
  document.body.classList.remove('sb-open');
}
// On a phone the same button opens the drawer; on a desktop it collapses the
// rail. Collapsing a drawer that is off-screen would look like a dead button.
function toggleSidebar() {
  if (isMobile()) {
    document.body.classList.toggle('sb-open');
    return;
  }
  const collapsed = !document.body.classList.contains('sb-collapsed');
  applySidebar(collapsed);
  localStorage.setItem(SIDEBAR_KEY, collapsed ? '1' : '0');
}
window.toggleSidebar = toggleSidebar;
window.closeSidebarDrawer = closeSidebarDrawer;
(function() {
  const saved = localStorage.getItem(SIDEBAR_KEY);
  applySidebar(saved === '1');
})();

function switchTab(name) {
  // A name outside the current tabs array (a stale id from before a phase of
  // this reorganisation shipped) must not reach getElementById and dereference
  // null — fall back to the landing tab instead of throwing on page load.
  if (!tabs.includes(name)) name = 'dashboard';
  tabs.forEach(t => {
    document.getElementById('tab-'+t).classList.toggle('active', t===name);
    document.querySelector('[data-tab='+t+']').classList.toggle('active', t===name);
  });
  localStorage.setItem(TAB_KEY, name);
  // The top bar names the section you are in. Read straight off the sidebar
  // button so the two can never disagree about what a section is called.
  const crumb = document.getElementById('adminCrumb');
  const btnLabel = document.querySelector('[data-tab=' + name + '] .tab-label');
  if (crumb && btnLabel) crumb.textContent = btnLabel.textContent;
  closeSidebarDrawer();
  // Preserve any other query params (the orders ledger period, ?history=1).
  // Rewriting the whole query string would drop them the moment this runs on
  // load, so a reload would silently snap back to the default view. `msg` is
  // deliberately dropped so its toast does not re-fire on refresh.
  const q = new URLSearchParams(window.location.search);
  q.delete('tab');
  q.delete('msg');
  if (name !== 'dashboard') q.set('tab', name);
  const qs = q.toString();
  history.replaceState({}, '', '/admin' + (qs ? '?' + qs : ''));
}

// Determine initial tab: URL param > msg-based auto-switch > localStorage > default
(function() {
  const params = new URLSearchParams(window.location.search);
  const msg = params.get('msg');
  const urlTab = params.get('tab');

  // Auto-switch to relevant tab after a form save
  const msgTabMap = {
    added:'games', updated:'games', deleted:'games',
    upcoming_added:'games', upcoming_updated:'games', upcoming_deleted:'games',
    cat_added:'games', cat_updated:'games', cat_deleted:'games',
    announcement:'content',
    psplus_added:'psplus', psplus_updated:'psplus', psplus_deleted:'psplus',
    psplus_prices:'psplus', popular_added:'psplus', popular_updated:'psplus', popular_deleted:'psplus',
    customer_added:'customers', customer_updated:'customers', customer_deleted:'customers',
    month_log_saved:'dashboard', month_log_deleted:'dashboard',
    settings_saved:'settings', promo_saved:'settings', popup_saved:'content', password_changed:'settings',
    wrong_password:'settings', password_mismatch:'settings', password_too_short:'settings',
    signin_step_saved:'content', signin_step_deleted:'content',
    request_approved:'games', request_rejected:'games', request_stocked:'games', request_deleted:'games', request_image:'games',
    voter_renamed:'games', voter_removed:'games', voter_dupe:'games', voter_empty:'games', voter_error:'games',
    alerts_saved:'settings',
    account_added:'accounts', account_updated:'accounts', account_deleted:'accounts', slot_updated:'accounts', account_error:'accounts',
    bg_saved:'posters', bg_removed:'posters', poster_error:'posters'
  };

  const rawInitial = urlTab || (msg && msgTabMap[msg]) || localStorage.getItem(TAB_KEY) || 'dashboard';
  const initial = LEGACY_TABS[rawInitial] || rawInitial;
  switchTab(initial);

  // Toast notifications
  if (msg) {
    const messages = { added:'✅ Game added!', updated:'✅ Game updated!', deleted:'🗑 Game deleted!', announcement:'📢 Announcement saved!', upcoming_added:'🔜 Upcoming game added!', upcoming_updated:'✅ Upcoming game updated!', upcoming_deleted:'🗑 Upcoming game deleted!', game_released:'🚀 Game released to Available Games!', psplus_added:'⭐ Monthly entry added!', psplus_updated:'✅ Monthly entry updated!', psplus_deleted:'🗑 Monthly entry deleted!', psplus_prices:'💰 PS Plus prices saved!', popular_added:'🔥 Game added to Most Played!', popular_updated:'✅ Most Played game updated!', popular_deleted:'🗑 Game removed from Most Played!', settings_saved:'⚙️ Settings saved!', promo_saved:'🎉 Promo settings saved!', popup_saved:'🪧 Popup settings saved!', password_changed:'🔒 Password changed!', wrong_password:'❌ Current password is wrong!', password_mismatch:'❌ Passwords do not match!', password_too_short:'❌ Password must be at least 4 characters!', cat_added:'🏷️ Category created!', cat_updated:'🏷️ Category updated!', cat_deleted:'🗑 Category deleted!', customer_added:'👤 Customer added!', customer_updated:'✅ Customer updated!', customer_deleted:'🗑 Customer deleted!', slot_required:'⚠ Pick the account slot — availability for this game comes from linked accounts, so a rental with no slot leaves it showing as free.', slot_unavailable:'❌ That account slot is no longer free — pick another.', slot_moved:'🗂️ Moved to the new account slot.', month_log_saved:'📣 Month log saved!', month_log_deleted:'🗑 Month log deleted!', signin_step_saved:'✅ Step saved!', signin_step_deleted:'🗑 Step deleted!', order_marked_paid:'✅ Order marked as paid!', order_priority_paid:'⭐ Moved to priority — they now sit above every free entry.', order_priority_undone:'↩ Priority undone — back on the free list, position kept.', alerts_saved:'🔔 Alert settings saved.', order_bad_state:'❌ That order is no longer in a state where this applies.', order_stale:'❌ Could not update that order — reload and try again.', order_cancelled:'🚫 Order cancelled.', request_approved:'✅ Request approved!', request_rejected:'🚫 Request rejected.', request_stocked:'📦 Marked as stocked!', request_deleted:'🗑 Request deleted.', request_image:'🖼️ Cover image saved!', voter_renamed:'✅ Voter name updated!', voter_removed:'🗑 Vote removed.', voter_dupe:'❌ That name has already voted for this game!', voter_empty:'❌ Voter name cannot be blank!', voter_error:'❌ Could not update that vote.', account_added:'🗂️ Account added!', account_updated:'✅ Account updated!', account_deleted:'🗑 Account deleted!', slot_updated:'✅ Slot updated!', account_error:'❌ Could not save that account.', bg_saved:'🎨 Poster background updated!', bg_removed:'🎨 Poster background removed.', poster_error:'❌ Choose an image first.' };
    const text = messages[msg];
    if (text) {
      const toast = document.createElement('div');
      toast.className = 'toast success';
      toast.textContent = text;
      document.body.appendChild(toast);
      setTimeout(() => toast.classList.add('show'), 100);
      setTimeout(() => { toast.classList.remove('show'); setTimeout(() => toast.remove(), 400); }, 3000);
      history.replaceState({}, '', '/admin?tab=' + (msgTabMap[msg] || initial));
    }
    // The Sign-In QR Guide used to need re-opening after a save; it is a
    // plain always-visible panel now, so landing on the tab is enough.
  }

  // Restore whichever PS5/PS4 console tab was last active in the Sign-In
  // QR Guide editor, independent of the toast/accordion logic above.
  try {
    const savedConsole = sessionStorage.getItem('ssgAdminConsole');
    if (savedConsole === 'ps4' && typeof ssgSwitch === 'function') ssgSwitch('ps4');
  } catch (e) {}
})();

// ── Loading overlay ──
(function() {
  const overlay = document.getElementById('loadingOverlay');
  const loadingText = document.getElementById('loadingText');
  const messages = { '/admin/announcement':'📢 Saving announcement...', '/admin/announcements':'📢 Saving announcement...', '/admin/site-settings':'⚙️ Saving settings...', '/admin/hero-text':'✏️ Saving hero text...', '/admin/change-password':'🔒 Changing password...', '/admin/psplus/prices':'💰 Saving PS Plus prices...', '/admin/add':'🎮 Adding game...', '/admin/upcoming/add':'🔜 Adding upcoming game...', '/admin/psplus/add':'⭐ Adding PS Plus entry...', '/admin/psplus/popular/add':'🔥 Adding Most Played game...', '/admin/price-categories':'🏷️ Saving category...' };
  document.addEventListener('submit', function(e) {
    if (e.target.dataset.noLoading) return;
    const action = e.target.action || '';
    const label = Object.keys(messages).find(k => action.includes(k));
    loadingText.textContent = label ? messages[label] : 'Saving changes...';
    overlay.style.display = 'flex';
  });
})();
</script>

