            <span class="desc">A rentable PS5 or PS4 title</span>
          </a>
          <a class="add-choice-card" href="/admin/add/game?bundle=1">
            <span class="icon">📦</span>
            <span class="label">Bundle</span>
            <span class="desc">One entry standing in for a whole account</span>
          </a>
          <a class="add-choice-card" href="/admin/add/upcoming">
            <span class="icon">🔜</span>
            <span class="label">Upcoming Game</span>
            <span class="desc">Not released yet — open for reservations</span>
          </a>
          <a class="add-choice-card" href="#add-category-form" onclick="document.getElementById('addChoiceModal').classList.remove('open');setTimeout(()=>document.getElementById('add-category-form').scrollIntoView({behavior:'smooth'}),50)">
            <span class="icon">🏷️</span>
            <span class="label">Price Category</span>
            <span class="desc">Create a pricing tier shared by multiple games</span>
          </a>
        </div>
      </div>
    </div>

    <!-- PRICE CATEGORIES -->
    <div class="settings-accordion">
      <div class="settings-accordion-header" onclick="toggleAccordion(this)" style="border-left:3px solid #22c55e;">
        <div class="sa-left">
          <div class="sa-icon" style="background:rgba(34,197,94,0.15);">🏷️</div>
          <div><div class="sa-title">Price Categories</div><div class="sa-desc">Shared pricing tiers assigned to multiple games</div></div>
        </div><span class="sa-arrow">▼</span>
      </div>
      <div class="settings-accordion-body">
    <div id="add-category-form" class="form-card" style="border-color:rgba(34,197,94,0.3);background:linear-gradient(135deg,#001a06,#0a1a0a);">
      <h2 style="display:none;">🏷️ Price Categories</h2>
      <p style="color:#666;font-size:0.82rem;margin-bottom:1.25rem;">Create pricing tiers (e.g. "New Games", "Classic") — assign games to a category so they all share the same price automatically.</p>
      <% if (priceCategories.length > 0) { %>
      <div style="display:flex;flex-direction:column;gap:0.75rem;margin-bottom:1.5rem;">
        <% priceCategories.forEach(cat => { %>
        <details style="background:#0a0a0a;border:1px solid #1a2a1a;border-radius:10px;overflow:hidden;">
          <summary style="padding:0.85rem 1rem;cursor:pointer;display:flex;align-items:center;gap:0.75rem;list-style:none;user-select:none;">
            <span style="font-size:1rem;">🏷️</span>
            <span style="font-weight:700;color:#fff;flex:1;"><%= cat.name %></span>
            <span style="font-size:0.75rem;color:#555;">NT: ₱<%= cat.nt_price_7d %>/₱<%= cat.nt_price_30d %> &nbsp;|&nbsp; TR: ₱<%= cat.tr_price_7d %>/₱<%= cat.tr_price_30d %></span>
            <span style="color:#444;font-size:0.8rem;margin-left:0.5rem;">▼</span>
          </summary>
          <div style="padding:1rem;border-top:1px solid #1a2a1a;">
            <form method="POST" action="/admin/price-categories/edit/<%= cat.id %>" enctype="multipart/form-data">
              <div class="form-grid">
                <div class="form-group full"><label>Category Name</label><input type="text" name="name" value="<%= cat.name %>" required></div>
                <div class="form-group full" style="margin-bottom:0;"><label style="color:#aaa;">🎮 Non-Trophy Prices (₱)</label></div>
                <div class="form-group"><label>Weekly</label><input type="number" name="nt_price_7d" value="<%= cat.nt_price_7d %>" min="1"></div>
                <div class="form-group"><label>Monthly</label><input type="number" name="nt_price_30d" value="<%= cat.nt_price_30d %>" min="1"></div>
                <div class="form-group full" style="margin-bottom:0;"><label style="color:#ffc400;">🏆 Trophy Account Prices (₱)</label></div>
                <div class="form-group"><label>Weekly</label><input type="number" name="tr_price_7d" value="<%= cat.tr_price_7d %>" min="1"></div>
                <div class="form-group"><label>Monthly</label><input type="number" name="tr_price_30d" value="<%= cat.tr_price_30d %>" min="1"></div>

                <div class="form-group full" style="margin-bottom:0;"><label style="color:#7dd3fc;">🎨 Homepage Card Design</label></div>
                <div class="form-group full">
                  <label>Card Picture</label>
                  <% if (cat.image) { %>
                  <div style="display:flex;align-items:center;gap:0.6rem;margin-bottom:0.5rem;">
                    <img src="<%= cat.image %>" style="width:60px;height:60px;object-fit:cover;border-radius:8px;border:1px solid #222;">
                    <label style="display:flex;align-items:center;gap:0.4rem;font-size:0.78rem;color:#ef4444;font-weight:600;">
                      <input type="checkbox" name="remove_image"> Remove current picture
                    </label>
                  </div>
                  <% } %>
                  <input type="file" name="image" accept="image/*">
                </div>
                <div class="form-group"><label>Picture Width (%) <span style="color:#666;font-weight:400;">— how far it reaches across the card</span></label><input type="number" name="image_width" value="<%= cat.image_width != null ? cat.image_width : 52 %>" min="20" max="90"></div>
                <div class="form-group"><label>Picture Opacity (%)</label><input type="number" name="image_opacity" value="<%= cat.image_opacity != null ? cat.image_opacity : 100 %>" min="0" max="100"></div>
                <div class="form-group"><label>Accent Color <span style="color:#666;font-weight:400;">— price text</span></label><input type="color" name="bg_color" value="<%= cat.bg_color || '#F0A500' %>" style="height:38px;padding:0.2rem;"></div>
                <div class="form-group"><label>Title Font Color</label><input type="color" name="title_color" value="<%= cat.title_color || '#ffffff' %>" style="height:38px;padding:0.2rem;"></div>
                <div class="form-group"><label>Title Font Size (px)</label><input type="number" name="title_size" value="<%= cat.title_size != null ? cat.title_size : 18 %>" min="10" max="40"></div>
              </div>
              <div class="form-actions" style="margin-top:0.75rem;">
                <button type="submit" class="btn btn-primary" style="background:#166534;">Save Category</button>
                <button type="button" class="btn btn-outline" style="border-color:#7f1d1d;color:#ef4444;"
                  onclick="if(confirm('Delete this category? Games using it will switch to custom price.')) { fetch('/admin/price-categories/delete/<%= cat.id %>',{method:'POST'}).then(()=>location.reload()); }">Delete</button>
              </div>
            </form>
          </div>
        </details>
        <% }) %>
      </div>
      <% } else { %>
      <p style="color:#444;font-size:0.82rem;margin-bottom:1.25rem;font-style:italic;">No categories yet. Add one below.</p>
      <% } %>
      <details style="background:#050f05;border:1px dashed #1a3a1a;border-radius:10px;overflow:hidden;">
        <summary style="padding:0.85rem 1rem;cursor:pointer;color:#22c55e;font-weight:700;font-size:0.9rem;list-style:none;">+ Add New Price Category</summary>
        <div style="padding:1rem;border-top:1px dashed #1a3a1a;">
          <form method="POST" action="/admin/price-categories/add" enctype="multipart/form-data">
            <div class="form-grid">
              <div class="form-group full"><label>Category Name *</label><input type="text" name="name" placeholder="e.g. New Games, Classic, Special" required></div>
              <div class="form-group full" style="margin-bottom:0;"><label style="color:#aaa;">🎮 Non-Trophy Prices (₱)</label></div>
              <div class="form-group"><label>Weekly</label><input type="number" name="nt_price_7d" value="149" min="1"></div>
              <div class="form-group"><label>Monthly</label><input type="number" name="nt_price_30d" value="349" min="1"></div>
              <div class="form-group full" style="margin-bottom:0;"><label style="color:#ffc400;">🏆 Trophy Account Prices (₱)</label></div>
              <div class="form-group"><label>Weekly</label><input type="number" name="tr_price_7d" value="199" min="1"></div>
              <div class="form-group"><label>Monthly</label><input type="number" name="tr_price_30d" value="399" min="1"></div>

              <div class="form-group full" style="margin-bottom:0;"><label style="color:#7dd3fc;">🎨 Homepage Card Design</label></div>
              <div class="form-group full"><label>Card Picture</label><input type="file" name="image" accept="image/*"></div>
              <div class="form-group"><label>Picture Width (%) <span style="color:#666;font-weight:400;">— how far it reaches across the card</span></label><input type="number" name="image_width" value="52" min="20" max="90"></div>
              <div class="form-group"><label>Picture Opacity (%)</label><input type="number" name="image_opacity" value="100" min="0" max="100"></div>
              <div class="form-group"><label>Accent Color <span style="color:#666;font-weight:400;">— price text</span></label><input type="color" name="bg_color" value="#F0A500" style="height:38px;padding:0.2rem;"></div>
              <div class="form-group"><label>Title Font Color</label><input type="color" name="title_color" value="#ffffff" style="height:38px;padding:0.2rem;"></div>
              <div class="form-group"><label>Title Font Size (px)</label><input type="number" name="title_size" value="18" min="10" max="40"></div>
            </div>
            <div class="form-actions" style="margin-top:0.75rem;">
              <button type="submit" class="btn btn-primary" style="background:#166534;">Create Category</button>
            </div>
          </form>
        </div>
      </details>
    </div>

      </div></div><!-- /accordion price-cat -->

    <!-- GAME REQUESTS -->
    <div class="settings-accordion">
      <div class="settings-accordion-header" onclick="toggleAccordion(this)" style="border-left:3px solid #22c55e;">
        <div class="sa-left">
          <div class="sa-icon" style="background:rgba(34,197,94,0.15);">🙋</div>
          <div>
            <div class="sa-title">Game Requests (<%= gameRequestRows.length %>)</div>
            <div class="sa-desc">What customers are asking for — approve new ones, mark stocked when you add them</div>
          </div>
        </div><span class="sa-arrow">▼</span>
      </div>
      <div class="settings-accordion-body">
        <div style="padding:1rem 1.25rem;">
          <% if (!gameRequestRows.length) { %>
            <div style="color:#666;font-size:0.85rem;padding:1rem 0;">No requests yet.</div>
          <% } %>
          <% gameRequestRows.forEach(r => { const votes = (r.voters || []).length; %>
          <div style="display:flex;align-items:flex-start;gap:0.85rem;background:#111;border:1px solid <%= r.status === 'pending' ? '#7a5c00' : '#222' %>;border-radius:10px;padding:0.8rem 1rem;margin-bottom:0.6rem;">
            <span style="font-size:1.1rem;font-weight:900;color:var(--ps-blue);min-width:2rem;text-align:center;"><%= votes %></span>
            <% if (r.cover_image) { %>
              <img src="<%= r.cover_image %>" alt="" style="width:40px;height:60px;min-width:40px;border-radius:5px;object-fit:cover;background:#151515;">
            <% } else { %>
              <div style="width:40px;height:60px;min-width:40px;border-radius:5px;border:1px dashed #2e2e2e;display:flex;align-items:center;justify-content:center;font-size:1.1rem;color:#3d3d3d;">🎮</div>
            <% } %>
            <div style="flex:1;min-width:0;">
              <div style="font-weight:700;color:#fff;font-size:0.9rem;">
                <%= r.title %>
                <span style="font-size:0.68rem;font-weight:800;text-transform:uppercase;letter-spacing:0.5px;margin-left:0.4rem;color:<%= r.status === 'pending' ? '#f59e0b' : r.status === 'approved' ? 'var(--ps-blue)' : r.status === 'stocked' ? '#22c55e' : '#666' %>;"><%= r.status %></span>
              </div>
              <div style="font-size:0.72rem;color:#666;margin-top:0.25rem;line-height:1.6;">
                <%= (r.voters || []).map(v => v.fb_name).join(', ') || 'no voters' %>
              </div>
            </div>
            <div style="display:flex;gap:0.35rem;flex-wrap:wrap;flex-shrink:0;">
              <% if (r.status === 'pending') { %>
              <form method="POST" action="/admin/requests/<%= r.slug %>/approve" style="display:inline"><button type="submit" class="btn-edit" style="background:rgba(34,197,94,0.15);color:#22c55e;">Approve</button></form>
              <form method="POST" action="/admin/requests/<%= r.slug %>/reject" style="display:inline"><button type="submit" class="btn-edit">Reject</button></form>
              <% } %>
              <% if (r.status === 'approved') { %>
              <form method="POST" action="/admin/requests/<%= r.slug %>/stock" style="display:inline" onsubmit="return confirm('Mark <%= r.title.replace(/'/g, "\\'") %> as stocked? It will show as Now available on the request board.');"><button type="submit" class="btn-edit" style="background:rgba(34,197,94,0.15);color:#22c55e;">Mark stocked</button></form>
              <% } %>
              <form method="POST" action="/admin/requests/<%= r.slug %>/delete" style="display:inline" onsubmit="return confirm('Delete this request permanently?');"><button type="submit" class="btn-delete">🗑</button></form>
            </div>
          </div>
          <form method="POST" action="/admin/requests/<%= r.slug %>/image" enctype="multipart/form-data" style="display:flex;gap:0.4rem;align-items:center;margin:-0.3rem 0 0.6rem 2.85rem;">
            <input type="file" name="cover_image" accept="image/*" style="font-size:0.72rem;color:#888;max-width:220px;">
            <button type="submit" class="btn-edit" style="font-size:0.72rem;padding:0.3rem 0.7rem;"><%= r.cover_image ? 'Replace cover' : 'Add cover' %></button>
          </form>
          <% }) %>
        </div>
      </div>
    </div>

    <!-- GAMES TABLE (not collapsible — always shown) -->
    <div class="settings-accordion">
      <div class="settings-accordion-header" style="border-left:3px solid #60a5fa;cursor:default;">
        <div class="sa-left">
          <div class="sa-icon" style="background:rgba(96,165,250,0.15);">📋</div>
          <div><div class="sa-title">All Games (<%= games.length %>)</div><div class="sa-desc">View, edit, and delete games in your library</div></div>
        </div>
      </div>
      <div class="settings-accordion-body open">
    <div class="table-card">
      <h2 style="display:none;">All Games (<%= games.length %>)</h2>
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.5rem;padding:1rem 1.25rem 0;">
        <div style="position:relative;flex:0 0 260px;">
          <input type="text" id="gameSearch" placeholder="Search title or category..." oninput="applyGameFilter()"
            style="width:100%;padding:0.45rem 0.9rem 0.45rem 2.2rem;background:#1a1a1a;border:1px solid #333;border-radius:8px;color:#fff;font-size:0.85rem;box-sizing:border-box;">
          <span style="position:absolute;left:0.6rem;top:50%;transform:translateY(-50%);color:#555;font-size:0.9rem;pointer-events:none;">🔍</span>
        </div>
        <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
          <button onclick="filterGamesPlatform('all')" id="gf-all" class="btn btn-outline" style="padding:0.3rem 0.85rem;font-size:0.78rem;font-weight:700;">All</button>
          <button onclick="filterGamesPlatform('PS5')" id="gf-PS5" class="btn btn-outline" style="padding:0.3rem 0.85rem;font-size:0.78rem;font-weight:700;">PS5</button>
          <button onclick="filterGamesPlatform('PS4')" id="gf-PS4" class="btn btn-outline" style="padding:0.3rem 0.85rem;font-size:0.78rem;font-weight:700;">PS4</button>
          <button onclick="filterGamesPlatform('PS4/PS5')" id="gf-PS4/PS5" class="btn btn-outline" style="padding:0.3rem 0.85rem;font-size:0.78rem;font-weight:700;">PS4/PS5</button>
          <button onclick="toggleGamesNewOnly()" id="gf-new" class="btn btn-outline" style="padding:0.3rem 0.85rem;font-size:0.78rem;font-weight:700;border-color:#166534;color:#22c55e;">🆕 New only</button>
        </div>
      </div>
      <div id="gameFilterCount" style="font-size:0.78rem;color:#555;padding:0.6rem 1.25rem 0;"></div>
      <div style="overflow:auto;max-height:calc(5 * 4.6rem + 2.6rem);">
        <table class="games-table">
          <thead>
            <tr><th>Cover</th><th>Title</th><th>Platform</th><th>🆕 Added</th><th>📅 Released</th><th>🎮 NT Slots</th><th style="color:#ffc400;">🏆 TR Slots</th><th>🕹️ PS4 Slots</th><th>Non-Trophy Prices</th><th>Trophy Prices</th><th style="color:#f59e0b;">Cost</th><th style="color:#22c55e;">Earned</th><th style="color:var(--ps-blue);">Profit</th><th>Actions</th></tr>
          </thead>
          <tbody>
            <% if (games.length === 0) { %>
            <tr><td colspan="14" style="text-align:center;color:var(--text-secondary);padding:2rem;">No games yet. Add one above!</td></tr>
            <% } %>
            <% games.forEach(game => {
              const gameTotalEarned = customers.filter(c => c.game_id === game.id).reduce((s,c) => s+(c.price||0), 0);
              const gameRentalCount = customers.filter(c => c.game_id === game.id).length;
              const gameCost = game.cost || 0;
              const gameProfit = gameTotalEarned - gameCost;
              // Fixed 11-day "new" window from created_at by default — same rule as the
              // site-wide NEW badge and New Arrivals poster group (server.js
              // NEW_GAME_WINDOW_DAYS), overridable per game via game.new_window_days.
              // Days-left is how much runway remains to see if the game gets any renters
              // before deciding whether to keep restocking it.
              const gWindowDays = game.new_window_days || 11;
              const gAddedDate = game.created_at ? new Date(game.created_at) : null;
              const gDaysSinceAdded = gAddedDate ? Math.floor((Date.now() - gAddedDate.getTime()) / 86400000) : null;
              const gIsNewThisMonth = gDaysSinceAdded !== null && gDaysSinceAdded < gWindowDays;
              const gDaysLeft = gIsNewThisMonth ? gWindowDays - gDaysSinceAdded : null;
              const gAddedLabel = gAddedDate ? gAddedDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : null;
              const gSearchText = (game.title + ' ' + (game._category_name || '')).toLowerCase();
            %>
            <tr class="game-row" data-platform="<%= game.platform %>" data-new="<%= gIsNewThisMonth ? '1' : '0' %>" data-search="<%= gSearchText %>">
              <td>
                <% if (game.cover_image) { %><img src="<%= game.cover_image %>" class="table-cover" alt=""><% } else { %><div class="table-cover-placeholder">🎮</div><% } %>
              </td>
              <td>
                <strong><%= game.title %></strong>
                <% if (game._category_name) { %>
                  <span style="display:inline-block;margin-left:0.4rem;background:#0a2a0a;border:1px solid #166534;border-radius:20px;padding:0.1rem 0.5rem;font-size:0.68rem;color:#22c55e;font-weight:600;">🏷️ <%= game._category_name %></span>
                <% } %>
              </td>
              <td><span style="color:var(--ps-blue);font-weight:600;font-size:0.8rem;"><%= game.platform %></span></td>
              <td>
                <% if (gIsNewThisMonth) { %>
                  <div style="font-size:0.72rem;color:#aaa;"><%= gAddedLabel %></div>
                  <div style="font-size:0.72rem;font-weight:700;color:<%= gDaysLeft <= 3 ? '#ef4444' : 'var(--ps-blue)' %>;"><%= gDaysLeft %>d left</div>
                  <% if (gameRentalCount === 0) { %>
                    <div style="font-size:0.66rem;color:#ef4444;font-weight:700;margin-top:0.15rem;">⚠️ 0 renters</div>
                  <% } %>
                <% } else { %>
                  <span style="color:#333;font-size:0.8rem;">—</span>
                <% } %>
              </td>
              <td>
                <% if (game.release_date && game.release_date !== 'TBA') { %>
                  <span style="color:#aaa;font-size:0.75rem;"><%= new Date(game.release_date + 'T00:00:00').toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
                <% } else { %>
                  <span style="color:#333;font-size:0.8rem;" title="Set a release date to include this game in New Releases">—</span>
                <% } %>
              </td>
              <td>
                <% const ntS = game.non_trophy_slots || 0; %>
                <% if (ntS > 0) { %><span class="badge badge-available"><%= ntS %></span><% } else { %><span class="badge badge-unavailable">0</span><% } %>
              </td>
              <td>
                <% if (game.trophy_account) { %>
                  <span style="color:#ffc400;font-weight:700;font-size:0.88rem;">🏆 <%= game.trophy_slots || 0 %></span>
                <% } else if ((game.trophy_slots || 0) > 0) { %>
                  <span style="color:#555;font-size:0.8rem;"><%= game.trophy_slots %> (off)</span>
                <% } else { %>
                  <span style="color:#333;font-size:0.8rem;">—</span>
                <% } %>
              </td>
              <td>
                <% const ps4S = game.ps4_primary_slots || 0; %>
                <% if (game.platform === 'PS4' || game.platform === 'PS4/PS5') { %>
                  <% if (ps4S > 0) { %><span style="color:#60a5fa;font-weight:700;">🕹️ <%= ps4S %></span><% } else { %><span style="color:#333;font-size:0.8rem;">0</span><% } %>
                <% } else { %>
                  <span style="color:#333;font-size:0.8rem;">—</span>
                <% } %>
              </td>
              <td style="font-size:0.8rem;color:#aaa;line-height:1.7;">₱<%= game.nt_price_7d %> / ₱<%= game.nt_price_30d %></td>
              <td style="font-size:0.8rem;color:#ffc400;line-height:1.7;"><%= game.trophy_account ? '₱'+game.tr_price_7d+' / ₱'+game.tr_price_30d : '—' %></td>
              <td>
                <div style="font-weight:700;color:#f59e0b;font-size:0.9rem;">₱<%= gameCost.toLocaleString() %></div>
              </td>
              <td>
                <div style="font-weight:800;color:#22c55e;font-size:0.9rem;">₱<%= gameTotalEarned.toLocaleString() %></div>
                <div style="font-size:0.68rem;color:#555;margin-top:0.1rem;"><%= gameRentalCount %> txn<%= gameRentalCount !== 1 ? 's' : '' %></div>
              </td>
              <td>
                <div style="font-weight:800;color:<%= gameProfit >= 0 ? 'var(--ps-blue)' : '#ef4444' %>;font-size:0.9rem;">₱<%= gameProfit.toLocaleString() %></div>
                <div style="font-size:0.68rem;color:#555;margin-top:0.1rem;"><%= gameProfit >= 0 ? 'profit' : 'at a loss' %></div>
              </td>
              <td>
                <div class="action-btns">
                  <a href="/admin/edit/<%= game.id %>" class="btn-edit">✏️ Edit</a>
                  <form method="POST" action="/admin/games/<%= game.id %>/stocked" style="display:inline">
                    <button type="submit" class="btn-edit" style="<%= game.stocked ? 'background:rgba(34,197,94,0.15);color:#22c55e;' : '' %>" title="<%= game.stocked ? 'Stocked — click to clear the not-yet-stocked notice override' : 'Mark this game as stocked, clearing the not-yet-stocked notice regardless of rental history' %>"><%= game.stocked ? '📦 Stocked' : '📦 Stock' %></button>
                  </form>
                  <form method="POST" action="/admin/delete/<%= game.id %>" style="display:inline" onsubmit="return confirm('Delete <%= game.title.replace(/'/g, "\\'") %>?')">
                    <button type="submit" class="btn-delete">🗑 Delete</button>
                  </form>
                </div>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

      </div></div><!-- /accordion all-games -->

    <!-- UPCOMING GAMES -->
    <div class="settings-accordion">
      <div class="settings-accordion-header" onclick="toggleAccordion(this)" style="border-left:3px solid #a855f7;">
        <div class="sa-left">
          <div class="sa-icon" style="background:rgba(168,85,247,0.15);">🔜</div>
          <div><div class="sa-title">Coming Soon Games</div><div class="sa-desc">Add upcoming titles & manage reservations</div></div>
        </div><span class="sa-arrow">▼</span>
      </div>
      <div class="settings-accordion-body">

    <% if (upcoming.length > 0) { %>
    <div class="table-card" style="border-color:#2a1a3a;">
      <h2 style="border-color:#2a1a3a;">🔜 Upcoming Games (<%= upcoming.length %>)</h2>
      <div style="overflow-x:auto;">
        <table class="games-table">
          <thead><tr><th>Cover</th><th>Title</th><th>Platform</th><th>Release Date</th><th>🎮 NT Slots</th><th>🏆 TR Slots</th><th>Prices (Weekly/Monthly)</th><th>Actions</th></tr></thead>
          <tbody>
            <% upcoming.forEach(game => { %>
            <tr>
              <td><% if (game.cover_image) { %><img src="<%= game.cover_image %>" class="table-cover" alt=""><% } else { %><div class="table-cover-placeholder" style="background:#1a0030;">🔜</div><% } %></td>
              <td>
                <strong><%= game.title %></strong>
                <div style="font-size:0.72rem;margin-top:0.2rem;"><span style="background:linear-gradient(135deg,#4a0080,#f107a3);-webkit-background-clip:text;-webkit-text-fill-color:transparent;font-weight:700;">COMING SOON</span></div>
              </td>
              <td><span style="color:var(--ps-blue);font-weight:600;font-size:0.8rem;"><%= game.platform %></span></td>
              <td style="color:#aaa;font-size:0.85rem;"><%= game.release_date === 'TBA' ? 'TBA' : (game.release_date ? new Date(game.release_date+'T00:00:00').toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'}) : '—') %></td>
              <td style="text-align:center;">
                <span style="font-weight:700;color:<%= (game.non_trophy_slots||0) > 0 ? '#22c55e' : '#555' %>"><%= game.non_trophy_slots || 0 %></span>
              </td>
              <td style="text-align:center;">
                <span style="font-weight:700;color:<%= (game.trophy_slots||0) > 0 ? '#ffc400' : '#555' %>"><%= game.trophy_slots || 0 %></span>
              </td>
              <td style="font-size:0.75rem;line-height:1.8;">
                <% if (game.nt_price_7d || game.nt_price_30d) { %>
                <div style="color:#ccc;">🎮 ₱<%= game.nt_price_7d||'—' %> / ₱<%= game.nt_price_30d||'—' %></div>
                <% } %>
                <% if (game.tr_price_7d || game.tr_price_30d) { %>
                <div style="color:#ffc400;">🏆 ₱<%= game.tr_price_7d||'—' %> / ₱<%= game.tr_price_30d||'—' %></div>
                <% } %>
                <% if (!game.nt_price_7d && !game.tr_price_7d) { %><span style="color:#444;">—</span><% } %>
              </td>
              <td>
                <div class="action-btns" style="flex-direction:column;align-items:flex-start;gap:0.4rem;">
                  <form method="POST" action="/admin/upcoming/release/<%= game.id %>" style="display:inline" onsubmit="return confirm('Release \'<%= game.title.replace(/'/g, "\\'") %>\' to Available Games?')">
                    <button type="submit" style="background:linear-gradient(135deg,#065f46,#22c55e);color:#fff;border:none;border-radius:20px;padding:0.3rem 0.8rem;font-size:0.75rem;font-weight:700;cursor:pointer;white-space:nowrap;">🚀 Release</button>
                  </form>
                  <div style="display:flex;gap:0.4rem;">
                    <a href="/admin/upcoming/edit/<%= game.id %>" class="btn-edit">✏️ Edit</a>
                    <form method="POST" action="/admin/upcoming/delete/<%= game.id %>" style="display:inline" onsubmit="return confirm('Delete <%= game.title.replace(/'/g, "\\'") %>?')">
                      <button type="submit" class="btn-delete">🗑</button>
                    </form>
                  </div>
                </div>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <% } %>
      </div></div><!-- /accordion upcoming -->

  </div><!-- /tab-games -->

  <!-- ═══════════════ PS PLUS TAB ═══════════════ -->
  <div class="tab-panel" id="tab-psplus">

    <div class="form-card" style="border-color:rgba(255,215,0,0.2);">
      <h2>🔥 Add Most Played PS Plus Game</h2>
      <form method="POST" action="/admin/psplus/popular/add" enctype="multipart/form-data">
        <div class="form-grid">
          <div class="form-group full"><label>Game Title *</label><input type="text" name="title" placeholder="e.g. God of War Ragnarök" required></div>
          <div class="form-group"><label>Platform</label><select name="platform"><option value="PS5">PS5</option><option value="PS4">PS4</option><option value="PS4/PS5">PS4/PS5</option></select></div>
          <div class="form-group"><label>Genre</label><input type="text" name="genre" placeholder="e.g. Action, RPG"></div>
          <div class="form-group"><label>Rank <span style="color:#555;font-size:0.75rem;">(display order)</span></label><input type="number" name="rank" value="1" min="1"></div>
          <div class="form-group"><label>Cover Image</label><input type="file" name="cover_image" accept="image/*" style="padding:0.5rem;"></div>
          <div class="form-group full"><label>Description (optional)</label><textarea name="description" placeholder="Short description..."></textarea></div>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn" style="background:linear-gradient(135deg,#856200,#FFD700);color:#000;font-weight:800;padding:0.65rem 1.5rem;border-radius:8px;border:none;cursor:pointer;">🔥 Add Game</button>
          <button type="reset" class="btn btn-outline">Clear</button>
        </div>
      </form>
    </div>

    <% if (psplusPopular.length > 0) { %>
    <div class="table-card" style="border-color:rgba(255,215,0,0.2);">
      <h2 style="border-color:rgba(255,215,0,0.15);">🔥 Most Played Games (<%= psplusPopular.length %>)</h2>
      <div style="overflow-x:auto;">
        <table class="games-table">
          <thead><tr><th>#</th><th>Cover</th><th>Title</th><th>Platform</th><th>Genre</th><th>Actions</th></tr></thead>
          <tbody>
            <% psplusPopular.forEach(game => { %>
            <tr>
              <td><span style="font-weight:800;color:#FFD700;">#<%= game.rank || '—' %></span></td>
              <td><% if (game.cover_image) { %><img src="<%= game.cover_image %>" class="table-cover" alt=""><% } else { %><div class="table-cover-placeholder" style="background:#1a1400;">🔥</div><% } %></td>
              <td><strong><%= game.title %></strong></td>
              <td><span style="color:var(--ps-blue);font-weight:600;font-size:0.8rem;"><%= game.platform %></span></td>
              <td style="color:var(--text-secondary)"><%= game.genre || '—' %></td>
              <td>
                <div class="action-btns">
                  <a href="/admin/psplus/popular/edit/<%= game.id %>" class="btn-edit">✏️ Edit</a>
                  <form method="POST" action="/admin/psplus/popular/delete/<%= game.id %>" style="display:inline" onsubmit="return confirm('Delete <%= game.title.replace(/'/g, "\\'") %>?')">
                    <button type="submit" class="btn-delete">🗑 Delete</button>
                  </form>
                </div>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <% } %>

    <div class="form-card" style="border-color:rgba(255,215,0,0.3);background:linear-gradient(135deg,#1a1a0a,#0d0900);">
      <h2 style="display:flex;align-items:center;gap:0.5rem;">⭐ PS Plus Deluxe — Global Pricing</h2>
      <p style="font-size:0.82rem;color:#555;margin-bottom:1rem;">These prices apply to all PS Plus Deluxe monthly game access.</p>
      <form method="POST" action="/admin/psplus/prices">
        <div class="form-grid">
          <div class="form-group full" style="margin-bottom:0;"><label style="color:#aaa;">🎮 Non-Trophy Prices (₱)</label></div>
          <div class="form-group"><label>Weekly</label><input type="number" name="nt_price_7d" value="<%= psplusPrices.nt_price_7d %>" min="1"></div>
          <div class="form-group"><label>Monthly</label><input type="number" name="nt_price_30d" value="<%= psplusPrices.nt_price_30d %>" min="1"></div>
          <div class="form-group full" style="margin-bottom:0;"><label style="color:#FFD700;">🏆 Trophy Account Prices (₱) <span style="font-weight:400;color:#664d00;font-size:0.78rem;">— +₱100 deposit not included</span></label></div>
          <div class="form-group"><label>Weekly</label><input type="number" name="tr_price_7d" value="<%= psplusPrices.tr_price_7d %>" min="1"></div>
          <div class="form-group"><label>Monthly</label><input type="number" name="tr_price_30d" value="<%= psplusPrices.tr_price_30d %>" min="1"></div>
        </div>
        <div class="form-actions" style="margin-top:0.75rem;">
          <button type="submit" class="btn" style="background:#FFD700;color:#000;font-weight:800;padding:0.65rem 1.5rem;border-radius:8px;border:none;cursor:pointer;">Save Prices</button>
        </div>
      </form>
    </div>

    <div class="form-card" style="border-color:rgba(255,215,0,0.2);">
      <h2 style="display:flex;align-items:center;gap:0.5rem;">+ Add Monthly Games</h2>
      <form method="POST" action="/admin/psplus/add" enctype="multipart/form-data">
        <div class="form-grid">
          <div class="form-group"><label>Year *</label><input type="number" name="year" value="<%= new Date().getFullYear() %>" min="2020" max="2040" required></div>
          <div class="form-group">
            <label>Month *</label>
            <select name="month" required>
              <% ['January','February','March','April','May','June','July','August','September','October','November','December'].forEach((m,i) => { %>
                <option value="<%= i+1 %>"><%= m %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group full"><label>Cover Image <span style="color:#555;font-size:0.75rem;">(monthly PS Plus banner screenshot)</span></label><input type="file" name="cover_image" accept="image/*" style="padding:0.5rem;"></div>
          <div class="form-group full"><label>Games List <span style="color:#555;font-size:0.75rem;">(one game per line)</span></label><textarea name="games_list" rows="6" placeholder="Suicide Squad: Kill the Justice League&#10;The Stanley Parable: Ultra Deluxe&#10;Hitman World of Assassination"></textarea></div>
          <div class="form-group"><label>🎮 Non-Trophy Slots</label><input type="number" name="nt_slots" value="0" min="0" placeholder="0"></div>
          <div class="form-group"><label>🏆 Trophy Slots</label><input type="number" name="tr_slots" value="0" min="0" placeholder="0"></div>
          <div class="form-group full"><label>Notes (optional)</label><textarea name="notes" rows="2" placeholder="e.g. Available on PS4 and PS5"></textarea></div>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn" style="background:#FFD700;color:#000;font-weight:800;padding:0.65rem 1.5rem;border-radius:8px;border:none;cursor:pointer;">Add Monthly Entry</button>
          <button type="reset" class="btn btn-outline">Clear</button>
        </div>
      </form>
    </div>

    <div class="table-card" style="border-color:rgba(255,215,0,0.2);">
      <h2 style="border-color:rgba(255,215,0,0.15);">⭐ PS Plus Monthly Entries (<%= psplus.length %>)</h2>
      <% if (psplus.length === 0) { %>
        <div style="padding:2rem;text-align:center;color:var(--text-secondary);">No entries yet. Add one above!</div>
      <% } else { %>
      <% let lastYear = null; %>
      <% psplus.forEach(entry => { %>
        <% if (entry.year !== lastYear) { lastYear = entry.year; %>
          <div style="padding:0.5rem 1rem;background:#0d0900;font-size:0.75rem;font-weight:800;color:#FFD700;letter-spacing:1px;border-bottom:1px solid #1a1500;">── <%= entry.year %> ──</div>
        <% } %>
        <div class="psplus-admin-entry">
          <% if (entry.cover_image) { %><img src="<%= entry.cover_image %>" class="psplus-admin-cover" alt=""><% } else { %><div class="psplus-admin-cover-placeholder">🎮</div><% } %>
          <div style="flex:1;min-width:0;">
            <div style="font-weight:700;font-size:0.9rem;"><%= entry.month_name %> <%= entry.year %></div>
            <% if (entry.games_list) { %>
              <div style="font-size:0.75rem;color:#555;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:400px;"><%= entry.games_list.split('\n').filter(g=>g.trim()).join(' · ') %></div>
            <% } %>
          </div>
          <div class="action-btns" style="flex-shrink:0;">
            <a href="/admin/psplus/edit/<%= entry.id %>" class="btn-edit">✏️ Edit</a>
            <form method="POST" action="/admin/psplus/delete/<%= entry.id %>" style="display:inline" onsubmit="return confirm('Delete <%= entry.month_name %> <%= entry.year %>?')">
              <button type="submit" class="btn-delete">🗑 Delete</button>
            </form>
          </div>
        </div>
      <% }) %>
      <% } %>
    </div>

  </div><!-- /tab-psplus -->

  <!-- ═══════════════ CUSTOMERS TAB ═══════════════ -->
  <div class="tab-panel" id="tab-customers">

    <%
      // Only static/live (not time-filtered) figures stay server-computed:
      // current-status snapshots and all-time cost/profit (games have no purchase
      // date, so cost can't be attributed to a year — see dashboard JS for the rest).
      const activeCustomers = customers.filter(c => c.status === 'renting');
      const boughtCustomersNow = customers.filter(c => c.status === 'bought');
      const doneCustomersNow = customers.filter(c => c.status === 'done');
      const reservationCustomersNow = customers.filter(c => c.status === 'reservation');
      const totalRevenueAllTime = customers.reduce((s, c) => s + (c.price || 0), 0);
      const totalGameCosts = games.reduce((s, g) => s + (g.cost || 0), 0);
      const netProfitAllTime = totalRevenueAllTime - totalGameCosts;
      const today0 = new Date(); today0.setHours(0,0,0,0);
      const overdueCustomers = activeCustomers.filter(c => c.end_date && new Date(c.end_date + 'T00:00:00') < today0);
      const dashNow = new Date();
    %>

    <!-- ── DASHBOARD ── -->
    <div class="settings-accordion" style="margin-bottom:1rem;">
      <div class="settings-accordion-header open" onclick="toggleAccordion(this)" style="border-left:3px solid #22c55e;">
        <div class="sa-left">
          <div class="sa-icon" style="background:rgba(34,197,94,0.15);">📊</div>
          <div><div class="sa-title">Business Dashboard</div><div class="sa-desc">Revenue, profit, monthly stats & top games</div></div>
        </div><span class="sa-arrow">▼</span>
      </div>
      <div class="settings-accordion-body open">
    <div style="margin-bottom:0;">

      <!-- Header -->
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;flex-wrap:wrap;gap:0.5rem;">
        <span style="font-size:1.05rem;font-weight:800;color:#fff;">📊 Business Dashboard</span>
        <div style="display:flex;align-items:center;gap:0.6rem;">
          <select id="dashYearSelect" onchange="renderDashboard()" style="background:#111;border:1px solid #2a2a2a;border-radius:8px;color:#fff;padding:0.35rem 0.6rem;font-size:0.78rem;"></select>
          <span style="font-size:0.7rem;color:#444;">as of <%= dashNow.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'}) %></span>
        </div>
      </div>

      <!-- KPI Row 1 -->
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:0.65rem;margin-bottom:0.65rem;">
        <div style="background:#0a1a0a;border:1px solid #1a3a1a;border-radius:12px;padding:0.9rem 1rem;">
          <div style="font-size:0.65rem;color:#555;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.3rem;">Total Earned</div>
          <div style="font-size:1.55rem;font-weight:900;color:#22c55e;line-height:1.1;" id="dashTotalEarned">₱0</div>
          <div style="font-size:0.65rem;color:#444;margin-top:0.2rem;" id="dashTransactions">0 transactions</div>
        </div>
        <div style="background:#1a0800;border:1px solid #3a1a00;border-radius:12px;padding:0.9rem 1rem;">
          <div style="font-size:0.65rem;color:#555;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.3rem;">Total Game Costs <span class="dash-tag">all-time</span></div>
          <div style="font-size:1.55rem;font-weight:900;color:#f59e0b;line-height:1.1;">₱<%= totalGameCosts.toLocaleString() %></div>
          <div style="font-size:0.65rem;color:#444;margin-top:0.2rem;"><%= games.length %> games in library</div>
        </div>
        <div style="background:<%= netProfitAllTime >= 0 ? '#060a18' : '#1a0606' %>;border:1px solid <%= netProfitAllTime >= 0 ? '#1a2a4a' : '#3a1a1a' %>;border-radius:12px;padding:0.9rem 1rem;">
          <div style="font-size:0.65rem;color:#555;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.3rem;">Net Profit <span class="dash-tag">all-time</span></div>
          <div style="font-size:1.55rem;font-weight:900;color:<%= netProfitAllTime >= 0 ? 'var(--ps-blue)' : '#ef4444' %>;line-height:1.1;">₱<%= netProfitAllTime.toLocaleString() %></div>
          <div style="font-size:0.65rem;color:#444;margin-top:0.2rem;"><%= totalRevenueAllTime > 0 ? Math.round((netProfitAllTime/totalRevenueAllTime)*100) : 0 %>% margin</div>
        </div>
      </div>

      <!-- KPI Row 2 -->
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:0.65rem;margin-bottom:0.65rem;">
        <div style="background:#100a00;border:1px solid #3a2a00;border-radius:12px;padding:0.9rem 1rem;">
          <div style="font-size:0.65rem;color:#555;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.3rem;">Unique Renters</div>
          <div style="font-size:1.55rem;font-weight:900;color:#fbbf24;line-height:1.1;" id="dashUniqueRenters">0</div>
          <div style="font-size:0.65rem;color:#444;margin-top:0.2rem;">by name — not a verified customer ID</div>
        </div>
        <div style="background:#0a0f1a;border:1px solid #1a2a3a;border-radius:12px;padding:0.9rem 1rem;">
          <div style="font-size:0.65rem;color:#555;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.3rem;">Rental Revenue</div>
          <div style="font-size:1.55rem;font-weight:900;color:#a78bfa;line-height:1.1;" id="dashRentRevenue">₱0</div>
          <div style="font-size:0.65rem;color:#444;margin-top:0.2rem;" id="dashRentSub">0 rentals · 0% of total</div>
        </div>
        <div style="background:#0f0a1a;border:1px solid #2a1a3a;border-radius:12px;padding:0.9rem 1rem;">
          <div style="font-size:0.65rem;color:#555;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.3rem;">Game Sales</div>
          <div style="font-size:1.55rem;font-weight:900;color:#60a5fa;line-height:1.1;" id="dashBuyRevenue">₱0</div>
          <div style="font-size:0.65rem;color:#444;margin-top:0.2rem;" id="dashBuySub">0 games sold · 0% of total</div>
        </div>
      </div>

      <!-- Status Row -->
      <div style="font-size:0.62rem;color:#444;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.4rem;">Live Status <span class="dash-tag">now</span></div>
      <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:0.5rem;margin-bottom:0.65rem;">
        <div style="background:#0a1a0a;border:1px solid #1a3a1a;border-radius:10px;padding:0.75rem 0.6rem;display:flex;align-items:center;gap:0.5rem;">
          <div style="font-size:1.2rem;">🟢</div>
          <div><div style="font-size:1.3rem;font-weight:900;color:#22c55e;line-height:1;"><%= activeCustomers.length %></div><div style="font-size:0.6rem;color:#555;margin-top:0.1rem;">Renting Now</div></div>
        </div>
        <div style="background:#0f0a1a;border:1px solid #2a1a3a;border-radius:10px;padding:0.75rem 0.6rem;display:flex;align-items:center;gap:0.5rem;">
          <div style="font-size:1.2rem;">🔖</div>
          <div><div style="font-size:1.3rem;font-weight:900;color:#c084fc;line-height:1;"><%= reservationCustomersNow.length %></div><div style="font-size:0.6rem;color:#555;margin-top:0.1rem;">Reservations</div></div>
        </div>
        <div style="background:#0a0f1a;border:1px solid #1a2a3a;border-radius:10px;padding:0.75rem 0.6rem;display:flex;align-items:center;gap:0.5rem;">
          <div style="font-size:1.2rem;">🛒</div>
          <div><div style="font-size:1.3rem;font-weight:900;color:#60a5fa;line-height:1;"><%= boughtCustomersNow.length %></div><div style="font-size:0.6rem;color:#555;margin-top:0.1rem;">Games Sold</div></div>
        </div>
        <div style="background:#0a0a1a;border:1px solid #1a1a3a;border-radius:10px;padding:0.75rem 0.6rem;display:flex;align-items:center;gap:0.5rem;">
          <div style="font-size:1.2rem;">✅</div>
          <div><div style="font-size:1.3rem;font-weight:900;color:#aaa;line-height:1;"><%= doneCustomersNow.length %></div><div style="font-size:0.6rem;color:#555;margin-top:0.1rem;">Completed</div></div>
        </div>
        <div style="background:<%= overdueCustomers.length > 0 ? '#1a0a0a' : '#0d0d0d' %>;border:1px solid <%= overdueCustomers.length > 0 ? '#3a1a1a' : '#1e1e1e' %>;border-radius:10px;padding:0.75rem 0.6rem;display:flex;align-items:center;gap:0.5rem;">
          <div style="font-size:1.2rem;">⚠️</div>
          <div><div style="font-size:1.3rem;font-weight:900;color:<%= overdueCustomers.length > 0 ? '#ef4444' : '#555' %>;line-height:1;"><%= overdueCustomers.length %></div><div style="font-size:0.6rem;color:#555;margin-top:0.1rem;">Overdue</div></div>
        </div>
      </div>

      <!-- Charts Row -->
      <div style="display:grid;grid-template-columns:1.4fr 1fr;gap:0.65rem;margin-bottom:0.65rem;">

        <!-- Monthly Bar Chart -->
        <div style="background:#0d0d0d;border:1px solid #1e1e1e;border-radius:12px;padding:1rem;">
          <div style="font-size:0.7rem;font-weight:700;color:#666;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.85rem;">Monthly Revenue — <span id="dashChartYearLabel"></span> <span style="color:#333;font-weight:500;">(click a month for details)</span></div>
          <div style="display:flex;align-items:flex-end;gap:0.4rem;height:122px;" id="dashBarChart"></div>
        </div>

        <!-- Top Games -->
        <div style="background:#0d0d0d;border:1px solid #1e1e1e;border-radius:12px;padding:1rem;">
          <div style="font-size:0.7rem;font-weight:700;color:#666;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.85rem;">Most Rented / Sold Games</div>
          <div id="dashTopGames"></div>
        </div>

      </div>

      <!-- Month Drill-Down Panel -->
      <div id="dashMonthPanel" style="display:none;background:#0a0e18;border:1px solid #1a2a4a;border-radius:12px;padding:1rem;margin-bottom:0.65rem;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.85rem;">
          <span style="font-size:0.85rem;font-weight:800;color:#fff;" id="dashMonthTitle"></span>
          <button type="button" onclick="clearMonthSelection()" style="background:#161616;border:1px solid #2a2a2a;color:#999;border-radius:20px;padding:0.25rem 0.7rem;font-size:0.7rem;font-weight:700;cursor:pointer;">✕ Clear</button>
        </div>
        <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:0.5rem;margin-bottom:0.85rem;">
          <div class="dash-month-stat"><div class="dash-month-val" id="dashMonthEarned" style="color:#22c55e;">₱0</div><div class="dash-month-lbl">Total Earned</div></div>
          <div class="dash-month-stat"><div class="dash-month-val" id="dashMonthTransactions" style="color:#fff;">0</div><div class="dash-month-lbl">Transactions</div></div>
          <div class="dash-month-stat"><div class="dash-month-val" id="dashMonthRenters" style="color:#fbbf24;">0</div><div class="dash-month-lbl">Unique Renters</div></div>
          <div class="dash-month-stat"><div class="dash-month-val" id="dashMonthReservations" style="color:#c084fc;">0</div><div class="dash-month-lbl">Reservations</div></div>
          <div class="dash-month-stat"><div class="dash-month-val" id="dashMonthBuys" style="color:#60a5fa;">0</div><div class="dash-month-lbl">Games Bought</div></div>
        </div>
        <div style="font-size:0.68rem;color:#666;margin-bottom:0.6rem;">🎮 <strong id="dashMonthStillRenting" style="color:#22c55e;">0</strong> rental<span id="dashMonthStillRentingS"></span> still active during this month</div>
        <div style="font-size:0.65rem;font-weight:700;color:#666;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.5rem;">Most Rented This Month</div>
        <div id="dashMonthTopGames"></div>

        <div style="border-top:1px solid #1a2a3a;margin-top:0.85rem;padding-top:0.85rem;">
          <div style="font-size:0.65rem;font-weight:700;color:#666;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.5rem;">📣 Month Log <span style="color:#333;font-weight:500;text-transform:none;">— ads &amp; screenshots for this month</span></div>
          <div id="dashMonthLogArea"></div>
        </div>
      </div>

      <!-- Insight Pills -->
      <div id="dashInsights" style="display:flex;flex-direction:column;gap:0.45rem;"></div>

      <!-- Tooltip -->
      <div id="dashTip" style="position:fixed;background:#1a1a1a;border:1px solid #333;border-radius:8px;padding:0.4rem 0.65rem;font-size:0.72rem;color:#fff;pointer-events:none;z-index:9999;display:none;white-space:nowrap;"></div>

    </div>

      </div></div><!-- /accordion dashboard -->

    <script>
    (function() {
      const DASH_DATA = <%- JSON.stringify(dashboardData).replace(/</g, '\\u003c') %>;
      const MONTH_LOGS = {};
      (<%- JSON.stringify(monthLogs).replace(/</g, '\\u003c') %>).forEach(function(m) { MONTH_LOGS[m.key] = m; });
      function monthKeyFor(year, month) { return year + '-' + String(month + 1).padStart(2, '0'); }
      let dashSelectedMonth = null; // { year, month } or null
      let dashMonthLogEditMode = false;

      function dashCustDate(c) {
        const raw = c.start_date || c.created_at;
        if (!raw) return null;
        const d = c.start_date ? new Date(c.start_date + 'T00:00:00') : new Date(c.created_at);
        return isNaN(d.getTime()) ? null : d;
      }
      function dashAvailableYears() {
        // Union of rental-start years and payment years: a year where money
        // only came in via an extension (no new rental started that year)
        // still needs to be selectable.
        const years = new Set();
        DASH_DATA.forEach(c => { const d = dashCustDate(c); if (d) years.add(d.getFullYear()); });
        DASH_DATA.forEach(c => {
          (c.payments || []).forEach(p => {
            if (!p || !p.date) return;
            const d = new Date(p.date + 'T00:00:00');
            if (!isNaN(d.getTime())) years.add(d.getFullYear());
          });
        });
        return [...years].sort((a, b) => b - a);
      }
      function dashUniqueRenters(list) {
        const set = new Set();
        list.forEach(c => { if (c.customer_name) set.add(c.customer_name.trim().toLowerCase()); });
        return set.size;
      }
      function dashFilterYear(year) {
        if (year === 'all') return DASH_DATA;
        return DASH_DATA.filter(c => { const d = dashCustDate(c); return d && d.getFullYear() === year; });
      }
      function dashFilterMonth(year, month) {
        return DASH_DATA.filter(c => { const d = dashCustDate(c); return d && d.getFullYear() === year && d.getMonth() === month; });
      }
      // Revenue and renter counts come from payments, each carrying its own
      // date — an extension paid in August counts in August even though the
      // rental started in June. dashFilterMonth stays as-is: it answers "which
      // rentals STARTED this month", which is still the right question for
      // rental-count and top-game figures.
      function dashPaymentsIn(year, month) {
        const out = [];
        DASH_DATA.forEach(function (c) {
          (c.payments || []).forEach(function (p) {
            if (!p || !p.date) return;
            const d = new Date(p.date + 'T00:00:00');
            if (isNaN(d.getTime())) return;
            if (d.getFullYear() === year && d.getMonth() === month) out.push({ c: c, p: p });
          });
        });
        return out;
      }
      function dashRevenueInMonth(year, month) {
        return dashPaymentsIn(year, month).reduce(function (s, x) { return s + (x.p.amount || 0); }, 0);
      }
      function dashRentersInMonth(year, month) {
        const names = new Set();
        dashPaymentsIn(year, month).forEach(function (x) {
          if (x.c.customer_name) names.add(String(x.c.customer_name).trim().toLowerCase());
        });
        return names.size;
      }
      // Same payments-based attribution as dashPaymentsIn/dashRevenueInMonth,
      // but scoped to a whole year (or all-time when year is null) — used for
      // the year/all-time totals so they agree with the monthly bars across a
      // year boundary instead of falling back to price-based, rental-start
      // attribution.
      function dashPaymentsInYear(year) {
        const out = [];
        DASH_DATA.forEach(function (c) {
          (c.payments || []).forEach(function (p) {
            if (!p || !p.date) return;
            const d = new Date(p.date + 'T00:00:00');
            if (isNaN(d.getTime())) return;
            if (year == null || d.getFullYear() === year) out.push({ c: c, p: p });
          });
        });
        return out;
      }
      function dashRevenueInYear(year) {
        return dashPaymentsInYear(year).reduce(function (s, x) { return s + (x.p.amount || 0); }, 0);
      }
      // "Still renting" = overlapped the month at all: started by month-end, and
      // either has no end date yet (ongoing) or ended on/after month-start.
      function dashOverlapsMonth(c, year, month) {
        if (c.status !== 'renting' && c.status !== 'done') return false;
        const start = dashCustDate(c);
        if (!start) return false;
        const monthStart = new Date(year, month, 1);
        const monthEnd = new Date(year, month + 1, 0, 23, 59, 59, 999);
        if (start > monthEnd) return false;
        if (!c.end_date) return true;
        const end = new Date(c.end_date + 'T23:59:59');
        return end >= monthStart;
      }
      function dashEscapeHtml(s) {
        return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
      }
      function dashTopGames(list, limit) {
        const counts = {};
        list.forEach(c => { if (c.game_title) counts[c.game_title] = (counts[c.game_title] || 0) + 1; });
        return Object.entries(counts).sort((a, b) => b[1] - a[1]).slice(0, limit || 5);
      }
      function dashRenderTopGamesList(el, topGames, emptyMsg) {
        if (!topGames.length) { el.innerHTML = '<div style="color:#333;font-size:0.8rem;text-align:center;padding:1.5rem 0;">' + emptyMsg + '</div>'; return; }
        const maxCount = topGames[0][1];
        const medals = ['🥇','🥈','🥉'];
        el.innerHTML = '<div style="display:flex;flex-direction:column;gap:0.55rem;">' + topGames.map(([title, count], i) =>
          '<div><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.2rem;">' +
          '<div style="font-size:0.75rem;color:#ccc;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:72%;">' + (medals[i] || (i+1)+'.') + ' ' + dashEscapeHtml(title) + '</div>' +
          '<div style="font-size:0.72rem;font-weight:800;color:#3b82f6;">' + count + 'x</div></div>' +
          '<div style="background:#1a1a1a;border-radius:3px;height:5px;"><div style="width:' + Math.round((count/maxCount)*100) + '%;height:100%;background:linear-gradient(90deg,#3b82f6,#7c3aed);border-radius:3px;"></div></div></div>'
        ).join('') + '</div>';
      }

      function populateYearSelect(preferYear) {
        const sel = document.getElementById('dashYearSelect');
        const years = dashAvailableYears();
        const currentYear = new Date().getFullYear();
        let opts = '<option value="all">All Time</option>';
        years.forEach(y => { opts += '<option value="' + y + '">' + y + '</option>'; });
        sel.innerHTML = opts;
        const pick = (preferYear && years.includes(preferYear)) ? preferYear : (years.includes(currentYear) ? currentYear : (years.length ? years[0] : null));
        sel.value = pick != null ? String(pick) : 'all';
      }

      window.renderDashboard = function() {
        const raw = document.getElementById('dashYearSelect').value;
        const yearNum = raw === 'all' ? null : parseInt(raw);
        const scoped = raw === 'all' ? DASH_DATA : dashFilterYear(yearNum);

        const yearPayments = dashPaymentsInYear(yearNum);
        const totalEarned = yearPayments.reduce((s, x) => s + (x.p.amount || 0), 0);
        const rentList = scoped.filter(c => c.status !== 'bought');
        const buyList = scoped.filter(c => c.status === 'bought');
        const rentRevenue = yearPayments.filter(x => x.c.status !== 'bought').reduce((s, x) => s + (x.p.amount || 0), 0);
        const buyRevenue = yearPayments.filter(x => x.c.status === 'bought').reduce((s, x) => s + (x.p.amount || 0), 0);

        document.getElementById('dashTotalEarned').textContent = '₱' + totalEarned.toLocaleString();
        document.getElementById('dashTransactions').textContent = scoped.length + ' transaction' + (scoped.length !== 1 ? 's' : '');
        document.getElementById('dashUniqueRenters').textContent = dashUniqueRenters(scoped);
        document.getElementById('dashRentRevenue').textContent = '₱' + rentRevenue.toLocaleString();
        document.getElementById('dashRentSub').textContent = rentList.length + ' rentals · ' + (totalEarned > 0 ? Math.round(rentRevenue/totalEarned*100) : 0) + '% of total';
        document.getElementById('dashBuyRevenue').textContent = '₱' + buyRevenue.toLocaleString();
        document.getElementById('dashBuySub').textContent = buyList.length + ' game' + (buyList.length !== 1 ? 's' : '') + ' sold · ' + (totalEarned > 0 ? Math.round(buyRevenue/totalEarned*100) : 0) + '% of total';

        dashRenderTopGamesList(document.getElementById('dashTopGames'), dashTopGames(scoped, 5), 'No data yet');

        const years = dashAvailableYears();
        const chartYear = yearNum || years[0] || new Date().getFullYear();
        renderDashChart(chartYear);
        renderDashInsights(scoped, chartYear);

        if (dashSelectedMonth && dashSelectedMonth.year !== chartYear) clearMonthSelection();
        else if (dashSelectedMonth) renderMonthPanel();
      };

      const MONTH_SHORT = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
      const MONTH_LONG = ['January','February','March','April','May','June','July','August','September','October','November','December'];

      function renderDashChart(year) {
        document.getElementById('dashChartYearLabel').textContent = year;
        const revs = [], renters = [];
        for (let m = 0; m < 12; m++) {
          revs.push(dashRevenueInMonth(year, m));
          renters.push(dashRentersInMonth(year, m));
        }
        const maxRev = Math.max(...revs, 1);
        const now = new Date();
        const container = document.getElementById('dashBarChart');
        container.innerHTML = MONTH_SHORT.map((lbl, i) => {
          const pct = revs[i] > 0 ? Math.max(Math.round(revs[i] / maxRev * 100), 3) : 0;
          const isCurrent = year === now.getFullYear() && i === now.getMonth();
          const isPeak = revs[i] === maxRev && maxRev > 0;
          const isSelected = dashSelectedMonth && dashSelectedMonth.year === year && dashSelectedMonth.month === i;
          const barColor = isSelected ? '#F0A500' : isPeak ? '#3b82f6' : isCurrent ? '#22c55e' : '#2a2a2a';
          const valColor = isSelected ? '#F0A500' : isPeak ? '#3b82f6' : isCurrent ? '#22c55e' : '#555';
          const valStr = revs[i] >= 1000 ? (revs[i]/1000).toFixed(1) + 'k' : revs[i];
          return '<div style="flex:1;display:flex;flex-direction:column;align-items:center;gap:0.2rem;height:100%;">' +
            '<div style="flex:1;display:flex;align-items:flex-end;width:100%;">' +
            '<div onclick="selectDashMonth(' + year + ',' + i + ')" ' +
            'onmouseenter="showDashTip(event,\'' + lbl + ' ' + year + ': ₱' + revs[i].toLocaleString() + ' · ' + renters[i] + ' renter' + (renters[i]!==1?'s':'') + '\')" ' +
            'onmouseleave="hideDashTip()" onmousemove="moveDashTip(event)" ' +
            'style="width:100%;height:' + pct + '%;background:' + barColor + ';border-radius:4px 4px 0 0;min-height:3px;cursor:pointer;transition:opacity 0.15s;' + (isSelected ? 'box-shadow:0 0 0 2px #F0A500;' : '') + '"></div></div>' +
            '<div style="font-size:0.58rem;color:#444;white-space:nowrap;">' + lbl + '</div>' +
            (revs[i] > 0 ? '<div style="font-size:0.58rem;font-weight:700;color:' + valColor + ';">₱' + valStr + '</div>' : '<div style="font-size:0.58rem;">&nbsp;</div>') +
            (renters[i] > 0 ? '<div style="font-size:0.52rem;color:#555;">👤' + renters[i] + '</div>' : '<div style="font-size:0.52rem;">&nbsp;</div>') +
            ((MONTH_LOGS[monthKeyFor(year, i)] && MONTH_LOGS[monthKeyFor(year, i)].ad_count > 0) ? '<div style="font-size:0.52rem;color:#F0A500;">📣' + MONTH_LOGS[monthKeyFor(year, i)].ad_count + '</div>' : '<div style="font-size:0.52rem;">&nbsp;</div>') +
            '</div>';
        }).join('');
      }

      window.selectDashMonth = function(year, month) {
        dashSelectedMonth = { year, month };
        dashMonthLogEditMode = false;
        renderDashChart(year);
        renderMonthPanel();
      };
      window.clearMonthSelection = function() {
        dashSelectedMonth = null;
        dashMonthLogEditMode = false;
        document.getElementById('dashMonthPanel').style.display = 'none';
        const raw = document.getElementById('dashYearSelect').value;
        const yearNum = raw === 'all' ? null : parseInt(raw);
        const years = dashAvailableYears();
        renderDashChart(yearNum || years[0] || new Date().getFullYear());
      };

      function renderMonthPanel() {
        if (!dashSelectedMonth) return;
        const { year, month } = dashSelectedMonth;
        const list = dashFilterMonth(year, month);
        const totalEarned = dashRevenueInMonth(year, month);
        const reservations = list.filter(c => c.status === 'reservation');
        const buys = list.filter(c => c.status === 'bought');
        const stillRenting = DASH_DATA.filter(c => dashOverlapsMonth(c, year, month));

        document.getElementById('dashMonthTitle').textContent = '📅 ' + MONTH_LONG[month] + ' ' + year;
        document.getElementById('dashMonthEarned').textContent = '₱' + totalEarned.toLocaleString();
        document.getElementById('dashMonthTransactions').textContent = list.length;
        document.getElementById('dashMonthRenters').textContent = dashRentersInMonth(year, month);
        document.getElementById('dashMonthReservations').textContent = reservations.length;
        document.getElementById('dashMonthBuys').textContent = buys.length;
        document.getElementById('dashMonthStillRenting').textContent = stillRenting.length;
        document.getElementById('dashMonthStillRentingS').textContent = stillRenting.length !== 1 ? 's were' : ' was';
        dashRenderTopGamesList(document.getElementById('dashMonthTopGames'), dashTopGames(list, 5), 'No rentals this month');
        renderMonthLogArea();

        document.getElementById('dashMonthPanel').style.display = 'block';
      }

      function renderMonthLogArea() {
        if (!dashSelectedMonth) return;
        const key = monthKeyFor(dashSelectedMonth.year, dashSelectedMonth.month);
        const log = MONTH_LOGS[key];
        const area = document.getElementById('dashMonthLogArea');
        if (dashMonthLogEditMode) {
          area.innerHTML = buildMonthLogForm(key, log);
        } else if (log) {
          area.innerHTML = buildMonthLogView(log);
        } else {
          area.innerHTML = '<button type="button" onclick="toggleMonthLogEdit(true)" style="background:#161616;border:1px dashed #333;color:#888;border-radius:8px;padding:0.6rem 1rem;font-size:0.78rem;cursor:pointer;width:100%;">＋ Add month log — track ads &amp; upload screenshots</button>';
        }
      }

      function buildMonthLogView(log) {
        let html = '<div style="display:flex;align-items:center;gap:0.6rem;flex-wrap:wrap;margin-bottom:0.6rem;">';
        html += '<span style="background:rgba(240,165,0,0.12);border:1px solid rgba(240,165,0,0.35);color:#F0A500;border-radius:20px;padding:0.2rem 0.65rem;font-size:0.72rem;font-weight:700;">📣 ' + log.ad_count + ' ad' + (log.ad_count !== 1 ? 's' : '') + '</span>';
        if (log.ad_spend > 0) html += '<span style="color:#888;font-size:0.72rem;">₱' + log.ad_spend.toLocaleString() + ' spent</span>';
        html += '<button type="button" onclick="toggleMonthLogEdit(true)" style="margin-left:auto;background:#161616;border:1px solid #2a2a2a;color:#999;border-radius:20px;padding:0.2rem 0.65rem;font-size:0.68rem;cursor:pointer;">✏️ Edit</button>';
        html += '</div>';
        if (log.note) html += '<div style="font-size:0.75rem;color:#ccc;margin-bottom:0.6rem;line-height:1.4;">' + dashEscapeHtml(log.note) + '</div>';
        if (log.images.length) {
          html += '<div style="display:flex;gap:0.5rem;flex-wrap:wrap;">' + log.images.map(img =>
            '<a href="' + img + '" target="_blank" rel="noopener"><img src="' + img + '" style="width:72px;height:72px;object-fit:cover;border-radius:6px;border:1px solid #2a2a2a;"></a>'
          ).join('') + '</div>';
        }
        return html;
      }

      function buildMonthLogForm(key, log) {
        const adCount = log ? log.ad_count : 0;
        const adSpend = log && log.ad_spend ? log.ad_spend : '';
        const note = log ? dashEscapeHtml(log.note) : '';
        const slotsLeft = 6 - (log ? log.images.length : 0);
        let html = '<form method="POST" action="/admin/month-log" enctype="multipart/form-data" style="display:flex;flex-direction:column;gap:0.5rem;">';
        html += '<input type="hidden" name="month_key" value="' + key + '">';
        html += '<div style="display:grid;grid-template-columns:1fr 1fr;gap:0.5rem;">';
        html += '<div><label style="font-size:0.62rem;color:#666;display:block;margin-bottom:0.2rem;">Ads Run</label><input type="number" name="ad_count" min="0" value="' + adCount + '" style="width:100%;box-sizing:border-box;background:#0a0a0a;border:1px solid #2a2a2a;border-radius:6px;color:#fff;padding:0.4rem 0.5rem;font-size:0.8rem;"></div>';
        html += '<div><label style="font-size:0.62rem;color:#666;display:block;margin-bottom:0.2rem;">Ad Spend (₱, optional)</label><input type="number" name="ad_spend" min="0" value="' + adSpend + '" style="width:100%;box-sizing:border-box;background:#0a0a0a;border:1px solid #2a2a2a;border-radius:6px;color:#fff;padding:0.4rem 0.5rem;font-size:0.8rem;"></div>';
        html += '</div>';
        html += '<div><label style="font-size:0.62rem;color:#666;display:block;margin-bottom:0.2rem;">Note</label><textarea name="note" rows="2" style="width:100%;box-sizing:border-box;background:#0a0a0a;border:1px solid #2a2a2a;border-radius:6px;color:#fff;padding:0.4rem 0.5rem;font-size:0.8rem;resize:vertical;">' + note + '</textarea></div>';
        if (slotsLeft > 0) html += '<div><label style="font-size:0.62rem;color:#666;display:block;margin-bottom:0.2rem;">Add Screenshots (' + slotsLeft + ' slot' + (slotsLeft !== 1 ? 's' : '') + ' left, 6 max)</label><input type="file" name="images" accept="image/*" multiple style="width:100%;font-size:0.75rem;color:#999;"></div>';
        if (log && log.images.length) {
          html += '<div style="display:flex;gap:0.5rem;flex-wrap:wrap;">' + log.images.map(img =>
            '<div style="position:relative;"><img src="' + img + '" style="width:60px;height:60px;object-fit:cover;border-radius:6px;border:1px solid #2a2a2a;">' +
            '<button type="button" onclick="deleteMonthLogImage(\'' + key + '\',\'' + img + '\')" style="position:absolute;top:-6px;right:-6px;background:#ef4444;color:#fff;border:none;border-radius:50%;width:18px;height:18px;font-size:0.6rem;cursor:pointer;line-height:1;padding:0;">✕</button></div>'
          ).join('') + '</div>';
        }
        html += '<div style="display:flex;gap:0.5rem;align-items:center;">';
        html += '<button type="submit" style="background:#166534;color:#fff;border:none;border-radius:8px;padding:0.5rem 1rem;font-size:0.78rem;font-weight:700;cursor:pointer;">Save</button>';
        html += '<button type="button" onclick="toggleMonthLogEdit(false)" style="background:#161616;border:1px solid #2a2a2a;color:#999;border-radius:8px;padding:0.5rem 1rem;font-size:0.78rem;cursor:pointer;">Cancel</button>';
        if (log) html += '<button type="button" onclick="deleteMonthLog(\'' + key + '\')" style="margin-left:auto;background:#1a0a0a;border:1px solid #3a1a1a;color:#ef4444;border-radius:8px;padding:0.5rem 1rem;font-size:0.78rem;cursor:pointer;">Delete Log</button>';
        html += '</div></form>';
        return html;
      }

      window.toggleMonthLogEdit = function(edit) { dashMonthLogEditMode = edit; renderMonthLogArea(); };
      window.deleteMonthLogImage = function(key, imgPath) {
        if (!confirm('Remove this screenshot?')) return;
        const f = document.createElement('form');
        f.method = 'POST'; f.action = '/admin/month-log/image/delete';
        const k = document.createElement('input'); k.type = 'hidden'; k.name = 'month_key'; k.value = key;
        const p = document.createElement('input'); p.type = 'hidden'; p.name = 'image_path'; p.value = imgPath;
        f.appendChild(k); f.appendChild(p);
        document.body.appendChild(f); f.submit();
      };
      window.deleteMonthLog = function(key) {
        if (!confirm('Delete this month\'s log (ads, spend, note, and all screenshots)?')) return;
        const f = document.createElement('form');
        f.method = 'POST'; f.action = '/admin/month-log/delete';
        const k = document.createElement('input'); k.type = 'hidden'; k.name = 'month_key'; k.value = key;
        f.appendChild(k);
        document.body.appendChild(f); f.submit();
      };

      function renderDashInsights(scoped, chartYear) {
        const chartYearPayments = dashPaymentsInYear(chartYear);
        const rentRevenue = chartYearPayments.filter(x => x.c.status !== 'bought').reduce((s, x) => s + (x.p.amount || 0), 0);
        const totalEarned = chartYearPayments.reduce((s, x) => s + (x.p.amount || 0), 0);
        const rentPct = totalEarned > 0 ? Math.round(rentRevenue/totalEarned*100) : 0;
        const topGames = dashTopGames(scoped, 1);

        let revs = [];
        for (let m = 0; m < 12; m++) revs.push(dashRevenueInMonth(chartYear, m));
        const peakVal = Math.max(...revs);
        const peakMonth = MONTH_SHORT[revs.indexOf(peakVal)];

        const pills = [];
        if (peakVal > 0) pills.push(['📈', '<strong style="color:#fff;">Best month: ' + peakMonth + ' ' + chartYear + '</strong> — ₱' + peakVal.toLocaleString() + '. Identify what worked and repeat it.', '#111', '#1e1e1e']);
        if (<%= overdueCustomers.length %> > 0) pills.push(['⚠️', '<strong style="color:#ef4444;"><%= overdueCustomers.length %> overdue rental<%= overdueCustomers.length !== 1 ? "s" : "" %></strong> — follow up immediately to recover games or collect late fees.', '#1a0a0a', '#3a1a1a']);
        if (rentPct > 90 && totalEarned > 0) pills.push(['💰', '<strong style="color:#fff;">Game sales are only ' + (100 - rentPct) + '% of revenue</strong> — push buy options to returning renters to grow this.', '#111', '#1e1e1e']);
        if (topGames.length > 0) pills.push(['🎮', '<strong style="color:#fff;">' + dashEscapeHtml(topGames[0][0]) + ' is your #1 game</strong> — ' + topGames[0][1] + 'x rented/sold. Keep it stocked and front-and-center on your site.', '#111', '#1e1e1e']);
        if (<%= doneCustomersNow.length %> > <%= activeCustomers.length %> * 5) pills.push(['📉', '<strong style="color:#fff;"><%= doneCustomersNow.length %> past customers</strong> vs <%= activeCustomers.length %> active — most renters don\'t return. A Messenger follow-up campaign could recover many of them.', '#111', '#1e1e1e']);

        document.getElementById('dashInsights').innerHTML = pills.map(([icon, text, bg, border]) =>
          '<div style="background:' + bg + ';border:1px solid ' + border + ';border-radius:8px;padding:0.55rem 0.85rem;font-size:0.72rem;color:#aaa;display:flex;align-items:flex-start;gap:0.5rem;line-height:1.4;">' +
          '<span style="flex-shrink:0;">' + icon + '</span><span>' + text + '</span></div>'
        ).join('');
      }

      function showDashTip(e, text) { var t=document.getElementById('dashTip'); t.textContent=text; t.style.display='block'; moveDashTip(e); }
      function hideDashTip() { document.getElementById('dashTip').style.display='none'; }
      function moveDashTip(e) { var t=document.getElementById('dashTip'); t.style.left=(e.clientX+12)+'px'; t.style.top=(e.clientY-28)+'px'; }
      window.showDashTip = showDashTip; window.hideDashTip = hideDashTip; window.moveDashTip = moveDashTip;

      // Reopen a specific month's drill-down after a month-log save redirects back
      // with ?month=YYYY-MM, so the panel doesn't just close on you after saving.
      let dashPreferYear = null;
      const dashMonthParam = new URLSearchParams(window.location.search).get('month');
      if (dashMonthParam && /^\d{4}-\d{2}$/.test(dashMonthParam)) {
        const parts = dashMonthParam.split('-').map(Number);
        dashSelectedMonth = { year: parts[0], month: parts[1] - 1 };
        dashPreferYear = parts[0];
      }
      populateYearSelect(dashPreferYear);
      renderDashboard();
    })();
    </script>

