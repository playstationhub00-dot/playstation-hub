<%
  // Shared nav for every customer-facing page. `active` (optional) marks the current
  // link; pass it as a local when including this partial, e.g. { active: 'browse' }.
  const navActive = typeof active !== 'undefined' ? active : '';
%>
<nav>
  <a href="/" class="logo"><img src="<%= settings.logo_path %>" alt="<%= settings.title %>" /></a>

  <div class="nav-links" id="navLinks">
    <a href="/" class="<%= navActive === 'home' ? 'active' : '' %>">Home</a>
    <a href="/browse" class="<%= navActive === 'browse' ? 'active' : '' %>">Rent</a>
    <a href="/buy" class="<%= navActive === 'buy' ? 'active' : '' %>">Buy</a>
    <a href="/requests" class="<%= navActive === 'requests' ? 'active' : '' %>">Requests</a>
    <a href="/how-it-works" class="<%= navActive === 'how' ? 'active' : '' %>">How It Works</a>
  </div>

  <div class="navicons">
    <!-- Search collapses to this icon; tapping it reveals the box below as a
         full-width dropdown instead of permanently occupying nav space. -->
    <button type="button" class="navicon-btn" id="navSearchToggle" aria-label="Search" aria-expanded="false">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" style="width:18px;height:18px;"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
    </button>
    <a href="/admin" class="navicon-btn" aria-label="Admin Panel">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
    </a>
    <a href="http://m.me/PlaystationHub00" target="_blank" rel="noopener" class="nav-cta">Message Us</a>
  </div>

  <div class="navsearch" id="navSearch">
    <div class="navsearch-box">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" style="width:15px;height:15px;flex-shrink:0;"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      <input type="text" id="navSearchInput" placeholder="Search games…" autocomplete="off" aria-label="Search games">
      <kbd class="navsearch-kbd">/</kbd>
    </div>
    <div class="navsearch-results" id="navSearchResults"></div>
  </div>

  <button type="button" class="nav-hamburger" id="navHamburger" aria-label="Menu" aria-expanded="false">
    <span></span><span></span><span></span>
  </button>
</nav>
<div class="nav-drawer-overlay" id="navDrawerOverlay"></div>
<div class="nav-drawer" id="navDrawer">
  <a href="/" class="<%= navActive === 'home' ? 'active' : '' %>">Home</a>
  <a href="/browse" class="<%= navActive === 'browse' ? 'active' : '' %>">Rent</a>
  <a href="/buy" class="<%= navActive === 'buy' ? 'active' : '' %>">Buy</a>
  <a href="/requests" class="<%= navActive === 'requests' ? 'active' : '' %>">Requests</a>
  <a href="/how-it-works" class="<%= navActive === 'how' ? 'active' : '' %>">How It Works</a>
  <a href="/admin">Admin Panel</a>
  <a href="http://m.me/PlaystationHub00" target="_blank" rel="noopener" class="nav-cta">Message Us</a>
</div>

<!-- Mobile-only: the nav's own Message Us button scrolls out of reach on a long page —
     this stays pinned in thumb range regardless of scroll position. -->
<a href="http://m.me/PlaystationHub00" target="_blank" rel="noopener" class="mobile-fab" aria-label="Message us on Messenger">
  💬 <span>Message Us</span>
</a>

<script>
(function(){
  const hamburger = document.getElementById('navHamburger');
  const drawer = document.getElementById('navDrawer');
  const overlay = document.getElementById('navDrawerOverlay');
  function openDrawer() {
    drawer.classList.add('open'); overlay.classList.add('open');
    hamburger.classList.add('open'); hamburger.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }
  function closeDrawer() {
    drawer.classList.remove('open'); overlay.classList.remove('open');
    hamburger.classList.remove('open'); hamburger.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }
  hamburger.addEventListener('click', function() {
    drawer.classList.contains('open') ? closeDrawer() : openDrawer();
  });
  overlay.addEventListener('click', closeDrawer);
  drawer.querySelectorAll('a').forEach(a => a.addEventListener('click', closeDrawer));
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeDrawer(); });
})();

(function(){
  const wrap = document.getElementById('navSearch');
  const input = document.getElementById('navSearchInput');
  const box = document.getElementById('navSearchResults');
  let index = null, items = [], sel = -1, loading = false;

  function esc(s) { return s.replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }
  function hl(text, term) {
    const i = text.toLowerCase().indexOf(term.toLowerCase());
    if (i < 0) return esc(text);
    return esc(text.slice(0, i)) + '<mark>' + esc(text.slice(i, i + term.length)) + '</mark>' + esc(text.slice(i + term.length));
  }

  function loadIndex() {
    if (index || loading) return;
    loading = true;
    fetch('/api/search-index').then(r => r.json()).then(data => { index = data; }).catch(() => { index = []; }).finally(() => { loading = false; });
  }
  input.addEventListener('focus', loadIndex, { once: true });

  function render(term) {
    if (!term.trim() || !index) { box.classList.remove('show'); box.innerHTML = ''; items = []; sel = -1; return; }
    const t = term.trim().toLowerCase();
    // Match the title, or a bundle's hidden contained-game keywords, so searching a
    // title that only lives inside a bundle still surfaces that bundle.
    const matches = index.filter(x => x.t.toLowerCase().includes(t) || (x.k || '').toLowerCase().includes(t));
    const now = matches.filter(x => x.y === 'now').slice(0, 6);
    const psplus = matches.filter(x => x.y === 'psplus').slice(0, 3);
    const soon = matches.filter(x => x.y === 'soon').slice(0, 3);

    let h = '';
    if (now.length) {
      h += '<div class="navsearch-head">Available now</div>';
      now.forEach(x => {
        const av = x.s > 0
          ? '<span class="navsearch-avail-yes">' + x.s + ' slot' + (x.s !== 1 ? 's' : '') + ' left</span>'
          : '<span class="navsearch-avail-no">FULLY BOOKED</span>';
        const thumb = x.img ? '<img src="' + x.img + '" alt="" loading="lazy">' : '🎮';
        // A bundle that matched on its contents (not its own name) needs to say why
        // it's in the results, otherwise the hit looks unrelated to what was typed.
        const viaContents = x.bn > 0 && !x.t.toLowerCase().includes(t);
        const bundleNote = x.bn > 0
          ? '<span class="navsearch-bundle-note">' + (viaContents ? 'includes this · ' : '') + x.bn + ' games</span>'
          : '';
        h += '<a class="navsearch-item" href="' + x.u + '"><div class="navsearch-thumb">' + thumb + '</div>' +
          '<div class="navsearch-body"><div class="navsearch-title">' + hl(x.t, t) + '</div>' +
          '<div class="navsearch-meta"><span>' + x.p + '</span>' + bundleNote + av + '</div></div>' +
          '<div class="navsearch-price-col">' +
          (x.pr ? '<div class="navsearch-price">₱' + x.pr + '</div>' : '') +
          (x.bpr ? '<div class="navsearch-buy-price">Buy ₱' + x.bpr + '</div>' : '') +
          '</div></a>';
      });
    }
    if (psplus.length) {
      h += '<div class="navsearch-head">PS Plus Deluxe</div>';
      psplus.forEach(x => {
        const psThumb = x.img ? '<img src="' + x.img + '" alt="" loading="lazy">' : '➕';
        h += '<a class="navsearch-item" href="' + x.u + '"><div class="navsearch-thumb">' + psThumb + '</div>' +
          '<div class="navsearch-body"><div class="navsearch-title">' + hl(x.t, t) + '</div>' +
          '<div class="navsearch-meta"><span>' + x.p + '</span></div></div>' +
          '<span class="navsearch-badge-psplus">PS PLUS</span></a>';
      });
    }
    if (soon.length) {
      h += '<div class="navsearch-head">Coming soon</div>';
      soon.forEach(x => {
        const soonThumb = x.img ? '<img src="' + x.img + '" alt="" loading="lazy">' : '🔜';
        h += '<a class="navsearch-item" href="' + x.u + '"><div class="navsearch-thumb">' + soonThumb + '</div>' +
          '<div class="navsearch-body"><div class="navsearch-title">' + hl(x.t, t) + '</div>' +
          '<div class="navsearch-meta"><span>' + x.p + '</span><span>' + x.d + '</span></div></div>' +
          '<span class="navsearch-badge-soon">SOON</span></a>';
      });
    }
    if (!h) {
      h = '<div class="navsearch-empty">' +
        '<div class="navsearch-empty-ico">🔍</div>' +
        '<div class="navsearch-empty-title">No games match &ldquo;' + esc(term.trim()) + '&rdquo;</div>' +
        '<div class="navsearch-empty-sub">We might still be able to get it for you — message us and we\'ll check.</div>' +
        '<div class="navsearch-empty-acts">' +
        '<a href="http://m.me/PlaystationHub00" target="_blank" rel="noopener" class="navsearch-empty-btn">Message Us</a>' +
        '<a href="/browse" class="navsearch-empty-btn2">Browse All Games</a>' +
        '</div></div>';
    } else if (matches.length > now.length + psplus.length + soon.length) {
      h += '<a class="navsearch-all" href="/browse?search=' + encodeURIComponent(term.trim()) + '">See all ' + matches.length + ' results →</a>';
    }
    box.innerHTML = h;
    box.classList.add('show');
    items = [...box.querySelectorAll('.navsearch-item')];
    sel = -1;
  }

  function move(d) {
    if (!items.length) return;
    if (sel >= 0) items[sel].classList.remove('sel');
    sel = (sel + d + items.length) % items.length;
    items[sel].classList.add('sel');
    items[sel].scrollIntoView({ block: 'nearest' });
  }

  input.addEventListener('input', e => render(e.target.value));
  input.addEventListener('keydown', e => {
    if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
    else if (e.key === 'Enter' && sel >= 0) { e.preventDefault(); items[sel].click(); }
    else if (e.key === 'Escape') { input.blur(); box.classList.remove('show'); }
  });
  document.addEventListener('keydown', e => {
    if (e.key === '/' && document.activeElement !== input && !/^(INPUT|TEXTAREA)$/.test(document.activeElement.tagName)) {
      e.preventDefault(); loadIndex(); input.focus();
    }
  });
  document.addEventListener('click', e => {
    if (!e.target.closest('.navsearch')) box.classList.remove('show');
  });
  input.addEventListener('focus', () => { if (input.value.trim()) render(input.value); });

  // Mobile search icon: toggles the box open/closed instead of it always occupying
  // nav width. Desktop never shows the toggle button, so this is inert there.
  const toggle = document.getElementById('navSearchToggle');
  function closeMobileSearch() {
    wrap.classList.remove('navsearch-active');
    toggle.setAttribute('aria-expanded', 'false');
  }
  toggle.addEventListener('click', e => {
    e.stopPropagation();
    const opening = !wrap.classList.contains('navsearch-active');
    wrap.classList.toggle('navsearch-active', opening);
    toggle.setAttribute('aria-expanded', String(opening));
    if (opening) { loadIndex(); input.focus(); }
  });
  document.addEventListener('click', e => {
    if (!e.target.closest('.navsearch') && !e.target.closest('.navsearch-toggle')) closeMobileSearch();
  });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeMobileSearch(); });
})();
</script>
