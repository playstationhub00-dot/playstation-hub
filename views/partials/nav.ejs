<%
  // Shared nav for every customer-facing page. `active` (optional) marks the current
  // link; pass it as a local when including this partial, e.g. { active: 'browse' }.
  const navActive = typeof active !== 'undefined' ? active : '';
  const navMenuSafe = (typeof navMenu !== 'undefined' && navMenu && navMenu.browse) ? navMenu : null;
  const navBrowseOn = ['browse', 'buy', 'psplus', 'trending', 'collections'].indexOf(navActive) >= 0;
  const navGuidesOn = navActive === 'guides' || navActive === 'how';
  const navFeat = navMenuSafe ? navMenuSafe.featured : [];
  const navChips = navMenuSafe ? navMenuSafe.chips : [];
  const navCat = navMenuSafe ? navMenuSafe.category : null;
%>
<link rel="stylesheet" href="/css/nav-mega.css?v=<%= assetV %>">
<nav>
  <a href="/" class="logo"><%- include('brand-logo') %></a>

  <div class="nav-links" id="navLinks">
    <a href="/" class="<%= navActive === 'home' ? 'active' : '' %>">Home</a>
    <div class="nav-drop" data-navdrop="browse">
      <button type="button" class="nav-drop-btn<%= navBrowseOn ? ' active' : '' %>" aria-expanded="false" aria-controls="navBrowseMenu" aria-haspopup="true">Browse</button>
      <div class="nav-mega" id="navBrowseMenu" role="region" aria-label="Browse">
        <div class="nav-mega-panel">
          <div class="nm-browse">
            <div class="nm-col">
              <div class="nm-kicker">Browse</div>
              <% (navMenuSafe ? navMenuSafe.browse : [
                { label: 'All games', detail: 'Every game you can rent', count: null, href: '/browse' },
                { label: 'Recently added', detail: 'Newest games on the site', count: null, href: '/browse?tab=new' },
                { label: 'Most popular', detail: 'Most rented by players', count: null, href: '/browse?tab=most-rented' },
                { label: 'Trending', detail: 'Hot this week', count: null, href: '/trending', fresh: true },
                { label: 'Collections', detail: 'Bundles, Coming soon, Buy to keep, and PS Plus Deluxe.', count: null, href: '/collections' }
              ]).forEach(function (item) { %>
              <a class="nm-row" href="<%= item.href %>">
                <span class="nm-row-t"><%= item.label %><% if (item.fresh) { %> <span class="nm-new">New</span><% } %></span>
                <span class="nm-row-d"><%= item.detail %></span>
                <% if (item.count != null) { %><span class="nm-row-n"><%= item.count %></span><% } %>
              </a>
              <% }) %>
            </div>
            <div class="nm-feat-col">
              <div class="nm-feat-head">
                <span>Featured · New releases</span>
                <a href="/browse?tab=new">View all ›</a>
              </div>
              <div class="nm-feat-row">
                <% if (!navFeat.length) { %><p class="nm-empty">New releases show here once a game has a release date.</p><% } %>
                <% navFeat.forEach(function (g) { %>
                <a class="nm-feat" href="<%= g.href %>">
                  <span class="nm-badge <%= g.avail ? 'is-open' : 'is-full' %>"><%= g.avail ? 'Available' : 'Full' %></span>
                  <% if (g.cover) { %><img src="<%= g.cover %>" alt=""><% } else { %><span class="nm-ph"></span><% } %>
                  <span class="nm-feat-title"><%= g.title %></span>
                  <% if (g.weekly) { %><span class="nm-feat-price">Weekly from <b>₱<%= g.weekly %></b></span><% } %>
                </a>
                <% }) %>
              </div>
            </div>
          </div>
          <% if (navChips.length) { %>
          <div class="nm-chips">
            <span>Also in Collections</span>
            <% navChips.forEach(function (c) { %>
            <a href="<%= c.href %>"><%= c.label %> <b><%= c.count %></b></a>
            <% }) %>
          </div>
          <% } %>
        </div>
      </div>
    </div>
    <div class="nav-drop" data-navdrop="category">
      <button type="button" class="nav-drop-btn" aria-expanded="false" aria-controls="navCategoryMenu" aria-haspopup="true">Category</button>
      <div class="nav-mega" id="navCategoryMenu" role="region" aria-label="Category">
        <div class="nav-mega-panel nm-cat">
          <div>
            <div class="nm-kicker">Genre</div>
            <div class="nm-genres">
              <% if (!navCat || !navCat.genres.length) { %><p class="nm-empty">Genres appear as games are added.</p><% } %>
              <% (navCat ? navCat.genres : []).forEach(function (g) { %>
              <a href="<%= g.href %>"><span><%= g.label %></span><b><%= g.count %></b></a>
              <% }) %>
            </div>
          </div>
          <div>
            <div class="nm-kicker">Account type</div>
            <% (navCat ? navCat.accounts : []).forEach(function (g) { %>
            <a class="nm-line" href="<%= g.href %>"><span><%= g.label %></span><b><%= g.count %></b></a>
            <% }) %>
            <div class="nm-kicker">Availability</div>
            <% (navCat ? navCat.availability : []).forEach(function (g) { %>
            <a class="nm-line" href="<%= g.href %>"><span><%= g.label %></span><b><%= g.count %></b></a>
            <% }) %>
          </div>
          <div>
            <div class="nm-kicker">Console</div>
            <% (navCat ? navCat.consoles : []).forEach(function (g) { %>
            <a class="nm-line" href="<%= g.href %>"><span><%= g.label %></span><b><%= g.count %></b></a>
            <% }) %>
            <div class="nm-kicker">Shortcuts</div>
            <% (navCat ? navCat.shortcuts : [{ label: 'PS Plus Deluxe', count: 0, href: '/browse?tab=psplus' }]).forEach(function (g) { %>
            <a class="nm-line" href="<%= g.href %>"><span><%= g.label %></span><b><%= g.count %></b></a>
            <% }) %>
          </div>
        </div>
      </div>
    </div>
    <a href="/requests" class="<%= navActive === 'requests' ? 'active' : '' %>">Request</a>
    <a href="/guides" class="<%= navGuidesOn ? 'active' : '' %>">Guides</a>
    <a href="/faq" class="<%= navActive === 'faq' ? 'active' : '' %>">FAQ</a>
  </div>

  <div class="navicons">
    <!-- Search collapses to this icon; tapping it reveals the box below as a
         full-width dropdown instead of permanently occupying nav space. -->
    <%- include('announcement-bell') %>
    <button type="button" class="navicon-btn nav-basket-btn" id="navBasketToggle" aria-label="Basket" aria-expanded="false">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 7h15l-1.5 9h-12z"/><path d="M6 7L5 4H2"/><circle cx="9" cy="20" r="1.2"/><circle cx="18" cy="20" r="1.2"/></svg>
      <span class="nav-basket-count" id="navBasketCount" hidden>0</span>
    </button>
    <button type="button" class="navicon-btn" id="navSearchToggle" aria-label="Search" aria-expanded="false">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" style="width:18px;height:18px;"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
    </button>
    <a href="http://m.me/PlaystationHub00" target="_blank" rel="noopener" class="nav-cta" data-track-source="nav">Message Us</a>
  </div>

  <div class="navsearch" id="navSearch">
    <div class="navsearch-box">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" style="width:15px;height:15px;flex-shrink:0;"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      <input type="text" id="navSearchInput" placeholder="Search games…" autocomplete="off" aria-label="Search games">
      <kbd class="navsearch-kbd">/</kbd>
    </div>
    <div class="navsearch-results" id="navSearchResults"></div>
  </div>

  <button type="button" class="nav-hamburger" id="navHamburger" aria-label="Menu" aria-expanded="false">
    <span></span><span></span><span></span>
  </button>
</nav>
<div class="nav-drawer-overlay" id="navDrawerOverlay"></div>
<div class="nav-drawer" id="navDrawer">
  <div class="nav-drawer-scroll">
    <a href="/" class="<%= navActive === 'home' ? 'active' : '' %>">Home</a>
    <button type="button" class="nav-acc-btn" aria-expanded="true" aria-controls="navAccBrowse">Browse <span class="nav-acc-chev" aria-hidden="true">⌃</span></button>
    <div class="nav-acc-panel" id="navAccBrowse">
      <% (navMenuSafe ? navMenuSafe.browse : [
        { label: 'All games', count: null, href: '/browse' },
        { label: 'Recently added', count: null, href: '/browse?tab=new' },
        { label: 'Most popular', count: null, href: '/browse?tab=most-rented' },
        { label: 'Trending', count: null, href: '/trending', fresh: true },
        { label: 'Collections', count: null, href: '/collections' }
      ]).forEach(function (item) { %>
      <a href="<%= item.href %>"><span><%= item.label %><% if (item.fresh) { %> <span class="nm-new">New</span><% } %></span><% if (item.count != null) { %><b><%= item.count %></b><% } %></a>
      <% }) %>
    </div>
    <button type="button" class="nav-acc-btn" aria-expanded="false" aria-controls="navAccCategory">Category <span class="nav-acc-chev" aria-hidden="true">⌄</span></button>
    <div class="nav-acc-panel" id="navAccCategory" hidden>
      <% if (navCat) { %>
        <% navCat.genres.forEach(function (g) { %><a href="<%= g.href %>"><span><%= g.label %></span><b><%= g.count %></b></a><% }) %>
        <% navCat.accounts.forEach(function (g) { %><a href="<%= g.href %>"><span><%= g.label %></span><b><%= g.count %></b></a><% }) %>
        <% navCat.consoles.forEach(function (g) { %><a href="<%= g.href %>"><span><%= g.label %></span><b><%= g.count %></b></a><% }) %>
        <% navCat.availability.forEach(function (g) { %><a href="<%= g.href %>"><span><%= g.label %></span><b><%= g.count %></b></a><% }) %>
        <% navCat.shortcuts.forEach(function (g) { %><a href="<%= g.href %>"><span><%= g.label %></span><b><%= g.count %></b></a><% }) %>
      <% } else { %>
        <a href="/browse">All games</a>
      <% } %>
    </div>
    <a href="/requests" class="<%= navActive === 'requests' ? 'active' : '' %>">Request</a>
    <a href="/guides" class="<%= navGuidesOn ? 'active' : '' %>">Guides</a>
    <a href="/faq" class="<%= navActive === 'faq' ? 'active' : '' %>">FAQ</a>
  </div>
  <a href="http://m.me/PlaystationHub00" target="_blank" rel="noopener" class="nav-cta" data-track-source="nav">Message Us</a>
</div>

<!-- Mobile-only: the nav's own Message Us button scrolls out of reach on a long page —
     this stays pinned in thumb range regardless of scroll position. -->
<a href="http://m.me/PlaystationHub00" target="_blank" rel="noopener" class="mobile-fab" data-track-source="fab" aria-label="Message us on Messenger">
  💬 <span>Message Us</span>
</a>

<script>
(function(){
  const hamburger = document.getElementById('navHamburger');
  const drawer = document.getElementById('navDrawer');
  const overlay = document.getElementById('navDrawerOverlay');
  function openDrawer() {
    drawer.classList.add('open'); overlay.classList.add('open');
    hamburger.classList.add('open'); hamburger.setAttribute('aria-expanded', 'true');
    document.body.classList.add('nav-open');
    document.body.style.overflow = 'hidden';
  }
  function closeDrawer() {
    drawer.classList.remove('open'); overlay.classList.remove('open');
    hamburger.classList.remove('open'); hamburger.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('nav-open');
    document.body.style.overflow = '';
  }
  drawer.querySelectorAll('.nav-acc-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const panel = document.getElementById(btn.getAttribute('aria-controls'));
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (panel) panel.hidden = !open;
      const chev = btn.querySelector('.nav-acc-chev');
      if (chev) chev.textContent = open ? '⌃' : '⌄';
    });
  });
  hamburger.addEventListener('click', function() {
    drawer.classList.contains('open') ? closeDrawer() : openDrawer();
  });
  overlay.addEventListener('click', closeDrawer);
  drawer.querySelectorAll('a').forEach(a => a.addEventListener('click', closeDrawer));
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeDrawer(); });
})();

(function(){
  const wrap = document.getElementById('navSearch');
  const input = document.getElementById('navSearchInput');
  const box = document.getElementById('navSearchResults');
  let index = null, items = [], sel = -1, loading = false;

  function esc(s) { return s.replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }
  function hl(text, term) {
    const i = text.toLowerCase().indexOf(term.toLowerCase());
    if (i < 0) return esc(text);
    return esc(text.slice(0, i)) + '<mark>' + esc(text.slice(i, i + term.length)) + '</mark>' + esc(text.slice(i + term.length));
  }

  function loadIndex() {
    if (index || loading) return;
    loading = true;
    fetch('/api/search-index').then(r => r.json()).then(data => { index = data; }).catch(() => { index = []; }).finally(() => { loading = false; });
  }
  input.addEventListener('focus', loadIndex, { once: true });

  function render(term) {
    if (!term.trim() || !index) { box.classList.remove('show'); box.innerHTML = ''; items = []; sel = -1; return; }
    const t = term.trim().toLowerCase();
    // Match the title, or a bundle's hidden contained-game keywords, so searching a
    // title that only lives inside a bundle still surfaces that bundle.
    const matches = index.filter(x => x.t.toLowerCase().includes(t) || (x.k || '').toLowerCase().includes(t));
    const now = matches.filter(x => x.y === 'now').slice(0, 6);
    const psplus = matches.filter(x => x.y === 'psplus').slice(0, 3);
    const soon = matches.filter(x => x.y === 'soon').slice(0, 3);
    const requested = matches.filter(x => x.y === 'requested').slice(0, 3);

    let h = '';
    if (now.length) {
      h += '<div class="navsearch-head">Available now</div>';
      now.forEach(x => {
        const av = x.s > 0
          ? '<span class="navsearch-avail-yes">Available</span>'
          : '<span class="navsearch-avail-no">Full</span>';
        const thumb = x.img ? '<img src="' + x.img + '" alt="' + esc(x.t) + '" loading="lazy">' : '🎮';
        // A bundle that matched on its contents (not its own name) needs to say why
        // it's in the results, otherwise the hit looks unrelated to what was typed.
        const viaContents = x.bn > 0 && !x.t.toLowerCase().includes(t);
        const bundleNote = x.bn > 0
          ? '<span class="navsearch-bundle-note">' + (viaContents ? 'includes this · ' : '') + x.bn + ' games</span>'
          : '';
        h += '<a class="navsearch-item" href="' + x.u + '"><div class="navsearch-thumb">' + thumb + '</div>' +
          '<div class="navsearch-body"><div class="navsearch-title">' + hl(x.t, t) + '</div>' +
          '<div class="navsearch-meta"><span>' + x.p + '</span>' + bundleNote + av + '</div></div>' +
          '<div class="navsearch-price-col">' +
          (x.pr ? '<span class="navsearch-way">Rent from ₱' + x.pr + '</span>' : '') +
          (x.bpr ? '<span class="navsearch-way">Buy ₱' + x.bpr + '</span>' : '') +
          (x.deluxe ? '<span class="navsearch-way navsearch-way-plus">Included in Deluxe</span>' : '') +
          '</div></a>';
      });
    }
    if (psplus.length) {
      h += '<div class="navsearch-head">PS Plus Deluxe</div>';
      psplus.forEach(x => {
        const psThumb = x.img ? '<img src="' + x.img + '" alt="' + esc(x.t) + '" loading="lazy">' : '➕';
        h += '<a class="navsearch-item" href="' + x.u + '"><div class="navsearch-thumb">' + psThumb + '</div>' +
          '<div class="navsearch-body"><div class="navsearch-title">' + hl(x.t, t) + '</div>' +
          '<div class="navsearch-meta"><span>' + x.p + '</span></div></div>' +
          '<span class="navsearch-badge-psplus">PS PLUS</span></a>';
      });
    }
    if (soon.length) {
      h += '<div class="navsearch-head">Coming soon</div>';
      soon.forEach(x => {
        const soonThumb = x.img ? '<img src="' + x.img + '" alt="' + esc(x.t) + '" loading="lazy">' : '🔜';
        h += '<a class="navsearch-item" href="' + x.u + '"><div class="navsearch-thumb">' + soonThumb + '</div>' +
          '<div class="navsearch-body"><div class="navsearch-title">' + hl(x.t, t) + '</div>' +
          '<div class="navsearch-meta"><span>' + x.p + '</span><span>' + x.d + '</span></div></div>' +
          '<span class="navsearch-badge-soon">SOON</span></a>';
      });
    }
    if (requested.length) {
      h += '<div class="navsearch-head">Requested by customers</div>';
      requested.forEach(x => {
        const reqThumb = x.img ? '<img src="' + x.img + '" alt="' + esc(x.t) + '" loading="lazy">' : '🙋';
        h += '<a class="navsearch-item" href="' + x.u + '"><div class="navsearch-thumb">' + reqThumb + '</div>' +
          '<div class="navsearch-body"><div class="navsearch-title">' + hl(x.t, t) + '</div>' +
          '<div class="navsearch-meta"><span>' + x.v + ' vote' + (x.v !== 1 ? 's' : '') + '</span></div></div>' +
          '<span class="navsearch-badge-requested">REQUESTED</span></a>';
      });
    }
    if (!h) {
      h = '<div class="navsearch-empty">' +
        '<div class="navsearch-empty-ico">🔍</div>' +
        '<div class="navsearch-empty-title">No games match &ldquo;' + esc(term.trim()) + '&rdquo;</div>' +
        '<div class="navsearch-empty-sub">Not in our library yet — request it and we\'ll stock the most-wanted titles first.</div>' +
        '<div class="navsearch-empty-acts">' +
        '<a href="/requests?title=' + encodeURIComponent(term.trim()) + '" class="navsearch-empty-btn">Request this game</a>' +
        '<a href="http://m.me/PlaystationHub00" target="_blank" rel="noopener" class="navsearch-empty-btn2" data-track-source="search-empty">Message Us</a>' +
        '<a href="/browse" class="navsearch-empty-btn2">Browse All Games</a>' +
        '</div></div>';
    } else if (matches.length > now.length + psplus.length + soon.length + requested.length) {
      h += '<a class="navsearch-all" href="/search?q=' + encodeURIComponent(term.trim()) + '">See all ' + matches.length + ' results →</a>';
    }
    box.innerHTML = h;
    box.classList.add('show');
    items = [...box.querySelectorAll('.navsearch-item')];
    sel = -1;
  }

  function move(d) {
    if (!items.length) return;
    if (sel >= 0) items[sel].classList.remove('sel');
    sel = (sel + d + items.length) % items.length;
    items[sel].classList.add('sel');
    items[sel].scrollIntoView({ block: 'nearest' });
  }

  input.addEventListener('input', e => render(e.target.value));
  input.addEventListener('keydown', e => {
    if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
    else if (e.key === 'Enter' && sel >= 0) { e.preventDefault(); items[sel].click(); }
    else if (e.key === 'Escape') { input.blur(); box.classList.remove('show'); }
  });
  document.addEventListener('keydown', e => {
    if (e.key === '/' && document.activeElement !== input && !/^(INPUT|TEXTAREA)$/.test(document.activeElement.tagName)) {
      e.preventDefault(); loadIndex(); input.focus();
    }
  });
  document.addEventListener('click', e => {
    if (!e.target.closest('.navsearch')) box.classList.remove('show');
  });
  input.addEventListener('focus', () => { if (input.value.trim()) render(input.value); });

  // Mobile search icon: toggles the box open/closed instead of it always occupying
  // nav width. Desktop never shows the toggle button, so this is inert there.
  const toggle = document.getElementById('navSearchToggle');
  function closeMobileSearch() {
    wrap.classList.remove('navsearch-active');
    toggle.setAttribute('aria-expanded', 'false');
  }
  toggle.addEventListener('click', e => {
    e.stopPropagation();
    const opening = !wrap.classList.contains('navsearch-active');
    wrap.classList.toggle('navsearch-active', opening);
    toggle.setAttribute('aria-expanded', String(opening));
    if (opening) { loadIndex(); input.focus(); }
  });
  document.addEventListener('click', e => {
    if (!e.target.closest('.navsearch') && !e.target.closest('.navsearch-toggle')) closeMobileSearch();
  });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeMobileSearch(); });
})();
</script>
<script>
(function () {
  const drops = [...document.querySelectorAll('[data-navdrop]')];
  if (!drops.length) return;
  const desktop = () => window.matchMedia('(min-width: 821px)').matches;
  const fineHover = () => window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const OPEN_MS = 80;
  const CLOSE_MS = 250;
  function setOpen(drop, on) {
    drop.classList.toggle('open', !!on);
    const btn = drop.querySelector('.nav-drop-btn');
    if (btn) btn.setAttribute('aria-expanded', on ? 'true' : 'false');
  }
  function clearTimers(drop) {
    clearTimeout(drop._openTimer);
    clearTimeout(drop._closeTimer);
  }
  function closeAll(except) {
    drops.forEach(d => {
      if (d === except) return;
      clearTimers(d);
      setOpen(d, false);
    });
  }
  drops.forEach(drop => {
    const btn = drop.querySelector('.nav-drop-btn');
    btn.addEventListener('click', e => {
      e.stopPropagation();
      if (!desktop()) return;
      clearTimers(drop);
      const on = !drop.classList.contains('open');
      closeAll(drop);
      setOpen(drop, on);
    });
    btn.addEventListener('keydown', e => {
      if (e.key === 'ArrowDown') {
        const first = drop.querySelector('.nav-mega a');
        if (first) { e.preventDefault(); clearTimers(drop); closeAll(drop); setOpen(drop, true); first.focus(); }
      }
    });
    drop.addEventListener('mouseenter', () => {
      if (!fineHover()) return;
      clearTimers(drop);
      closeAll(drop);
      drop._openTimer = setTimeout(() => setOpen(drop, true), OPEN_MS);
    });
    drop.addEventListener('mouseleave', () => {
      if (!fineHover()) return;
      clearTimeout(drop._openTimer);
      const focus = document.activeElement;
      if (focus && drop.contains(focus) && focus !== btn) return;
      drop._closeTimer = setTimeout(() => setOpen(drop, false), CLOSE_MS);
    });
    drop.addEventListener('focusout', e => {
      if (!drop.contains(e.relatedTarget)) {
        clearTimers(drop);
        setOpen(drop, false);
      }
    });
  });
  document.addEventListener('click', e => {
    if (!e.target.closest('[data-navdrop]')) closeAll(null);
  });
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeAll(null);
  });
})();
</script>
<script src="/js/message-taps.js?v=<%= assetV %>" defer></script>
