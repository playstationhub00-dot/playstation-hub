<%#
  Top rented as a ranked list (all ten, rows stretch to fill), beside the PS Plus
  Deluxe card: a logo band with the price, a strip of game covers, then the
  category tiles. Locals: home, psplusPopular, psplusLogo.
%>
<section class="hm-wrap hm-sec" id="topRented">
  <div class="hr-sec-head">
    <h2 class="hr-title"><span class="hr-mark hr-mark-sq" aria-hidden="true">□</span> Popular right now</h2>
    <a class="hm-viewall" href="/browse">View all games ›</a>
  </div>
  <h2 class="hr-subhead">Top rented <span class="hm-sub">this month</span> <a class="hm-viewall" href="/browse?tab=most-rented">View all ›</a></h2>
  <div class="hr-two">
    <div class="hr-panel">
      <% if (home.topRented.length) { %>
      <ol class="hr-rank">
        <% home.topRented.slice(0, 10).forEach(function (t, i) { %>
        <li><a href="<%= seo.rentPath(t.game.title) %>"><span class="hr-rank-n"><%= i + 1 %></span><% if (t.game.cover_image) { %><img <%- imgThumb(t.game.cover_image) %> alt="" width="42" height="42"><% } %><span class="hr-rank-t"><%= t.game.title %></span><% if (t.weekly) { %><span class="hr-rank-p">₱<%= t.weekly %></span><% } %></a></li>
        <% }) %>
      </ol>
      <% } %>
    </div>
    <div class="hr-psplus" id="psplus">
      <div class="hr-ps-band">
        <% if (typeof psplusLogo !== 'undefined' && psplusLogo) { %><img class="hr-ps-logo" <%- imgThumb(psplusLogo) %> alt="PS Plus Deluxe" width="48" height="48"><% } else { %><svg class="hr-ps-logo" viewBox="0 0 44 44" width="48" height="48" aria-hidden="true"><rect x="16" y="3" width="12" height="38" rx="2" fill="#F5B800"/><rect x="3" y="16" width="38" height="12" rx="2" fill="#F5B800"/><rect x="16" y="16" width="12" height="12" fill="#D99A00"/></svg><% } %>
        <div class="hr-ps-brand"><small>PlayStation Plus</small><b>Deluxe</b></div>
        <% if (home.prices.psplus) { %><p class="hr-psplus-price">from <b>₱<%= home.prices.psplus %></b> / week</p><% } %>
      </div>
      <div class="hr-ps-body">
      <h2 class="hm-title hm-title-plain">Hundreds of games, one rental</h2>
      <p class="hr-ps-sub">Play any of them for the length of your rental.</p>
      <% if (psplusPopular && psplusPopular.length) { %>
      <ul class="hr-ps-covers" aria-label="Games on PS Plus Deluxe">
        <% psplusPopular.slice(0, psplusPopular.length >= 10 ? 10 : 5).forEach(function (row) { %><li><a href="/ps-plus"><% if (row.cover_image) { %><img <%- imgCard(row.cover_image) %> alt="" loading="lazy" decoding="async"><% } %><span><%= row.title %></span></a></li><% }) %>
      </ul>
      <% } %>
      <div class="hr-ps-acts">
        <a class="hm-btn" href="/ps-plus/rent">Rent PS Plus Deluxe</a>
        <a class="hr-ps-ghost" href="/ps-plus">See all games</a>
      </div>
      <nav class="hr-cats" aria-label="Categories">
        <% home.quickGenres.forEach(function (gn) { %><a href="/browse?genre=<%= encodeURIComponent(gn) %>"><%= gn %><small>Browse genre</small></a><% }) %>
        <% if (home.hasPs4) { %><a href="/browse?console=ps4">Plays on PS4<small>PS4 compatible</small></a><% } %>
        <a href="/browse?price=low">Under ₱<%= home.bands.low %><small>Budget picks</small></a>
        <% if (home.prices.buy) { %><a href="/buy">Buy<small>Keep it</small></a><% } %>
      </nav>
      </div>
    </div>
  </div>
</section>
