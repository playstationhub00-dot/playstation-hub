<%#
  New releases and Coming soon, five each, with the rest linked as text so
  those game URLs stay on the page. Cards keep the catalogue card; the
  action sits under it. Coming soon shows no price.
%>
<%
  function hrSeen(list) {
    const seen = {};
    const out = [];
    (list || []).forEach(function (g) {
      if (!g || seen[g.id]) return;
      seen[g.id] = true;
      out.push(g);
    });
    return out;
  }
  const hrNew = hrSeen(home.newGames);
  const hrSoon = hrSeen(upcoming);
%>
<section class="hr-shelves hm-wrap hm-sec" id="shelves">
  <div class="hr-sec-head">
    <h2 class="hr-title"><span class="hr-mark">△</span> New &amp; Coming Soon</h2>
    <p class="hr-sec-sub">Newest games show even when they're full. Join the line or reserve early.</p>
    <a class="hm-viewall" href="/browse">View all ›</a>
  </div>
  <div class="hr-tabs">
    <input type="radio" name="hrtab" id="hrTabNew" checked>
    <input type="radio" name="hrtab" id="hrTabSoon">
    <div class="hr-tablist">
      <label for="hrTabNew">New releases</label>
      <label for="hrTabSoon">Coming soon</label>
    </div>
    <div class="hr-panel hr-panel-new">
      <h2 class="hm-title" id="newReleasesSection">New releases <a class="hm-viewall" href="/browse?tab=new">View all ›</a></h2>
      <div class="hr-row">
        <% hrNew.slice(0, 5).forEach(function (game) {
          const sum = (typeof accountSummaryMap !== 'undefined' && accountSummaryMap) ? (accountSummaryMap[game.id] || null) : null;
          const av = computeAvailability(game, sum, { nt: game.nt_days_left, tr: game.tr_days_left, ps4: game.ps4_days_left });
          const full = av.totalSlots === 0;
        %>
        <div class="hr-tile">
          <%- include('../game-card', { game: game, dealPrice: false }) %>
          <a class="hr-act<%= full ? ' hr-act-full' : '' %>" href="<%= seo.rentPath(game.title) %>"><%= full ? 'Full · Join line' : 'Rent now' %></a>
        </div>
        <% }) %>
      </div>
      <% if (hrNew.length > 5) { %>
      <p class="hr-also">Also new: <% hrNew.slice(5).forEach(function (game, i) { %><% if (i) { %>, <% } %><a href="<%= seo.rentPath(game.title) %>"><%= game.title %></a><% }) %></p>
      <% } %>
    </div>
    <div class="hr-panel hr-panel-soon">
      <h2 class="hm-title" id="comingSoon"><span aria-hidden="true" class="hm-mark hm-sq">□</span>Coming soon <span class="hm-sub">reserve a slot</span><a class="hm-viewall" href="/browse?tab=coming-soon">View all ›</a></h2>
      <div class="hr-row">
        <% hrSoon.slice(0, 5).forEach(function (game) { %>
        <div class="hr-tile">
          <a href="/upcoming/<%= seo.slug(game.title) %>-<%= game.id %>" class="game-card upcoming-card gc2-split game-card-link">
            <div class="gc2-art">
              <% if (game.cover_image) { %>
              <img <%- imgCard(game.cover_image) %> width="480" height="720" alt="<%= game.title %>" class="cs-cover-img" loading="lazy" decoding="async">
              <% } else { %>
              <div class="cs-cover-placeholder"><span>No Image</span></div>
              <% } %>
              <div class="cs-badge<%= (typeof siteTheme !== 'undefined' && siteTheme && siteTheme.decor === 'halloween') ? ' theme-pumpkin' : '' %>">Reserve</div>
            </div>
            <div class="gc2-body">
              <div class="gc2-title"><%= game.title %></div>
              <div class="gc2-price">Coming soon<% 
                if (game.release_date && game.release_date !== 'TBA') {
                  const rel = new Date(game.release_date + 'T00:00:00');
                  const today = new Date(); today.setHours(0,0,0,0);
                  const days = Math.ceil((rel - today) / 86400000);
                  if (days > 0) { %> · <%= days %> days<% }
                } %></div>
            </div>
          </a>
          <a class="hr-act hr-act-reserve" href="/upcoming/<%= seo.slug(game.title) %>-<%= game.id %>">Reserve a slot</a>
        </div>
        <% }) %>
      </div>
      <% if (hrSoon.length > 5) { %>
      <p class="hr-also">Also coming: <% hrSoon.slice(5).forEach(function (game, i) { %><% if (i) { %>, <% } %><a href="/upcoming/<%= seo.slug(game.title) %>-<%= game.id %>"><%= game.title %></a><% }) %></p>
      <% } %>
    </div>
  </div>
</section>
<% if (specialDeals.length) { %>
<section class="hm-wrap hm-sec" id="specialDealsSection">
  <h2 class="hm-title"><span aria-hidden="true" class="hm-mark hm-cir">○</span>Loot drops <span class="hm-sub">special deals</span></h2>
  <div class="hr-row">
    <% specialDeals.slice(0, 5).forEach(function (game) { %>
    <div class="hr-tile"><%- include('../game-card', { game: game, dealPrice: true }) %></div>
    <% }) %>
  </div>
</section>
<% } %>
