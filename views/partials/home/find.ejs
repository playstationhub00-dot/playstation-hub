<%#
  Under the hero: the page H1 (hero text), the search, category chips, and
  the trust line. The search heading stays in the HTML for the same query
  the old strip answered. Locals: home, settings, featured.
%>
<%
  const hmBase = settings.hero_text || {};
  const hmCustom = (typeof siteTheme !== 'undefined' && siteTheme && siteTheme.headline) ? siteTheme.headline : null;
  const hmText = hmCustom || hmBase;
%>
<section class="hr-find hm-wrap" id="find">
  <% if (hmCustom) { %>
  <h1 class="hm-tagline">PlayStation Hub · <%= hmText.line1 %> <span class="hm-hl"><%= hmText.highlight %></span> <%= hmText.line2 %></h1>
  <% } else { %>
  <h1 class="hm-tagline">PlayStation Hub · <%= hmText.line1 %> <span style="color:<%= hmText.highlight_color || '#F0A500' %>;"><%= hmText.highlight %></span> <%= hmText.line2 %></h1>
  <% } %>
  <div class="hr-search">
    <%- include('../home-search', { featured, compact: true }) %>
    <label class="hr-search-go" for="hsInput">Search</label>
  </div>
  <% if (home.powerUp) { %>
  <a class="hm-power" href="/browse"><span class="hm-power-tag">Power-up</span><span class="hm-power-text">Rent <%= home.powerUp.days %> days → <b><%= home.powerUp.pct %>% off</b><%= home.powerUp.days === 30 ? ' while the monthly promo is on' : ', automatically' %></span><span class="hm-power-go">See games ›</span></a>
  <% } %>
  <%
    const hrChips = [];
    if (home.newGames.length) hrChips.push({ href: '#newReleasesSection', label: 'New releases' });
    if (specialDeals.length) hrChips.push({ href: '#specialDealsSection', label: 'Deals' });
    if (home.prices.psplus || psplusPopular.length) hrChips.push({ href: '#psplus', label: 'PS Plus' });
    if (upcoming.length) hrChips.push({ href: '#comingSoon', label: 'Coming soon' });
    hrChips.push({ href: '/browse?price=low', label: 'Under ₱' + home.bands.low });
    if (home.hasPs4) hrChips.push({ href: '/browse?console=ps4', label: 'Plays on PS4' });
    (home.quickGenres || []).forEach(function (gn) {
      if (gn) hrChips.push({ href: '/browse?genre=' + encodeURIComponent(gn), label: String(gn) });
    });
  %>
  <nav class="hr-chips" aria-label="Quick picks">
    <% hrChips.forEach(function (chip) { %>
    <a class="hr-chip" href="<%= chip.href %>"><%= chip.label %></a>
    <% }) %>
  </nav>
  <ul class="hm-trust">
    <% if (home.trust.renters) { %><li><span class="hm-tick" aria-hidden="true">✓</span> <%= home.trust.renters %> players</li><% } %>
    <% if (home.trust.recommendPct != null) { %><li><span class="hm-tick" aria-hidden="true">✓</span> <%= home.trust.recommendPct %>% recommend us</li><% } else if (home.trust.reviewCount) { %><li><span class="hm-tick" aria-hidden="true">✓</span> <%= home.trust.reviewCount %> player reviews</li><% } %>
    <li><span class="hm-tick" aria-hidden="true">✓</span> Ready in minutes</li>
    <li><span class="hm-tick" aria-hidden="true">✓</span> No password needed</li>
  </ul>
</section>
