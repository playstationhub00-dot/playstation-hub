<!-- Asked on the customer's own order page once they actually have the game.
     Two radios, not five stars: a thumb is one tap on a phone and nobody was
     picking 2 or 3 anyway. The comment is optional — one tap is a complete
     answer, and demanding a sentence is why review forms get abandoned.

     No JavaScript: `input:checked + label` does the highlighting, so it still
     works in the Facebook in-app browser. -->
<div class="rvp">
  <div class="rvp-title">How was it?</div>
  <div class="rvp-sub">One tap. Add a line if you want to.</div>
  <form method="POST" action="/order/<%= order.ref %>/review">
    <input type="hidden" name="k" value="<%= order.url_key %>">
    <div class="rvp-thumbs">
      <input type="radio" name="sentiment" id="rvpUp" value="up" required>
      <label for="rvpUp" class="rvp-thumb rvp-up">
        <span class="rvp-thumb-ic" aria-hidden="true">👍</span>
        <span>Good</span>
      </label>
      <input type="radio" name="sentiment" id="rvpDown" value="down">
      <label for="rvpDown" class="rvp-thumb rvp-down">
        <span class="rvp-thumb-ic" aria-hidden="true">👎</span>
        <span>Not good</span>
      </label>
    </div>
    <textarea name="text" class="rvp-text" rows="2" maxlength="300"
              placeholder="Anything you want to add? (optional)"></textarea>
    <div class="rvp-who"><%= order.fb_name %> · <%= order.game_title %></div>
    <button type="submit" class="rvp-btn">Send</button>
    <%# Says what actually happens to each answer. A "not good" never goes on
        the site — it goes straight to the owner — and saying so is what makes
        the button honest to tap. %>
    <div class="rvp-fine">A good one goes on our site once we've checked it. Anything else comes straight to us — we'll make it right.</div>
  </form>
</div>
