<% (items || []).forEach(function (item) {
  var chipLabel = item.label;
  if (typeof compact !== 'undefined' && compact) {
    var blob = String(item.text || '');
    if (item.kind === 'punch') {
      var nth = blob.match(/(\d+(?:st|nd|rd|th))/i);
      if (nth) chipLabel = nth[1] + ' rental free';
    } else if (item.kind === 'rebook') {
      var peso = blob.match(/₱\s*[\d,]+/);
      if (peso) chipLabel = 'Rebook ' + peso[0].replace(/\s+/g, '') + ' off';
    }
  }
%>
<div class="gd-promo-item" title="<%= item.text %>">
  <span class="gd-promo-label" data-kind="<%= item.kind || 'promo' %>"><%= chipLabel %></span>
  <span class="gd-promo-text"><%= item.text %></span>
</div>
<% }) %>
