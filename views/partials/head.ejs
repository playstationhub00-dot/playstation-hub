<%
  // One <head> for every page: title, description, canonical on www, social
  // tags, and JSON-LD. Admin routes pass noindex (the visitor middleware also
  // sets seoNoindex for /admin). Query strings never become the canonical.
  var seoApi = seo;
  var pageKey = (typeof page !== 'undefined') ? page : '';
  var base = {};
  if (pageKey === 'home') {
    base = seoApi.homePage({
      games: (typeof games !== 'undefined' ? games : []),
      promo: (typeof promo !== 'undefined' ? promo : null),
      faqItems: (typeof faqItems !== 'undefined' ? faqItems : [])
    });
  } else if (pageKey) {
    base = seoApi.staticPage(pageKey);
  }
  var pageTitle = (typeof title !== 'undefined' && title) ? title : (base.title || ((typeof settings !== 'undefined' && settings && settings.title) || 'PlayStation Hub'));
  var pageDesc = (typeof description !== 'undefined') ? description : (base.description || '');
  var pagePath = (typeof canonicalPath !== 'undefined') ? canonicalPath : (base.canonicalPath || '/');
  var canonical = seoApi.canonicalUrl(pagePath);
  var noindexPage = !!((typeof noindex !== 'undefined' && noindex) || (typeof seoNoindex !== 'undefined' && seoNoindex));
  // Social image stays /logo.svg for the built-in wordmark. The transparent
  // header file is white and vanishes on a light share card. A custom admin
  // upload (logo_path after logo_builtin_at) is still used. Pages that pass
  // their own image, and static pages whose base.image is /logo.svg, win first.
  var rawLogo = (typeof settings !== 'undefined' && settings && settings.logo_path) || '';
  var logoStamped = typeof settings !== 'undefined' && settings && settings.logo_builtin_at;
  var stockLogo = !rawLogo || rawLogo === '/logo.svg' || rawLogo === '/logo.png'
    || rawLogo === '/logo-hub-light.png' || rawLogo === '/logo-hub-light-4x.png'
    || rawLogo === '/logo-hub-dark.png' || rawLogo === '/logo-hub-dark-4x.png'
    || (/^\/uploads\/logo-custom\./.test(rawLogo) && !logoStamped);
  var socialLogo = stockLogo ? '/logo.svg' : rawLogo;
  var img = (typeof image !== 'undefined' && image) ? image : (base.image || socialLogo);
  var ogImage = seoApi.absoluteUrl(img);
  var ogType = (typeof type !== 'undefined' && type) ? type : (base.type || 'website');
  var blocks = [];
  if (!noindexPage) blocks = blocks.concat(seoApi.siteGraph());
  if (base.jsonLd && base.jsonLd.length) blocks = blocks.concat(base.jsonLd);
  if (typeof jsonLd !== 'undefined' && jsonLd && jsonLd.length) blocks = blocks.concat(jsonLd);
  var fav = (typeof settings !== 'undefined' && settings && settings.favicon_path) || '/favicon.svg';
  var verify = (typeof googleSiteVerification !== 'undefined' && googleSiteVerification) ? googleSiteVerification : '';
%>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<% if (typeof siteTheme !== 'undefined' && siteTheme && siteTheme.css && !noindexPage) { %>
<link rel="stylesheet" href="/css/themes.css?v=<%= assetV %>">
<style id="site-theme"><%= siteTheme.css %></style>
<meta name="theme-color" content="<%= siteTheme.colors.bg %>">
<script>document.documentElement.dataset.theme=<%- JSON.stringify(siteTheme.id) %>;document.documentElement.classList.add(<%- JSON.stringify(siteTheme.className) %>);document.documentElement.style.cssText=<%- JSON.stringify(siteTheme.declarations) %>;</script>
<% } %>
<title><%= pageTitle %></title>
<% if (pageDesc) { %>
<meta name="description" content="<%= pageDesc %>">
<% } %>
<% if (!noindexPage) { %>
<link rel="canonical" href="<%= canonical %>">
<% } %>
<% if (noindexPage) { %>
<meta name="robots" content="noindex, nofollow">
<% } %>
<meta property="og:title" content="<%= pageTitle %>">
<% if (pageDesc) { %>
<meta property="og:description" content="<%= pageDesc %>">
<% } %>
<meta property="og:image" content="<%= ogImage %>">
<meta property="og:url" content="<%= canonical %>">
<meta property="og:type" content="<%= ogType %>">
<meta property="og:site_name" content="PlayStation Hub">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= pageTitle %>">
<% if (pageDesc) { %>
<meta name="twitter:description" content="<%= pageDesc %>">
<% } %>
<meta name="twitter:image" content="<%= ogImage %>">
<link rel="icon" href="<%= fav %>" type="<%= seoApi.faviconType(fav) %>">
<meta name="facebook-domain-verification" content="noj6ccmsehjq0v2oeq2e716fgyaqq0" />
<% if (verify) { %>
<meta name="google-site-verification" content="<%= verify %>">
<% } %>
<% blocks.forEach(function (block) { %>
<script type="application/ld+json"><%- seoApi.jsonLdScript(block) %></script>
<% }); %>
