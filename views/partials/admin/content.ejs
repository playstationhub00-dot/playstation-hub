  <div class="tab-panel" id="tab-content">
    <!-- HERO SLIDES MANAGER -->
    <div class="settings-accordion">
      <div class="settings-accordion-header" onclick="toggleAccordion(this)" style="border-left:3px solid #a855f7;">
        <div class="sa-left">
          <div class="sa-icon" style="background:rgba(168,85,247,0.15);">🖼</div>
          <div>
            <div class="sa-title">Hero Promo Slider</div>
            <div class="sa-desc">Upload promo banners shown as a slideshow on the homepage</div>
          </div>
        </div>
        <span class="sa-arrow">▼</span>
      </div>
      <div class="settings-accordion-body">
    <div style="border-color:rgba(240,165,0,0.5);background:linear-gradient(135deg,#0d0d00,#1a1a0a);">
      <h2 style="display:none;">🖼 Hero Promo Slideshow</h2>
      <p style="color:#888;font-size:0.85rem;margin:0 0 1.25rem;">Upload promo posters. They replace the homepage hero with an auto-sliding carousel (auto-advances every 5 seconds). Remove all slides to restore the text hero.</p>

      <!-- Current slides -->
      <% if (settings.hero_slides && settings.hero_slides.length > 0) { %>
      <div style="display:flex;flex-wrap:wrap;gap:1rem;margin-bottom:1.5rem;">
        <% settings.hero_slides.forEach((sl, i) => { %>
        <div style="background:#1a1a1a;border:1px solid #2a2a2a;border-radius:10px;padding:0.75rem;display:flex;flex-direction:column;align-items:center;gap:0.5rem;width:160px;">
          <img src="<%= sl.path %>" style="width:100%;height:100px;object-fit:cover;border-radius:6px;">
          <% if (sl.caption) { %>
          <div style="font-size:0.72rem;color:#aaa;text-align:center;word-break:break-word;"><%= sl.caption %></div>
          <% } %>
          <form method="POST" action="/admin/hero-slides/delete" onsubmit="return confirm('Delete this slide?');" style="width:100%;">
            <input type="hidden" name="index" value="<%= i %>">
            <button type="submit" style="width:100%;background:#c0392b;border:none;color:#fff;border-radius:6px;padding:0.35rem;cursor:pointer;font-size:0.78rem;">🗑 Delete</button>
          </form>
        </div>
        <% }) %>
      </div>
      <% } else { %>
      <div style="color:#666;font-size:0.85rem;margin-bottom:1.25rem;padding:0.75rem;background:#111;border-radius:8px;border:1px dashed #333;">No slides yet — upload your first promo poster below to activate the slideshow.</div>
      <% } %>

      <!-- Upload new slide -->
      <form method="POST" action="/admin/hero-slides/upload" enctype="multipart/form-data" style="display:flex;flex-direction:column;gap:0.75rem;max-width:480px;">
        <label style="color:#aaa;font-size:0.82rem;font-weight:600;">Add New Slide</label>
        <input type="file" name="slide_image" accept="image/*" required style="padding:0.5rem;background:#1a1a1a;border:1px solid #333;border-radius:8px;color:#fff;">
        <input type="text" name="caption" placeholder="Caption (optional — shown at bottom of slide)" style="padding:0.6rem 0.9rem;background:#1a1a1a;border:1px solid #333;border-radius:8px;color:#fff;font-size:0.875rem;">
        <input type="text" name="link" placeholder="Link when tapped (optional, e.g. /browse)" style="padding:0.6rem 0.9rem;background:#1a1a1a;border:1px solid #333;border-radius:8px;color:#fff;font-size:0.875rem;">
        <div class="form-actions">
          <button type="submit" class="btn btn-primary" style="background:var(--ps-blue);">Upload Slide</button>
        </div>
      </form>
    </div><!-- /hero-slides inner -->
      </div><!-- /accordion-body -->
    </div><!-- /accordion hero-slides -->
    <!-- SIGN-IN QR GUIDE -->
    <div class="settings-accordion">
      <div class="settings-accordion-header" id="ssgAccordionHeader" onclick="toggleAccordion(this)" style="border-left:3px solid #38bdf8;">
        <div class="sa-left">
          <div class="sa-icon" style="background:rgba(56,189,248,0.15);">📷</div>
          <div>
            <div class="sa-title">Sign-In QR Guide</div>
            <div class="sa-desc">Step-by-step, with screenshots, for PS5 and PS4</div>
          </div>
        </div>
        <span class="sa-arrow">▼</span>
      </div>
      <div class="settings-accordion-body" id="ssgAccordionBody">
    <div style="border-color:rgba(56,189,248,0.3);background:linear-gradient(135deg,#04141c,#071d2a);padding:1.25rem;">
      <div style="display:flex;gap:0.5rem;margin-bottom:1rem;">
        <button type="button" class="ssg-tab ssg-tab-on" data-c="ps5" onclick="ssgSwitch('ps5')">PS5 steps</button>
        <button type="button" class="ssg-tab" data-c="ps4" onclick="ssgSwitch('ps4')">PS4 steps</button>
      </div>

      <% ['ps5', 'ps4'].forEach(cons => { %>
      <div class="ssg-panel<%= cons === 'ps5' ? '' : ' ssg-hidden' %>" data-c="<%= cons %>">
        <% signinSteps[cons].forEach((s, i) => { %>
        <div style="border:1px solid #1a3a4a;border-radius:8px;padding:0.6rem 0.75rem;margin-bottom:0.5rem;background:#0a1a24;">
          <form method="POST" action="/admin/signin-steps/<%= s.id %>" enctype="multipart/form-data" style="display:flex;gap:0.6rem;align-items:flex-start;">
            <span style="color:#555;font-size:0.8rem;padding-top:0.5rem;width:16px;flex-shrink:0;"><%= i + 1 %></span>
            <div style="flex:1;min-width:0;">
              <input type="text" name="text" value="<%= s.text %>" style="width:100%;background:#111;border:1px solid #222;border-radius:6px;padding:0.5rem 0.7rem;color:#fff;font-size:0.85rem;margin-bottom:0.4rem;">
              <div style="display:flex;align-items:center;gap:0.6rem;flex-wrap:wrap;">
                <% if (s.image) { %>
                <img src="<%= s.image %>" style="width:48px;height:38px;object-fit:cover;border-radius:4px;border:1px solid #222;">
                <label style="display:flex;align-items:center;gap:0.3rem;font-size:0.72rem;color:#e74c3c;cursor:pointer;">
                  <input type="checkbox" name="remove_image" style="width:13px;height:13px;">Remove
                </label>
                <% } %>
                <input type="file" name="image" accept="image/*" style="font-size:0.72rem;color:#888;max-width:180px;">
                <button type="submit" style="font-size:0.72rem;padding:0.3rem 0.7rem;background:#38bdf8;color:#000;border:none;border-radius:5px;font-weight:700;cursor:pointer;">Save</button>
              </div>
            </div>
          </form>
          <div style="display:flex;gap:0.4rem;margin-top:0.4rem;padding-left:26px;">
            <form method="POST" action="/admin/signin-steps/<%= s.id %>/move">
              <input type="hidden" name="dir" value="up">
              <button type="submit" <%= i === 0 ? 'disabled' : '' %> style="font-size:0.7rem;padding:0.2rem 0.5rem;background:#1a1a1a;color:#aaa;border:1px solid #222;border-radius:4px;cursor:pointer;">↑</button>
            </form>
            <form method="POST" action="/admin/signin-steps/<%= s.id %>/move">
              <input type="hidden" name="dir" value="down">
              <button type="submit" <%= i === signinSteps[cons].length - 1 ? 'disabled' : '' %> style="font-size:0.7rem;padding:0.2rem 0.5rem;background:#1a1a1a;color:#aaa;border:1px solid #222;border-radius:4px;cursor:pointer;">↓</button>
            </form>
            <form method="POST" action="/admin/signin-steps/<%= s.id %>/delete" onsubmit="return confirm('Delete this step?');">
              <button type="submit" style="font-size:0.7rem;padding:0.2rem 0.5rem;background:#2a0a0a;color:#ef4444;border:1px solid #4a1e1e;border-radius:4px;cursor:pointer;">Delete</button>
            </form>
          </div>
        </div>
        <% }) %>

        <form method="POST" action="/admin/signin-steps/add" enctype="multipart/form-data" style="border:1px dashed #2a4a5a;border-radius:8px;padding:0.75rem;margin-top:0.5rem;">
          <input type="hidden" name="console" value="<%= cons %>">
          <input type="text" name="text" placeholder="New step text…" required style="width:100%;background:#111;border:1px solid #222;border-radius:6px;padding:0.5rem 0.7rem;color:#fff;font-size:0.85rem;margin-bottom:0.4rem;">
          <div style="display:flex;align-items:center;gap:0.6rem;">
            <input type="file" name="image" accept="image/*" style="font-size:0.72rem;color:#888;">
            <button type="submit" style="font-size:0.75rem;padding:0.35rem 0.9rem;background:#38bdf8;color:#000;border:none;border-radius:5px;font-weight:700;cursor:pointer;">+ Add step</button>
          </div>
        </form>
      </div>
      <% }) %>

      <div style="margin-top:1rem;font-size:0.72rem;color:#555;">Also live at <code>/how-to-sign-in</code> — link it in Messenger anytime.</div>
    </div>
      </div>
    </div>

    <style>
      .ssg-tab { font-size:0.78rem; padding:0.4rem 1rem; background:#111; color:#888; border:1px solid #222; border-radius:6px; cursor:pointer; }
      .ssg-tab-on { background:#38bdf8; color:#000; font-weight:700; border-color:#38bdf8; }
      .ssg-hidden { display:none; }
    </style>
    <script>
      function ssgSwitch(cons) {
        document.querySelectorAll('.ssg-tab').forEach(function(t){ t.classList.toggle('ssg-tab-on', t.dataset.c === cons); });
        document.querySelectorAll('.ssg-panel').forEach(function(p){ p.classList.toggle('ssg-hidden', p.dataset.c !== cons); });
        try { sessionStorage.setItem('ssgAdminConsole', cons); } catch (e) {}
      }
    </script>

    <!-- HOMEPAGE POPUP -->
    <% const adminPopup = settings.popup || { enabled: false, image_path: '', link_url: '/browse', starts_at: '', ends_at: '' }; %>
    <div class="settings-accordion">
      <div class="settings-accordion-header" onclick="toggleAccordion(this)" style="border-left:3px solid #ec4899;">
        <div class="sa-left">
          <div class="sa-icon" style="background:rgba(236,72,153,0.15);">🪧</div>
          <div>
            <div class="sa-title">Homepage Popup</div>
            <div class="sa-desc">Pop-out promo image shown once per visit on the homepage</div>
          </div>
        </div>
        <span class="sa-arrow">▼</span>
      </div>
      <div class="settings-accordion-body">
    <div style="border-color:rgba(236,72,153,0.3);background:linear-gradient(135deg,#12040c,#1a0714);">
      <form method="POST" action="/admin/popup" enctype="multipart/form-data">
        <div class="form-grid">
          <div class="form-group full">
            <label style="display:flex;align-items:center;gap:0.75rem;cursor:pointer;">
              <input type="checkbox" name="enabled" <%= adminPopup.enabled ? 'checked' : '' %> style="width:18px;height:18px;accent-color:#ec4899;">
              <span>Enable Homepage Popup</span>
            </label>
          </div>
          <div class="form-group full" style="margin-bottom:0;">
            <label>Popup Image <span style="color:#555;font-size:0.75rem;">(4:5 portrait works best — e.g. 800×1000px. Up to 20MB)</span></label>
            <input type="file" name="popup_image" accept="image/*">
          </div>
          <% if (adminPopup.image_path) { %>
          <div class="form-group full" style="margin-bottom:0;">
            <div style="display:flex;align-items:center;gap:1rem;background:#0d0d0d;border:1px solid #222;border-radius:10px;padding:0.75rem;">
              <img src="<%= adminPopup.image_path %>" style="width:70px;height:88px;object-fit:cover;border-radius:6px;">
              <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;color:#e74c3c;font-size:0.85rem;">
                <input type="checkbox" name="remove_image" style="width:16px;height:16px;accent-color:#e74c3c;">
                <span>Remove current image</span>
              </label>
            </div>
          </div>
          <% } %>
          <div class="form-group full">
            <label>Click Destination <span style="color:#555;font-size:0.75rem;">(where the image and button send them)</span></label>
            <input type="text" name="link_url" value="<%= adminPopup.link_url || '/browse' %>" placeholder="/browse">
          </div>
          <div class="form-group">
            <label>Start Showing <span style="color:#555;font-size:0.75rem;">(optional)</span></label>
            <input type="datetime-local" name="starts_at" value="<%= adminPopup.starts_at || '' %>">
          </div>
          <div class="form-group">
            <label>Stop Showing <span style="color:#555;font-size:0.75rem;">(optional)</span></label>
            <input type="datetime-local" name="ends_at" value="<%= adminPopup.ends_at || '' %>">
          </div>
          <div class="form-group full" style="margin-bottom:0;">
            <div style="font-size:0.78rem;color:#666;background:#0d0d0d;border:1px dashed #2a2a2a;border-radius:8px;padding:0.75rem;line-height:1.6;">
              Customers who close it see it again next visit. Those who tap <b style="color:#999;">Don't show this again today</b> won't see it until tomorrow — but uploading a new image resets everyone so your next promo always lands.
            </div>
          </div>
        </div>
        <div class="form-actions" style="margin-top:0.75rem;">
          <button type="submit" class="btn btn-primary" style="background:#ec4899;color:#000;">Save Popup Settings</button>
        </div>
      </form>
    </div><!-- /popup inner -->
      </div><!-- /accordion-body -->
    </div><!-- /accordion popup -->
    <!-- HERO TEXT EDITOR -->
    <div class="settings-accordion">
      <div class="settings-accordion-header" onclick="toggleAccordion(this)" style="border-left:3px solid #60a5fa;">
        <div class="sa-left">
          <div class="sa-icon" style="background:rgba(96,165,250,0.15);">✏️</div>
          <div>
            <div class="sa-title">Home Page Hero Text</div>
            <div class="sa-desc">Edit headline, subtitle, colors & font size</div>
          </div>
        </div>
        <span class="sa-arrow">▼</span>
      </div>
      <div class="settings-accordion-body">
    <div style="border-color:rgba(240,165,0,0.3);background:linear-gradient(135deg,#111000,#1a1a0a);">
      <h2 style="display:none;">✏️ Home Page Hero Text</h2>
      <form method="POST" action="/admin/hero-text">
        <div class="form-grid">
          <div class="form-group">
            <label>Line 1 <span style="color:#555;font-size:0.75rem;">("Rent the Latest")</span></label>
            <input type="text" name="line1" value="<%= settings.hero_text.line1 %>" placeholder="e.g. Rent the Latest">
          </div>
          <div class="form-group">
            <label>Line 2 <span style="color:#555;font-size:0.75rem;">("Games")</span></label>
            <input type="text" name="line2" value="<%= settings.hero_text.line2 %>" placeholder="e.g. Games">
          </div>
          <div class="form-group">
            <label>Highlighted Text <span style="color:#555;font-size:0.75rem;">("PS5 & PS4")</span></label>
            <input type="text" name="highlight" value="<%= settings.hero_text.highlight %>" placeholder="e.g. PS5 & PS4">
          </div>
          <div class="form-group">
            <label>Highlight Color</label>
            <div style="display:flex;align-items:center;gap:0.75rem;">
              <input type="color" name="highlight_color" value="<%= settings.hero_text.highlight_color %>" style="width:48px;height:40px;border:none;border-radius:8px;cursor:pointer;background:none;">
              <span id="hlColorVal" style="color:#aaa;font-size:0.85rem;font-family:monospace;"><%= settings.hero_text.highlight_color %></span>
            </div>
          </div>
          <div class="form-group full">
            <label>Subtitle Text</label>
            <textarea name="subtitle" rows="2" placeholder="e.g. Play more, pay less..."><%= settings.hero_text.subtitle %></textarea>
          </div>
          <div class="form-group">
            <label>Subtitle Color</label>
            <div style="display:flex;align-items:center;gap:0.75rem;">
              <input type="color" name="subtitle_color" value="<%= settings.hero_text.subtitle_color %>" style="width:48px;height:40px;border:none;border-radius:8px;cursor:pointer;background:none;">
              <span id="subColorVal" style="color:#aaa;font-size:0.85rem;font-family:monospace;"><%= settings.hero_text.subtitle_color %></span>
            </div>
          </div>
          <div class="form-group full">
            <label style="display:flex;justify-content:space-between;">
              <span>Title Font Size</span>
              <span id="titleSizeVal" style="color:var(--ps-blue);font-weight:700;"><%= settings.hero_text.title_size %>px</span>
            </label>
            <input type="range" name="title_size" min="20" max="120" value="<%= settings.hero_text.title_size %>"
              oninput="document.getElementById('titleSizeVal').textContent=this.value+'px'"
              style="width:100%;accent-color:var(--ps-blue);cursor:pointer;height:6px;">
            <div style="display:flex;justify-content:space-between;font-size:0.72rem;color:#555;margin-top:0.3rem;">
              <span>20px — small</span><span>120px — huge</span>
            </div>
          </div>
          <div class="form-group full">
            <label style="color:#555;font-size:0.78rem;text-transform:uppercase;letter-spacing:0.5px;">Preview</label>
            <div id="heroPreview" style="background:linear-gradient(135deg,#000,#1a1000,#000);border-radius:12px;padding:2rem;text-align:center;border:1px solid #222;">
              <div id="prevTitle" style="font-weight:900;line-height:1.15;margin-bottom:0.75rem;color:#fff;"></div>
              <div id="prevSubtitle" style="font-size:0.9rem;max-width:480px;margin:0 auto;"></div>
            </div>
          </div>
        </div>
        <div class="form-actions" style="margin-top:0.75rem;">
          <button type="submit" class="btn btn-primary" style="background:var(--ps-blue);">Save Hero Text</button>
        </div>
      </form>
      <script>
      (function() {
        const fields = { line1:document.querySelector('[name=line1]'), line2:document.querySelector('[name=line2]'), highlight:document.querySelector('[name=highlight]'), highlight_color:document.querySelector('[name=highlight_color]'), subtitle:document.querySelector('[name=subtitle]'), subtitle_color:document.querySelector('[name=subtitle_color]'), title_size:document.querySelector('[name=title_size]') };
        function updatePreview() {
          const l1=fields.line1.value,l2=fields.line2.value,hl=fields.highlight.value,hlColor=fields.highlight_color.value,subColor=fields.subtitle_color.value,size=fields.title_size.value;
          document.getElementById('prevTitle').style.fontSize=size+'px';
          document.getElementById('prevTitle').innerHTML=(l1?l1+'<br>':'')+'<span style="color:'+hlColor+'">'+(hl||'')+'</span>'+(l2?' '+l2:'');
          document.getElementById('prevSubtitle').style.color=subColor;
          document.getElementById('prevSubtitle').textContent=fields.subtitle.value;
          document.getElementById('hlColorVal').textContent=hlColor;
          document.getElementById('subColorVal').textContent=subColor;
        }
        Object.values(fields).forEach(f=>{if(f)f.addEventListener('input',updatePreview);});
        updatePreview();
      })();
      </script>
    </div><!-- /hero-text inner -->
      </div><!-- /accordion-body -->
    </div><!-- /accordion hero-text -->
    <!-- CUSTOMER REVIEWS -->
    <div class="settings-accordion">
      <div class="settings-accordion-header" onclick="toggleAccordion(this)" style="border-left:3px solid #f59e0b;">
        <div class="sa-left"><div class="sa-icon" style="background:rgba(245,158,11,0.15);">⭐</div><div><div class="sa-title">Customer Reviews</div><div class="sa-desc">Shown on your homepage and game pages</div></div></div>
        <span class="sa-arrow">▼</span>
      </div>
      <div class="settings-accordion-body">
        <div style="font-weight:700;color:#f59e0b;margin-bottom:1rem;">➕ Add a review</div>
        <form method="POST" action="/admin/reviews/add">
          <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr auto;gap:1rem;align-items:end;flex-wrap:wrap;">
            <div class="form-group" style="margin:0;"><label>Customer Name *</label><input type="text" name="name" placeholder="e.g. Juan dela Cruz" required></div>
            <div class="form-group" style="margin:0;"><label>Game Rented</label><input type="text" name="game_rented" placeholder="e.g. GTA V"></div>
            <div class="form-group" style="margin:0;"><label>Rating (1–5 ⭐)</label><select name="rating"><option value="5">⭐⭐⭐⭐⭐ 5</option><option value="4">⭐⭐⭐⭐ 4</option><option value="3">⭐⭐⭐ 3</option><option value="2">⭐⭐ 2</option><option value="1">⭐ 1</option></select></div>
            <div class="form-group" style="margin:0;"><label>Source</label><select name="source"><option value="facebook">Facebook</option><option value="site">Website</option></select></div>
            <div class="form-group" style="margin:0;"><label>Order</label><input type="number" name="order" value="99" min="1" style="width:70px;"></div>
          </div>
          <div class="form-group" style="margin-top:0.75rem;"><label>Review Text *</label><textarea name="text" rows="3" placeholder="Paste the customer's review from Facebook..." required style="width:100%;resize:vertical;"></textarea></div>
          <button type="submit" class="btn" style="background:linear-gradient(135deg,#f59e0b,#d97706);color:#000;font-weight:700;border:none;padding:0.6rem 1.5rem;border-radius:50px;cursor:pointer;margin-top:0.5rem;">➕ Add Review</button>
        </form>
        <% const pendingReviews = (reviews || []).filter(r => !r.visible); %>
        <% if (pendingReviews.length) { %>
        <div style="margin-top:1.5rem;border:1px solid #4a3a00;background:#1a1204;border-radius:10px;padding:1rem;">
          <div style="font-weight:700;color:#f59e0b;margin-bottom:0.75rem;">⏳ Waiting for your approval (<%= pendingReviews.length %>)</div>
          <% pendingReviews.forEach(pr => { %>
          <div style="background:#111;border:1px solid #2a2a2a;border-radius:10px;padding:0.85rem;margin-bottom:0.5rem;">
            <div style="color:#f59e0b;font-size:0.85rem;"><%= '⭐'.repeat(pr.rating) %></div>
            <div style="color:#ccc;font-size:0.88rem;line-height:1.5;margin:0.35rem 0 0.5rem;">"<%= pr.text %>"</div>
            <div style="font-size:0.75rem;color:#777;margin-bottom:0.6rem;">
              <%= pr.name %><% if (pr.game_rented) { %> · <%= pr.game_rented %><% } %><% if (pr.order_ref) { %> · <%= pr.order_ref %><% } %>
            </div>
            <div style="display:flex;gap:0.5rem;">
              <form method="POST" action="/admin/reviews/toggle/<%= pr.id %>"><button type="submit" style="background:#14532d;color:#4ade80;border:1px solid #22c55e;border-radius:6px;padding:0.35rem 0.9rem;font-size:0.78rem;cursor:pointer;">✓ Approve</button></form>
              <form method="POST" action="/admin/reviews/delete/<%= pr.id %>" onsubmit="return confirm('Delete this review?')"><button type="submit" style="background:#2a0000;color:#ef4444;border:1px solid #4a0000;border-radius:6px;padding:0.35rem 0.9rem;font-size:0.78rem;cursor:pointer;">🗑 Delete</button></form>
            </div>
          </div>
          <% }) %>
        </div>
        <% } %>
        <% if (reviews && reviews.length > 0) { %>
        <div style="display:flex;flex-direction:column;gap:0.75rem;margin-top:1.5rem;">
          <% reviews.forEach(r => { %>
          <div style="background:#111;border:1px solid <%= r.visible ? '#2a2a2a' : '#3a1a1a' %>;border-radius:10px;padding:1rem;display:flex;align-items:flex-start;gap:1rem;opacity:<%= r.visible ? '1' : '0.5' %>;">
            <div style="flex:1;">
              <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.4rem;flex-wrap:wrap;">
                <strong style="color:#fff;"><%= r.name %></strong>
                <span style="color:#f59e0b;font-size:0.85rem;"><%= '⭐'.repeat(r.rating) %></span>
                <% if (r.game_rented) { %><span style="font-size:0.75rem;color:#888;background:#1a1a1a;padding:0.15rem 0.5rem;border-radius:20px;">🎮 <%= r.game_rented %></span><% } %>
                <% if (!r.visible) { %><span style="font-size:0.7rem;color:#ef4444;background:#2a0000;padding:0.15rem 0.5rem;border-radius:20px;">Hidden</span><% } %>
              </div>
              <div style="color:#ccc;font-size:0.88rem;line-height:1.5;">"<%= r.text %>"</div>
            </div>
            <div style="display:flex;flex-direction:column;gap:0.4rem;flex-shrink:0;">
              <form method="POST" action="/admin/reviews/toggle/<%= r.id %>"><button type="submit" style="background:<%= r.visible ? '#1a2a1a' : '#2a1a00' %>;color:<%= r.visible ? '#4ade80' : '#f59e0b' %>;border:1px solid <%= r.visible ? '#2a4a2a' : '#4a3a00' %>;border-radius:6px;padding:0.3rem 0.75rem;font-size:0.75rem;cursor:pointer;white-space:nowrap;"><%= r.visible ? '👁 Hide' : '👁 Show' %></button></form>
              <form method="POST" action="/admin/reviews/delete/<%= r.id %>" onsubmit="return confirm('Delete this review?')"><button type="submit" style="background:#2a0000;color:#ef4444;border:1px solid #4a0000;border-radius:6px;padding:0.3rem 0.75rem;font-size:0.75rem;cursor:pointer;">🗑 Delete</button></form>
            </div>
          </div>
          <% }) %>
        </div>
        <% } else { %>
        <div style="color:#555;text-align:center;padding:1.5rem;">No reviews yet. Add your first one above!</div>
        <% } %>
      </div><!-- /accordion-body reviews -->
    </div><!-- /accordion reviews -->
    <div class="form-card" style="border-color:rgba(0,112,209,0.4);background:linear-gradient(135deg,#1a1a1a 0%,#0d1a2e 100%);">
      <h2 style="display:flex;align-items:center;gap:0.5rem;">📢 Announcements <span style="font-size:0.78rem;font-weight:400;color:#555;margin-left:0.25rem;">— rotate through multiple banners</span></h2>

      <% if (announcements && announcements.length > 0) { %>
      <div style="display:flex;flex-direction:column;gap:0.65rem;margin-bottom:1.25rem;">
        <% announcements.forEach((ann, i) => { %>
        <div style="background:#0a0a14;border:1px solid #1a1a3a;border-radius:10px;padding:0.85rem 1rem;display:flex;align-items:flex-start;gap:0.75rem;">
          <span style="font-size:1rem;margin-top:0.1rem;">📢</span>
          <div style="flex:1;">
            <form method="POST" action="/admin/announcements/edit/<%= ann.id %>" style="display:flex;flex-direction:column;gap:0.6rem;">
              <textarea name="text" rows="2" style="width:100%;resize:vertical;"><%= ann.text %></textarea>
              <div style="display:flex;align-items:center;gap:1rem;">
                <label style="display:flex;align-items:center;gap:0.4rem;font-size:0.82rem;cursor:pointer;">
                  <label class="toggle-switch" style="width:38px;height:20px;">
                    <input type="checkbox" name="active" <%= ann.active ? 'checked' : '' %>>
                    <span class="toggle-slider"></span>
                  </label>
                  <span style="color:<%= ann.active ? '#22c55e' : '#555' %>"><%= ann.active ? 'Active' : 'Hidden' %></span>
                </label>
                <button type="submit" class="btn btn-primary" style="padding:0.35rem 0.9rem;font-size:0.8rem;">Save</button>
                <button type="button" class="btn btn-outline" style="padding:0.35rem 0.9rem;font-size:0.8rem;border-color:#7f1d1d;color:#ef4444;"
                  onclick="if(confirm('Delete this announcement?')) fetch('/admin/announcements/delete/<%= ann.id %>',{method:'POST'}).then(()=>location.reload());">
                  Delete
                </button>
              </div>
            </form>
          </div>
        </div>
        <% }) %>
      </div>
      <% } else { %>
      <p style="color:#444;font-size:0.82rem;margin-bottom:1rem;font-style:italic;">No announcements yet.</p>
      <% } %>

      <details style="background:#050514;border:1px dashed #1a1a3a;border-radius:10px;overflow:hidden;">
        <summary style="padding:0.85rem 1rem;cursor:pointer;color:#4a9eff;font-weight:700;font-size:0.9rem;list-style:none;">+ Add New Announcement</summary>
        <div style="padding:1rem;border-top:1px dashed #1a1a3a;">
          <form method="POST" action="/admin/announcements/add">
            <div class="form-grid">
              <div class="form-group full">
                <label>Announcement Text *</label>
                <textarea name="text" rows="2" placeholder="📢 Your announcement here..." required></textarea>
              </div>
              <div class="form-group">
                <label>Show on Website</label>
                <label class="toggle-switch"><input type="checkbox" name="active" checked><span class="toggle-slider"></span></label>
              </div>
            </div>
            <div class="form-actions" style="margin-top:0.75rem;">
              <button type="submit" class="btn btn-primary" style="background:#1d4ed8;">Add Announcement</button>
            </div>
          </form>
        </div>
      </details>
    </div>
  </div><!-- /tab-announcements -->
