  <div class="tab-panel" id="tab-visitors">
    <style>
      .vis-day-bar:hover > div:nth-child(2) { background: rgba(96,165,250,0.4) !important; }
      .vis-day-bar.vis-day-active > div:nth-child(2) { background: #60a5fa !important; }
      .vis-day-bar.vis-day-active > div:last-child { color: #60a5fa !important; font-weight: 700; }
    </style>
    <%
      const vNow = new Date();
      const vTodayStr = vNow.toISOString().slice(0, 10);
      const vWeekAgo  = new Date(vNow - 7 * 86400000).toISOString().slice(0, 10);
      const vMonthAgo = new Date(vNow - 30 * 86400000).toISOString().slice(0, 10);
      const vYearAgo  = new Date(vNow - 365 * 86400000).toISOString().slice(0, 10);

      const visToday = visitors.filter(v => v.date === vTodayStr);
      const visWeek  = visitors.filter(v => v.date >= vWeekAgo);
      const visMonth = visitors.filter(v => v.date >= vMonthAgo);
      const visYear  = visitors.filter(v => v.date >= vYearAgo);

      const uniqueToday = new Set(visToday.map(v => v.ip)).size;
      const uniqueWeek  = new Set(visWeek.map(v => v.ip)).size;
      const uniqueMonth = new Set(visMonth.map(v => v.ip)).size;
      const uniqueAll   = new Set(visitors.map(v => v.ip)).size;

      // topPages removed — per-period top pages computed below

      const vLast14 = [];
      for (let i = 13; i >= 0; i--) {
        const vd = new Date(vNow - i * 86400000);
        const vds = vd.toISOString().slice(0, 10);
        const vlabel = vd.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
        vLast14.push({ date: vds, label: vlabel, count: visitors.filter(v => v.date === vds).length });
      }
      const vMaxBar = Math.max(...vLast14.map(d => d.count), 1);

      const recentVisitors = [...visitors].reverse().slice(0, 100);

    %>

    <!-- KPI Cards -->
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:1rem;margin-bottom:2rem;">
      <div class="stat-card">
        <div class="stat-card-label">Today's Visits</div>
        <div class="stat-card-num" style="color:#22c55e;"><%= visToday.length %></div>
        <div class="stat-card-sub"><%= uniqueToday %> unique visitor<%= uniqueToday!==1?'s':'' %></div>
      </div>
      <div class="stat-card">
        <div class="stat-card-label">Last 7 Days</div>
        <div class="stat-card-num" style="color:#60a5fa;"><%= visWeek.length %></div>
        <div class="stat-card-sub"><%= uniqueWeek %> unique visitor<%= uniqueWeek!==1?'s':'' %></div>
      </div>
      <div class="stat-card">
        <div class="stat-card-label">Last 30 Days</div>
        <div class="stat-card-num" style="color:#a78bfa;"><%= visMonth.length %></div>
        <div class="stat-card-sub"><%= uniqueMonth %> unique visitor<%= uniqueMonth!==1?'s':'' %></div>
      </div>
      <div class="stat-card">
        <div class="stat-card-label">All-Time Visits</div>
        <div class="stat-card-num" style="color:#ffc400;"><%= visitors.length %></div>
        <div class="stat-card-sub"><%= uniqueAll %> unique visitor<%= uniqueAll!==1?'s':'' %></div>
      </div>
    </div>

    <!-- Session Funnel + Exit Pages -->
    <div class="vf-section">
      <div class="vf-filter-row">
        <span class="vf-filter-label">Sessions</span>
        <button onclick="setFunnelFilter('today')" id="vfBtn-today" class="vis-filter-btn vis-filter-active" style="font-size:0.7rem;padding:0.25rem 0.6rem;">Today</button>
        <button onclick="setFunnelFilter('week')"  id="vfBtn-week"  class="vis-filter-btn"                  style="font-size:0.7rem;padding:0.25rem 0.6rem;">Weekly</button>
        <button onclick="setFunnelFilter('month')" id="vfBtn-month" class="vis-filter-btn"                  style="font-size:0.7rem;padding:0.25rem 0.6rem;">Monthly</button>
        <button onclick="setFunnelFilter('year')"  id="vfBtn-year"  class="vis-filter-btn"                  style="font-size:0.7rem;padding:0.25rem 0.6rem;">Yearly</button>
        <button onclick="setFunnelFilter('all')"   id="vfBtn-all"   class="vis-filter-btn"                  style="font-size:0.7rem;padding:0.25rem 0.6rem;">All</button>
        <span class="vf-day-label" id="vfDayLabel" style="display:none;"></span>
      </div>
      <div class="vf-grid">
        <div class="vf-panel">
          <div class="vf-panel-label">Funnel</div>
          <div class="vf-browsed" id="vfBrowsedStat"></div>
          <div id="vfFunnelBody"></div>
        </div>
        <div class="vf-panel">
          <div class="vf-panel-label">Top exit pages</div>
          <div id="vfExitBody"></div>
        </div>
      </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin-bottom:2rem;">

      <!-- Last 14 Days Bar Chart -->
      <div class="table-card" style="border-color:rgba(96,165,250,0.2);">
        <h2 style="border-color:rgba(96,165,250,0.1);margin-bottom:0.4rem;">📈 Visits — Last 14 Days</h2>
        <div style="font-size:0.72rem;color:#555;margin-bottom:0.85rem;">Click a bar to see that day's visits below</div>
        <div style="display:flex;align-items:flex-end;gap:0.25rem;height:120px;">
          <% vLast14.forEach(day => { %>
          <div class="vis-day-bar" data-date="<%= day.date %>" data-label="<%= day.label %>" onclick="filterVisitsByDate('<%= day.date %>','<%= day.label %>')" style="flex:1;display:flex;flex-direction:column;align-items:center;gap:0.3rem;height:100%;cursor:pointer;" title="View visits for <%= day.label %>">
            <div style="font-size:0.6rem;color:#555;"><%= day.count %></div>
            <div style="width:100%;background:rgba(96,165,250,0.15);border-radius:4px 4px 0 0;border-top:2px solid #60a5fa;height:<%= day.count > 0 ? Math.round((day.count/vMaxBar)*85) : 2 %>px;min-height:2px;transition:background 0.15s;"></div>
            <div style="font-size:0.56rem;color:#555;text-align:center;line-height:1.2;"><%= day.label %></div>
          </div>
          <% }) %>
        </div>
      </div>

      <!-- Top Pages -->
      <div class="table-card" style="border-color:rgba(167,139,250,0.2);">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;flex-wrap:wrap;gap:0.5rem;">
          <h2 style="border:none;margin:0;padding:0;">🔗 Most Visited Pages <span style="font-size:0.7rem;color:#555;">(Top 5)</span></h2>
          <div style="display:flex;gap:0.35rem;">
            <button onclick="setTopFilter('today')" id="tpBtn-today" class="vis-filter-btn vis-filter-active" style="font-size:0.7rem;padding:0.25rem 0.6rem;">Today</button>
            <button onclick="setTopFilter('week')"  id="tpBtn-week"  class="vis-filter-btn"                  style="font-size:0.7rem;padding:0.25rem 0.6rem;">Weekly</button>
            <button onclick="setTopFilter('month')" id="tpBtn-month" class="vis-filter-btn"                  style="font-size:0.7rem;padding:0.25rem 0.6rem;">Monthly</button>
            <button onclick="setTopFilter('year')"  id="tpBtn-year"  class="vis-filter-btn"                  style="font-size:0.7rem;padding:0.25rem 0.6rem;">Yearly</button>
            <button onclick="setTopFilter('all')"   id="tpBtn-all"   class="vis-filter-btn"                  style="font-size:0.7rem;padding:0.25rem 0.6rem;">All</button>
          </div>
        </div>
        <div id="topPagesBody"><!-- filled by JS --></div>
      </div>
    </div>

    <!-- Recent Visits Table -->
    <div class="table-card" style="border-color:rgba(34,197,94,0.15);">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;flex-wrap:wrap;gap:0.5rem;">
        <h2 style="border:none;margin:0;padding:0;">🕐 Recent Visits</h2>
        <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;">
          <span id="rvDayLabel" style="display:none;font-size:0.72rem;color:#60a5fa;font-weight:700;background:rgba(96,165,250,0.12);border:1px solid rgba(96,165,250,0.3);border-radius:20px;padding:0.2rem 0.65rem;"></span>
          <div style="display:flex;gap:0.35rem;">
            <button onclick="setVisFilter('today')" id="rvBtn-today" class="vis-filter-btn vis-filter-active" style="font-size:0.7rem;padding:0.25rem 0.6rem;">Today</button>
            <button onclick="setVisFilter('week')"  id="rvBtn-week"  class="vis-filter-btn"                  style="font-size:0.7rem;padding:0.25rem 0.6rem;">Weekly</button>
            <button onclick="setVisFilter('month')" id="rvBtn-month" class="vis-filter-btn"                  style="font-size:0.7rem;padding:0.25rem 0.6rem;">Monthly</button>
            <button onclick="setVisFilter('year')"  id="rvBtn-year"  class="vis-filter-btn"                  style="font-size:0.7rem;padding:0.25rem 0.6rem;">Yearly</button>
            <button onclick="setVisFilter('all')"   id="rvBtn-all"   class="vis-filter-btn"                  style="font-size:0.7rem;padding:0.25rem 0.6rem;">All</button>
          </div>
        </div>
      </div>
      <% if (recentVisitors.length === 0) { %>
        <div style="padding:2rem;text-align:center;color:#555;">No visits recorded yet. Share your website link to get visitors!</div>
      <% } else { %>
      <div style="max-height:420px;overflow-y:auto;border-radius:8px;">
      <table class="games-table" style="width:100%;">
        <thead>
          <tr>
            <th>Page</th>
            <th>Date</th>
            <th>Time</th>
            <th>Session</th>
          </tr>
        </thead>
        <tbody id="recentVisitsBody">
          <% recentVisitors.forEach(v => { %>
          <tr data-date="<%= v.date %>">
            <td><span style="color:#22c55e;font-weight:600;"><%= v.page || v.path %></span></td>
            <td style="color:#aaa;font-size:0.8rem;"><%= v.date %></td>
            <td style="color:#aaa;font-size:0.8rem;"><%= v.time ? new Date(v.time).toLocaleTimeString('en-US', {hour:'2-digit',minute:'2-digit'}) : '' %></td>
            <td style="color:#555;font-size:0.75rem;font-family:monospace;"><%= v.session_id ? v.session_id.slice(0,12) : '—' %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      </div>
      <% } %>
    </div>

    <script>
    const VIS_WINDOWS = <%- JSON.stringify(VIS_WINDOWS).replace(/</g, '\\u003c') %>;

    // Every value below can originate from req.path (the visitor-tracking
    // middleware records whatever path a client requests, fully attacker
    // controlled), so anything user-influenced must be escaped before it is
    // concatenated into an innerHTML string.
    function escHtml(s) {
      return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    }

    function renderFunnel(win) {
      const body = document.getElementById('vfFunnelBody');
      const browsedEl = document.getElementById('vfBrowsedStat');
      if (!win || win.funnel[0].count === 0) {
        browsedEl.innerHTML = '';
        body.innerHTML = '<div class="vf-empty">No tracked sessions in this period.</div>';
        return;
      }
      const b = win.browsed;
      browsedEl.innerHTML = 'Browsed the catalog — <strong>' + b.count + '</strong> of <strong>' + b.total +
        '</strong> sessions <span class="vf-browsed-pct">' + (b.pct === null ? '—' : b.pct + '%') + '</span>';
      const top = win.funnel[0].count;
      body.innerHTML = win.funnel.map(stage => {
        const widthPct = top > 0 ? Math.max(2, Math.round((stage.count / top) * 100)) : 0;
        const pctHtml = stage.pctOfPrev === null ? '' : ' <span class="vf-pct">' + stage.pctOfPrev + '%</span>';
        return '<div class="vf-row">' +
          '<span class="vf-name">' + stage.label + '</span>' +
          '<div class="vf-bar-track"><div class="vf-bar-fill" style="width:' + widthPct + '%"></div></div>' +
          '<span class="vf-n"><strong>' + stage.count + '</strong>' + pctHtml + '</span>' +
          '</div>';
      }).join('');
    }

    function renderExitPages(win) {
      const body = document.getElementById('vfExitBody');
      if (!win || !win.exitPages.length) {
        body.innerHTML = '<div class="vf-empty">Nothing to show yet.</div>';
        return;
      }
      body.innerHTML = win.exitPages.map(ep =>
        '<div class="vf-exit-row">' +
          '<span class="vf-exit-path">' + escHtml(ep.path) + '</span>' +
          '<span class="vf-exit-n"><strong>' + ep.count + '</strong> session' + (ep.count !== 1 ? 's' : '') + '</span>' +
        '</div>'
      ).join('');
    }

    // Paints all three session-scoped panels from one window object, so they
    // can never end up describing different periods.
    function renderVisWindow(win) {
      renderFunnel(win);
      renderExitPages(win);
      renderTopPages(win && win.topPages ? win.topPages : []);
    }

    function setFunnelFilter(f) {
      setPeriodFilter(f);
    }

    function renderTopPages(pages) {
      const body = document.getElementById('topPagesBody');
      if (!pages || pages.length === 0) {
        body.innerHTML = '<div style="color:#555;font-size:0.85rem;">No visits for this period.</div>';
        return;
      }
      const maxCount = pages[0][1];
      body.innerHTML = pages.map(([page, count]) =>
        `<div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.6rem;">
          <div style="flex:1;font-size:0.82rem;color:#ccc;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${escHtml(page)}</div>
          <div style="font-size:0.75rem;color:#a78bfa;font-weight:700;">${count}</div>
          <div style="width:60px;height:6px;background:#1a1a1a;border-radius:3px;overflow:hidden;">
            <div style="height:100%;background:#a78bfa;border-radius:3px;width:${Math.round((count/maxCount)*100)}%;"></div>
          </div>
        </div>`
      ).join('');
    }

    function setTopFilter(f) {
      // Most Visited Pages and the funnel share one window, so selecting a
      // period on either row moves both.
      setFunnelFilter(f);
    }

    // Recent Visits filter
    const vTodayStr = '<%= new Date().toISOString().slice(0,10) %>';
    const vWeekAgo  = '<%= new Date(Date.now()-7*86400000).toISOString().slice(0,10) %>';
    const vMonthAgo = '<%= new Date(Date.now()-30*86400000).toISOString().slice(0,10) %>';
    const vYearAgo  = '<%= new Date(Date.now()-365*86400000).toISOString().slice(0,10) %>';
    // Kept so the day-drill-down (which replaces the table body with a fetched day's
    // full results) can restore the original server-rendered rows afterward.
    const ORIGINAL_TBODY_HTML = document.getElementById('recentVisitsBody') ? document.getElementById('recentVisitsBody').innerHTML : '';

    // Single source of truth for "select a period" (today/week/month/year/all),
    // reachable from any of the three button rows (vfBtn-*, tpBtn-*, rvBtn-*)
    // or from the 14-day chart's own period buttons. Every path that used to
    // paint only its "own half" of the tab now goes through here, so the
    // funnel, exit pages, top pages, and Recent Visits table — plus all three
    // button rows and both day labels — always agree on one period.
    function setPeriodFilter(f) {
      document.querySelectorAll('.vis-day-bar').forEach(bar => bar.classList.remove('vis-day-active'));
      document.getElementById('vfDayLabel').style.display = 'none';
      document.getElementById('rvDayLabel').style.display = 'none';
      ['today','week','month','year','all'].forEach(k => {
        document.getElementById('vfBtn-'+k).classList.toggle('vis-filter-active', k === f);
        document.getElementById('tpBtn-'+k).classList.toggle('vis-filter-active', k === f);
        document.getElementById('rvBtn-'+k).classList.toggle('vis-filter-active', k === f);
      });

      renderVisWindow(VIS_WINDOWS[f]);

      const tbody = document.getElementById('recentVisitsBody');
      if (tbody) tbody.innerHTML = ORIGINAL_TBODY_HTML;
      const rows = document.querySelectorAll('#recentVisitsBody tr');
      rows.forEach(row => {
        const d = row.dataset.date || '';
        let show = true;
        if (f === 'today') show = d === vTodayStr;
        else if (f === 'week')  show = d >= vWeekAgo;
        else if (f === 'month') show = d >= vMonthAgo;
        else if (f === 'year')  show = d >= vYearAgo;
        row.style.display = show ? '' : 'none';
      });
    }

    function setVisFilter(f) {
      setPeriodFilter(f);
    }

    setPeriodFilter('today');

    // Clicking a bar in the 14-day chart fetches that day's full visit list (the
    // server-rendered table only has the 100 most recent rows overall, which may not
    // include an older day at all once daily traffic exceeds that).
    function filterVisitsByDate(date, label) {
      document.querySelectorAll('.vis-filter-btn').forEach(b => b.classList.remove('vis-filter-active'));
      document.querySelectorAll('.vis-day-bar').forEach(bar => bar.classList.toggle('vis-day-active', bar.dataset.date === date));

      // The three session-scoped panels have this date precomputed; only the
      // Recent Visits table needs a fetch, because the server-rendered table
      // holds just the 100 most recent rows overall and may not contain an
      // older day at all.
      renderVisWindow(VIS_WINDOWS.byDate[date]);
      const vfLabel = document.getElementById('vfDayLabel');
      vfLabel.textContent = '📅 ' + label;
      vfLabel.style.display = '';

      const dayLabel = document.getElementById('rvDayLabel');
      dayLabel.textContent = '📅 ' + label + ' — click a filter button above to clear';
      dayLabel.style.display = '';
      const tbody = document.getElementById('recentVisitsBody');
      tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;color:#555;padding:1.5rem;">Loading…</td></tr>';
      fetch('/admin/api/visitors-by-date?date=' + encodeURIComponent(date))
        .then(r => r.json())
        .then(rows => {
          if (!rows.length) {
            tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;color:#555;padding:1.5rem;">No visits on ' + label + '.</td></tr>';
            return;
          }
          tbody.innerHTML = rows.map(v => `<tr data-date="${escHtml(v.date)}">
            <td><span style="color:#22c55e;font-weight:600;">${escHtml(v.page || v.path)}</span></td>
            <td style="color:#aaa;font-size:0.8rem;">${escHtml(v.date)}</td>
            <td style="color:#aaa;font-size:0.8rem;">${v.time ? escHtml(new Date(v.time).toLocaleTimeString('en-US', {hour:'2-digit',minute:'2-digit'})) : ''}</td>
            <td style="color:#555;font-size:0.75rem;font-family:monospace;">${v.session_id ? escHtml(v.session_id.slice(0,12)) : '—'}</td>
          </tr>`).join('');
        })
        .catch(() => { tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;color:#ef4444;padding:1.5rem;">Failed to load visits.</td></tr>'; });
    }
    </script>
  </div><!-- /tab-visitors -->
