<%# Quick Add — one popup that records the customer AND the order together.
    Included by both the Customers and Orders tabs; one component so the two
    can never drift into different forms again, which is how this job ended up
    split across two half-forms in the first place. %>

<%# The Trophy deposit rides on the element rather than being written into
    the script below. Keeping template tags out of that block is what lets
    the tests parse and execute it: the inline-script gate skips any block
    containing them, and this form is exactly the one that needs covering. %>
<div class="qa-overlay" id="qaOverlay" data-res-deposit="<%= typeof qaResDeposit !== 'undefined' ? (Number(qaResDeposit) || 0) : 0 %>" onclick="if(event.target===this)qaClose()">
  <div class="qa-box" role="dialog" aria-modal="true" aria-labelledby="qaTitle">

    <div class="qa-head">
      <span id="qaIcon">⚡</span>
      <span class="qa-title" id="qaTitle">Quick Add — customer &amp; order</span>
      <button type="button" class="qa-x" onclick="qaClose()" aria-label="Close">✕</button>
    </div>

    <!-- ── FORM ── -->
    <form class="qa-body" id="qaForm" data-no-loading="1">
      <div class="qa-err" id="qaErr" hidden></div>

      <div class="qa-l">Customer</div>
      <input class="qa-in" type="text" name="customer_name" id="qaName" placeholder="Facebook name — e.g. Ana Cruz" required autocomplete="off">

      <%# Status was buried in "More options", but it decides everything now:
          rental pricing vs buy pricing, whether there is a duration at all,
          whether an end date exists, and which message you get to copy. A
          control that load-bearing does not belong behind a disclosure. %>
      <div class="qa-l">What this is</div>
      <div class="qa-modes" id="qaModes">
        <input type="radio" name="status" id="qaStRent" value="renting" checked onchange="qaStatusChanged()">
        <label for="qaStRent" class="qa-mode">🟢 Renting</label>
        <input type="radio" name="status" id="qaStBought" value="bought" onchange="qaStatusChanged()">
        <label for="qaStBought" class="qa-mode">🛒 Bought</label>
        <input type="radio" name="status" id="qaStDone" value="done" onchange="qaStatusChanged()">
        <label for="qaStDone" class="qa-mode">✅ Finished</label>
      </div>

      <div class="qa-l">What they're getting</div>
      <div class="qa-g3">
        <select class="qa-in" name="game_id" id="qaGame" onchange="qaGameChanged()" required>
          <option value="">— Game —</option>
          <%# Prices come from qaGames, not the raw game records: they have the
              running promo already taken off, the same way the save path
              prices them. Reading the raw tier fields here is what made this
              form preview ₱349 and then save ₱314. %>
          <% (qaGames || []).forEach(g => { %>
          <option value="<%= g.id %>"
            data-nt7="<%= g.nt7 %>" data-nt30="<%= g.nt30 %>"
            data-tr7="<%= g.tr7 %>" data-tr30="<%= g.tr30 %>"
            data-buynt="<%= g.buynt %>" data-buytr="<%= g.buytr %>"
            data-nt7f="<%= g.nt7f %>" data-nt30f="<%= g.nt30f %>"
            data-tr7f="<%= g.tr7f %>" data-tr30f="<%= g.tr30f %>"
            data-buyntf="<%= g.buyntf %>" data-buytrf="<%= g.buytrf %>"><%= g.title %></option>
          <% }) %>
          <%# Coming Soon games carry data-upcoming, which switches the form
              over: Renting becomes Reserve (a rental slot, paid in full now)
              and Bought becomes Pre-order (permanent, also paid in full).
              Their rent tiers are the real list prices, which is what a
              reservation is quoted from. %>
          <% if ((typeof qaUpcoming !== 'undefined' ? qaUpcoming : []).length) { %>
          <optgroup label="Coming soon — reserve or pre-order">
            <% qaUpcoming.forEach(g => { %>
            <option value="<%= g.id %>" data-upcoming="1" data-release="<%= g.release_date %>"
              data-nt7="<%= g.nt7 %>" data-nt30="<%= g.nt30 %>" data-tr7="<%= g.tr7 %>" data-tr30="<%= g.tr30 %>"
              data-buynt="<%= g.buynt %>" data-buytr="<%= g.buytr %>"><%= g.title %></option>
            <% }) %>
          </optgroup>
          <% } %>
        </select>
        <select class="qa-in" name="account_type" id="qaType" onchange="qaPrice()">
          <option value="nt">🎮 Non-Trophy</option>
          <option value="tr">🏆 Trophy</option>
          <option value="ps4">🕹️ PS4 Primary</option>
        </select>
        <select class="qa-in" name="days" id="qaDays" onchange="qaDaysChanged()">
          <option value="7">Weekly (7d)</option>
          <option value="30" selected>Monthly (30d)</option>
          <option value="custom">✏️ Custom…</option>
        </select>
        <%# Hidden for a purchase — there is no duration to enter. Disabled too,
            so a hidden control cannot still post a value. %>
        <div class="qa-nodur" id="qaNoDuration" hidden>Yours to keep</div>
      </div>
      <input class="qa-in" type="number" name="custom_days" id="qaCustomDays" min="1" max="365" placeholder="How many days?" hidden oninput="qaEnd(); qaPrice()" style="margin-top:0.45rem;">
      <div class="qa-warn" id="qaUpcomingNote" hidden></div>
      <%# Hidden for a Coming Soon pick: reservations/pre-orders are always
          quoted off the undiscounted list price (lib/reservations never
          applies a promo), so the toggle would have nothing to switch. %>
      <div class="qa-modes qa-pricing-modes" id="qaPricingModes">
        <input type="radio" name="pricing_mode" id="qaPriceModePromo" value="promo" checked onchange="qaPrice()">
        <label for="qaPriceModePromo" class="qa-mode">🏷️ Promo price</label>
        <input type="radio" name="pricing_mode" id="qaPriceModeFull" value="full" onchange="qaPrice()">
        <label for="qaPriceModeFull" class="qa-mode">Full price</label>
      </div>
      <div class="qa-price" id="qaPriceBox">Pick a game to see the price</div>

      <div class="qa-l">Account slot</div>
      <select class="qa-in" name="account_assign" id="qaSlot">
        <option value="">— None —</option>
        <% const QA_SLOT = { trophy:'🏆 Trophy', non_trophy:'🎮 Non-Trophy', ps4_primary:'🕹️ PS4 Primary' }; %>
        <% (accounts || []).forEach(a => { ['trophy','non_trophy','ps4_primary'].forEach(t => {
             const sl = a.slots && a.slots[t];
             if (sl && sl.enabled && sl.status === 'open') { %>
          <option value="<%= a.id %>:<%= t %>"><%= a.label %> — <%= QA_SLOT[t] %></option>
        <% } }) }) %>
      </select>
      <%# When nothing is free, the guard below would demand a choice that does
          not exist. Say so up front, with the way out, rather than letting the
          owner submit into a wall. %>
      <% const qaOpenSlots = (accounts || []).reduce((n, a) => n + ['trophy','non_trophy','ps4_primary']
           .filter(t => a.slots && a.slots[t] && a.slots[t].enabled && a.slots[t].status === 'open').length, 0); %>
      <% if (!qaOpenSlots) { %>
      <div class="qa-warn">
        No account slot is free right now. Free one in <a href="#" onclick="qaClose();switchTab('accounts');return false;">Accounts</a>
        first — recording a rental against no slot is what leaves it showing as available to the next customer.
      </div>
      <% } else { %>
      <div class="qa-hint">Leave blank only for a game whose slots aren't tracked by an account.</div>
      <% } %>

      <div class="qa-l">Paid already?</div>
      <div class="qa-radios">
        <label class="qa-radio qa-on" id="qaPaidYes">
          <input type="radio" name="paid" value="yes" checked onchange="qaPaidChanged()"> ✅ Yes
        </label>
        <label class="qa-radio" id="qaPaidNo">
          <input type="radio" name="paid" value="no" onchange="qaPaidChanged()"> Not yet
        </label>
        <select class="qa-in" name="method" id="qaMethod" style="flex:1;">
          <% (((settings.payment_methods)||[]).filter(m => m.enabled)).forEach(m => { %>
          <option value="<%= m.key %>"><%= m.label %></option>
          <% }) %>
          <option value="manual">Other / cash</option>
        </select>
      </div>

      <div class="qa-l">Dates</div>
      <div class="qa-g2">
        <label class="qa-sub">Starts
          <input class="qa-in" type="date" name="start_date" id="qaStart" onchange="qaEnd()">
        </label>
        <label class="qa-sub" id="qaEndWrap">Ends <span id="qaEndAuto">(auto)</span>
          <input class="qa-in" type="date" name="end_date" id="qaEndDate">
        </label>
      </div>

      <%# The five fields the full Customers form had that the common path does
          not need. Demoted, not dropped: the day a completed rental or a
          hand-agreed price needs recording, it still has somewhere to go. %>
      <details class="qa-more">
        <summary>More options</summary>
        <%# Status now lives at the top of the form — it decides pricing, the
            duration, the dates and the message, so it is not an extra option. %>
        <label class="qa-sub">Price override (₱)
          <input class="qa-in" type="number" name="price" id="qaPriceOverride" min="0" placeholder="auto" oninput="qaPrice()">
        </label>
        <%# Decides what the order link shows. Signed in already means the page
            confirms the rental and asks how it went; "not yet" leaves it asking
            for a sign-in code, which is what every Quick Add used to do. %>
        <label class="qa-sub" style="margin-top:0.55rem;display:flex;align-items:center;gap:0.5rem;cursor:pointer;">
          <input type="checkbox" name="signed_in_box" id="qaSignedIn" checked
                 onchange="document.getElementById('qaSignedInVal').value = this.checked ? 'yes' : 'no';"
                 style="width:auto;margin:0;">
          <span>Already signed in to their console</span>
        </label>
        <input type="hidden" name="signed_in" id="qaSignedInVal" value="yes">

        <label class="qa-sub" style="margin-top:0.55rem;">Notes
          <input class="qa-in" type="text" name="notes" placeholder="e.g. paid via GCash, follow up Friday">
        </label>
      </details>

      <input type="hidden" name="mode" id="qaMode" value="rent">
    </form>

    <div class="qa-foot" id="qaFootForm">
      <span class="qa-grow"></span>
      <button type="button" class="qa-btn qa-ghost" onclick="qaClose()">Cancel</button>
      <button type="button" class="qa-btn qa-gold" id="qaSubmit" onclick="qaSubmit()">Create + get message</button>
    </div>

    <!-- ── SUCCESS ── -->
    <div class="qa-body" id="qaDone" hidden>
      <div class="qa-ok">
        <span class="qa-ok-tick">✅</span>
        <div>
          <div class="qa-ok-ref" id="qaOkRef"></div>
          <div class="qa-ok-sub" id="qaOkSub"></div>
        </div>
      </div>
      <div class="qa-chips" id="qaChips"></div>
      <div class="qa-l">Message to send</div>
      <div class="qa-msg" id="qaMsg"></div>
    </div>

    <div class="qa-foot" id="qaFootDone" hidden>
      <button type="button" class="qa-btn qa-gold" id="qaCopyMsg" onclick="qaCopy('msg', this)">📋 Copy message</button>
      <button type="button" class="qa-btn qa-ghost" onclick="qaCopy('url', this)">Copy order link</button>
      <span class="qa-grow"></span>
      <button type="button" class="qa-btn qa-ghost" onclick="qaReset()">Add another</button>
      <button type="button" class="qa-btn qa-ghost" onclick="qaDoneClose()">Done</button>
    </div>

  </div>
</div>

<%# The .qa-* modal-shell CSS this component depends on now lives in
    public/css/style.css — shared with views/partials/admin/extend.ejs, which
    needs the exact same rules on a page that doesn't otherwise include this
    partial. See the comment there for why. %>

<script>
(function () {
  var last = { msg: '', url: '' };

  function el(id) { return document.getElementById(id); }

  window.qaOpen = function () {
    el('qaOverlay').classList.add('open');
    qaReset();
    setTimeout(function () { el('qaName').focus(); }, 50);
  };
  window.qaClose = function () { el('qaOverlay').classList.remove('open'); };
  // After a successful add the tables behind the popup are stale, so closing
  // from the success screen reloads rather than leaving old numbers on screen.
  window.qaDoneClose = function () { window.location.reload(); };

  window.qaReset = function () {
    el('qaForm').reset();
    el('qaForm').hidden = false;
    el('qaFootForm').hidden = false;
    el('qaDone').hidden = true;
    el('qaFootDone').hidden = true;
    el('qaErr').hidden = true;
    el('qaIcon').textContent = '⚡';
    el('qaTitle').textContent = 'Quick Add — customer & order';
    el('qaCustomDays').hidden = true;
    el('qaStart').value = new Date().toISOString().slice(0, 10);
    el('qaStRent').disabled = false;
    el('qaStDone').disabled = false;
    el('qaUpcomingNote').hidden = true;
    qaPaidChanged(); qaStatusChanged();
  };

  // Is this a sale? One question the rest of the form hangs off.
  function qaIsBuy() {
    var b = el('qaStBought');
    return !!(b && b.checked);
  }

  // Is the selected game one that has not released? A reservation and a
  // pre-order both hang off this: neither has dates, whatever the status says.
  function qaIsUpcoming() {
    var opt = el('qaGame').selectedOptions[0];
    return !!(opt && opt.dataset && opt.dataset.upcoming);
  }

  // Status decides the shape of the form: a purchase has no duration, no end
  // date, and is priced from the buy fields rather than the rental tiers.
  // Everything that used to assume "rental" asks this first.
  // Picking a game decides more than the price when it is a Coming Soon one:
  // an unreleased game has no account to sign into, so it can only be a
  // pre-order. Renting and Finished are switched off rather than silently
  // ignored, and the server refuses the combination too — this half is so the
  // owner is never offered a choice that will bounce.
  // A Coming Soon game can be reserved two ways, which is what the site sells:
  // Renting holds a rental slot, paid in full now; Bought is a permanent
  // pre-order, also paid in full. Neither has dates, and neither has an
  // account to sign into yet. Only "Finished" is meaningless for a game
  // nobody can have played.
  window.qaGameChanged = function () {
    var opt = el('qaGame').selectedOptions[0];
    var upcoming = !!(opt && opt.dataset && opt.dataset.upcoming);

    // Renting stays available on an unreleased game — it means "reserve" —
    // so the labels say which of the two things each button now records.
    el('qaStDone').disabled = upcoming;
    var rentLabel = document.querySelector('label[for="qaStRent"]');
    var buyLabel = document.querySelector('label[for="qaStBought"]');
    if (rentLabel) rentLabel.textContent = upcoming ? '🔖 Reserve' : '🟢 Renting';
    if (buyLabel) buyLabel.textContent = upcoming ? '🛒 Pre-order' : '🛒 Bought';

    var note = el('qaUpcomingNote');
    if (upcoming) {
      var when = (opt.dataset.release || '').trim();
      note.textContent = 'Not released yet. Reserve holds a rental slot; Pre-order is permanent access.'
        + ' Both are paid in full now, and either way there are no dates and no account to sign into'
        + (when ? ' until it launches on ' + when + '.' : ' until it launches.');
      note.hidden = false;
    } else {
      note.hidden = true;
    }

    // A reservation is always quoted at list price — lib/reservations never
    // applies a promo — so the toggle has nothing to do on a Coming Soon
    // pick. Reset it back to Promo (the default) rather than leaving "Full
    // price" checked and silently carrying over to the next game picked.
    el('qaPricingModes').hidden = upcoming;
    if (upcoming) el('qaPriceModePromo').checked = true;

    // Only "Finished" has to be moved off, and only when it was the choice.
    if (upcoming && el('qaStDone').checked) {
      el('qaStBought').checked = true;
      qaStatusChanged();
      return;
    }
    // A reservation has no dates either, so the form still needs re-shaping
    // when Renting is what is selected on an unreleased game.
    qaStatusChanged();
  };

  window.qaStatusChanged = function () {
    var buy = qaIsBuy();
    var upcoming = qaIsUpcoming();
    el('qaMode').value = buy ? 'buy' : 'rent';

    // Hidden AND disabled: a hidden select still posts its value, and a stale
    // "30" reaching the server is how a purchase got a duration in the first
    // place. The server ignores days for a buy anyway — this is the second lock.
    //
    // A reservation KEEPS its duration: the customer is reserving a weekly or
    // a monthly slot, and that is half of what they are paying for. Only a
    // purchase has nothing to pick.
    el('qaDays').hidden = buy;
    el('qaDays').disabled = buy;
    el('qaNoDuration').hidden = !buy;
    if (buy) { el('qaCustomDays').hidden = true; el('qaCustomDays').disabled = true; }
    else { el('qaCustomDays').disabled = false; qaDaysChanged(); }

    // Dates are the part a reservation shares with a purchase: the game does
    // not exist yet, so there is nothing to start or return. An order carrying
    // an end_date is what advanceEndedRentals sweeps into "awaiting return".
    var noDates = buy || upcoming;
    el('qaEndWrap').hidden = noDates;
    el('qaEndDate').disabled = noDates;
    if (noDates) el('qaEndDate').value = '';

    qaEnd();
    qaPrice();
  };

  window.qaDaysChanged = function () {
    var custom = el('qaDays').value === 'custom';
    el('qaCustomDays').hidden = !custom;
    if (custom) el('qaCustomDays').focus();
    qaEnd(); qaPrice();
  };

  function daysValue() {
    if (el('qaDays').value === 'custom') return parseInt(el('qaCustomDays').value) || 0;
    return parseInt(el('qaDays').value) || 0;
  }

  // End date always follows start + duration, and every control that can change
  // either one has to call this. The custom-days box did not: it updated the
  // price for the new duration and left the end date on the previous one, so a
  // 10-day rental was saved with a 30-day return date and the copied message
  // told the customer the wrong day to give the account back.
  window.qaEnd = function () {
    if (qaIsBuy() || qaIsUpcoming()) { el('qaEndDate').value = ''; return; }
    var start = el('qaStart').value, d = daysValue();
    if (!start || d < 1) return;
    var end = new Date(Date.parse(start + 'T00:00:00Z') + d * 86400000).toISOString().slice(0, 10);
    el('qaEndDate').value = end;
  };

  window.qaPaidChanged = function () {
    var yes = document.querySelector('input[name=paid]:checked').value === 'yes';
    el('qaPaidYes').classList.toggle('qa-on', yes);
    el('qaPaidNo').classList.toggle('qa-on', !yes);
    el('qaMethod').style.display = yes ? '' : 'none';
  };

  // The client half of lib/rent-pricing.js — same curve, same rounding:
  //   d < 7        pro-rata at the weekly rate
  //   7 < d < 30   straight line between the weekly and monthly price
  //   d > 30       pro-rata at the monthly rate
  // Standard durations charge their tier exactly.
  // The deposit the server would charge on a Trophy reservation. Read off the
  // modal rather than guessed: the browser has no access to promo settings,
  // and a quote without it would be short by the deposit.
  function qaResDepositValue() {
    var root = el('qaOverlay');
    return (root && Number(root.dataset.resDeposit)) || 0;
  }

  // A reservation is quoted off the upcoming game's own list price for the
  // chosen duration — no interpolation, because only 7 and 30 are offered.
  function qaResBase(d, p7, p30) {
    return d === 7 ? p7 : d === 30 ? p30 : 0;
  }

  // Mirrors lib/reservations.preorderPricing: deposit on Trophy only, paid in
  // full now — nothing owed on release.
  function qaReservation(base, type) {
    var b = Number(base) || 0;
    if (b <= 0) return { total: 0, amountDue: 0, remainingDue: 0 };
    var deposit = type === 'tr' ? qaResDepositValue() : 0;
    var total = b + deposit;
    return { total: total, amountDue: total, remainingDue: 0 };
  }

  function qaAmountForDays(d, p7, p30) {
    if (!d || d < 1 || d !== Math.floor(d)) return 0;
    if (!p7 && !p30) return 0;
    if (d === 7 && p7) return p7;
    if (d === 30 && p30) return p30;
    if (!p30) return Math.round(p7 * d / 7);
    if (!p7) return Math.round(p30 * d / 30);
    if (d < 7) return Math.round(p7 * d / 7);
    if (d > 30) return Math.round(p30 * d / 30);
    return Math.round(p7 + (p30 - p7) * (d - 7) / 23);
  }

  // Mirrors the server's pricing so the number on screen is the number saved.
  // The server still recomputes it — this is a preview, not the source.
  window.qaPrice = function () {
    var box = el('qaPriceBox');
    var opt = el('qaGame').selectedOptions[0];
    var override = el('qaPriceOverride').value;
    if (!opt || !opt.value) {
      box.className = 'qa-price qa-price-empty';
      box.textContent = 'Pick a game to see the price';
      return;
    }
    var type = el('qaType').value, d = daysValue();
    var pre = type === 'tr' ? 'tr' : 'nt';
    // "Full price" reads the "f"-suffixed dataset (undiscounted) instead of
    // the promo'd one — same fields the server computes with the promo's
    // enabled flags switched off, so this preview cannot drift from the save.
    // Not applicable to a reservation: lib/reservations never applies a
    // promo either way, so that branch below always reads the plain fields.
    var full = !qaIsUpcoming() && document.querySelector('input[name=pricing_mode]:checked').value === 'full';
    var suf = full ? 'f' : '';

    // A sale is priced from the buy fields, not the rental tiers. PS4 Primary
    // has no buy price of its own and borrows Non-Trophy, same as the server.
    if (qaIsBuy()) {
      var buy = parseInt(opt.dataset[(pre === 'tr' ? 'buytr' : 'buynt') + suf]) || 0;
      var amt = override !== '' ? (parseInt(override) || 0) : buy;
      if (!amt) {
        box.className = 'qa-price qa-price-empty';
        box.textContent = 'No buy price set for this game — type the amount in Price override (under More options).';
        return;
      }
      box.className = 'qa-price';
      box.innerHTML = '<b>₱' + amt.toLocaleString() + '</b> purchase'
        + (override !== '' ? ' <span style="color:#888;">(your override)</span>' : (full ? ' <span style="color:#7a7a7a;">(full price)</span>' : ''))
        + ' <span style="color:#7a7a7a;">· no deposit, no return date</span>';
      return;
    }

    var p7 = parseInt(opt.dataset[pre + '7' + suf]) || 0;
    var p30 = parseInt(opt.dataset[pre + '30' + suf]) || 0;

    // A reservation on a game that has not released: the list price plus the
    // deposit, paid in full now — nothing owed on launch day. Mirrors
    // lib/reservations.preorderPricing exactly, and scripts/test-reservations.js
    // pulls this arithmetic out of the template and runs it against that module
    // so the quote on screen cannot drift from the one that gets saved.
    if (qaIsUpcoming()) {
      var resBase = qaResBase(d, p7, p30);
      if (!resBase && override === '') {
        box.className = 'qa-price qa-price-empty';
        box.textContent = 'No ' + (d === 7 ? 'weekly' : 'monthly') + ' price set for this type on that game — type the amount in Price override.';
        return;
      }
      var res = qaReservation(resBase, type);
      var paid = override !== '' ? (parseInt(override) || 0) : res.amountDue;
      box.className = 'qa-price';
      box.innerHTML = '<b>₱' + paid.toLocaleString() + '</b> reservation'
        + (override !== '' ? ' <span style="color:#888;">(your override)</span>' : '')
        + ' <span style="color:#7a7a7a;">· paid in full, nothing due on release</span>';
      return;
    }

    // Mirrors lib/rent-pricing.js exactly. It used to pro-rate everything under
    // 30 days at the WEEKLY rate and claim the server matched — the server
    // rejected the save outright, so the form promised a price it could not
    // honour, and 29 days quoted higher than 30. Keep these two in step.
    var base = qaAmountForDays(d, p7, p30);
    var amount = override !== '' ? (parseInt(override) || 0) : base;
    if (!amount) {
      box.className = 'qa-price qa-price-empty';
      box.textContent = 'No price set for this type and duration — set one in Games, or use a price override.';
      return;
    }
    box.className = 'qa-price';
    // The deposit comes from promo settings the browser does not have, so this
    // shows the rent only and says so, rather than printing a total it cannot know.
    // Say when the number was derived rather than set, so a custom-duration
    // quote is not mistaken for a price on the Games page.
    var derived = override === '' && d !== 7 && d !== 30
      ? ' <span style="color:#7a7a7a;">· worked out for ' + d + ' day' + (d === 1 ? '' : 's') + '</span>' : '';
    var fullTag = full ? ' <span style="color:#7a7a7a;">(full price)</span>' : '';
    box.innerHTML = '<b>₱' + amount.toLocaleString() + '</b> rent'
      + (override !== '' ? ' <span style="color:#888;">(your override)</span>' : derived + fullTag)
      + ' <span style="color:#7a7a7a;">· any deposit is added when it saves</span>';
  };

  window.qaSubmit = function () {
    var btn = el('qaSubmit'), err = el('qaErr');
    err.hidden = true;
    btn.disabled = true;
    var original = btn.textContent;
    btn.textContent = '… saving';
    fetch('/admin/quick-add', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams(new FormData(el('qaForm')))
    })
      .then(function (r) { return r.json().then(function (body) { return { ok: r.ok, body: body }; }); })
      .then(function (res) {
        btn.disabled = false;
        btn.textContent = original;
        if (!res.ok || !res.body.ok) {
          err.textContent = '⚠ ' + (res.body && res.body.message ? res.body.message : 'Could not save that — try again.');
          err.hidden = false;
          el('qaBoxScroll') || el('qaForm').scrollIntoView({ block: 'start' });
          return;
        }
        last.msg = res.body.message || '';
        last.url = res.body.url || '';
        el('qaForm').hidden = true;
        el('qaFootForm').hidden = true;
        el('qaDone').hidden = false;
        el('qaFootDone').hidden = false;
        el('qaIcon').textContent = '✅';
        el('qaTitle').textContent = 'Added';
        el('qaOkRef').textContent = res.body.ref + ' created';
        el('qaOkSub').textContent = res.body.summary || '';
        el('qaMsg').textContent = last.msg;
        el('qaChips').innerHTML = '<span>customer record ✓</span><span>order ✓</span>'
          + (res.body.paid ? '<span>marked paid ✓</span>' : '<span>awaiting payment</span>');
      })
      .catch(function () {
        btn.disabled = false;
        btn.textContent = original;
        err.textContent = '⚠ Something went wrong — try again.';
        err.hidden = false;
      });
  };

  window.qaCopy = function (which, btn) {
    var text = which === 'msg' ? last.msg : last.url;
    if (!text) return;
    var was = btn.textContent;
    var flash = function (label) {
      btn.textContent = label;
      setTimeout(function () { btn.textContent = was; }, 1600);
    };
    var done = function () { flash('✓ Copied'); };
    var failed = function () { flash('⚠ Select and copy manually'); };
    // A hidden textarea, used both as the fallback and when the clipboard API
    // rejects. Over plain http the API exists but refuses, so a bare
    // .then(done, noop) would copy nothing and say nothing — the worst outcome,
    // because you would paste the previous thing into a customer's chat.
    function legacyCopy() {
      var ta = document.createElement('textarea');
      ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
      document.body.appendChild(ta); ta.select();
      var ok = false;
      try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
      document.body.removeChild(ta);
      if (ok) done(); else failed();
    }
    if (navigator.clipboard && window.isSecureContext) {
      navigator.clipboard.writeText(text).then(done, legacyCopy);
      return;
    }
    legacyCopy();
  };

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && el('qaOverlay').classList.contains('open')) qaClose();
  });
})();
</script>
