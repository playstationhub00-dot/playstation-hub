<%#
  Settings → Announcements. One entry can feed the top bar, the What's New
  bell, and the homepage banner. The Loyalty promo row stays bound to
  Loyalty → Promos until someone types their own words.
%>
<%
  const annRows = (announcements || []).slice().sort(function (a, b) {
    return ((a.sort || 0) - (b.sort || 0)) || ((a.id || 0) - (b.id || 0));
  });
  const annNow = (typeof announcementNow !== 'undefined' && announcementNow) ? announcementNow : '';
  const liveOffer = (typeof liveBanner !== 'undefined' && liveBanner && liveBanner.title) ? liveBanner : null;
  function annOn(a) { return a.enabled !== undefined ? a.enabled !== false : a.active !== false; }
  function annStatus(a) {
    if (!annOn(a)) return 'Off';
    if (a.starts_at && annNow && a.starts_at > annNow) return 'Scheduled';
    if (a.ends_at && annNow && a.ends_at <= annNow) return 'Ended';
    return 'Live';
  }
%>
<div class="adm-card" id="sec-announcements">
  <div class="adm-card-head" style="border-left:3px solid #f0a500;">
    <div class="sa-left">
      <div class="sa-icon" style="background:rgba(240,165,0,0.15);">📣</div>
      <div>
        <div class="sa-title">Announcements</div>
        <div class="sa-desc">Top bar, the What's New bell, and a homepage banner. One entry can feed any of them.</div>
      </div>
    </div>
  </div>
  <div class="adm-card-body">
    <p class="set-lead">
      Times are Philippines time. An entry hides itself at the end time. The bar shows the three highest-priority messages.
      The promo code from Themes shares that same bar, so it does not sit on top of it.
      Leave the Loyalty row's title and text blank and it keeps showing whatever is live under Loyalty → Promos.
    </p>

    <% if (!annRows.length) { %>
    <p class="set-hint">No announcements yet.</p>
    <% } %>

    <% annRows.forEach(function (ann, index) {
      const on = annOn(ann);
      const bound = ann.bind === 'promo-banner';
    %>
    <div class="ann-card">
      <div class="ann-card-h">
        <strong><%= ann.title || ann.text || (bound ? 'Loyalty promo' : 'Untitled') %></strong>
        <span class="ann-status" style="background:<%= annStatus(ann) === 'Live' ? '#22c55e' : (annStatus(ann) === 'Off' || annStatus(ann) === 'Ended' ? '#555' : '#f0a500') %>;"><%= annStatus(ann) %></span>
        <% if (bound) { %><span class="ann-bound">Follows Loyalty → Promos</span><% } %>
        <% if (ann.place_bar) { %><span class="ann-place">Bar</span><% } %>
        <% if (ann.place_bell) { %><span class="ann-place">Bell<% if (ann.bell_pin) { %> · pinned<% } %></span><% } %>
        <% if (ann.place_banner) { %><span class="ann-place">Banner</span><% } %>
        <span class="ann-move">
          <% if (index > 0) { %>
          <form method="POST" action="/admin/announcements/move" style="display:inline;">
            <input type="hidden" name="id" value="<%= ann.id %>">
            <input type="hidden" name="dir" value="up">
            <button type="submit" class="btn btn-outline" style="padding:0.25rem 0.55rem;font-size:0.75rem;" aria-label="Move up">Up</button>
          </form>
          <% } %>
          <% if (index < annRows.length - 1) { %>
          <form method="POST" action="/admin/announcements/move" style="display:inline;">
            <input type="hidden" name="id" value="<%= ann.id %>">
            <input type="hidden" name="dir" value="down">
            <button type="submit" class="btn btn-outline" style="padding:0.25rem 0.55rem;font-size:0.75rem;" aria-label="Move down">Down</button>
          </form>
          <% } %>
        </span>
      </div>

      <form method="POST" action="/admin/announcements/save" enctype="multipart/form-data">
        <input type="hidden" name="id" value="<%= ann.id %>">
        <%- include('announcement-fields', { ann: ann }) %>
        <div class="form-actions ann-save-row">
          <button type="submit" class="btn btn-primary">Save</button>
        </div>
      </form>

      <div class="ann-admin-preview">
        <div class="ann-preview-label">Preview</div>
        <% if (ann.place_bar || bound) { %>
        <div class="announcement-bar" style="position:relative;border-radius:8px;margin-bottom:0.45rem;">
          <span class="ann-bar-copy">
            <% if (ann.label) { %><span class="ann-bar-chip"><%= ann.label %></span><% } %>
            <% if (bound && !ann.title && !ann.text) { %>
              <strong><%= liveOffer ? liveOffer.title : 'Live promo' %></strong><% if (liveOffer && liveOffer.text) { %> — <%= liveOffer.text %><% } %>
            <% } else { %>
              <% if (ann.title) { %><strong><%= ann.title %></strong><% } %><% if (ann.title && ann.text) { %> — <% } %><%= ann.text %>
            <% } %>
          </span>
          <% if (ann.button_url || bound) { %><span class="ann-bar-more" style="text-decoration:underline;font-weight:800;"><%= ann.button_label || 'Learn more' %></span><% } %>
        </div>
        <% } %>
        <% if (ann.place_banner && (ann.image || ann.title || ann.text)) { %>
        <div class="ann-banner" style="padding:0;">
          <div class="ann-banner-slide on" style="min-height:140px;">
            <% if (ann.image) { %><div class="ann-banner-media" style="min-height:140px;"><img src="<%= ann.image %>" alt=""></div><% } %>
            <div class="ann-banner-copy" style="padding:16px;">
              <% if (ann.label) { %><span class="ann-banner-label"><%= ann.label %></span><% } %>
              <% if (ann.title) { %><div class="ann-banner-title" style="font-size:1.25rem;"><%= ann.title %></div><% } %>
              <% if (ann.text) { %><p class="ann-banner-text"><%= ann.text %></p><% } %>
            </div>
          </div>
        </div>
        <% } %>
      </div>

      <div class="ann-remove">
        <div>
          <strong>Delete this announcement</strong>
          <p class="set-hint">Separate from Save. It asks before the announcement comes off the site.</p>
        </div>
        <form method="POST" action="/admin/announcements/delete/<%= ann.id %>" data-confirm-title="Delete this announcement?" data-confirm-body="It comes off the top bar, the What's New bell, and the homepage banner. This cannot be undone." data-confirm-ok="Delete announcement">
          <button type="submit" class="adm-btn adm-btn-danger">Delete</button>
        </form>
      </div>
    </div>
    <% }) %>

    <div class="ann-new">
      <div class="ann-new-title">New announcement</div>
      <form method="POST" action="/admin/announcements/save" enctype="multipart/form-data">
        <%- include('announcement-fields', { ann: null }) %>
        <div class="form-actions ann-save-row">
          <button type="submit" class="btn btn-primary">Add announcement</button>
        </div>
      </form>
    </div>
  </div>
</div>
