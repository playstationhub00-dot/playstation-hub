      <!-- Stats bar -->
      <%
        const doneC = customers.filter(c => c.status === 'done');
        const uniqueNames = [...new Set(doneC.map(c => c.customer_name))];
        const blastToday = new Date(); blastToday.setHours(0,0,0,0);
        const blastData = uniqueNames.map(name => {
          const records = doneC.filter(c => c.customer_name === name);
          const lastRecord = records[records.length - 1];
          const lastGame = lastRecord?.game_title || '';
          const totalRentals = records.length;
          // end_date is the meaningful "last active" date; a record missing it
          // (never happens for a normal rental, but Excel-imported rows can be
          // incomplete) falls back to start_date rather than being untimed.
          const lastDateStr = lastRecord?.end_date || lastRecord?.start_date || null;
          const daysSinceLastRental = lastDateStr
            ? Math.floor((blastToday - new Date(lastDateStr + 'T00:00:00')) / 86400000)
            : null;
          return { name, lastGame, totalRentals, daysSinceLastRental };
        }).sort((a,b) => b.totalRentals - a.totalRentals);

        // {promo} and {new_games} tokens for the blast template — computed once
        // here so the admin never hand-types this month's numbers into the
        // textarea, and next month's promo change needs no template edit.
        const blastPromo = settings.promo || {};
        const blastPromoDurations = [7, 30].filter(d => getPromoDiscountPct(blastPromo, d) > 0);
        const blastPromoText = blastPromoDurations.length
          ? blastPromoDurations.map(d => getPromoDiscountPct(blastPromo, d) + '% OFF ' + (d === 7 ? 'weekly' : 'monthly') + ' rentals').join(' and ')
          : '';
        // Same "is this new" window every other new-game badge in the app already
        // uses (game.new_window_days || 11 days since created_at).
        const blastNewGames = games.filter(g => {
          if (!g.created_at) return false;
          const windowDays = g.new_window_days || 11;
          const daysSinceAdded = Math.floor((Date.now() - new Date(g.created_at).getTime()) / 86400000);
          return daysSinceAdded < windowDays;
        }).slice(0, 5).map(g => g.title);
        const blastNewGamesText = blastNewGames.join(', ');
      %>
      %>
      <div style="display:flex;gap:0.65rem;margin-bottom:1.25rem;flex-wrap:wrap;">
        <div style="background:#0a1a0a;border:1px solid #1a3a1a;border-radius:10px;padding:0.65rem 1rem;flex:1;min-width:120px;">
          <div style="font-size:0.65rem;color:#555;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;">Past Customers</div>
          <div style="font-size:1.4rem;font-weight:900;color:#22c55e;"><%= uniqueNames.length %></div>
        </div>
        <div style="background:#100a00;border:1px solid #3a2a00;border-radius:10px;padding:0.65rem 1rem;flex:1;min-width:120px;">
          <div style="font-size:0.65rem;color:#555;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;">Total Past Rentals</div>
          <div style="font-size:1.4rem;font-weight:900;color:#fbbf24;"><%= doneC.length %></div>
        </div>
        <div style="background:#0a0a1a;border:1px solid #1a1a3a;border-radius:10px;padding:0.65rem 1rem;flex:2;min-width:180px;display:flex;align-items:center;gap:0.75rem;">
          <div style="font-size:1.5rem;">💡</div>
          <div style="font-size:0.75rem;color:#555;line-height:1.5;">Copy a customer's message and paste it in <strong style="color:#aaa;">Facebook Messenger</strong> to reach them individually.</div>
        </div>
      </div>

      <!-- Message Template Composer -->
      <div style="margin-bottom:1rem;">
        <label style="font-size:0.75rem;font-weight:700;color:#888;text-transform:uppercase;letter-spacing:0.5px;display:block;margin-bottom:0.5rem;">Message Template</label>
        <div style="font-size:0.72rem;color:#555;margin-bottom:0.75rem;">Use <code style="background:#1a1a1a;padding:0.1rem 0.35rem;border-radius:4px;color:#a78bfa;">{name}</code>, <code style="background:#1a1a1a;padding:0.1rem 0.35rem;border-radius:4px;color:#a78bfa;">{game}</code>, <code style="background:#1a1a1a;padding:0.1rem 0.35rem;border-radius:4px;color:#22c55e;">{promo}</code>, and <code style="background:#1a1a1a;padding:0.1rem 0.35rem;border-radius:4px;color:#22c55e;">{new_games}</code> as placeholders — the last two are filled in automatically from your current promo and new-arrival games below, so this template stays correct as those change.</div>

        <!-- AI Generator -->
        <div style="background:linear-gradient(135deg,rgba(168,85,247,0.08),rgba(59,130,246,0.06));border:1px solid #2a1a3a;border-radius:12px;padding:0.9rem;margin-bottom:0.85rem;">
          <div style="font-size:0.72rem;font-weight:700;color:#a855f7;margin-bottom:0.5rem;display:flex;align-items:center;gap:0.35rem;">
            <span>✨</span> AI Message Generator
          </div>
          <div style="display:flex;gap:0.5rem;">
            <input type="text" id="aiPrompt" placeholder='e.g. "encourage them to come back for holidays" or "promote our Buy permanent option"'
              style="flex:1;background:#111;border:1px solid #2a2a2a;border-radius:8px;color:#fff;padding:0.55rem 0.85rem;font-size:0.8rem;min-width:0;">
            <button onclick="generateAITemplate()" id="aiGenBtn"
              style="background:linear-gradient(135deg,#7b2ff7,#3b82f6);color:#fff;border:none;border-radius:8px;padding:0.55rem 1rem;font-weight:700;font-size:0.8rem;cursor:pointer;white-space:nowrap;flex-shrink:0;">
              ✨ Generate
            </button>
          </div>
          <div id="aiGenStatus" style="font-size:0.72rem;color:#555;margin-top:0.4rem;min-height:1rem;"></div>
        </div>
        <textarea id="blastTemplate" rows="5" style="width:100%;background:#111;border:1px solid #333;border-radius:10px;color:#fff;padding:0.85rem;font-size:0.85rem;line-height:1.6;resize:vertical;font-family:inherit;box-sizing:border-box;">Hey {name}! 👋

Kamusta na? Just wanted to reach out — we have new games available at PlayStation Hub! 🎮

Last time you rented {game} — we've got even more titles now including {new_games}!

{promo} this month 🎉

Check it out: https://playstation-hub-production.up.railway.app

Message us anytime to reserve your slot! 😊</textarea>
        <div style="display:flex;gap:0.5rem;margin-top:0.65rem;flex-wrap:wrap;">
          <button onclick="generateBlast()" style="background:linear-gradient(135deg,#f43f5e,#e11d48);color:#fff;border:none;border-radius:8px;padding:0.55rem 1.1rem;font-weight:700;font-size:0.82rem;cursor:pointer;">⚡ Generate Messages</button>
          <button onclick="copyAllNames()" style="background:#1a1a1a;color:#aaa;border:1px solid #333;border-radius:8px;padding:0.55rem 1.1rem;font-weight:700;font-size:0.82rem;cursor:pointer;">📋 Copy All Names</button>
          <button onclick="filterBlast('all')" id="blastFilterAll" style="background:var(--ps-blue);color:#000;border:none;border-radius:8px;padding:0.55rem 0.85rem;font-weight:700;font-size:0.78rem;cursor:pointer;">All</button>
          <button onclick="filterBlast('top')" id="blastFilterTop" style="background:#1a1a1a;color:#aaa;border:1px solid #333;border-radius:8px;padding:0.55rem 0.85rem;font-weight:700;font-size:0.78rem;cursor:pointer;">Top Renters</button>
          <button onclick="filterBlast('inactive30')" id="blastFilterInactive30" style="background:#1a1a1a;color:#aaa;border:1px solid #333;border-radius:8px;padding:0.55rem 0.85rem;font-weight:700;font-size:0.78rem;cursor:pointer;">30+ Days Inactive</button>
          <button onclick="filterBlast('inactive90')" id="blastFilterInactive90" style="background:#1a1a1a;color:#aaa;border:1px solid #333;border-radius:8px;padding:0.55rem 0.85rem;font-weight:700;font-size:0.78rem;cursor:pointer;">90+ Days Inactive</button>
          <button onclick="toggleUncopiedOnly()" id="blastFilterUncopied" style="background:#1a1a1a;color:#aaa;border:1px solid #333;border-radius:8px;padding:0.55rem 0.85rem;font-weight:700;font-size:0.78rem;cursor:pointer;">👁️ Show uncopied only</button>
          <button onclick="resetCopiedList()" style="background:#1a1a1a;color:#666;border:1px solid #333;border-radius:8px;padding:0.55rem 0.85rem;font-weight:700;font-size:0.78rem;cursor:pointer;">↺ Reset copied list</button>
          <input type="text" id="blastSearch" oninput="filterBlastSearch(this.value)" placeholder="Search name..." style="background:#1a1a1a;border:1px solid #333;border-radius:8px;color:#fff;padding:0.5rem 0.85rem;font-size:0.82rem;flex:1;min-width:140px;">
        </div>
      </div>

      <!-- Copied toast -->
      <div id="blastToast" style="display:none;background:#22c55e;color:#000;font-weight:700;font-size:0.8rem;padding:0.4rem 1rem;border-radius:20px;text-align:center;margin-bottom:0.75rem;">✅ Copied!</div>

      <!-- Customer List -->
      <div id="blastList" style="display:flex;flex-direction:column;gap:0.5rem;max-height:520px;overflow-y:auto;">
        <% blastData.forEach((c, i) => { %>
        <div class="blast-row" data-name="<%= c.name.toLowerCase() %>" data-display-name="<%= c.name.replace(/"/g,'&quot;') %>" data-rentals="<%= c.totalRentals %>"
          data-days-since="<%= c.daysSinceLastRental != null ? c.daysSinceLastRental : '' %>"
          style="background:#111;border:1px solid #1e1e1e;border-radius:10px;padding:0.85rem 1rem;display:flex;align-items:center;gap:0.85rem;">
          <div style="font-size:0.75rem;font-weight:900;color:#333;min-width:22px;text-align:right;">#<%= i+1 %></div>
          <div style="flex:1;min-width:0;">
            <div style="font-weight:700;font-size:0.88rem;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= c.name %> <span class="blast-copied-badge" style="display:none;font-size:0.65rem;font-weight:700;color:#22c55e;">✓ Copied</span></div>
            <div style="font-size:0.7rem;color:#555;margin-top:0.1rem;">Last: <%= c.lastGame %> &nbsp;·&nbsp; <%= c.totalRentals %> rental<%= c.totalRentals !== 1 ? 's' : '' %><% if (c.daysSinceLastRental != null) { %> &nbsp;·&nbsp; <%= c.daysSinceLastRental %>d ago<% } %></div>
          </div>
          <button onclick="copyBlastMsg('<%= c.name.replace(/'/g,"\\'") %>','<%= c.lastGame.replace(/'/g,"\\'") %>', this)"
            style="background:#1a1a1a;color:#aaa;border:1px solid #2a2a2a;border-radius:7px;padding:0.4rem 0.75rem;font-size:0.75rem;font-weight:700;cursor:pointer;white-space:nowrap;flex-shrink:0;">
            📋 Copy Msg
          </button>
          <button onclick="openFBSearch('<%= c.name.replace(/'/g,"\\'") %>')"
            style="background:#1877f2;color:#fff;border:none;border-radius:7px;padding:0.4rem 0.75rem;font-size:0.75rem;font-weight:700;cursor:pointer;white-space:nowrap;flex-shrink:0;">
            📘 Find
          </button>
        </div>
        <% }) %>
        <% if (blastData.length === 0) { %>
        <div style="text-align:center;padding:2rem;color:#333;font-size:0.85rem;">No past customers yet.</div>
        <% } %>
      </div>

      <script>
      // Filled server-side once per page load from the current promo/new-game
      // state — see the {promo}/{new_games} computation above the stats bar.
      const BLAST_PROMO_TEXT = <%- JSON.stringify(blastPromoText) %>;
      const BLAST_NEW_GAMES_TEXT = <%- JSON.stringify(blastNewGamesText) %>;
      // Keyed by year-month so "already copied" naturally resets when a new
      // month's promo campaign starts, instead of carrying over stale state.
      const BLAST_COPIED_KEY = 'blastCopied_' + new Date().toISOString().slice(0, 7);

      function getCopiedSet() {
        try { return new Set(JSON.parse(localStorage.getItem(BLAST_COPIED_KEY) || '[]')); }
        catch (e) { return new Set(); }
      }
      function saveCopiedSet(set) {
        localStorage.setItem(BLAST_COPIED_KEY, JSON.stringify([...set]));
      }
      function markRowCopied(name, btn) {
        const set = getCopiedSet();
        set.add(name);
        saveCopiedSet(set);
        applyCopiedMark(btn.closest('.blast-row'));
      }
      function applyCopiedMark(row) {
        const badge = row.querySelector('.blast-copied-badge');
        if (badge) badge.style.display = '';
        row.style.opacity = '0.55';
      }
      function restoreCopiedMarks() {
        const set = getCopiedSet();
        document.querySelectorAll('.blast-row').forEach(row => {
          if (set.has(row.dataset.displayName)) applyCopiedMark(row);
        });
      }
      document.addEventListener('DOMContentLoaded', restoreCopiedMarks);

      let _blastUncopiedOnly = false;
      function toggleUncopiedOnly() {
        _blastUncopiedOnly = !_blastUncopiedOnly;
        const btn = document.getElementById('blastFilterUncopied');
        btn.style.background = _blastUncopiedOnly ? 'var(--ps-blue)' : '#1a1a1a';
        btn.style.color = _blastUncopiedOnly ? '#000' : '#aaa';
        applyBlastFilters();
      }
      function resetCopiedList() {
        if (!confirm('Clear the "already copied" marks for this month? This does not un-send any messages, it only resets the tracking.')) return;
        localStorage.removeItem(BLAST_COPIED_KEY);
        document.querySelectorAll('.blast-row').forEach(row => {
          const badge = row.querySelector('.blast-copied-badge');
          if (badge) badge.style.display = 'none';
          row.style.opacity = '';
        });
        showBlastToast('↺ Copied list reset for this month');
      }

      async function generateAITemplate() {
        const prompt = document.getElementById('aiPrompt').value.trim();
        if (!prompt) { document.getElementById('aiGenStatus').textContent = 'Please describe what kind of message you want.'; return; }
        const btn = document.getElementById('aiGenBtn');
        const status = document.getElementById('aiGenStatus');
        btn.disabled = true; btn.textContent = '⏳ Generating...';
        status.textContent = 'AI is writing your message...';
        try {
          const resp = await fetch('/admin/ai-generate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'prompt=' + encodeURIComponent(prompt)
          });
          const data = await resp.json();
          if (data.ok) {
            document.getElementById('blastTemplate').value = data.message;
            document.getElementById('autoBlastMsg').value = data.message;
            status.innerHTML = '<span style="color:#22c55e;">✅ Message generated! You can edit it before sending.</span>';
          } else {
            status.innerHTML = '<span style="color:#f43f5e;">❌ ' + (data.error || 'Failed') + '</span>';
          }
        } catch(e) {
          status.innerHTML = '<span style="color:#f43f5e;">❌ Network error.</span>';
        }
        btn.disabled = false; btn.textContent = '✨ Generate';
      }

      // Load contact count — reachable (inside Messenger's 24h window) vs total ever saved
      fetch('/admin/blast/contacts').then(r=>r.json()).then(d=>{
        document.getElementById('blastContactCount').textContent = d.reachable + ' reachable now · ' + d.total + ' total';
        document.getElementById('blastContactCount').style.color = d.reachable > 0 ? '#22c55e' : '#f43f5e';
      }).catch(()=>{});

      // Load opted-in count for the Recurring Notifications section
      fetch('/admin/notifications/optins').then(r=>r.json()).then(d=>{
        document.getElementById('notifOptinCount').textContent = d.active + ' opted in';
        document.getElementById('notifOptinCount').style.color = d.active > 0 ? '#22c55e' : '#f43f5e';
      }).catch(()=>{});

      async function sendNotifBlast() {
        const msg = document.getElementById('notifBlastMsg').value.trim()
          .replace(/\{promo\}/g, BLAST_PROMO_TEXT).replace(/\{new_games\}/g, BLAST_NEW_GAMES_TEXT);
        if (!msg) return showBlastToast('Please write a message first!');
        const btn = document.getElementById('notifBlastBtn');
        const status = document.getElementById('notifBlastStatus');
        const result = document.getElementById('notifBlastResult');
        if (!confirm('Send this month\'s update to everyone who opted in?\n\nThis cannot be undone.')) return;
        btn.disabled = true;
        btn.textContent = '⏳ Sending...';
        status.textContent = 'Please wait...';
        result.style.display = 'none';
        try {
          const resp = await fetch('/admin/notifications/send', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'message=' + encodeURIComponent(msg)
          });
          const data = await resp.json();
          result.style.display = 'block';
          if (data.ok) {
            result.innerHTML = '<strong style="color:#22c55e;">✅ Send Complete!</strong><br>' +
              '📤 Sent: <strong style="color:#22c55e;">' + data.sent + '</strong> &nbsp;|&nbsp; ' +
              '❌ Failed: <strong style="color:' + (data.failed>0?'#f43f5e':'#555') + '">' + data.failed + '</strong> &nbsp;|&nbsp; ' +
              '👥 Total opted-in: <strong>' + data.total + '</strong>';
            status.textContent = '';
          } else {
            result.innerHTML = '<strong style="color:#f43f5e;">❌ ' + (data.error || 'Send failed') + '</strong>';
            status.textContent = '';
          }
        } catch(e) {
          result.style.display = 'block';
          result.innerHTML = '<strong style="color:#f43f5e;">❌ Network error. Try again.</strong>';
          status.textContent = '';
        }
        btn.disabled = false;
        btn.textContent = '📅 Send to Opted-In Contacts';
      }

      async function sendAutoBlast() {
        const msg = document.getElementById('autoBlastMsg').value.trim();
        if (!msg) return showBlastToast('Please write a message first!');
        const btn = document.getElementById('autoBlastBtn');
        const status = document.getElementById('autoBlastStatus');
        const result = document.getElementById('autoBlastResult');
        if (!confirm('Send this message to everyone currently inside Messenger\'s 24-hour reachable window?\n\nThis cannot be undone.')) return;
        btn.disabled = true;
        btn.textContent = '⏳ Sending...';
        status.textContent = 'Please wait...';
        result.style.display = 'none';
        try {
          const resp = await fetch('/admin/blast', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'message=' + encodeURIComponent(msg)
          });
          const data = await resp.json();
          result.style.display = 'block';
          if (data.ok) {
            result.innerHTML = '<strong style="color:#22c55e;">✅ Blast Complete!</strong><br>' +
              '📤 Sent: <strong style="color:#22c55e;">' + data.sent + '</strong> &nbsp;|&nbsp; ' +
              '❌ Failed: <strong style="color:' + (data.failed>0?'#f43f5e':'#555') + '">' + data.failed + '</strong> &nbsp;|&nbsp; ' +
              '👥 Reachable contacts: <strong>' + data.total + '</strong>';
            status.textContent = '';
          } else {
            result.innerHTML = '<strong style="color:#f43f5e;">❌ ' + (data.error || 'Send failed') + '</strong>';
            status.textContent = '';
          }
        } catch(e) {
          result.style.display = 'block';
          result.innerHTML = '<strong style="color:#f43f5e;">❌ Network error. Try again.</strong>';
          status.textContent = '';
        }
        btn.disabled = false;
        btn.textContent = '⚡ Send to Reachable Contacts';
      }

      const _blastData = <%- JSON.stringify(blastData) %>;

      function generateBlast() {
        const tmpl = document.getElementById('blastTemplate').value;
        document.querySelectorAll('.blast-preview').forEach(e => e.remove());
        showBlastToast('⚡ Messages ready — click Copy Msg on each customer!');
      }

      function copyBlastMsg(name, game, btn) {
        const tmpl = document.getElementById('blastTemplate').value;
        const msg = tmpl.replace(/\{name\}/g, name).replace(/\{game\}/g, game || 'a game')
          .replace(/\{promo\}/g, BLAST_PROMO_TEXT).replace(/\{new_games\}/g, BLAST_NEW_GAMES_TEXT);
        navigator.clipboard.writeText(msg).then(() => {
          showBlastToast('✅ Copied message for ' + name + '!');
          if (btn) markRowCopied(name, btn);
        });
      }

      function copyAllNames() {
        const rows = document.querySelectorAll('.blast-row:not([style*="display: none"]):not([style*="display:none"])');
        const names = [...rows].map(r => r.dataset.displayName).filter(Boolean);
        navigator.clipboard.writeText(names.join('\n')).then(() => showBlastToast('✅ Copied ' + names.length + ' names!'));
      }

      function showBlastToast(msg) {
        const t = document.getElementById('blastToast');
        t.textContent = msg; t.style.display = 'block';
        setTimeout(() => t.style.display = 'none', 2500);
      }

      let _blastFilter = 'all';
      function filterBlast(type) {
        _blastFilter = type;
        ['All','Top','Inactive30','Inactive90'].forEach(k => {
          const btn = document.getElementById('blastFilter' + k);
          const active = type === k.charAt(0).toLowerCase() + k.slice(1);
          btn.style.background = active ? 'var(--ps-blue)' : '#1a1a1a';
          btn.style.color = active ? '#000' : '#aaa';
        });
        applyBlastFilters();
      }

      function filterBlastSearch(q) { applyBlastFilters(q); }

      function openFBSearch(name) {
        navigator.clipboard.writeText(name).catch(()=>{});
        window.open('https://www.facebook.com/messages/search/?query=' + encodeURIComponent(name), '_blank');
        showBlastToast('📘 Opening Messenger search for ' + name);
      }

      function applyBlastFilters(q) {
        q = (q || document.getElementById('blastSearch').value || '').toLowerCase().trim();
        const copiedSet = _blastUncopiedOnly ? getCopiedSet() : null;
        document.querySelectorAll('.blast-row').forEach(row => {
          const nameMatch = !q || row.dataset.name.includes(q);
          const topMatch = _blastFilter !== 'top' || parseInt(row.dataset.rentals) >= 3;
          const daysSince = row.dataset.daysSince === '' ? null : parseInt(row.dataset.daysSince);
          // A customer with no recorded date at all doesn't match either
          // inactive filter — there's no evidence either way, so it's excluded
          // rather than guessed into "inactive."
          const inactive30Match = _blastFilter !== 'inactive30' || (daysSince != null && daysSince >= 30);
          const inactive90Match = _blastFilter !== 'inactive90' || (daysSince != null && daysSince >= 90);
          const uncopiedMatch = !copiedSet || !copiedSet.has(row.dataset.displayName);
          row.style.display = (nameMatch && topMatch && inactive30Match && inactive90Match && uncopiedMatch) ? '' : 'none';
        });
      }
      </script>

    </div>
      </div></div><!-- /accordion message-blast -->
    <!-- Message Templates -->
    <div class="settings-accordion">
      <div class="settings-accordion-header" onclick="toggleAccordion(this)" style="border-left:3px solid #22c55e;">
        <div class="sa-left">
          <div class="sa-icon" style="background:rgba(34,197,94,0.15);">💬</div>
