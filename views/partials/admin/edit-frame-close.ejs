<script>
function applySidebar(collapsed) { document.body.classList.toggle('sb-collapsed', collapsed); }
function closeSidebarDrawer() { document.body.classList.remove('sb-open'); }
function toggleSidebar() {
  if (window.matchMedia('(max-width: 860px)').matches) {
    document.body.classList.toggle('sb-open');
    return;
  }
  var collapsed = !document.body.classList.contains('sb-collapsed');
  applySidebar(collapsed);
  try { localStorage.setItem('adminSidebarCollapsed', collapsed ? '1' : '0'); } catch (e) {}
}
(function () {
  try { applySidebar(localStorage.getItem('adminSidebarCollapsed') === '1'); } catch (e) {}
})();
</script>
