<div class="adm-card" id="sec-categories">
      <div class="adm-card-head" style="border-left:3px solid #22c55e;">
        <div class="sa-left">
          <div class="sa-icon" style="background:rgba(34,197,94,0.15);">🏷️</div>
          <div><div class="sa-title">Price Categories</div><div class="sa-desc">Shared pricing tiers assigned to multiple games</div></div>
        </div>
      </div>
      <div class="adm-card-body">
    <div id="add-category-form" class="form-card" style="border-color:rgba(34,197,94,0.3);background:linear-gradient(135deg,#001a06,#0a1a0a);">
      <p style="color:#666;font-size:0.82rem;margin-bottom:1.25rem;">Create pricing tiers (e.g. "New Games", "Classic") — assign games to a category so they all share the same price automatically.</p>
      <% if (priceCategories.length > 0) { %>
      <div style="display:flex;flex-direction:column;gap:0.75rem;margin-bottom:1.5rem;">
        <% priceCategories.forEach(cat => { %>
        <details style="background:#0a0a0a;border:1px solid #1a2a1a;border-radius:10px;overflow:hidden;">
          <summary style="padding:0.85rem 1rem;cursor:pointer;display:flex;align-items:center;gap:0.75rem;list-style:none;user-select:none;">
            <span style="font-size:1rem;">🏷️</span>
            <span style="font-weight:700;color:#fff;flex:1;"><%= cat.name %></span>
            <span style="font-size:0.75rem;color:#555;">NT: ₱<%= cat.nt_price_7d %>/₱<%= cat.nt_price_30d %> &nbsp;|&nbsp; TR: ₱<%= cat.tr_price_7d %>/₱<%= cat.tr_price_30d %></span>
            <span style="color:#444;font-size:0.8rem;margin-left:0.5rem;">▼</span>
          </summary>
          <div style="padding:1rem;border-top:1px solid #1a2a1a;">
            <form method="POST" action="/admin/price-categories/edit/<%= cat.id %>" enctype="multipart/form-data">
              <div class="form-grid">
                <div class="form-group full"><label>Category Name</label><input type="text" name="name" value="<%= cat.name %>" required></div>
                <div class="form-group full" style="margin-bottom:0;"><label style="color:#aaa;">🎮 Non-Trophy Prices (₱)</label></div>
                <div class="form-group"><label>Weekly</label><input type="number" name="nt_price_7d" value="<%= cat.nt_price_7d %>" min="1"></div>
                <div class="form-group"><label>Monthly</label><input type="number" name="nt_price_30d" value="<%= cat.nt_price_30d %>" min="1"></div>
                <div class="form-group full" style="margin-bottom:0;"><label style="color:#ffc400;">🏆 Trophy Account Prices (₱)</label></div>
                <div class="form-group"><label>Weekly</label><input type="number" name="tr_price_7d" value="<%= cat.tr_price_7d %>" min="1"></div>
                <div class="form-group"><label>Monthly</label><input type="number" name="tr_price_30d" value="<%= cat.tr_price_30d %>" min="1"></div>

                <div class="form-group full" style="margin-bottom:0;"><label style="color:#7dd3fc;">🎨 Homepage Card Design</label></div>
                <div class="form-group full">
                  <label>Card Picture</label>
                  <% if (cat.image) { %>
                  <div style="display:flex;align-items:center;gap:0.6rem;margin-bottom:0.5rem;">
                    <img src="<%= cat.image %>" style="width:60px;height:60px;object-fit:cover;border-radius:8px;border:1px solid #222;">
                    <label style="display:flex;align-items:center;gap:0.4rem;font-size:0.78rem;color:#ef4444;font-weight:600;">
                      <input type="checkbox" name="remove_image"> Remove current picture
                    </label>
                  </div>
                  <% } %>
                  <input type="file" name="image" accept="image/*">
                </div>
                <div class="form-group"><label>Picture Width (%) <span style="color:#666;font-weight:400;">— how far it reaches across the card</span></label><input type="number" name="image_width" value="<%= cat.image_width != null ? cat.image_width : 52 %>" min="20" max="90"></div>
                <div class="form-group"><label>Picture Opacity (%)</label><input type="number" name="image_opacity" value="<%= cat.image_opacity != null ? cat.image_opacity : 100 %>" min="0" max="100"></div>
                <div class="form-group"><label>Accent Color <span style="color:#666;font-weight:400;">— price text</span></label><input type="color" name="bg_color" value="<%= cat.bg_color || '#F0A500' %>" style="height:38px;padding:0.2rem;"></div>
                <div class="form-group"><label>Title Font Color</label><input type="color" name="title_color" value="<%= cat.title_color || '#ffffff' %>" style="height:38px;padding:0.2rem;"></div>
                <div class="form-group"><label>Title Font Size (px)</label><input type="number" name="title_size" value="<%= cat.title_size != null ? cat.title_size : 18 %>" min="10" max="40"></div>
              </div>
              <div class="form-actions" style="margin-top:0.75rem;">
                <button type="submit" class="btn btn-primary" style="background:#166534;">Save Category</button>
                <button type="button" class="btn btn-outline" style="border-color:#7f1d1d;color:#ef4444;"
                  onclick="if(confirm('Delete this category? Games using it will switch to custom price.')) { fetch('/admin/price-categories/delete/<%= cat.id %>',{method:'POST'}).then(()=>location.reload()); }">Delete</button>
              </div>
            </form>
          </div>
        </details>
        <% }) %>
      </div>
      <% } else { %>
      <p style="color:#444;font-size:0.82rem;margin-bottom:1.25rem;font-style:italic;">No categories yet. Add one below.</p>
      <% } %>
      <%# Closed until needed: seven fields the owner fills in rarely. + Add New
          → Price Category opens it (window.gmOpenNewCategory). %>
      <details class="gm-newcat" id="gmNewCat">
        <summary class="gm-newcat-btn">+ New category</summary>
        <div style="padding:1rem;border-top:1px dashed #1a3a1a;">
          <form method="POST" action="/admin/price-categories/add" enctype="multipart/form-data">
            <div class="form-grid">
              <div class="form-group full"><label>Category Name *</label><input type="text" name="name" placeholder="e.g. New Games, Classic, Special" required></div>
              <div class="form-group full" style="margin-bottom:0;"><label style="color:#aaa;">🎮 Non-Trophy Prices (₱)</label></div>
              <div class="form-group"><label>Weekly</label><input type="number" name="nt_price_7d" value="149" min="1"></div>
              <div class="form-group"><label>Monthly</label><input type="number" name="nt_price_30d" value="349" min="1"></div>
              <div class="form-group full" style="margin-bottom:0;"><label style="color:#ffc400;">🏆 Trophy Account Prices (₱)</label></div>
              <div class="form-group"><label>Weekly</label><input type="number" name="tr_price_7d" value="199" min="1"></div>
              <div class="form-group"><label>Monthly</label><input type="number" name="tr_price_30d" value="399" min="1"></div>

              <div class="form-group full" style="margin-bottom:0;"><label style="color:#7dd3fc;">🎨 Homepage Card Design</label></div>
              <div class="form-group full"><label>Card Picture</label><input type="file" name="image" accept="image/*"></div>
              <div class="form-group"><label>Picture Width (%) <span style="color:#666;font-weight:400;">— how far it reaches across the card</span></label><input type="number" name="image_width" value="52" min="20" max="90"></div>
              <div class="form-group"><label>Picture Opacity (%)</label><input type="number" name="image_opacity" value="100" min="0" max="100"></div>
              <div class="form-group"><label>Accent Color <span style="color:#666;font-weight:400;">— price text</span></label><input type="color" name="bg_color" value="#F0A500" style="height:38px;padding:0.2rem;"></div>
              <div class="form-group"><label>Title Font Color</label><input type="color" name="title_color" value="#ffffff" style="height:38px;padding:0.2rem;"></div>
              <div class="form-group"><label>Title Font Size (px)</label><input type="number" name="title_size" value="18" min="10" max="40"></div>
            </div>
            <div class="form-actions" style="margin-top:0.75rem;">
              <button type="submit" class="btn btn-primary" style="background:#166534;">Create Category</button>
            </div>
          </form>
        </div>
      </details>
    </div>

      </div></div><!-- /accordion price-cat -->
