<div class="adm-card" id="sec-requests">
      <div class="adm-card-head" style="border-left:3px solid #22c55e;">
        <div class="sa-left">
          <div class="sa-icon" style="background:rgba(34,197,94,0.15);">🙋</div>
          <div>
            <div class="sa-title">Game Requests (<%= gameRequestRows.length %>)</div>
            <div class="sa-desc">What customers are asking for — approve new ones, mark stocked when you add them</div>
          </div>
        </div>
      </div>
      <div class="adm-card-body">
        <div style="padding:1rem 1.25rem;">
          <%# For a game someone asked for over Messenger, never through this
              form — records it as an already-fulfilled request so it counts
              toward "you asked, we stocked" and shows in Now available. %>
          <div style="background:#0a0a0a;border:1px solid #1c1c1c;border-radius:10px;padding:0.9rem 1rem;margin-bottom:1rem;">
            <div style="font-weight:700;font-size:0.85rem;color:#fff;margin-bottom:0.3rem;">➕ Add a Messenger request</div>
            <div style="font-size:0.72rem;color:#666;margin-bottom:0.6rem;">For a game you already added because someone asked on Messenger — this logs their ask and marks it stocked right away.</div>
            <form method="POST" action="/admin/requests/add" style="display:flex;gap:0.5rem;flex-wrap:wrap;align-items:center;">
              <input type="text" name="title" placeholder="Game title" required style="flex:1;min-width:160px;background:#141414;border:1px solid #2a2a2a;color:#fff;border-radius:6px;padding:0.4rem 0.6rem;font-size:0.8rem;">
              <input type="text" name="fb_name" placeholder="Customer's Facebook name" required style="flex:1;min-width:160px;background:#141414;border:1px solid #2a2a2a;color:#fff;border-radius:6px;padding:0.4rem 0.6rem;font-size:0.8rem;">
              <select name="game_id" style="background:#141414;border:1px solid #2a2a2a;color:#ccc;border-radius:6px;padding:0.4rem 0.6rem;font-size:0.8rem;max-width:180px;">
                <option value="">No linked game</option>
                <% games.forEach(g => { %>
                <option value="<%= g.id %>"><%= g.title %></option>
                <% }) %>
              </select>
              <button type="submit" class="btn-edit" style="background:rgba(34,197,94,0.15);color:#22c55e;">Add &amp; mark stocked</button>
            </form>
          </div>
          <% if (!gameRequestRows.length) { %>
            <div style="color:#666;font-size:0.85rem;padding:1rem 0;">No requests yet.</div>
          <% } %>
          <% gameRequestRows.forEach(r => { const votes = (r.voters || []).length; %>
          <div class="gm-req-card" style="background:#111;border:1px solid <%= r.status === 'pending' ? '#7a5c00' : '#222' %>;">
            <span style="font-size:1.1rem;font-weight:900;color:var(--ps-blue);min-width:2rem;text-align:center;"><%= votes %></span>
            <% if (r.cover_image) { %>
              <img src="<%= r.cover_image %>" alt="" style="width:40px;height:60px;min-width:40px;border-radius:5px;object-fit:cover;background:#151515;">
            <% } else { %>
              <div style="width:40px;height:60px;min-width:40px;border-radius:5px;border:1px dashed #2e2e2e;display:flex;align-items:center;justify-content:center;font-size:1.1rem;color:#3d3d3d;">🎮</div>
            <% } %>
            <div style="flex:1;min-width:0;">
              <div style="font-weight:700;color:#fff;font-size:0.9rem;">
                <%= r.title %>
                <span style="font-size:0.68rem;font-weight:800;text-transform:uppercase;letter-spacing:0.5px;margin-left:0.4rem;color:<%= r.status === 'pending' ? '#f59e0b' : r.status === 'approved' ? 'var(--ps-blue)' : r.status === 'stocked' ? '#22c55e' : '#666' %>;"><%= r.status %></span>
              </div>
              <div class="gm-req-names">
                <% if (!(r.voters || []).length) { %><span class="gm-sub">No requesters</span><% } else { %>
                <form id="reqSave-<%= r.slug %>" method="POST" action="/admin/requests/<%= r.slug %>/voters/save"></form>
                <% (r.voters || []).forEach(v => { %>
                <div class="gm-req-name">
                  <input form="reqSave-<%= r.slug %>" type="hidden" name="at" value="<%= v.at %>">
                  <input form="reqSave-<%= r.slug %>" type="text" name="fb_name" value="<%= v.fb_name %>" aria-label="Requester name" maxlength="80">
                  <form method="POST" action="/admin/requests/<%= r.slug %>/voter/remove" data-undo-label="Requester removed">
                    <input type="hidden" name="at" value="<%= v.at %>">
                    <button type="submit" class="adm-btn adm-btn-ghost adm-btn-sm">Remove</button>
                  </form>
                </div>
                <% }) %>
                <button type="submit" form="reqSave-<%= r.slug %>" class="adm-btn adm-btn-secondary adm-btn-sm">Save names</button>
                <% } %>
              </div>
            </div>
            <div class="gm-req-actions">
              <% if (r.status === 'pending') { %>
              <form method="POST" action="/admin/requests/<%= r.slug %>/approve" style="display:inline"><button type="submit" class="btn-edit" style="background:rgba(34,197,94,0.15);color:#22c55e;">Approve</button></form>
              <form method="POST" action="/admin/requests/<%= r.slug %>/reject" style="display:inline"><button type="submit" class="btn-edit">Reject</button></form>
              <% } %>
              <% if (r.status === 'approved') { %>
              <form method="POST" action="/admin/requests/<%= r.slug %>/stock" style="display:inline-flex;gap:0.3rem;align-items:center;" onsubmit="return confirm('Mark <%= r.title.replace(/'/g, "\\'") %> as stocked? It will show as Now available on the request board.');">
                <select name="game_id" style="font-size:0.72rem;background:#141414;border:1px solid #2a2a2a;color:#ccc;border-radius:6px;padding:0.3rem 0.4rem;max-width:150px;">
                  <option value="">No linked game</option>
                  <% games.forEach(g => { %>
                  <option value="<%= g.id %>"><%= g.title %></option>
                  <% }) %>
                </select>
                <button type="submit" class="btn-edit" style="background:rgba(34,197,94,0.15);color:#22c55e;">Mark stocked</button>
              </form>
              <% } %>
              <form method="POST" action="/admin/requests/<%= r.slug %>/delete" data-confirm-title="Delete this request?" data-confirm-body="This removes the request and every name on it." data-confirm-ok="Delete request"><button type="submit" class="adm-btn adm-btn-danger adm-btn-sm">Delete</button></form>
            </div>
          </div>
          <form method="POST" action="/admin/requests/<%= r.slug %>/image" enctype="multipart/form-data" class="gm-req-cover">
            <label class="gm-file">
              <input type="file" name="cover_image" accept="image/*">
              <span><%= r.cover_image ? 'Replace cover' : 'Choose cover' %></span>
            </label>
            <button type="submit" class="adm-btn adm-btn-secondary adm-btn-sm">Upload cover</button>
          </form>
          <% }) %>
        </div>
      </div>
    </div>
