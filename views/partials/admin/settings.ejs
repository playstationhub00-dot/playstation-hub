  <div class="tab-panel" id="tab-settings">

    <div class="adm-jump">
      <a href="#sec-site">Site</a>
      <a href="#sec-promo">Promo & pricing</a>
      <a href="#sec-payments">Payment methods</a>
      <a href="#sec-alerts">Phone alerts</a>
      <a href="#sec-images">Images</a>
    </div>



    <!-- SITE SETTINGS -->
    <div class="adm-card" id="sec-site">
      <div class="adm-card-head" style="border-left:3px solid #f0a500;">
        <div class="sa-left">
          <div class="sa-icon" style="background:rgba(240,165,0,0.15);">⚙️</div>
          <div>
            <div class="sa-title">Site Settings</div>
            <div class="sa-desc">Website title, logo, favicon & hero background</div>
          </div>
        </div>
      </div>
      <div class="adm-card-body">
    <div style="border-color:rgba(240,165,0,0.4);background:linear-gradient(135deg,#1a1500 0%,#1a1a0a 100%);">
      <form method="POST" action="/admin/site-settings" enctype="multipart/form-data">
        <div class="form-grid">
          <div class="form-group full">
            <label>Website Title <span style="color:#555;font-size:0.75rem;">(shown in browser tab and nav)</span></label>
            <input type="text" name="title" value="<%= settings.title %>" placeholder="e.g. Playstation Hub" required>
          </div>
          <div class="form-group full">
            <label>Logo Image <span style="color:#555;font-size:0.75rem;">(PNG, JPG or SVG — blank keeps current)</span></label>
            <div style="display:flex;align-items:center;gap:1.25rem;margin-bottom:0.75rem;">
              <img src="<%= settings.logo_path %>" alt="Current logo" style="height:44px;width:auto;background:#000;border-radius:8px;padding:6px 10px;">
              <span style="color:#555;font-size:0.8rem;">Current logo</span>
            </div>
            <input type="file" name="logo" accept="image/*,.svg" style="padding:0.5rem;">
          </div>
          <div class="form-group full">
            <label>Favicon <span style="color:#555;font-size:0.75rem;">(small icon in browser tab — PNG, ICO or SVG)</span></label>
            <div style="display:flex;align-items:center;gap:1.25rem;margin-bottom:0.75rem;">
              <img src="<%= settings.favicon_path %>" alt="Current favicon" style="width:32px;height:32px;background:#000;border-radius:6px;padding:4px;">
              <span style="color:#555;font-size:0.8rem;">Current favicon</span>
            </div>
            <input type="file" name="favicon" accept="image/*,.svg,.ico" style="padding:0.5rem;">
          </div>

          <!-- Hero Background -->
          <div class="form-group full" style="margin-top:0.5rem;">
            <label>Home Page Hero Background</label>
            <div style="display:flex;gap:0.75rem;margin:0.65rem 0 1rem;flex-wrap:wrap;" id="heroBgOptions">
              <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;background:#1a1a1a;border:1px solid <%= (settings.hero_bg.type==='default') ? 'var(--ps-blue)' : '#333' %>;border-radius:10px;padding:0.6rem 1rem;font-size:0.875rem;font-weight:600;">
                <input type="radio" name="hero_bg_type" value="default" <%= settings.hero_bg.type==='default' ? 'checked' : '' %> onchange="heroTypeChange(this)"> Default Gradient
              </label>
              <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;background:#1a1a1a;border:1px solid <%= (settings.hero_bg.type==='image') ? 'var(--ps-blue)' : '#333' %>;border-radius:10px;padding:0.6rem 1rem;font-size:0.875rem;font-weight:600;">
                <input type="radio" name="hero_bg_type" value="image" <%= settings.hero_bg.type==='image' ? 'checked' : '' %> onchange="heroTypeChange(this)"> 🖼 Image
              </label>
              <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;background:#1a1a1a;border:1px solid <%= (settings.hero_bg.type==='video') ? 'var(--ps-blue)' : '#333' %>;border-radius:10px;padding:0.6rem 1rem;font-size:0.875rem;font-weight:600;">
                <input type="radio" name="hero_bg_type" value="video" <%= settings.hero_bg.type==='video' ? 'checked' : '' %> onchange="heroTypeChange(this)"> 🎬 Video Loop
              </label>
            </div>
            <div id="heroBgUpload" style="display:<%= settings.hero_bg.type!=='default' ? 'block' : 'none' %>;">
              <% if (settings.hero_bg.path) { %>
              <div style="margin-bottom:0.75rem;display:flex;align-items:center;gap:0.75rem;">
                <% if (settings.hero_bg.type==='video') { %>
                  <video src="<%= settings.hero_bg.path %>" style="height:60px;border-radius:6px;" muted></video>
                <% } else { %>
                  <img src="<%= settings.hero_bg.path %>" style="height:60px;border-radius:6px;object-fit:cover;width:100px;">
                <% } %>
                <span style="color:#555;font-size:0.8rem;">Current background</span>
              </div>
              <% } %>
              <label style="color:#aaa;font-size:0.82rem;display:block;margin-bottom:0.4rem;">Upload new file <span style="color:#555;">(blank = keep current)</span></label>
              <input type="file" name="hero_bg_file" accept="image/*,video/mp4,video/webm" style="padding:0.5rem;">
              <div style="margin-top:0.5rem;font-size:0.78rem;color:#555;">Supported: JPG, PNG, WEBP for image · MP4, WEBM for video loop</div>
              <div style="margin-top:1.25rem;">
                <label style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.5rem;">
                  <span style="color:#aaa;font-size:0.82rem;font-weight:600;">🌑 Background Darkness (overlay)</span>
                  <span id="overlayVal" style="color:var(--ps-blue);font-weight:700;font-size:0.9rem;"><%= settings.hero_bg.overlay || 50 %>%</span>
                </label>
                <input type="range" name="hero_bg_overlay" id="overlaySlider" min="0" max="100" value="<%= settings.hero_bg.overlay || 50 %>"
                  oninput="document.getElementById('overlayVal').textContent=this.value+'%'"
                  style="width:100%;accent-color:var(--ps-blue);cursor:pointer;height:6px;">
                <div style="display:flex;justify-content:space-between;font-size:0.72rem;color:#555;margin-top:0.3rem;">
                  <span>0% — fully visible</span><span>100% — fully dark</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Section Spacing -->
          <div class="form-group full" style="margin-top:0.5rem;">
            <label style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.5rem;">
              <span>📏 Homepage Section Spacing <span style="color:#555;font-size:0.75rem;font-weight:400;">(gap between homepage sections)</span></span>
              <span id="sectionGapVal" style="color:var(--ps-blue);font-weight:700;font-size:0.9rem;"><%= settings.section_gap || 4 %>rem</span>
            </label>
            <input type="range" name="section_gap" id="sectionGapSlider" min="1.5" max="7" step="0.25" value="<%= settings.section_gap || 4 %>"
              oninput="document.getElementById('sectionGapVal').textContent=this.value+'rem'"
              style="width:100%;accent-color:var(--ps-blue);cursor:pointer;height:6px;">
            <div style="display:flex;justify-content:space-between;font-size:0.72rem;color:#555;margin-top:0.3rem;">
              <span>1.5rem — tight</span><span>7rem — airy</span>
            </div>
          </div>
        </div>
        <div class="form-actions" style="margin-top:0.75rem;">
          <button type="submit" class="btn btn-primary" style="background:var(--ps-blue);">Save Settings</button>
        </div>
      </form>

      <script>
      function heroTypeChange(el) {
        document.getElementById('heroBgUpload').style.display = el.value === 'default' ? 'none' : 'block';
        document.querySelectorAll('#heroBgOptions label').forEach(l => {
          l.style.borderColor = l.querySelector('input').checked ? 'var(--ps-blue)' : '#333';
        });
      }
      </script>
    </div><!-- /site-settings inner -->
      </div><!-- /accordion-body -->
    </div><!-- /accordion site-settings -->

    <!-- PROMO SETTINGS -->
    <%
      const adminPromo = settings.promo || { enabled: true, discounts: { 10: 0, 15: 0, 30: 10 }, deposit: 100 };
      const adminDiscounts = adminPromo.discounts || { 10: 0, 15: 0, 30: 0 };
    %>
    <div class="adm-card" id="sec-promo">
      <div class="adm-card-head" style="border-left:3px solid #22c55e;">
        <div class="sa-left">
          <div class="sa-icon" style="background:rgba(34,197,94,0.15);">🎉</div>
          <div>
            <div class="sa-title">Promo & Pricing Rules</div>
            <div class="sa-desc">Discount %, rental duration rules & security deposit</div>
          </div>
        </div>
      </div>
      <div class="adm-card-body">
    <div style="border-color:rgba(34,197,94,0.3);background:linear-gradient(135deg,#041008,#071a0a);">
      <form method="POST" action="/admin/promo" enctype="multipart/form-data">
        <div class="form-grid">
          <!-- RENT PROMO -->
          <div class="form-group full" style="margin-bottom:0;">
            <label style="color:#22c55e;font-weight:700;font-size:0.8rem;text-transform:uppercase;letter-spacing:0.5px;">⏱️ Rent Promo</label>
          </div>
          <div class="form-group full">
            <label style="display:flex;align-items:center;gap:0.75rem;cursor:pointer;">
              <input type="checkbox" name="enabled" <%= adminPromo.enabled ? 'checked' : '' %> style="width:18px;height:18px;accent-color:#22c55e;">
              <span>Enable Rent Promo Discount</span>
            </label>
          </div>
          <div class="form-group full">
            <label>Promo Title <span style="color:#555;font-size:0.75rem;">(shown as the homepage headline)</span></label>
            <input type="text" name="title" value="<%= adminPromo.title || 'Rent Longer. Save More.' %>" maxlength="80" placeholder="Rent Longer. Save More.">
          </div>
          <div class="form-group full" style="margin-bottom:0;">
            <label>Promo Text <span style="color:#555;font-size:0.75rem;">(shown under the title)</span></label>
            <input type="text" name="text" value="<%= adminPromo.text || 'Discount applied automatically at checkout — no code needed.' %>" maxlength="160" placeholder="Discount applied automatically at checkout — no code needed.">
          </div>
          <div class="form-group full" style="margin-bottom:0;">
            <label style="color:#888;font-size:0.78rem;">Discount % per duration <span style="color:#555;">(0 = no discount for that duration — set either or both of Weekly/Monthly)</span></label>
          </div>
          <div class="form-group">
            <label>Weekly Discount %</label>
            <input type="number" name="discount_7" value="<%= adminDiscounts[7] || 0 %>" min="0" max="100" placeholder="0">
          </div>
          <div class="form-group">
            <label>Monthly Discount %</label>
            <input type="number" name="discount_30" value="<%= adminDiscounts[30] || 0 %>" min="0" max="100" placeholder="10">
          </div>
          <div class="form-group">
            <label>Trophy Account Security Deposit (₱) <span style="color:#555;font-size:0.75rem;">(refundable, added to Trophy rentals)</span></label>
            <input type="number" name="deposit" value="<%= adminPromo.deposit %>" min="0" placeholder="100">
          </div>
          <div class="form-group">
            <label>Late Return Fee (₱ per day) <span style="color:#555;font-size:0.75rem;">(deducted from the deposit in the overdue notice — 0 turns it off)</span></label>
            <input type="number" name="late_fee_per_day" value="<%= adminPromo.late_fee_per_day != null ? adminPromo.late_fee_per_day : 20 %>" min="0" placeholder="20">
          </div>
          <div class="form-group">
            <label>Promo Ends At <span style="color:#555;font-size:0.75rem;">(optional — shows a countdown &amp; auto-hides the section after)</span></label>
            <input type="datetime-local" name="ends_at" value="<%= adminPromo.ends_at || '' %>">
          </div>
          <div class="form-group full" style="margin-bottom:0;">
            <label>Promo Poster / Video <span style="color:#555;font-size:0.75rem;">(shown next to the discount ladder on the homepage — image or short video, up to 20MB)</span></label>
            <input type="file" name="promo_media" accept="image/*,video/mp4,video/webm,video/ogg">
          </div>
          <% if (adminPromo.media_path) { %>
          <div class="form-group full" style="margin-bottom:0;">
            <div style="display:flex;align-items:center;gap:1rem;background:#0d0d0d;border:1px solid #222;border-radius:10px;padding:0.75rem;">
              <% if (adminPromo.media_type === 'video') { %>
              <video src="<%= adminPromo.media_path %>" style="width:70px;height:88px;object-fit:cover;border-radius:6px;" muted></video>
              <% } else { %>
              <img src="<%= adminPromo.media_path %>" style="width:70px;height:88px;object-fit:cover;border-radius:6px;">
              <% } %>
              <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;color:#e74c3c;font-size:0.85rem;">
                <input type="checkbox" name="remove_media" style="width:16px;height:16px;accent-color:#e74c3c;">
                <span>Remove current media</span>
              </label>
            </div>
          </div>
          <% } %>

          <!-- BUY PROMO -->
          <div class="form-group full" style="margin-top:0.5rem;padding-top:1rem;border-top:1px solid #1a1a1a;margin-bottom:0;">
            <label style="color:#a855f7;font-weight:700;font-size:0.8rem;text-transform:uppercase;letter-spacing:0.5px;">♾️ Buy Permanent Promo</label>
          </div>
          <div class="form-group full">
            <label style="display:flex;align-items:center;gap:0.75rem;cursor:pointer;">
              <input type="checkbox" name="buy_promo_enabled" <%= adminPromo.buy_promo_enabled ? 'checked' : '' %> style="width:18px;height:18px;accent-color:#a855f7;">
              <span>Enable Buy Promo Discount</span>
            </label>
          </div>
          <div class="form-group">
            <label>Buy Discount % <span style="color:#555;font-size:0.75rem;">(applied to permanent access price)</span></label>
            <input type="number" name="buy_promo_pct" value="<%= adminPromo.buy_promo_pct || 0 %>" min="0" max="100" placeholder="0">
          </div>
        </div>
        <div class="form-actions" style="margin-top:0.75rem;">
          <button type="submit" class="btn btn-primary" style="background:#22c55e;color:#000;">Save Promo Settings</button>
        </div>
      </form>
    </div><!-- /promo inner -->
      </div><!-- /accordion-body -->
    </div><!-- /accordion promo -->





    <!-- PAYMENT METHODS -->
    <div class="adm-card" id="sec-payments">
      <div class="adm-card-head" style="border-left:3px solid #a855f7;">
        <div class="sa-left">
          <div class="sa-icon" style="background:rgba(168,85,247,0.15);">💳</div>
          <div>
            <div class="sa-title">Payment Methods</div>
            <div class="sa-desc">GCash and Maya account details customers see when paying</div>
          </div>
        </div>
      </div>
      <div class="adm-card-body">
        <div style="padding:1.25rem;">
        <form method="POST" action="/admin/payment-methods" enctype="multipart/form-data">
          <label class="pm-field">
            <span>Facebook page handle (the part after m.me/)</span>
            <input type="text" name="fb_page_username" value="<%= settings.fb_page_username || '' %>" placeholder="PlaystationHub00">
          </label>
          <p class="pm-note">
            Order links to Messenger are built as <code>m.me/&lt;handle&gt;?ref=PH-1234</code>.
            If the handle is wrong the link still opens Messenger, but we never learn
            which customer the order belongs to.
          </p>

          <% (settings.payment_methods || []).forEach(m => { %>
          <div class="pm-card">
            <div class="pm-card-head">
              <strong><%= m.label %></strong>
              <label class="pm-toggle">
                <input type="checkbox" name="enabled_<%= m.key %>" <%= m.enabled ? 'checked' : '' %>>
                <span>Show to customers</span>
              </label>
            </div>
            <label class="pm-field">
              <span>Account name</span>
              <input type="text" name="name_<%= m.key %>" value="<%= m.account_name %>">
            </label>
            <label class="pm-field">
              <span><%= m.key === 'paypal' ? 'PayPal.Me username or business email' : 'Account number' %></span>
              <input type="text" name="number_<%= m.key %>" value="<%= m.account_number %>"
                     placeholder="<%= m.key === 'paypal' ? 'playstationhub' : '' %>">
            </label>
            <% if (m.key === 'paypal') { %>
            <p class="pm-note">
              Just the handle, not the whole link — the site builds
              <code>paypal.me/&lt;handle&gt;/&lt;amount&gt;PHP</code> so the amount is
              filled in for the customer. Use a PayPal <strong>Business</strong> account:
              taking payment for goods on a personal one risks a limitation.
            </p>
            <% } %>
            <% if (m.key !== 'paypal') { %>
            <label class="pm-field">
              <span>QR image</span>
              <input type="file" name="qr_<%= m.key %>" accept="image/*">
            </label>
            <% } %>
            <% if (m.qr_image) { %>
            <div class="pm-qr-preview">
              <img src="<%= m.qr_image %>" alt="<%= m.label %> QR">
              <label class="pm-remove"><input type="checkbox" name="remove_qr_<%= m.key %>"> Remove this QR</label>
            </div>
            <% } %>
          </div>
          <% }) %>

          <div class="pm-card">
            <div class="pm-card-head"><strong>PayPal fees</strong></div>
            <p class="pm-note">
              What PayPal and the bank take out, added on top of the rental price for
              PayPal orders only. These are starting estimates — check what your first
              real payment actually nets and correct them here.
            </p>
            <label class="pm-field">
              <span>PayPal percentage fee (%)</span>
              <input type="number" step="0.01" min="0" name="paypal_fee_percent" value="<%= settings.paypal_fee_percent %>">
            </label>
            <label class="pm-field">
              <span>PayPal fixed fee (₱)</span>
              <input type="number" step="1" min="0" name="paypal_fee_fixed" value="<%= settings.paypal_fee_fixed %>">
            </label>
            <label class="pm-field">
              <span>Bank payout buffer ($)</span>
              <input type="number" step="0.01" min="0" name="paypal_payout_usd" value="<%= settings.paypal_payout_usd %>">
            </label>
            <p class="pm-note">
              The payout fee is charged per <em>withdrawal</em>, not per order — so
              recovering it on every order over-collects once you batch several into one
              transfer. Set it to 0 when that starts happening.
            </p>
            <label class="pm-field">
              <span>Fallback exchange rate (₱ per $1)</span>
              <input type="number" step="0.01" min="30" max="120" name="fx_manual_rate" value="<%= settings.fx_manual_rate %>">
            </label>
            <p class="pm-note">
              Only used if the live rate can't be fetched. The site refreshes the real
              rate daily on its own.
            </p>
          </div>

          <div class="form-actions" style="margin-top:0.75rem;">
            <button type="submit" class="btn btn-primary" style="background:#a855f7;">Save payment methods</button>
          </div>
        </form>
        </div>
      </div>
    </div><!-- /accordion payment-methods -->

    <div class="form-card" style="border-color:rgba(255,50,50,0.2);background:linear-gradient(135deg,#1a0a0a,#1a1a1a);">
      <h2 style="display:flex;align-items:center;gap:0.5rem;">🔒 Change Admin Password</h2>
      <form method="POST" action="/admin/change-password">
        <div class="form-grid">
          <div class="form-group"><label>Current Password</label><input type="password" name="current_password" placeholder="Current password" required></div>
          <div class="form-group"><label>New Password</label><input type="password" name="new_password" placeholder="New password (min 4 chars)" required></div>
          <div class="form-group"><label>Confirm New Password</label><input type="password" name="confirm_password" placeholder="Repeat new password" required></div>
        </div>
        <div class="form-actions" style="margin-top:0.75rem;">
          <button type="submit" class="btn" style="background:#c0392b;color:#fff;font-weight:700;padding:0.75rem 1.75rem;border-radius:50px;border:none;cursor:pointer;">Change Password</button>
        </div>
      </form>
    </div>

    <!-- MAINTENANCE -->
    <div style="margin:1.5rem 0 0.75rem;font-size:0.78rem;font-weight:800;letter-spacing:0.5px;text-transform:uppercase;color:#555;">Maintenance</div>
    <!-- PHONE ALERTS -->
    <div class="adm-card" id="sec-alerts">
      <div class="adm-card-head" style="border-left:3px solid #38bdf8;">
        <div class="sa-left">
          <div class="sa-icon" style="background:rgba(56,189,248,0.15);">🔔</div>
          <div><div class="sa-title">Phone Alerts</div><div class="sa-desc">Which Telegram alerts reach you, and a button to prove they arrive</div></div>
        </div>
      </div>
      <div class="adm-card-body" style="padding:1.15rem;">
<div class="oq-alert-test">
  <button type="button" id="oqTestAlert" class="oq-alert-btn">🔔 Send test alert</button>
  <span class="oq-alert-msg" id="oqTestAlertMsg">Checks that alerts reach your Telegram.</span>
</div>

<%
  // Labels live here rather than in lib/telegram.js — that module builds
  // messages, and how the owner's own settings panel words a switch is a
  // presentation choice. Falling back to the raw key means a kind added to
  // ALERT_KINDS still renders a working toggle before anyone writes copy for it.
  const ALERT_LABELS = {
    signin:        { name: 'Sign-in waiting',   note: 'The one that blocks — you have 10 minutes' },
    order_created: { name: 'New order started', note: 'Noisiest: about half never pay' },
    order_review:  { name: 'Payment to approve', note: 'Blocks the order until you act' },
    order_paid:    { name: 'Paid online',       note: 'Money landed; already advanced itself' },
    request:       { name: 'Game request',      note: 'New titles only, never repeat votes' }
  };
  const alertsOn = (settings && settings.alerts) || {};
%>
  <form method="POST" action="/admin/settings/alerts">
    <% (alertKinds || []).forEach(k => { const L = ALERT_LABELS[k] || { name: k, note: '' }; %>
    <label class="oq-alert-row">
      <%# Unset means on, matching lib/telegram.js — so a brand new install and
          a kind added later both start out checked. %>
      <input type="checkbox" name="alert_<%= k %>" <%= alertsOn[k] !== false ? 'checked' : '' %>>
      <span>
        <span class="oq-alert-name"><%= L.name %></span>
        <% if (L.note) { %><span class="oq-alert-note"><%= L.note %></span><% } %>
      </span>
    </label>
    <% }) %>
    <button type="submit" class="oq-alert-btn" style="margin-top:0.5rem;">Save alert settings</button>
    <div class="oq-alert-msg" style="margin-top:0.4rem;">The test button ignores these and always sends, so you can check the connection with everything switched off.</div>
  </form>

    </div>
    </div>

    <!-- IMAGE OPTIMIZATION -->
    <div class="adm-card" id="sec-images">
      <div class="adm-card-head" style="border-left:3px solid #22c55e;">
        <div class="sa-left">
          <div class="sa-icon" style="background:rgba(34,197,94,0.15);">🗜️</div>
          <div>
            <div class="sa-title">Image Optimization</div>
            <div class="sa-desc">Shrink existing uploads for faster mobile loading</div>
          </div>
        </div>
      </div>
      <div class="adm-card-body">
    <div style="border-color:rgba(34,197,94,0.3);background:linear-gradient(135deg,#041008,#071a0a);">
      <p style="color:#888;font-size:0.85rem;margin:0 0 1.25rem;line-height:1.6;">
        New uploads are already auto-resized to WebP. This button re-processes every existing cover, gallery, popup, and promo image the same way — safe to run more than once, already-optimized files are skipped.
      </p>
      <button type="button" class="btn btn-primary" style="background:#22c55e;" onclick="runImageBackfill(this)">🗜️ Optimize All Images Now</button>
      <div id="backfillResult" style="margin-top:1rem;font-size:0.85rem;"></div>
    </div>
      </div><!-- /accordion-body -->
    </div><!-- /accordion image-optimization -->
    <script>
    function runImageBackfill(btn) {
      btn.disabled = true;
      btn.textContent = '⏳ Optimizing… this may take a minute';
      const resultEl = document.getElementById('backfillResult');
      resultEl.textContent = '';
      fetch('/admin/backfill-images', { method: 'POST' })
        .then(r => r.json())
        .then(stats => {
          resultEl.innerHTML = `<span style="color:#22c55e;">✅ Done — ${stats.processed} image${stats.processed!==1?'s':''} shrunk, ${stats.skipped} already optimized${stats.errors ? `, <span style="color:#ef4444;">${stats.errors} failed</span>` : ''}.</span>`;
        })
        .catch(() => { resultEl.innerHTML = '<span style="color:#ef4444;">❌ Something went wrong — try again.</span>'; })
        .finally(() => { btn.disabled = false; btn.textContent = '🗜️ Optimize All Images Now'; });
    }
    </script>
    <script>
(function () {
  var btn = document.getElementById('oqTestAlert');
  var out = document.getElementById('oqTestAlertMsg');
  if (!btn || !out) return;
  btn.addEventListener('click', function () {
    btn.disabled = true;
    out.className = 'oq-alert-msg';
    out.textContent = 'Sending…';
    fetch('/admin/test-alert', { method: 'POST', headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (d && d.ok) {
          out.className = 'oq-alert-msg oq-alert-ok';
          out.textContent = 'Sent — check Telegram. If it arrived, alerts are working.';
          return;
        }
        out.className = 'oq-alert-msg oq-alert-bad';
        // Say what to fix, not just that it failed.
        if (d && d.reason === 'not_configured') {
          out.textContent = 'Not set up yet — missing ' + (d.missing || []).join(' and ') + ' in Railway.';
        } else if (d && d.reason === 'api') {
          out.textContent = 'Telegram refused it: ' + (d.description || ('HTTP ' + d.status))
            + (/unauthorized/i.test(d.description || '') ? ' — the bot token is wrong or was revoked.' : '')
            + (/chat not found/i.test(d.description || '') ? ' — the chat ID is wrong, or you have not messaged the bot yet.' : '');
        } else {
          out.textContent = 'Could not reach Telegram: ' + ((d && d.description) || 'unknown error');
        }
      })
      .catch(function (e) {
        out.className = 'oq-alert-msg oq-alert-bad';
        out.textContent = 'Request failed: ' + e.message;
      })
      .then(function () { btn.disabled = false; });
  });
})();
    </script>
  </div><!-- /tab-settings -->
