          <div style="font-size:1.55rem;font-weight:900;color:#fbbf24;line-height:1.1;" id="dashUniqueRenters">0</div>
          <div style="font-size:0.65rem;color:#444;margin-top:0.2rem;">by name — not a verified customer ID</div>
        </div>
        <div style="background:#0a0f1a;border:1px solid #1a2a3a;border-radius:12px;padding:0.9rem 1rem;">
          <div style="font-size:0.65rem;color:#555;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.3rem;">Rental Revenue</div>
          <div style="font-size:1.55rem;font-weight:900;color:#a78bfa;line-height:1.1;" id="dashRentRevenue">₱0</div>
          <div style="font-size:0.65rem;color:#444;margin-top:0.2rem;" id="dashRentSub">0 rentals · 0% of total</div>
        </div>
        <div style="background:#0f0a1a;border:1px solid #2a1a3a;border-radius:12px;padding:0.9rem 1rem;">
          <div style="font-size:0.65rem;color:#555;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.3rem;">Game Sales</div>
          <div style="font-size:1.55rem;font-weight:900;color:#60a5fa;line-height:1.1;" id="dashBuyRevenue">₱0</div>
          <div style="font-size:0.65rem;color:#444;margin-top:0.2rem;" id="dashBuySub">0 games sold · 0% of total</div>
        </div>
      </div>

      <!-- Status Row -->
      <div style="font-size:0.62rem;color:#444;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.4rem;">Live Status <span class="dash-tag">now</span></div>
      <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:0.5rem;margin-bottom:0.65rem;">
        <div style="background:#0a1a0a;border:1px solid #1a3a1a;border-radius:10px;padding:0.75rem 0.6rem;display:flex;align-items:center;gap:0.5rem;">
          <div style="font-size:1.2rem;">🟢</div>
          <div><div style="font-size:1.3rem;font-weight:900;color:#22c55e;line-height:1;"><%= activeCustomers.length %></div><div style="font-size:0.6rem;color:#555;margin-top:0.1rem;">Renting Now</div></div>
        </div>
        <div style="background:#0f0a1a;border:1px solid #2a1a3a;border-radius:10px;padding:0.75rem 0.6rem;display:flex;align-items:center;gap:0.5rem;">
          <div style="font-size:1.2rem;">🔖</div>
          <div><div style="font-size:1.3rem;font-weight:900;color:#c084fc;line-height:1;"><%= reservationCustomersNow.length %></div><div style="font-size:0.6rem;color:#555;margin-top:0.1rem;">Reservations</div></div>
        </div>
        <div style="background:#0a0f1a;border:1px solid #1a2a3a;border-radius:10px;padding:0.75rem 0.6rem;display:flex;align-items:center;gap:0.5rem;">
          <div style="font-size:1.2rem;">🛒</div>
          <div><div style="font-size:1.3rem;font-weight:900;color:#60a5fa;line-height:1;"><%= boughtCustomersNow.length %></div><div style="font-size:0.6rem;color:#555;margin-top:0.1rem;">Games Sold</div></div>
        </div>
        <div style="background:#0a0a1a;border:1px solid #1a1a3a;border-radius:10px;padding:0.75rem 0.6rem;display:flex;align-items:center;gap:0.5rem;">
          <div style="font-size:1.2rem;">✅</div>
          <div><div style="font-size:1.3rem;font-weight:900;color:#aaa;line-height:1;"><%= doneCustomersNow.length %></div><div style="font-size:0.6rem;color:#555;margin-top:0.1rem;">Completed</div></div>
        </div>
        <div style="background:<%= overdueCustomers.length > 0 ? '#1a0a0a' : '#0d0d0d' %>;border:1px solid <%= overdueCustomers.length > 0 ? '#3a1a1a' : '#1e1e1e' %>;border-radius:10px;padding:0.75rem 0.6rem;display:flex;align-items:center;gap:0.5rem;">
          <div style="font-size:1.2rem;">⚠️</div>
          <div><div style="font-size:1.3rem;font-weight:900;color:<%= overdueCustomers.length > 0 ? '#ef4444' : '#555' %>;line-height:1;"><%= overdueCustomers.length %></div><div style="font-size:0.6rem;color:#555;margin-top:0.1rem;">Overdue</div></div>
        </div>
      </div>

      <!-- Charts Row -->
      <div style="display:grid;grid-template-columns:1.4fr 1fr;gap:0.65rem;margin-bottom:0.65rem;">

        <!-- Monthly Bar Chart -->
        <div style="background:#0d0d0d;border:1px solid #1e1e1e;border-radius:12px;padding:1rem;">
          <div style="font-size:0.7rem;font-weight:700;color:#666;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.85rem;">Monthly Revenue — <span id="dashChartYearLabel"></span> <span style="color:#333;font-weight:500;">(click a month for details)</span></div>
          <div style="display:flex;align-items:flex-end;gap:0.4rem;height:122px;" id="dashBarChart"></div>
        </div>

        <!-- Top Games -->
        <div style="background:#0d0d0d;border:1px solid #1e1e1e;border-radius:12px;padding:1rem;">
          <div style="font-size:0.7rem;font-weight:700;color:#666;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.85rem;">Most Rented / Sold Games</div>
          <div id="dashTopGames"></div>
        </div>

      </div>

      <!-- Month Drill-Down Panel -->
      <div id="dashMonthPanel" style="display:none;background:#0a0e18;border:1px solid #1a2a4a;border-radius:12px;padding:1rem;margin-bottom:0.65rem;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.85rem;">
          <span style="font-size:0.85rem;font-weight:800;color:#fff;" id="dashMonthTitle"></span>
          <button type="button" onclick="clearMonthSelection()" style="background:#161616;border:1px solid #2a2a2a;color:#999;border-radius:20px;padding:0.25rem 0.7rem;font-size:0.7rem;font-weight:700;cursor:pointer;">✕ Clear</button>
        </div>
        <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:0.5rem;margin-bottom:0.85rem;">
          <div class="dash-month-stat"><div class="dash-month-val" id="dashMonthEarned" style="color:#22c55e;">₱0</div><div class="dash-month-lbl">Total Earned</div></div>
          <div class="dash-month-stat"><div class="dash-month-val" id="dashMonthTransactions" style="color:#fff;">0</div><div class="dash-month-lbl">Transactions</div></div>
          <div class="dash-month-stat"><div class="dash-month-val" id="dashMonthRenters" style="color:#fbbf24;">0</div><div class="dash-month-lbl">Unique Renters</div></div>
          <div class="dash-month-stat"><div class="dash-month-val" id="dashMonthReservations" style="color:#c084fc;">0</div><div class="dash-month-lbl">Reservations</div></div>
          <div class="dash-month-stat"><div class="dash-month-val" id="dashMonthBuys" style="color:#60a5fa;">0</div><div class="dash-month-lbl">Games Bought</div></div>
        </div>
        <div style="font-size:0.68rem;color:#666;margin-bottom:0.6rem;">🎮 <strong id="dashMonthStillRenting" style="color:#22c55e;">0</strong> rental<span id="dashMonthStillRentingS"></span> still active during this month</div>
        <div style="font-size:0.65rem;font-weight:700;color:#666;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.5rem;">Most Rented This Month</div>
        <div id="dashMonthTopGames"></div>

        <div style="border-top:1px solid #1a2a3a;margin-top:0.85rem;padding-top:0.85rem;">
          <div style="font-size:0.65rem;font-weight:700;color:#666;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.5rem;">📣 Month Log <span style="color:#333;font-weight:500;text-transform:none;">— ads &amp; screenshots for this month</span></div>
          <div id="dashMonthLogArea"></div>
        </div>
      </div>

      <!-- Insight Pills -->
      <div id="dashInsights" style="display:flex;flex-direction:column;gap:0.45rem;"></div>

      <!-- Tooltip -->
      <div id="dashTip" style="position:fixed;background:#1a1a1a;border:1px solid #333;border-radius:8px;padding:0.4rem 0.65rem;font-size:0.72rem;color:#fff;pointer-events:none;z-index:9999;display:none;white-space:nowrap;"></div>

    </div>

      </div></div><!-- /accordion dashboard -->

    <script>
    (function() {
      const DASH_DATA = <%- JSON.stringify(dashboardData).replace(/</g, '\\u003c') %>;
      const MONTH_LOGS = {};
      (<%- JSON.stringify(monthLogs).replace(/</g, '\\u003c') %>).forEach(function(m) { MONTH_LOGS[m.key] = m; });
      function monthKeyFor(year, month) { return year + '-' + String(month + 1).padStart(2, '0'); }
      let dashSelectedMonth = null; // { year, month } or null
      let dashMonthLogEditMode = false;

      function dashCustDate(c) {
        const raw = c.start_date || c.created_at;
        if (!raw) return null;
        const d = c.start_date ? new Date(c.start_date + 'T00:00:00') : new Date(c.created_at);
        return isNaN(d.getTime()) ? null : d;
      }
      function dashAvailableYears() {
        // Union of rental-start years and payment years: a year where money
        // only came in via an extension (no new rental started that year)
        // still needs to be selectable.
        const years = new Set();
        DASH_DATA.forEach(c => { const d = dashCustDate(c); if (d) years.add(d.getFullYear()); });
        DASH_DATA.forEach(c => {
          (c.payments || []).forEach(p => {
            if (!p || !p.date) return;
            const d = new Date(p.date + 'T00:00:00');
            if (!isNaN(d.getTime())) years.add(d.getFullYear());
          });
        });
        return [...years].sort((a, b) => b - a);
      }
      function dashUniqueRenters(list) {
        const set = new Set();
        list.forEach(c => { if (c.customer_name) set.add(c.customer_name.trim().toLowerCase()); });
        return set.size;
      }
      function dashFilterYear(year) {
        if (year === 'all') return DASH_DATA;
        return DASH_DATA.filter(c => { const d = dashCustDate(c); return d && d.getFullYear() === year; });
      }
      function dashFilterMonth(year, month) {
        return DASH_DATA.filter(c => { const d = dashCustDate(c); return d && d.getFullYear() === year && d.getMonth() === month; });
      }
      // Revenue and renter counts come from payments, each carrying its own
      // date — an extension paid in August counts in August even though the
      // rental started in June. dashFilterMonth stays as-is: it answers "which
      // rentals STARTED this month", which is still the right question for
      // rental-count and top-game figures.
      function dashPaymentsIn(year, month) {
        const out = [];
        DASH_DATA.forEach(function (c) {
          (c.payments || []).forEach(function (p) {
            if (!p || !p.date) return;
            const d = new Date(p.date + 'T00:00:00');
            if (isNaN(d.getTime())) return;
            if (d.getFullYear() === year && d.getMonth() === month) out.push({ c: c, p: p });
          });
        });
        return out;
      }
      function dashRevenueInMonth(year, month) {
        return dashPaymentsIn(year, month).reduce(function (s, x) { return s + (x.p.amount || 0); }, 0);
      }
      function dashRentersInMonth(year, month) {
        const names = new Set();
        dashPaymentsIn(year, month).forEach(function (x) {
          if (x.c.customer_name) names.add(String(x.c.customer_name).trim().toLowerCase());
        });
        return names.size;
      }
      // Same payments-based attribution as dashPaymentsIn/dashRevenueInMonth,
      // but scoped to a whole year (or all-time when year is null) — used for
      // the year/all-time totals so they agree with the monthly bars across a
      // year boundary instead of falling back to price-based, rental-start
      // attribution.
      function dashPaymentsInYear(year) {
        const out = [];
        DASH_DATA.forEach(function (c) {
          (c.payments || []).forEach(function (p) {
            if (!p || !p.date) return;
            const d = new Date(p.date + 'T00:00:00');
            if (isNaN(d.getTime())) return;
            if (year == null || d.getFullYear() === year) out.push({ c: c, p: p });
          });
        });
        return out;
      }
      function dashRevenueInYear(year) {
        return dashPaymentsInYear(year).reduce(function (s, x) { return s + (x.p.amount || 0); }, 0);
      }
      // "Still renting" = overlapped the month at all: started by month-end, and
      // either has no end date yet (ongoing) or ended on/after month-start.
      function dashOverlapsMonth(c, year, month) {
        if (c.status !== 'renting' && c.status !== 'done') return false;
        const start = dashCustDate(c);
        if (!start) return false;
        const monthStart = new Date(year, month, 1);
        const monthEnd = new Date(year, month + 1, 0, 23, 59, 59, 999);
        if (start > monthEnd) return false;
        if (!c.end_date) return true;
        const end = new Date(c.end_date + 'T23:59:59');
        return end >= monthStart;
      }
      function dashEscapeHtml(s) {
        return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
      }
      function dashTopGames(list, limit) {
        const counts = {};
        list.forEach(c => { if (c.game_title) counts[c.game_title] = (counts[c.game_title] || 0) + 1; });
        return Object.entries(counts).sort((a, b) => b[1] - a[1]).slice(0, limit || 5);
      }
      function dashRenderTopGamesList(el, topGames, emptyMsg) {
        if (!topGames.length) { el.innerHTML = '<div style="color:#333;font-size:0.8rem;text-align:center;padding:1.5rem 0;">' + emptyMsg + '</div>'; return; }
        const maxCount = topGames[0][1];
        const medals = ['🥇','🥈','🥉'];
        el.innerHTML = '<div style="display:flex;flex-direction:column;gap:0.55rem;">' + topGames.map(([title, count], i) =>
          '<div><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.2rem;">' +
          '<div style="font-size:0.75rem;color:#ccc;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:72%;">' + (medals[i] || (i+1)+'.') + ' ' + dashEscapeHtml(title) + '</div>' +
          '<div style="font-size:0.72rem;font-weight:800;color:#3b82f6;">' + count + 'x</div></div>' +
          '<div style="background:#1a1a1a;border-radius:3px;height:5px;"><div style="width:' + Math.round((count/maxCount)*100) + '%;height:100%;background:linear-gradient(90deg,#3b82f6,#7c3aed);border-radius:3px;"></div></div></div>'
        ).join('') + '</div>';
      }

      function populateYearSelect(preferYear) {
        const sel = document.getElementById('dashYearSelect');
        const years = dashAvailableYears();
        const currentYear = new Date().getFullYear();
        let opts = '<option value="all">All Time</option>';
        years.forEach(y => { opts += '<option value="' + y + '">' + y + '</option>'; });
        sel.innerHTML = opts;
        const pick = (preferYear && years.includes(preferYear)) ? preferYear : (years.includes(currentYear) ? currentYear : (years.length ? years[0] : null));
        sel.value = pick != null ? String(pick) : 'all';
      }

      window.renderDashboard = function() {
        const raw = document.getElementById('dashYearSelect').value;
        const yearNum = raw === 'all' ? null : parseInt(raw);
        const scoped = raw === 'all' ? DASH_DATA : dashFilterYear(yearNum);

        const yearPayments = dashPaymentsInYear(yearNum);
        const totalEarned = yearPayments.reduce((s, x) => s + (x.p.amount || 0), 0);
        const rentList = scoped.filter(c => c.status !== 'bought');
        const buyList = scoped.filter(c => c.status === 'bought');
        const rentRevenue = yearPayments.filter(x => x.c.status !== 'bought').reduce((s, x) => s + (x.p.amount || 0), 0);
        const buyRevenue = yearPayments.filter(x => x.c.status === 'bought').reduce((s, x) => s + (x.p.amount || 0), 0);

        document.getElementById('dashTotalEarned').textContent = '₱' + totalEarned.toLocaleString();
        document.getElementById('dashTransactions').textContent = scoped.length + ' transaction' + (scoped.length !== 1 ? 's' : '');
        document.getElementById('dashUniqueRenters').textContent = dashUniqueRenters(scoped);
        document.getElementById('dashRentRevenue').textContent = '₱' + rentRevenue.toLocaleString();
        document.getElementById('dashRentSub').textContent = rentList.length + ' rentals · ' + (totalEarned > 0 ? Math.round(rentRevenue/totalEarned*100) : 0) + '% of total';
        document.getElementById('dashBuyRevenue').textContent = '₱' + buyRevenue.toLocaleString();
        document.getElementById('dashBuySub').textContent = buyList.length + ' game' + (buyList.length !== 1 ? 's' : '') + ' sold · ' + (totalEarned > 0 ? Math.round(buyRevenue/totalEarned*100) : 0) + '% of total';

        dashRenderTopGamesList(document.getElementById('dashTopGames'), dashTopGames(scoped, 5), 'No data yet');

        const years = dashAvailableYears();
        const chartYear = yearNum || years[0] || new Date().getFullYear();
        renderDashChart(chartYear);
        renderDashInsights(scoped, chartYear);

        if (dashSelectedMonth && dashSelectedMonth.year !== chartYear) clearMonthSelection();
        else if (dashSelectedMonth) renderMonthPanel();
      };

      const MONTH_SHORT = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
      const MONTH_LONG = ['January','February','March','April','May','June','July','August','September','October','November','December'];

      function renderDashChart(year) {
        document.getElementById('dashChartYearLabel').textContent = year;
        const revs = [], renters = [];
        for (let m = 0; m < 12; m++) {
          revs.push(dashRevenueInMonth(year, m));
          renters.push(dashRentersInMonth(year, m));
        }
        const maxRev = Math.max(...revs, 1);
        const now = new Date();
        const container = document.getElementById('dashBarChart');
        container.innerHTML = MONTH_SHORT.map((lbl, i) => {
          const pct = revs[i] > 0 ? Math.max(Math.round(revs[i] / maxRev * 100), 3) : 0;
          const isCurrent = year === now.getFullYear() && i === now.getMonth();
          const isPeak = revs[i] === maxRev && maxRev > 0;
          const isSelected = dashSelectedMonth && dashSelectedMonth.year === year && dashSelectedMonth.month === i;
          const barColor = isSelected ? '#F0A500' : isPeak ? '#3b82f6' : isCurrent ? '#22c55e' : '#2a2a2a';
          const valColor = isSelected ? '#F0A500' : isPeak ? '#3b82f6' : isCurrent ? '#22c55e' : '#555';
          const valStr = revs[i] >= 1000 ? (revs[i]/1000).toFixed(1) + 'k' : revs[i];
          return '<div style="flex:1;display:flex;flex-direction:column;align-items:center;gap:0.2rem;height:100%;">' +
            '<div style="flex:1;display:flex;align-items:flex-end;width:100%;">' +
            '<div onclick="selectDashMonth(' + year + ',' + i + ')" ' +
            'onmouseenter="showDashTip(event,\'' + lbl + ' ' + year + ': ₱' + revs[i].toLocaleString() + ' · ' + renters[i] + ' renter' + (renters[i]!==1?'s':'') + '\')" ' +
            'onmouseleave="hideDashTip()" onmousemove="moveDashTip(event)" ' +
            'style="width:100%;height:' + pct + '%;background:' + barColor + ';border-radius:4px 4px 0 0;min-height:3px;cursor:pointer;transition:opacity 0.15s;' + (isSelected ? 'box-shadow:0 0 0 2px #F0A500;' : '') + '"></div></div>' +
            '<div style="font-size:0.58rem;color:#444;white-space:nowrap;">' + lbl + '</div>' +
            (revs[i] > 0 ? '<div style="font-size:0.58rem;font-weight:700;color:' + valColor + ';">₱' + valStr + '</div>' : '<div style="font-size:0.58rem;">&nbsp;</div>') +
            (renters[i] > 0 ? '<div style="font-size:0.52rem;color:#555;">👤' + renters[i] + '</div>' : '<div style="font-size:0.52rem;">&nbsp;</div>') +
            ((MONTH_LOGS[monthKeyFor(year, i)] && MONTH_LOGS[monthKeyFor(year, i)].ad_count > 0) ? '<div style="font-size:0.52rem;color:#F0A500;">📣' + MONTH_LOGS[monthKeyFor(year, i)].ad_count + '</div>' : '<div style="font-size:0.52rem;">&nbsp;</div>') +
            '</div>';
        }).join('');
      }

      window.selectDashMonth = function(year, month) {
        dashSelectedMonth = { year, month };
        dashMonthLogEditMode = false;
        renderDashChart(year);
        renderMonthPanel();
      };
      window.clearMonthSelection = function() {
        dashSelectedMonth = null;
        dashMonthLogEditMode = false;
        document.getElementById('dashMonthPanel').style.display = 'none';
        const raw = document.getElementById('dashYearSelect').value;
        const yearNum = raw === 'all' ? null : parseInt(raw);
        const years = dashAvailableYears();
        renderDashChart(yearNum || years[0] || new Date().getFullYear());
      };

      function renderMonthPanel() {
        if (!dashSelectedMonth) return;
        const { year, month } = dashSelectedMonth;
        const list = dashFilterMonth(year, month);
        const totalEarned = dashRevenueInMonth(year, month);
        const reservations = list.filter(c => c.status === 'reservation');
        const buys = list.filter(c => c.status === 'bought');
        const stillRenting = DASH_DATA.filter(c => dashOverlapsMonth(c, year, month));

        document.getElementById('dashMonthTitle').textContent = '📅 ' + MONTH_LONG[month] + ' ' + year;
        document.getElementById('dashMonthEarned').textContent = '₱' + totalEarned.toLocaleString();
        document.getElementById('dashMonthTransactions').textContent = list.length;
        document.getElementById('dashMonthRenters').textContent = dashRentersInMonth(year, month);
        document.getElementById('dashMonthReservations').textContent = reservations.length;
        document.getElementById('dashMonthBuys').textContent = buys.length;
        document.getElementById('dashMonthStillRenting').textContent = stillRenting.length;
        document.getElementById('dashMonthStillRentingS').textContent = stillRenting.length !== 1 ? 's were' : ' was';
        dashRenderTopGamesList(document.getElementById('dashMonthTopGames'), dashTopGames(list, 5), 'No rentals this month');
        renderMonthLogArea();

        document.getElementById('dashMonthPanel').style.display = 'block';
      }

      function renderMonthLogArea() {
        if (!dashSelectedMonth) return;
        const key = monthKeyFor(dashSelectedMonth.year, dashSelectedMonth.month);
        const log = MONTH_LOGS[key];
        const area = document.getElementById('dashMonthLogArea');
        if (dashMonthLogEditMode) {
          area.innerHTML = buildMonthLogForm(key, log);
        } else if (log) {
          area.innerHTML = buildMonthLogView(log);
        } else {
          area.innerHTML = '<button type="button" onclick="toggleMonthLogEdit(true)" style="background:#161616;border:1px dashed #333;color:#888;border-radius:8px;padding:0.6rem 1rem;font-size:0.78rem;cursor:pointer;width:100%;">＋ Add month log — track ads &amp; upload screenshots</button>';
        }
      }

      function buildMonthLogView(log) {
        let html = '<div style="display:flex;align-items:center;gap:0.6rem;flex-wrap:wrap;margin-bottom:0.6rem;">';
        html += '<span style="background:rgba(240,165,0,0.12);border:1px solid rgba(240,165,0,0.35);color:#F0A500;border-radius:20px;padding:0.2rem 0.65rem;font-size:0.72rem;font-weight:700;">📣 ' + log.ad_count + ' ad' + (log.ad_count !== 1 ? 's' : '') + '</span>';
        if (log.ad_spend > 0) html += '<span style="color:#888;font-size:0.72rem;">₱' + log.ad_spend.toLocaleString() + ' spent</span>';
        html += '<button type="button" onclick="toggleMonthLogEdit(true)" style="margin-left:auto;background:#161616;border:1px solid #2a2a2a;color:#999;border-radius:20px;padding:0.2rem 0.65rem;font-size:0.68rem;cursor:pointer;">✏️ Edit</button>';
        html += '</div>';
        if (log.note) html += '<div style="font-size:0.75rem;color:#ccc;margin-bottom:0.6rem;line-height:1.4;">' + dashEscapeHtml(log.note) + '</div>';
        if (log.images.length) {
          html += '<div style="display:flex;gap:0.5rem;flex-wrap:wrap;">' + log.images.map(img =>
            '<a href="' + img + '" target="_blank" rel="noopener"><img src="' + img + '" style="width:72px;height:72px;object-fit:cover;border-radius:6px;border:1px solid #2a2a2a;"></a>'
          ).join('') + '</div>';
        }
        return html;
      }

      function buildMonthLogForm(key, log) {
        const adCount = log ? log.ad_count : 0;
        const adSpend = log && log.ad_spend ? log.ad_spend : '';
        const note = log ? dashEscapeHtml(log.note) : '';
        const slotsLeft = 6 - (log ? log.images.length : 0);
        let html = '<form method="POST" action="/admin/month-log" enctype="multipart/form-data" style="display:flex;flex-direction:column;gap:0.5rem;">';
        html += '<input type="hidden" name="month_key" value="' + key + '">';
        html += '<div style="display:grid;grid-template-columns:1fr 1fr;gap:0.5rem;">';
        html += '<div><label style="font-size:0.62rem;color:#666;display:block;margin-bottom:0.2rem;">Ads Run</label><input type="number" name="ad_count" min="0" value="' + adCount + '" style="width:100%;box-sizing:border-box;background:#0a0a0a;border:1px solid #2a2a2a;border-radius:6px;color:#fff;padding:0.4rem 0.5rem;font-size:0.8rem;"></div>';
        html += '<div><label style="font-size:0.62rem;color:#666;display:block;margin-bottom:0.2rem;">Ad Spend (₱, optional)</label><input type="number" name="ad_spend" min="0" value="' + adSpend + '" style="width:100%;box-sizing:border-box;background:#0a0a0a;border:1px solid #2a2a2a;border-radius:6px;color:#fff;padding:0.4rem 0.5rem;font-size:0.8rem;"></div>';
        html += '</div>';
        html += '<div><label style="font-size:0.62rem;color:#666;display:block;margin-bottom:0.2rem;">Note</label><textarea name="note" rows="2" style="width:100%;box-sizing:border-box;background:#0a0a0a;border:1px solid #2a2a2a;border-radius:6px;color:#fff;padding:0.4rem 0.5rem;font-size:0.8rem;resize:vertical;">' + note + '</textarea></div>';
        if (slotsLeft > 0) html += '<div><label style="font-size:0.62rem;color:#666;display:block;margin-bottom:0.2rem;">Add Screenshots (' + slotsLeft + ' slot' + (slotsLeft !== 1 ? 's' : '') + ' left, 6 max)</label><input type="file" name="images" accept="image/*" multiple style="width:100%;font-size:0.75rem;color:#999;"></div>';
        if (log && log.images.length) {
          html += '<div style="display:flex;gap:0.5rem;flex-wrap:wrap;">' + log.images.map(img =>
            '<div style="position:relative;"><img src="' + img + '" style="width:60px;height:60px;object-fit:cover;border-radius:6px;border:1px solid #2a2a2a;">' +
            '<button type="button" onclick="deleteMonthLogImage(\'' + key + '\',\'' + img + '\')" style="position:absolute;top:-6px;right:-6px;background:#ef4444;color:#fff;border:none;border-radius:50%;width:18px;height:18px;font-size:0.6rem;cursor:pointer;line-height:1;padding:0;">✕</button></div>'
          ).join('') + '</div>';
        }
        html += '<div style="display:flex;gap:0.5rem;align-items:center;">';
        html += '<button type="submit" style="background:#166534;color:#fff;border:none;border-radius:8px;padding:0.5rem 1rem;font-size:0.78rem;font-weight:700;cursor:pointer;">Save</button>';
        html += '<button type="button" onclick="toggleMonthLogEdit(false)" style="background:#161616;border:1px solid #2a2a2a;color:#999;border-radius:8px;padding:0.5rem 1rem;font-size:0.78rem;cursor:pointer;">Cancel</button>';
        if (log) html += '<button type="button" onclick="deleteMonthLog(\'' + key + '\')" style="margin-left:auto;background:#1a0a0a;border:1px solid #3a1a1a;color:#ef4444;border-radius:8px;padding:0.5rem 1rem;font-size:0.78rem;cursor:pointer;">Delete Log</button>';
        html += '</div></form>';
        return html;
      }

      window.toggleMonthLogEdit = function(edit) { dashMonthLogEditMode = edit; renderMonthLogArea(); };
      window.deleteMonthLogImage = function(key, imgPath) {
        if (!confirm('Remove this screenshot?')) return;
        const f = document.createElement('form');
        f.method = 'POST'; f.action = '/admin/month-log/image/delete';
        const k = document.createElement('input'); k.type = 'hidden'; k.name = 'month_key'; k.value = key;
        const p = document.createElement('input'); p.type = 'hidden'; p.name = 'image_path'; p.value = imgPath;
        f.appendChild(k); f.appendChild(p);
        document.body.appendChild(f); f.submit();
      };
      window.deleteMonthLog = function(key) {
        if (!confirm('Delete this month\'s log (ads, spend, note, and all screenshots)?')) return;
        const f = document.createElement('form');
        f.method = 'POST'; f.action = '/admin/month-log/delete';
        const k = document.createElement('input'); k.type = 'hidden'; k.name = 'month_key'; k.value = key;
        f.appendChild(k);
        document.body.appendChild(f); f.submit();
      };

      function renderDashInsights(scoped, chartYear) {
        const chartYearPayments = dashPaymentsInYear(chartYear);
        const rentRevenue = chartYearPayments.filter(x => x.c.status !== 'bought').reduce((s, x) => s + (x.p.amount || 0), 0);
        const totalEarned = chartYearPayments.reduce((s, x) => s + (x.p.amount || 0), 0);
        const rentPct = totalEarned > 0 ? Math.round(rentRevenue/totalEarned*100) : 0;
        const topGames = dashTopGames(scoped, 1);

        let revs = [];
        for (let m = 0; m < 12; m++) revs.push(dashRevenueInMonth(chartYear, m));
        const peakVal = Math.max(...revs);
        const peakMonth = MONTH_SHORT[revs.indexOf(peakVal)];

        const pills = [];
        if (peakVal > 0) pills.push(['📈', '<strong style="color:#fff;">Best month: ' + peakMonth + ' ' + chartYear + '</strong> — ₱' + peakVal.toLocaleString() + '. Identify what worked and repeat it.', '#111', '#1e1e1e']);
        if (<%= overdueCustomers.length %> > 0) pills.push(['⚠️', '<strong style="color:#ef4444;"><%= overdueCustomers.length %> overdue rental<%= overdueCustomers.length !== 1 ? "s" : "" %></strong> — follow up immediately to recover games or collect late fees.', '#1a0a0a', '#3a1a1a']);
        if (rentPct > 90 && totalEarned > 0) pills.push(['💰', '<strong style="color:#fff;">Game sales are only ' + (100 - rentPct) + '% of revenue</strong> — push buy options to returning renters to grow this.', '#111', '#1e1e1e']);
        if (topGames.length > 0) pills.push(['🎮', '<strong style="color:#fff;">' + dashEscapeHtml(topGames[0][0]) + ' is your #1 game</strong> — ' + topGames[0][1] + 'x rented/sold. Keep it stocked and front-and-center on your site.', '#111', '#1e1e1e']);
        if (<%= doneCustomersNow.length %> > <%= activeCustomers.length %> * 5) pills.push(['📉', '<strong style="color:#fff;"><%= doneCustomersNow.length %> past customers</strong> vs <%= activeCustomers.length %> active — most renters don\'t return. A Messenger follow-up campaign could recover many of them.', '#111', '#1e1e1e']);

        document.getElementById('dashInsights').innerHTML = pills.map(([icon, text, bg, border]) =>
          '<div style="background:' + bg + ';border:1px solid ' + border + ';border-radius:8px;padding:0.55rem 0.85rem;font-size:0.72rem;color:#aaa;display:flex;align-items:flex-start;gap:0.5rem;line-height:1.4;">' +
          '<span style="flex-shrink:0;">' + icon + '</span><span>' + text + '</span></div>'
        ).join('');
      }

      function showDashTip(e, text) { var t=document.getElementById('dashTip'); t.textContent=text; t.style.display='block'; moveDashTip(e); }
      function hideDashTip() { document.getElementById('dashTip').style.display='none'; }
      function moveDashTip(e) { var t=document.getElementById('dashTip'); t.style.left=(e.clientX+12)+'px'; t.style.top=(e.clientY-28)+'px'; }
      window.showDashTip = showDashTip; window.hideDashTip = hideDashTip; window.moveDashTip = moveDashTip;

      // Reopen a specific month's drill-down after a month-log save redirects back
      // with ?month=YYYY-MM, so the panel doesn't just close on you after saving.
      let dashPreferYear = null;
      const dashMonthParam = new URLSearchParams(window.location.search).get('month');
      if (dashMonthParam && /^\d{4}-\d{2}$/.test(dashMonthParam)) {
        const parts = dashMonthParam.split('-').map(Number);
        dashSelectedMonth = { year: parts[0], month: parts[1] - 1 };
        dashPreferYear = parts[0];
      }
      populateYearSelect(dashPreferYear);
      renderDashboard();
    })();
    </script>

