<script>
// Ignoring a priced-short row happens in place. It is a small action repeated
// down a list, and routing each one through a POST + redirect meant a full
// reload, a fresh tab decision and a scroll reset every single time.
//
// Progressive enhancement, not a replacement: the form still posts normally if
// this never runs or the request fails, so the button is never dead.
(function () {
  function el(id) { return document.getElementById(id); }

  function recount() {
    var panel = el('pzPanel');
    if (!panel) return;
    var left = panel.querySelectorAll('.rem-row').length;
    var ignored = panel.querySelector('.rem-ignored');
    // Rows inside the collapsed "ignored" list are not open findings.
    if (ignored) left -= ignored.querySelectorAll('.rem-row').length;
    var count = el('pzCount');
    if (count) count.textContent = String(left);
    // Nothing left to answer for: the panel has done its job and an empty
    // "needs attention" card every day is how you learn to stop reading it.
    if (left <= 0) panel.hidden = true;
  }

  document.addEventListener('submit', function (e) {
    var form = e.target;
    if (!form || !form.classList || !form.classList.contains('pz-ignore')) return;
    e.preventDefault();

    var row = form.closest('.rem-row');
    var btn = form.querySelector('button');
    if (btn) { btn.disabled = true; btn.textContent = 'Ignoring...'; }

    fetch(form.action, {
      method: 'POST',
      headers: { 'X-Requested-With': 'fetch' },
      credentials: 'same-origin'
    }).then(function (r) {
      if (!r.ok) throw new Error('http ' + r.status);
      return r.json();
    }).then(function (data) {
      if (!data || !data.ok) throw new Error('refused');
      if (row) row.parentNode.removeChild(row);
      var ign = el('pzIgnCount');
      if (ign) ign.textContent = String((parseInt(ign.textContent, 10) || 0) + 1);
      recount();
    }).catch(function () {
      // Hand it back to the browser rather than leave a dead button. Calling
      // the prototype method directly because a form containing a control
      // named "submit" shadows form.submit().
      if (btn) { btn.disabled = false; btn.textContent = 'Ignore'; }
      HTMLFormElement.prototype.submit.call(form);
    });
  });
})();
</script>
