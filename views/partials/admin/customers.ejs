  <div class="tab-panel" id="tab-customers">

    <%
      // Only static/live (not time-filtered) figures stay server-computed:
      // current-status snapshots and all-time cost/profit (games have no purchase
      // date, so cost can't be attributed to a year — see dashboard JS for the rest).
      const activeCustomers = customers.filter(c => c.status === 'renting');
      const boughtCustomersNow = customers.filter(c => c.status === 'bought');
      const doneCustomersNow = customers.filter(c => c.status === 'done');
      const reservationCustomersNow = customers.filter(c => c.status === 'reservation');
      const totalRevenueAllTime = customers.reduce((s, c) => s + (c.price || 0), 0);
      const totalGameCosts = games.reduce((s, g) => s + (g.cost || 0), 0);
      const netProfitAllTime = totalRevenueAllTime - totalGameCosts;
      const today0 = new Date(); today0.setHours(0,0,0,0);
      const overdueCustomers = activeCustomers.filter(c => c.end_date && new Date(c.end_date + 'T00:00:00') < today0);
      const dashNow = new Date();
    %>

    <!-- ── DASHBOARD ── -->
    <div class="settings-accordion" style="margin-bottom:1rem;">
      <div class="settings-accordion-header open" onclick="toggleAccordion(this)" style="border-left:3px solid #22c55e;">
        <div class="sa-left">
          <div class="sa-icon" style="background:rgba(34,197,94,0.15);">📊</div>
          <div><div class="sa-title">Business Dashboard</div><div class="sa-desc">Revenue, profit, monthly stats & top games</div></div>
        </div><span class="sa-arrow">▼</span>
      </div>
      <div class="settings-accordion-body open">
    <div style="margin-bottom:0;">

      <!-- Header -->
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;flex-wrap:wrap;gap:0.5rem;">
        <span style="font-size:1.05rem;font-weight:800;color:#fff;">📊 Business Dashboard</span>
        <div style="display:flex;align-items:center;gap:0.6rem;">
          <select id="dashYearSelect" onchange="renderDashboard()" style="background:#111;border:1px solid #2a2a2a;border-radius:8px;color:#fff;padding:0.35rem 0.6rem;font-size:0.78rem;"></select>
          <span style="font-size:0.7rem;color:#444;">as of <%= dashNow.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'}) %></span>
        </div>
      </div>

      <!-- KPI Row 1 -->
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:0.65rem;margin-bottom:0.65rem;">
        <div style="background:#0a1a0a;border:1px solid #1a3a1a;border-radius:12px;padding:0.9rem 1rem;">
          <div style="font-size:0.65rem;color:#555;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.3rem;">Total Earned</div>
          <div style="font-size:1.55rem;font-weight:900;color:#22c55e;line-height:1.1;" id="dashTotalEarned">₱0</div>
          <div style="font-size:0.65rem;color:#444;margin-top:0.2rem;" id="dashTransactions">0 transactions</div>
        </div>
        <div style="background:#1a0800;border:1px solid #3a1a00;border-radius:12px;padding:0.9rem 1rem;">
          <div style="font-size:0.65rem;color:#555;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.3rem;">Total Game Costs <span class="dash-tag">all-time</span></div>
          <div style="font-size:1.55rem;font-weight:900;color:#f59e0b;line-height:1.1;">₱<%= totalGameCosts.toLocaleString() %></div>
          <div style="font-size:0.65rem;color:#444;margin-top:0.2rem;"><%= games.length %> games in library</div>
        </div>
        <div style="background:<%= netProfitAllTime >= 0 ? '#060a18' : '#1a0606' %>;border:1px solid <%= netProfitAllTime >= 0 ? '#1a2a4a' : '#3a1a1a' %>;border-radius:12px;padding:0.9rem 1rem;">
          <div style="font-size:0.65rem;color:#555;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.3rem;">Net Profit <span class="dash-tag">all-time</span></div>
          <div style="font-size:1.55rem;font-weight:900;color:<%= netProfitAllTime >= 0 ? 'var(--ps-blue)' : '#ef4444' %>;line-height:1.1;">₱<%= netProfitAllTime.toLocaleString() %></div>
