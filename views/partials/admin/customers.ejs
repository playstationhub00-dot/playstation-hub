  <div class="tab-panel" id="tab-customers">

    <div class="qa-launch">
      <button type="button" class="qa-btn qa-gold" onclick="qaOpen()">⚡ Quick Add</button>
      <span>Records the customer and the order together, and hands you the message to send.</span>
    </div>




    <%
      // Pre-render every message server-side so lib/templates.js stays the
      // single implementation of the substitution rules — the browser only
      // copies a finished string.
      const remPromo = settings.promo || {};
      const tplDeposit = remPromo.deposit != null ? remPromo.deposit : 100;
      const tplLateFee = remPromo.late_fee_per_day != null ? remPromo.late_fee_per_day : 20;
      const renderMsg = (kind, cust, extra) => renderTemplate(kind, cust, messageTemplates, Object.assign({ deposit: tplDeposit, lateFeePerDay: tplLateFee }, extra));
    %>
    <%# Only rendered when something is actually waiting — an empty
        "Needs attention" card every day trains you to ignore it. %>
    <% const qaBought = (typeof boughtWithDuration !== 'undefined' && boughtWithDuration) ? boughtWithDuration : []; %>
    <% const qaStaleEnd = (typeof staleEndDates !== 'undefined' && staleEndDates) ? staleEndDates : []; %>
    <% const qaShort = (typeof rentMismatches !== 'undefined' && rentMismatches) ? rentMismatches : []; %>
    <% if ((typeof unlinkedRentals !== 'undefined' && unlinkedRentals.length) || needsReminder.length || qaBought.length || qaStaleEnd.length || qaShort.length) { %>
    <!-- NEEDS ATTENTION -->
    <div class="adm-card" id="sec-attention">
      <div class="adm-card-head" style="border-left:3px solid #ef4444;">
        <div class="sa-left">
          <div class="sa-icon" style="background:rgba(239,68,68,0.15);">⚠️</div>
          <div><div class="sa-title">Needs attention</div><div class="sa-desc">Rentals due back, and rentals holding a slot the site still shows as free</div></div>
        </div>
      </div>
      <div class="adm-card-body" style="padding:1rem 1.15rem;">
        <%# Rentals occupying no account slot on a game whose availability is
            driven by accounts. Each one is a slot the site is still offering
            to the next customer while somebody is already in it, so this
            sits above the reminders — a double-booking costs more than a
            late return. %>
        <%# Purchases that were recorded as rentals. Above the others because
            the consequence is the loudest: on the end date the site starts
            asking someone who OWNS the game to give it back. %>
        <%# Extensions made before the Extend action existed: the customer row was
            edited by hand, so the order still expires on the original date and
            the sweep asks for a return early. %>
        <% if (qaStaleEnd.length) { %>
        <div class="rem-panel unlinked-panel">
          <div class="rem-title">📅 Extension never reached the order (<%= qaStaleEnd.length %>)</div>
          <div class="unlinked-note">
            These rentals run longer than their order thinks. Left alone, the customer's own link
            counts down to the old date and asks them to return a game they have paid to keep.
            Fixing copies the rental's real end date onto the order — nothing else changes.
          </div>
          <% qaStaleEnd.forEach(o => { %>
          <div class="rem-row">
            <div class="rem-info">
              <span class="rem-name"><%= o.fb_name || 'Unnamed customer' %></span>
              <span class="rem-badge rem-overdue"><%= o.ref %></span>
              <div class="rem-meta"><%= o.game_title || '' %> · order ends <%= o.end_date || '—' %>, rental ends <%= o.customer_end_date %></div>
            </div>
            <form method="POST" action="/admin/orders/<%= o.ref %>/sync-end-date" style="display:inline">
              <button type="submit" class="btn-copy">Fix it</button>
            </form>
          </div>
          <% }) %>
        </div>
        <% } %>
        <% if (qaBought.length) { %>
        <div class="rem-panel unlinked-panel">
          <div class="rem-title">🛒 Bought, but filed as a rental (<%= qaBought.length %>)</div>
          <div class="unlinked-note">
            These carry a rental duration and an end date. On that date the site will ask a
            customer who owns the game to return it. Fixing clears the duration and end date
            and marks the order a purchase — the money and everything else stays.
          </div>
          <% qaBought.forEach(o => { %>
          <div class="rem-row">
            <div class="rem-info">
              <span class="rem-name"><%= o.fb_name || 'Unnamed customer' %></span>
              <span class="rem-badge rem-overdue"><%= o.ref %></span>
              <div class="rem-meta"><%= o.game_title || '' %><%= o.end_date ? ' · would ask for a return on ' + o.end_date : '' %></div>
            </div>
            <form method="POST" action="/admin/orders/<%= o.ref %>/fix-purchase" style="display:inline"
                  class="cst-confirm" data-confirm="File <%= o.ref %> as a purchase? This clears its duration and end date so no return is ever asked for.">
              <button type="submit" class="btn-copy">Fix it</button>
            </form>
          </div>
          <% }) %>
        </div>
        <% } %>
        <%# Rentals charged for a shorter duration than they were booked for.
            Deliberately has no Fix button: there is no single right answer.
            Collecting the difference, shortening their end date, or deciding it
            was a discount you meant to give are all reasonable, and only you
            know which. This lists them; you decide. %>
        <% if (qaShort.length) { %>
        <div class="rem-panel unlinked-panel" id="pzPanel">
          <div class="rem-title">⚖️ Priced short (<span id="pzCount"><%= qaShort.length %></span>)</div>
          <div class="unlinked-note">
            These were charged for a shorter rental than they are booked for — a week's rate
            against a month on the calendar. Read each one before acting: a price you set
            deliberately looks exactly like this, and so does a rental that started before you
            changed the game's prices. Nothing here has been changed for you — hit Ignore
            on any you meant to price that way and it will not come back.
          </div>
          <% qaShort.forEach(m => { %>
          <div class="rem-row">
            <div class="rem-info">
              <span class="rem-name"><%= m.customer_name || 'Unnamed customer' %></span>
              <% if (m.order_ref) { %><span class="rem-badge rem-overdue"><%= m.order_ref %></span><% } %>
              <% if (m.extended) { %><span class="rem-badge">extended since</span><% } %>
              <div class="rem-meta">
                <%= m.game_title || '' %> · paid ₱<%= m.paidPrice.toLocaleString() %><%
                  %><%= m.paidForDays ? ' (' + m.paidForDays + ' day' + (m.paidForDays === 1 ? '' : 's') + ' of rent)' : '' %><%
                  %> but booked for <%= m.recordedDays %> days
              </div>
              <div class="rem-meta">
                <%= m.recordedDays %> days at today's prices is ₱<%= m.expectedPrice.toLocaleString() %>
                · <strong>₱<%= m.shortfall.toLocaleString() %> under</strong><%= m.end_date ? ' · ends ' + m.end_date : '' %>
              </div>
            </div>
            <%# "That price was deliberate." Stores the days and price it was
                said about, so re-pricing this rental later asks again rather
                than riding an old dismissal. %>
            <form method="POST" action="/admin/customers/<%= m.id %>/price-ok" style="display:inline" class="pz-ignore">
              <button type="submit" class="btn-copy">Ignore</button>
            </form>
          </div>
          <% }) %>
          <%# Undo, because a mis-click should not permanently hide money.
              Collapsed: once judged, these are not meant to be read daily. %>
          <% const qaIgnored = (typeof rentIgnored !== 'undefined' && rentIgnored) ? rentIgnored : []; %>
          <% if (qaIgnored.length) { %>
          <details class="rem-ignored">
            <summary><span id="pzIgnCount"><%= qaIgnored.length %></span> ignored — custom prices you've already okayed</summary>
            <% qaIgnored.forEach(g => { %>
            <div class="rem-row">
              <div class="rem-info">
                <span class="rem-name"><%= g.customer_name || 'Unnamed customer' %></span>
                <% if (g.order_ref) { %><span class="rem-badge"><%= g.order_ref %></span><% } %>
                <div class="rem-meta"><%= g.game_title || '' %> · ₱<%= (g.paidPrice || 0).toLocaleString() %> for <%= g.recordedDays %> days<%= g.at ? ' · ignored ' + String(g.at).slice(0, 10) : '' %></div>
              </div>
              <form method="POST" action="/admin/customers/<%= g.id %>/price-recheck" style="display:inline">
                <button type="submit" class="btn-copy">Check again</button>
              </form>
            </div>
            <% }) %>
          </details>
          <% } %>
        </div>
        <% } %>
        <% if (typeof unlinkedRentals !== 'undefined' && unlinkedRentals.length) { %>
        <div class="rem-panel unlinked-panel">
          <div class="rem-title">⚠ Renting, but no account slot linked (<%= unlinkedRentals.length %>)</div>
          <div class="unlinked-note">
            The site still shows these slots as free, so someone else can rent the same one.
            Open each and pick the account slot they're actually on.
          </div>
          <% unlinkedRentals.forEach(u => { %>
          <div class="rem-row">
            <div class="rem-info">
              <span class="rem-name"><%= u.customer_name %></span>
              <span class="rem-badge rem-overdue"><%= u.account_type === 'tr' ? 'Trophy' : u.account_type === 'ps4' ? 'PS4 Primary' : 'Non-Trophy' %></span>
              <div class="rem-meta"><%= u.game_title %><%= u.end_date ? ' · ends ' + u.end_date : '' %></div>
            </div>
            <a class="btn-copy" href="/admin/customers/edit/<%= u.id %>">Assign slot</a>
          </div>
          <% }) %>
        </div>
        <% } %>
        <% if (needsReminder.length) { %>
        <div class="rem-panel">
          <div class="rem-title">🔔 Needs a reminder (<%= needsReminder.length %>)</div>
          <% needsReminder.forEach(r => { %>
          <div class="rem-row">
            <div class="rem-info">
              <span class="rem-name"><%= r.c.customer_name %></span>
              <span class="rem-badge <%= r.dl < 0 ? 'rem-overdue' : r.dl === 0 ? 'rem-today' : 'rem-tomorrow' %>"><%= r.dl < 0 ? 'Overdue by ' + r.overdueBy + 'd' : r.dl === 0 ? 'Due today' : 'Due tomorrow' %></span>
              <div class="rem-meta"><%= r.c.game_title %> · <%= r.c.account_type === 'tr' ? 'Trophy' : r.c.account_type === 'ps4' ? 'PS4 Primary' : 'Non-Trophy' %> · <%= r.c.days %> days</div>
            </div>
            <button type="button" class="rem-copy" data-msg="<%= renderMsg(r.kind, r.c, { daysOverdue: r.overdueBy }) %>"><%= r.dl < 0 ? '📋 Copy overdue notice' : '📋 Copy reminder' %></button>
          </div>
          <% }) %>
        </div>
        <% } %>
      </div>
    </div>
    <% } %>

<div class="adm-card" id="sec-all-customers">
      <div class="adm-card-head" style="border-left:3px solid #60a5fa;">
        <div class="sa-left">
          <div class="sa-icon" style="background:rgba(96,165,250,0.15);">📋</div>
          <div><div class="sa-title">All Customers (<%= customers.length %>)</div><div class="sa-desc">View, filter, edit & manage all rental records</div></div>
        </div>
      </div>
      <div class="adm-card-body">
    <div class="table-card" style="margin-top:0;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.75rem;flex-wrap:wrap;gap:0.5rem;">
        <h2 style="margin:0;border:none;padding:0;">All Customers (<%= customers.length %>)</h2>
        <div style="position:relative;flex:0 0 260px;">
          <input type="text" id="custSearch" placeholder="Search name or game..." oninput="searchCustomers(this.value)"
            style="width:100%;padding:0.45rem 0.9rem 0.45rem 2.2rem;background:#1a1a1a;border:1px solid #333;border-radius:8px;color:#fff;font-size:0.85rem;box-sizing:border-box;">
          <span style="position:absolute;left:0.6rem;top:50%;transform:translateY(-50%);color:#555;font-size:0.9rem;pointer-events:none;">🔍</span>
        </div>
      </div>
      <div style="display:flex;gap:0.5rem;flex-wrap:wrap;margin-bottom:1rem;">
        <button onclick="filterCustomers('all')" id="cf-all" class="btn btn-outline" style="padding:0.3rem 0.85rem;font-size:0.78rem;font-weight:700;">All</button>
        <button onclick="filterCustomers('renting')" id="cf-renting" class="btn btn-outline" style="padding:0.3rem 0.85rem;font-size:0.78rem;font-weight:700;border-color:#166534;color:#22c55e;">🟢 Renting</button>
        <button onclick="filterCustomers('reservation')" id="cf-reservation" class="btn btn-outline" style="padding:0.3rem 0.85rem;font-size:0.78rem;font-weight:700;border-color:#4a1a6a;color:#c084fc;">🔖 Reservation</button>
        <button onclick="filterCustomers('bought')" id="cf-bought" class="btn btn-outline" style="padding:0.3rem 0.85rem;font-size:0.78rem;font-weight:700;border-color:#1e3a5f;color:#60a5fa;">🛒 Bought</button>
        <% if (showHistory) { %>
        <button onclick="filterCustomers('done')" id="cf-done" class="btn btn-outline" style="padding:0.3rem 0.85rem;font-size:0.78rem;font-weight:700;">✅ Done</button>
        <a href="/admin?tab=customers" class="btn btn-outline" style="padding:0.3rem 0.85rem;font-size:0.78rem;font-weight:700;text-decoration:none;margin-left:auto;">⚡ Hide finished (faster)</a>
        <% } else { %>
        <a href="/admin?tab=customers&history=1" class="btn btn-outline" style="padding:0.3rem 0.85rem;font-size:0.78rem;font-weight:700;text-decoration:none;margin-left:auto;">✅ Show finished (<%= customers.filter(c => c.status === 'done').length %>)</a>
        <% } %>
      </div>
      <% if (!showHistory) { %>
      <div style="font-size:0.78rem;color:#555;margin-bottom:0.85rem;">
        Showing live rentals only. <%= customers.filter(c => c.status === 'done').length %> finished rentals are hidden to keep this page fast — all totals and reports still include them.
      </div>
      <% } %>

      <% if (customers.length === 0) { %>
        <div style="padding:2rem;text-align:center;color:#444;font-style:italic;">No customers yet. Add one above!</div>
      <% } else { %>
            <%
      // Which account slot each customer currently occupies. Built once as a
      // lookup rather than scanning every account per row — this table runs to
      // hundreds of rows.
      const CST_SLOT_BY_CUSTOMER = {};
      (accounts || []).forEach(a => {
        ['trophy','non_trophy','ps4_primary'].forEach(t => {
          const sl = a.slots && a.slots[t];
          if (sl && sl.renter_id) {
            CST_SLOT_BY_CUSTOMER[sl.renter_id] = {
              assign: a.id + ':' + t,
              label: a.label + ' · ' + ({ trophy:'🏆', non_trophy:'🎮', ps4_primary:'🕹️' }[t] || t)
            };
          }
        });
      });
      const custSlotAssign = id => (CST_SLOT_BY_CUSTOMER[id] || {}).assign || '';
      const custSlotLabel = id => (CST_SLOT_BY_CUSTOMER[id] || {}).label || '';
    %>
    <%# needsReminder is computed once in server.js (shared with the
                dashboard's "Needs you now" summary) so the two can never
                disagree about who is due. %>
      <div style="max-height:520px;overflow-y:auto;overflow-x:auto;border-radius:8px;">
        <table class="games-table" id="customersTable">
          <thead>
            <tr>
              <th>Customer</th>
              <th>Game</th>
              <th>Duration</th>
              <th>Type</th>
              <th>Start</th>
              <th>End</th>
              <th>Price</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <%
              // Only the rendered rows are narrowed — `customers` itself stays whole
              // so every count, total, and dashboard figure above is unaffected.
              const tableCustomers = showHistory ? customers : customers.filter(c => c.status !== 'done');
            %>
            <% tableCustomers.forEach(c => {
              const isRenting = c.status === 'renting';
              const isBought = c.status === 'bought';
              const isReservation = c.status === 'reservation';
              const endDate = c.end_date ? new Date(c.end_date + 'T00:00:00') : null;
              const today = new Date(); today.setHours(0,0,0,0);
              const isOverdue = isRenting && endDate && endDate < today;
              const daysLeft = endDate ? Math.ceil((endDate - today) / 86400000) : null;
            %>
            <tr class="cust-row" data-status="<%= c.status %>" data-name="<%= c.customer_name.toLowerCase() %>" data-game="<%= c.game_title.toLowerCase() %>" style="<%= isOverdue ? 'background:rgba(239,68,68,0.06);' : '' %>">
              <td>
                <div style="font-weight:700;"><%= c.customer_name %></div>
                <% if (c.notes) { %><div style="font-size:0.7rem;color:#555;margin-top:0.15rem;"><%= c.notes %></div><% } %>
              </td>
              <td style="font-size:0.85rem;">
                <strong><%= c.game_title %></strong>
                <% if (isReservation && String(c.game_id).startsWith('upcoming_')) { %>
                <div style="margin-top:0.2rem;"><span style="background:linear-gradient(135deg,rgba(74,0,128,0.3),rgba(241,7,163,0.2));border:1px solid #5a2a8a;border-radius:6px;padding:0.1rem 0.45rem;font-size:0.65rem;color:#a855f7;font-weight:700;">🔜 Coming Soon</span></div>
                <% } %>
                <% if (c.swap_history && c.swap_history.length) { const lastSwap = c.swap_history[c.swap_history.length - 1]; %>
                <div style="margin-top:0.2rem;font-size:0.68rem;color:#888;" title="Swapped from <%= lastSwap.from_game_title %> to <%= lastSwap.to_game_title %> on <%= new Date(lastSwap.at).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) %>">
                  🔄 Swapped from <%= lastSwap.from_game_title %><% if (lastSwap.top_up > 0) { %> <span style="color:#fbbf24;font-weight:700;">(+₱<%= lastSwap.top_up %>)</span><% } %>
                </div>
                <% } %>
              </td>
              <td style="color:#aaa;font-size:0.85rem;"><%= (isBought || isReservation) ? '—' : c.days + ' days' %></td>
              <td>
                <% if (c.account_type === 'tr') { %>
                  <span style="color:#ffc400;font-size:0.78rem;font-weight:700;">🏆 Trophy</span>
                <% } else if (c.account_type === 'ps4') { %>
                  <span style="color:#60a5fa;font-size:0.78rem;font-weight:700;">🕹️ PS4 Primary</span>
                <% } else { %>
                  <span style="color:#aaa;font-size:0.78rem;">🎮 Non-Trophy</span>
                <% } %>
              </td>
              <td style="font-size:0.82rem;color:#aaa;"><%= c.start_date ? new Date(c.start_date+'T00:00:00').toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) : '—' %></td>
              <td style="font-size:0.82rem;">
                <% if (c.end_date) { %>
                  <span style="color:<%= isOverdue ? '#ef4444' : (daysLeft !== null && daysLeft <= 2 && isRenting ? '#f59e0b' : '#aaa') %>;">
                    <%= new Date(c.end_date+'T00:00:00').toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) %>
                  </span>
                  <% if (isRenting && daysLeft !== null) { %>
                    <div style="font-size:0.68rem;color:<%= isOverdue ? '#ef4444' : (daysLeft <= 2 ? '#f59e0b' : '#555') %>;">
                      <%= isOverdue ? 'Overdue by '+Math.abs(daysLeft)+'d' : daysLeft === 0 ? 'Due today' : daysLeft+'d left' %>
                    </div>
                  <% } %>
                <% } else { %>—<% } %>
              </td>
              <td style="font-weight:700;color:var(--ps-blue);">₱<%= c.price || 0 %></td>
              <td>
                <form method="POST" action="/admin/customers/status/<%= c.id %>" style="display:inline;">
                  <% if (isRenting) { %>
                    <input type="hidden" name="status" value="done">
                    <button type="submit" class="cst-done" title="Finish this rental and free its account slot">✓ Mark done</button>
                  <% } else if (isReservation) { %>
                    <span style="background:#2d1a4a;color:#c084fc;border-radius:20px;padding:0.25rem 0.7rem;font-size:0.72rem;font-weight:700;white-space:nowrap;">🔖 Reserved</span>
                  <% } else if (isBought) { %>
                    <span style="background:#1e3a5f;color:#60a5fa;border-radius:20px;padding:0.25rem 0.7rem;font-size:0.72rem;font-weight:700;white-space:nowrap;">🛒 Bought</span>
                  <% } else { %>
                    <input type="hidden" name="status" value="renting">
                    <button type="submit" class="cst-undone" title="Put this rental back to renting">✅ Done · undo</button>
                  <% } %>
                </form>
              </td>
              <td>
                <div class="action-btns">
                  <% if (isRenting || isReservation) { %>
                  <button type="button" class="btn-copy rem-copy" data-msg="<%= renderMsg('confirmation', c) %>" title="Copy confirmation message">📋</button>
                  <% } %>
                  <%# Extending was three fields on the edit form that nothing kept
                      in agreement. One action now: extra days, price, new end
                      date, and the message that says it was an extension. %>
                  <% if (isRenting) { %>
                  <% const xtT = (typeof extendTiers !== 'undefined' && extendTiers[c.id]) ? extendTiers[c.id] : { p7: 0, p30: 0 }; %>
                  <button type="button" class="btn-copy cst-extend" title="Extend this rental"
                    data-id="<%= c.id %>" data-name="<%= c.customer_name || '' %>" data-game="<%= c.game_title || '' %>"
                    data-end="<%= c.end_date || '' %>" data-p7="<%= xtT.p7 %>" data-p30="<%= xtT.p30 %>"
                    data-today="<%= typeof todayManila !== 'undefined' ? todayManila : '' %>">⏩ Extend</button>
                  <% } %>
                  <%# Once they're done, the useful message is the thank-you that
                      carries the review ask — the confirmation no longer applies. %>
                  <% if (c.status === 'done') { %>
                  <button type="button" class="btn-copy rem-copy" data-msg="<%= renderMsg('return_complete', c) %>" title="Copy thank-you + review ask">⭐</button>
                  <% } %>
                  <%# Changing which account a live rental sits on was the last routine
                      reason to open a fifteen-field form. It is a dropdown now. %>
                  <% if (isRenting || isBought) { %>
                  <details class="cst-slot">
                    <summary title="Move to a different account slot">🗂️ <%= custSlotLabel(c.id) || 'No slot' %></summary>
                    <form method="POST" action="/admin/customers/<%= c.id %>/slot" class="cst-slot-form">
                      <select name="account_assign">
                        <option value="">— No slot —</option>
                        <% const CST_SLOT = { trophy:'🏆 Trophy', non_trophy:'🎮 Non-Trophy', ps4_primary:'🕹️ PS4 Primary' }; %>
                        <% const curAssign = custSlotAssign(c.id); %>
                        <% (accounts || []).forEach(a => { ['trophy','non_trophy','ps4_primary'].forEach(t => {
                             const sl = a.slots && a.slots[t];
                             if (!sl || !sl.enabled) return;
                             const val = a.id + ':' + t;
                             // Its own slot stays listed so the current one is visible and
                             // re-picking it is a no-op rather than an error.
                             if (sl.status !== 'open' && val !== curAssign) return; %>
                        <option value="<%= val %>" <%= val === curAssign ? 'selected' : '' %>><%= a.label %> — <%= CST_SLOT[t] %></option>
                        <% }) }) %>
                      </select>
                      <button type="submit">Move</button>
                    </form>
                  </details>
                  <% } %>
                  <a href="/admin/customers/edit/<%= c.id %>" class="btn-edit">✏️ Edit</a>
                  <%# Names the order too. A rental is recorded in two places —
                      a customer row carrying payments[], and an order carrying
                      amount_due — and deleting one used to leave the other's
                      money on the books. Both go now, so the dialog says so. %>
                  <%# The confirmation text rides in a data-* attribute read by the
                      delegated handler below, NOT inline in onsubmit. An earlier
                      version interpolated raw JSON.stringify into a double-quoted
                      onsubmit — JSON's own quotes closed the attribute, so the
                      dialog was broken for every customer, and a name containing a
                      quote could inject a live event handler. customer_name is the
                      fb_name typed on the public order form, so that is reachable
                      by anyone who can place an order. EJS escaping applies here. %>
                  <form method="POST" action="/admin/customers/delete/<%= c.id %>" style="display:inline" class="cst-confirm"
                        data-confirm="Delete <%= c.customer_name %>?<%= c.order_ref ? ' This also deletes order ' + c.order_ref + ' and takes its \u20b1' + (c.price || 0) + ' out of your monthly totals.' : '' %>">
                    <button type="submit" class="btn-delete">🗑</button>
                  </form>
                </div>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>

    <script>
    let _custStatus = 'all';
    function filterCustomers(status) {
      _custStatus = status;
      applyCustomerFilter();
      ['all','renting','reservation','bought','done'].forEach(s => {
        const btn = document.getElementById('cf-'+s);
        if (!btn) return;
        btn.style.background = s === status ? 'var(--ps-blue)' : '';
        btn.style.color = s === status ? '#000' : '';
        btn.style.borderColor = s === status ? 'var(--ps-blue)' : '';
      });
    }
    function searchCustomers(q) { applyCustomerFilter(); }
    function applyCustomerFilter() {
      const q = (document.getElementById('custSearch')?.value || '').toLowerCase().trim();
      document.querySelectorAll('.cust-row').forEach(r => {
        const statusOk = _custStatus === 'all' || r.dataset.status === _custStatus;
        const searchOk = !q || r.dataset.name.includes(q) || r.dataset.game.includes(q);
        r.style.display = (statusOk && searchOk) ? '' : 'none';
      });
    }
    </script>
    <script>
    (function(){
      // navigator.clipboard needs a secure context. Production is HTTPS so this
      // works, but on plain-http localhost the API is absent — fall back to a
      // visible textarea the owner can copy from manually rather than doing nothing.
      function fallbackCopy(text, btn) {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.cssText = 'position:fixed;left:1rem;right:1rem;bottom:1rem;height:9rem;z-index:9999;font-size:0.8rem;';
        document.body.appendChild(ta);
        ta.select();
        let ok = false;
        try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
        if (ok) { ta.remove(); flash(btn, '✅ Copied'); }
        else { flash(btn, '⬇ Copy from the box'); setTimeout(() => ta.remove(), 15000); }
      }
      function flash(btn, text) {
        if (!btn.dataset.original) btn.dataset.original = btn.textContent;
        const original = btn.dataset.original;
        btn.textContent = text;
        clearTimeout(btn._flashTimer);
        btn._flashTimer = setTimeout(() => { btn.textContent = original; }, 1800);
      }
      // Confirmation text comes from a data-* attribute so EJS escapes it. An
      // inline onsubmit with interpolated values is what broke, and what let a
      // customer name inject an attribute.
      document.addEventListener('submit', function(e){
        const form = e.target.closest('.cst-confirm');
        if (!form) return;
        if (!confirm(form.dataset.confirm || 'Are you sure?')) e.preventDefault();
      });

      document.addEventListener('click', function(e){
        const x = e.target.closest('.cst-extend');
        if (!x) return;
        xtOpen({
          id: x.dataset.id,
          name: x.dataset.name || '',
          game: x.dataset.game || '',
          end: x.dataset.end || '',
          p7: parseInt(x.dataset.p7) || 0,
          p30: parseInt(x.dataset.p30) || 0,
          today: x.dataset.today || ''
        });
      });

      document.addEventListener('click', function(e){
        const btn = e.target.closest('.rem-copy');
        if (!btn) return;
        const msg = btn.dataset.msg || '';
        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(msg).then(() => flash(btn, '✅ Copied')).catch(() => fallbackCopy(msg, btn));
        } else {
          fallbackCopy(msg, btn);
        }
      });
    })();
    </script>
