  <div class="dash-pane<%= (typeof dashSub !== 'undefined' && dashSub === 'site') ? ' active' : '' %>" id="dsub-site">
    <style>
      .tr-bar { display:flex; align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:12px; }
      .tr-seg { display:flex; border:1px solid #333; border-radius:10px; overflow:hidden; }
      .tr-seg button { background:#141414; color:#ddd; border:0; border-right:1px solid #333; padding:7px 14px; font-weight:700; font-size:13px; cursor:pointer; }
      .tr-seg button:last-child { border-right:0; }
      .tr-seg button.on { background:#F5B800; color:#0a0a0a; }
      .tr-cmp { font-size:13px; color:#d0d0d0; border:1px solid #333; border-radius:10px; padding:7px 12px; }
      .tr-cmp b { color:#fff; }
      .tr-custom { display:flex; align-items:flex-end; gap:8px; flex-wrap:wrap; margin:0 0 12px; }
      .tr-custom[hidden] { display:none; }
      .tr-custom label { font-size:12px; font-weight:700; color:#d0d0d0; display:flex; flex-direction:column; gap:4px; }
      .tr-custom input { background:#141414; color:#fff; border:1px solid #333; border-radius:8px; padding:6px 8px; font-size:13px; }
      .tr-custom button { height:32px; }
      .tr-ban { background:#0f2135; border:1px solid #23466e; color:#d7e6ff; border-radius:12px; padding:10px 14px; font-size:13.5px; margin-bottom:14px; line-height:1.45; }
      .tr-ban b { color:#9ec7ff; }
      .tr-kpis { display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin-bottom:14px; }
      .tr-kpi { background:#171717; border:1px solid #2a2a2a; border-radius:14px; padding:14px 16px; }
      .tr-kpi .k { font-size:13px; color:#c8c8c8; font-weight:700; }
      .tr-kpi .v { font-size:26px; font-weight:800; color:#fff; margin:4px 0 2px; }
      .tr-kpi .s { font-size:12.5px; color:#c8c8c8; }
      .tr-up { color:#6fe39a; font-weight:700; }
      .tr-dn { color:#ff9a7a; font-weight:700; }
      .tr-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:14px; }
      .tr-card { background:#171717; border:1px solid #2a2a2a; border-radius:14px; padding:16px 18px; min-width:0; }
      .tr-card h3 { font-size:15px; font-weight:800; color:#fff; margin:0 0 8px; display:flex; align-items:center; gap:8px; }
      .tr-cap { font-size:13.5px; line-height:1.45; color:#e6e6e6; font-weight:600; margin:0 0 12px; }
      .tr-src { margin-bottom:10px; }
      .tr-src-l { display:flex; justify-content:space-between; gap:8px; font-size:13.5px; color:#eee; }
      .tr-src-l b { font-weight:700; white-space:nowrap; }
      .tr-barline { height:7px; background:#262626; border-radius:4px; margin-top:4px; overflow:hidden; }
      .tr-barline i { display:block; height:100%; background:#F5B800; border-radius:4px; }
      .tr-sub { font-size:12px; text-transform:uppercase; letter-spacing:.8px; color:#c8c8c8; font-weight:700; margin:12px 0 8px; }
      .tr-fn { display:flex; gap:8px; }
      .tr-fn div { flex:1; background:#121212; border:1px solid #262626; border-radius:10px; padding:10px 8px; text-align:center; font-size:12px; color:#c8c8c8; }
      .tr-fn b { display:block; font-size:20px; color:#fff; }
      .tr-table { width:100%; border-collapse:collapse; font-size:13.5px; }
      .tr-table th { text-align:left; font-size:12px; text-transform:uppercase; letter-spacing:.6px; color:#c8c8c8; font-weight:700; padding:8px 6px; border-bottom:1px solid #2a2a2a; }
      .tr-table td { padding:8px 6px; border-bottom:1px solid #232323; color:#eee; }
      .tr-table .r { text-align:right; }
      .tr-empty { color:#d0d0d0; font-size:13.5px; padding:8px 0; }
      .tr-more { margin-top:4px; }
      .tr-chart { display:flex; align-items:flex-end; gap:4px; height:120px; }
      .tr-col { flex:1; display:flex; flex-direction:column; align-items:center; height:100%; cursor:pointer; background:transparent; border:0; color:inherit; padding:0; min-width:0; }
      .tr-col .n { font-size:11px; color:#d0d0d0; font-weight:700; }
      .tr-col .plot { flex:1; width:100%; display:flex; align-items:flex-end; }
      .tr-col .fill { width:100%; background:rgba(245,184,0,0.35); border-top:2px solid #F5B800; border-radius:4px 4px 0 0; min-height:2px; }
      .tr-col.on .fill { background:#F5B800; }
      .tr-col .d { font-size:10px; color:#d0d0d0; text-align:center; line-height:1.2; }
      .tr-scroll { max-height:420px; overflow:auto; }
      @media (max-width: 900px) {
        .tr-kpis, .tr-grid { grid-template-columns:1fr 1fr; }
        .tr-fn { flex-wrap:wrap; }
        .tr-fn div { flex:1 1 40%; }
      }
      @media (max-width: 640px) {
        .tr-kpis, .tr-grid { grid-template-columns:1fr; }
        .tr-seg { width:100%; }
        .tr-seg button { flex:1; padding:7px 6px; }
      }
      body.light-mode .tr-seg { border-color:#d5dbe1; }
      body.light-mode .tr-seg button { background:#fff; color:#3f464d; border-right-color:#e0e4e8; }
      body.light-mode .tr-seg button.on { background:#F5B800; color:#0a0a0a; }
      body.light-mode .tr-cmp, body.light-mode .tr-cap, body.light-mode .tr-empty, body.light-mode .tr-kpi .s, body.light-mode .tr-kpi .k { color:#3f464d; }
      body.light-mode .tr-cmp b, body.light-mode .tr-kpi .v, body.light-mode .tr-card h3, body.light-mode .tr-src-l, body.light-mode .tr-fn b, body.light-mode .tr-table td { color:#14171a; }
      body.light-mode .tr-kpi, body.light-mode .tr-card { background:#fff; border-color:#e6e9ec; }
      body.light-mode .tr-ban { background:#eef5ff; border-color:#c5d7f2; color:#1d3b66; }
      body.light-mode .tr-ban b { color:#1d4e89; }
      body.light-mode .tr-fn div { background:#f7f8fa; border-color:#e6e9ec; color:#5b636c; }
      body.light-mode .tr-custom input { background:#fff; color:#14171a; border-color:#d5dbe1; }
      body.light-mode .tr-table th, body.light-mode .tr-sub { color:#5b636c; }
      body.light-mode .tr-table td { border-bottom-color:#eef0f2; }
    </style>

    <div class="tr-bar">
      <div class="tr-seg" role="group" aria-label="Traffic period">
        <button type="button" data-tr="today">Today</button>
        <button type="button" data-tr="week">7 days</button>
        <button type="button" data-tr="month">30 days</button>
        <button type="button" data-tr="custom">Custom</button>
      </div>
      <span class="tr-cmp" id="trCompare"></span>
    </div>
    <form method="GET" action="/admin" class="tr-custom" id="trCustom" hidden>
      <input type="hidden" name="tab" value="dashboard">
      <input type="hidden" name="sub" value="site">
      <label>From <input type="date" name="tfrom" value="<%= typeof trafficFrom !== 'undefined' ? trafficFrom : '' %>"></label>
      <label>To <input type="date" name="tto" value="<%= typeof trafficTo !== 'undefined' ? trafficTo : '' %>"></label>
      <button type="submit" class="adm-btn adm-btn-sm">Apply</button>
      <button type="button" class="adm-btn adm-btn-secondary adm-btn-sm" data-tr-extra="year">Past year</button>
      <button type="button" class="adm-btn adm-btn-secondary adm-btn-sm" data-tr-extra="all">All time</button>
    </form>

    <div class="tr-ban"><b>Shop visit log.</b> These numbers are counted on this site. A Google Analytics feed is not connected, so nothing here is a GA4 report. <span id="trBots"></span></div>

    <div class="tr-kpis">
      <div class="tr-kpi"><div class="k">Real visitors</div><div class="v" id="trVisitors">0</div><div class="s" id="trVisitorsDelta"></div><div class="s" id="trBotsLine"></div></div>
      <div class="tr-kpi"><div class="k">Site conversion</div><div class="v" id="trConv">0%</div><div class="s" id="trConvDelta"></div><div class="s">Visitors to paid orders</div></div>
      <div class="tr-kpi"><div class="k">Orders from website</div><div class="v" id="trOrders">0 of 0</div><div class="s" id="trOrdersSub"></div><div class="s">The rest have no site session</div></div>
      <div class="tr-kpi"><div class="k">Message Us taps</div><div class="v" id="trMsg">0</div><div class="s" id="trMsgDelta"></div><div class="s">On the site. No Messenger inbox tag.</div></div>
    </div>

    <div class="tr-grid">
      <div class="tr-card">
        <h3>Sources, real visitors</h3>
        <p class="tr-cap">First visit of each session. Campaign names come from the link that brought them.</p>
        <div id="trSources"></div>
        <div class="tr-sub">Funnel</div>
        <div class="tr-fn" id="trFunnel"></div>
      </div>
      <div class="tr-card">
        <h3>Top UTM campaigns</h3>
        <p class="tr-cap">Visits are sessions. Orders and revenue are joined when that session placed an order. Revenue is the paid amount, without the deposit.</p>
        <div id="trCampaigns"></div>
      </div>
    </div>

    <div class="tr-card tr-more">
      <h3>More from this period</h3>
      <p class="tr-cap">Same period as the control above. Scanner paths and order status checks are left out.</p>
      <div class="vf-grid">
        <div class="vf-panel">
          <div class="vf-panel-label">Funnel</div>
          <div class="vf-browsed" id="vfBrowsedStat"></div>
          <div id="vfFunnelBody"></div>
        </div>
        <div class="vf-panel">
          <div class="vf-panel-label">Top exit pages</div>
          <div id="vfExitBody"></div>
        </div>
      </div>
      <div class="vf-grid" style="margin-top:12px;">
        <div class="vf-panel">
          <div class="vf-panel-label">Most asked-about games</div>
          <div id="vfAskedBody"></div>
        </div>
        <div class="vf-panel" id="vfMissesPanel">
          <div class="vf-panel-label">Searched, nothing found</div>
          <div id="vfMissesBody"></div>
        </div>
      </div>
      <div class="tr-grid" style="margin-top:12px;">
        <div>
          <div class="tr-sub">Most visited pages</div>
          <div id="topPagesBody"></div>
        </div>
        <div>
          <div class="tr-sub">Last 14 days</div>
          <p class="tr-cap">Click a day to use it as the period.</p>
          <div class="tr-chart" id="trChart">
            <% const chart = (typeof trafficChart !== 'undefined' && trafficChart) ? trafficChart : []; %>
            <% const chartMax = Math.max.apply(null, chart.map(function (d) { return d.count; }).concat([1])); %>
            <% chart.forEach(function (day) { %>
            <button type="button" class="tr-col" data-date="<%= day.date %>" data-label="<%= day.label %>">
              <span class="n"><%= day.count %></span>
              <span class="plot"><span class="fill" style="height:<%= day.count > 0 ? Math.max(4, Math.round((day.count / chartMax) * 78)) : 2 %>px"></span></span>
              <span class="d"><%= day.label %></span>
            </button>
            <% }) %>
          </div>
        </div>
      </div>
      <div class="tr-sub">Recent visits</div>
      <p class="tr-cap">The same page in a row, in one session, is one line. Order status checks are not listed.</p>
      <div class="tr-scroll">
        <table class="tr-table">
          <thead><tr><th>Page</th><th>Date</th><th>Time</th><th>Session</th></tr></thead>
          <tbody id="recentVisitsBody"></tbody>
        </table>
      </div>
    </div>

    <script src="/js/dashboard-visitors.js?v=<%= assetV %>"></script>
    <script>
    const VIS_WINDOWS = <%- JSON.stringify(VIS_WINDOWS).replace(/</g, '\\u003c') %>;

    function escHtml(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
        return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c];
      });
    }
    function peso(n) {
      return '₱' + Math.round(Number(n) || 0).toLocaleString('en-US');
    }
    function deltaHtml(text, n) {
      if (!text) return '';
      var cls = n > 0 ? 'tr-up' : (n < 0 ? 'tr-dn' : '');
      return '<span class="' + cls + '">' + escHtml(text) + '</span>';
    }
    function pctText(n) {
      if (n == null) return '';
      if (n === 0) return 'Same as the previous period';
      return (n > 0 ? '+' : '') + n + '% vs previous';
    }
    function ptsText(n) {
      if (n == null) return '';
      if (n === 0) return 'Same as the previous period';
      return (n > 0 ? '+' : '') + n + ' pts';
    }
    function absText(n) {
      if (n == null) return '';
      if (n === 0) return 'Same as the previous period';
      return (n > 0 ? '+' : '') + n + ' vs previous';
    }
    function stageCount(win, label) {
      var row = (win.funnel || []).filter(function (s) { return s.label === label; })[0];
      return row ? row.count : 0;
    }

    function renderSources(win) {
      var host = document.getElementById('trSources');
      var rows = win.sources || [];
      if (!rows.length) {
        host.innerHTML = '<div class="tr-empty">No real visits in this period.</div>';
        return;
      }
      host.innerHTML = rows.map(function (s) {
        return '<div class="tr-src"><div class="tr-src-l"><span>' + escHtml(s.label) + '</span><b>' +
          s.count.toLocaleString('en-US') + ' · ' + s.pct + '%</b></div><div class="tr-barline"><i style="width:' +
          Math.max(0, Math.min(100, s.pct)) + '%"></i></div></div>';
      }).join('');
    }
    function renderFunnelBoxes(win) {
      var boxes = [
        ['Visits', stageCount(win, 'Landed')],
        ['Game page', stageCount(win, 'Viewed a game')],
        ['Checkout', stageCount(win, 'Ordered on website')],
        ['Paid', stageCount(win, 'Paid')]
      ];
      document.getElementById('trFunnel').innerHTML = boxes.map(function (b) {
        return '<div>' + escHtml(b[0]) + '<b>' + Number(b[1]).toLocaleString('en-US') + '</b></div>';
      }).join('');
    }
    function renderCampaigns(win) {
      var host = document.getElementById('trCampaigns');
      var rows = win.campaigns || [];
      if (!rows.length) {
        host.innerHTML = '<div class="tr-empty">No campaign names on visits in this period. Names come from the link that brought them.</div>';
        return;
      }
      host.innerHTML = '<table class="tr-table"><thead><tr><th>Campaign</th><th class="r">Visits</th><th class="r">Orders</th><th class="r">Revenue</th></tr></thead><tbody>' +
        rows.map(function (c) {
          return '<tr><td>' + escHtml(c.campaign) + '</td><td class="r">' + c.visits + '</td><td class="r">' +
            c.orders + '</td><td class="r">' + peso(c.revenue) + '</td></tr>';
        }).join('') + '</tbody></table>';
    }
    function renderKpis(win) {
      var k = win.kpis || {};
      document.getElementById('trVisitors').textContent = (k.visitors || 0).toLocaleString('en-US');
      document.getElementById('trVisitorsDelta').innerHTML = deltaHtml(pctText(k.visitorsDelta), k.visitorsDelta);
      document.getElementById('trBotsLine').textContent = 'Bots hidden: ' + (k.botsHidden || 0).toLocaleString('en-US');
      document.getElementById('trBots').textContent = 'Bots hidden: ' + (k.botsHidden || 0).toLocaleString('en-US') + '.';
      document.getElementById('trConv').textContent = k.conversion == null ? 'n/a' : (k.conversion + '%');
      document.getElementById('trConvDelta').innerHTML = deltaHtml(ptsText(k.conversionDelta), k.conversionDelta);
      document.getElementById('trOrders').textContent = (k.websiteOrders || 0) + ' of ' + (k.allOrders || 0);
      var share = k.allOrders ? Math.round((k.websiteOrders / k.allOrders) * 100) : 0;
      document.getElementById('trOrdersSub').textContent = share + '% from the site';
      document.getElementById('trMsg').textContent = (k.messenger || 0).toLocaleString('en-US');
      document.getElementById('trMsgDelta').innerHTML = deltaHtml(absText(k.messengerDelta), k.messengerDelta);
      document.getElementById('trCompare').textContent = win.compareLabel || '';
    }
    function renderTopPages(pages) {
      var body = document.getElementById('topPagesBody');
      if (!pages || !pages.length) {
        body.innerHTML = '<div class="tr-empty">No pages in this period.</div>';
        return;
      }
      var maxCount = pages[0][1] || 1;
      body.innerHTML = pages.map(function (row) {
        var page = row[0], count = row[1];
        return '<div class="tr-src"><div class="tr-src-l"><span>' + escHtml(page) + '</span><b>' + count +
          '</b></div><div class="tr-barline"><i style="width:' + Math.round((count / maxCount) * 100) + '%"></i></div></div>';
      }).join('');
    }
    function renderExitPages(win) {
      var body = document.getElementById('vfExitBody');
      var pages = (win && win.exitPages) || [];
      if (!pages.length) {
        body.innerHTML = '<div class="vf-empty">Nothing to show yet.</div>';
        return;
      }
      body.innerHTML = pages.map(function (ep) {
        return '<div class="vf-exit-row"><span class="vf-exit-path">' + escHtml(ep.path) + '</span><span class="vf-exit-n"><strong>' +
          ep.count + '</strong> session' + (ep.count === 1 ? '' : 's') + '</span></div>';
      }).join('');
    }
    function renderRecent(rows) {
      var body = document.getElementById('recentVisitsBody');
      if (!body) return;
      if (!rows || !rows.length) {
        body.innerHTML = '<tr><td colspan="4" class="tr-empty">No visits in this period.</td></tr>';
        return;
      }
      body.innerHTML = rows.map(function (v) {
        var when = v.time ? new Date(v.time).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) : '';
        var times = v.times > 1 ? ' <span style="color:#c8c8c8;">(' + v.times + ' times)</span>' : '';
        var sid = v.session_id ? escHtml(String(v.session_id).slice(0, 12)) : '';
        return '<tr><td>' + escHtml(v.page || v.path) + times + '</td><td>' + escHtml(v.date || '') +
          '</td><td>' + escHtml(when) + '</td><td style="font-family:monospace;">' + sid + '</td></tr>';
      }).join('');
    }
    function renderDetail(win) {
      var browsedEl = document.getElementById('vfBrowsedStat');
      if (!win || !win.funnel || !win.funnel.length || win.funnel[0].count === 0) {
        browsedEl.innerHTML = win && win.skipped > 0 ? '<strong>' + win.skipped + '</strong> robot / system hits not counted' : '';
        document.getElementById('vfFunnelBody').innerHTML = '<div class="vf-empty">No tracked sessions in this period.</div>';
      } else {
        browsedEl.innerHTML = DashVisitors.browsedHtml(win);
        document.getElementById('vfFunnelBody').innerHTML = DashVisitors.funnelHtml(win);
      }
      document.getElementById('vfAskedBody').innerHTML = DashVisitors.askedHtml(win);
      var missesHtml = DashVisitors.missesHtml(win);
      document.getElementById('vfMissesBody').innerHTML = missesHtml;
      document.getElementById('vfMissesPanel').style.display = missesHtml ? '' : 'none';
      renderExitPages(win);
      renderTopPages(win && win.topPages ? win.topPages : []);
      renderRecent(win && win.recent ? win.recent : []);
    }
    function markPeriod(key) {
      var main = { today: 'today', week: 'week', month: 'month' };
      var shown = main[key] || 'custom';
      document.querySelectorAll('#dsub-site [data-tr]').forEach(function (b) {
        b.classList.toggle('on', b.getAttribute('data-tr') === shown);
      });
      var box = document.getElementById('trCustom');
      if (box) box.hidden = shown !== 'custom';
      document.querySelectorAll('#trChart .tr-col').forEach(function (col) {
        col.classList.toggle('on', key === 'day:' + col.getAttribute('data-date'));
      });
    }
    function applyWindow(key, win) {
      if (!win) return;
      markPeriod(key);
      renderKpis(win);
      renderSources(win);
      renderFunnelBoxes(win);
      renderCampaigns(win);
      renderDetail(win);
    }
    function setTrafficPeriod(key) {
      if (key === 'custom') {
        if (VIS_WINDOWS.custom) applyWindow('custom', VIS_WINDOWS.custom);
        else {
          var box = document.getElementById('trCustom');
          if (box) box.hidden = false;
        }
        return;
      }
      var win = VIS_WINDOWS[key];
      if (!win) return;
      applyWindow(key, win);
    }
    function filterVisitsByDate(date, label) {
      var win = VIS_WINDOWS.byDate && VIS_WINDOWS.byDate[date];
      if (win) applyWindow('day:' + date, win);
      else markPeriod('day:' + date);
      var tbody = document.getElementById('recentVisitsBody');
      if (!tbody) return;
      tbody.innerHTML = '<tr><td colspan="4" class="tr-empty">Loading ' + escHtml(label || date) + '...</td></tr>';
      fetch('/admin/api/visitors-by-date?date=' + encodeURIComponent(date))
        .then(function (r) { return r.json(); })
        .then(function (rows) { renderRecent(rows); })
        .catch(function () {
          tbody.innerHTML = '<tr><td colspan="4" class="tr-empty">Could not load that day.</td></tr>';
        });
    }
    document.querySelectorAll('#dsub-site [data-tr]').forEach(function (b) {
      b.addEventListener('click', function () { setTrafficPeriod(b.getAttribute('data-tr')); });
    });
    document.querySelectorAll('#dsub-site [data-tr-extra]').forEach(function (b) {
      b.addEventListener('click', function () { setTrafficPeriod(b.getAttribute('data-tr-extra')); });
    });
    var chart = document.getElementById('trChart');
    if (chart) chart.addEventListener('click', function (e) {
      var col = e.target.closest ? e.target.closest('[data-date]') : null;
      if (!col) return;
      filterVisitsByDate(col.getAttribute('data-date'), col.getAttribute('data-label'));
    });
    setTrafficPeriod(VIS_WINDOWS.custom ? 'custom' : 'week');
    </script>
  </div>
