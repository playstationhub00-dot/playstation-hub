  <div class="dash-pane<%= (typeof dashSub === 'undefined' ? 'overview' : dashSub) === 'overview' ? ' active' : '' %>" id="dsub-overview">
    <%
      const qrPending = orderQueue.filter(o => o.state === 'qr_pending');
      const paymentsToApprove = orderQueue.filter(o => o.state === 'verifying_payment');
      const returnsToVerify = orderQueue.filter(o => o.state === 'verifying_return');
      const soonestQr = qrPending.slice().sort((a, b) =>
        new Date(a.qr_expires_at || 0) - new Date(b.qr_expires_at || 0)
      )[0];
      const overdueReminders = needsReminder.filter(r => r.dl < 0);
      const needsNow = dashMetrics.needsNowTotal;
      const greet = dashMetrics.greeting || { greeting: 'Hello', line: '' };
      const ago = iso => {
        const mins = Math.max(0, Math.round((dashNow - new Date(iso)) / 60000));
        if (mins < 1) return 'just now';
        if (mins < 60) return mins + 'm ago';
        const h = Math.round(mins / 60);
        if (h < 24) return h + 'h ago';
        return Math.round(h / 24) + 'd ago';
      };
      const t = dashMetrics.collectedTrend;
      const pace = dashMetrics.collectedPace;
      const bell = dashMetrics.bell || { total: needsNow, queue: needsNow, other: 0 };
      const nn = [
        { n: qrPending.length, ic: '🕐', lbl: 'Sign-in' + (qrPending.length !== 1 ? 's' : '') + ' waiting', hot: qrPending.length > 0, dest: { tab: 'orders', chip: 'signin', group: 'now' } },
        { n: paymentsToApprove.length, ic: '💳', lbl: 'Payment' + (paymentsToApprove.length !== 1 ? 's' : '') + ' to approve', hot: paymentsToApprove.length > 0, dest: { tab: 'orders', chip: 'review', group: 'now' } },
        { n: returnsToVerify.length, ic: '↩️', lbl: 'Return' + (returnsToVerify.length !== 1 ? 's' : '') + ' to verify', hot: false, dest: { tab: 'orders', chip: 'verify', group: 'now' } },
        { n: needsReminder.length, ic: '⏰', lbl: 'Reminder' + (needsReminder.length !== 1 ? 's' : '') + ' due', hot: overdueReminders.length > 0, dest: { tab: 'customers', anchor: needsReminder.length ? 'sec-reminders' : 'sec-attention' } },
        { n: unlinkedRentals.length, ic: '🗂️', lbl: 'Rental' + (unlinkedRentals.length !== 1 ? 's' : '') + ' with no slot', hot: unlinkedRentals.length > 0, dest: { tab: 'customers', anchor: unlinkedRentals.length ? 'sec-unlinked' : 'sec-attention' } }
      ];
      const queueBits = [
        qrPending.length ? qrPending.length + ' sign-in' + (qrPending.length === 1 ? '' : 's') : '',
        paymentsToApprove.length ? paymentsToApprove.length + ' payment' + (paymentsToApprove.length === 1 ? '' : 's') : '',
        returnsToVerify.length ? returnsToVerify.length + ' return' + (returnsToVerify.length === 1 ? '' : 's') : '',
        needsReminder.length ? needsReminder.length + ' reminder' + (needsReminder.length === 1 ? '' : 's') : '',
        unlinkedRentals.length ? unlinkedRentals.length + ' with no slot' : ''
      ].filter(Boolean);
      const bellNote = !needsNow && !bell.total
        ? 'Nothing waiting on you right now. The bell agrees.'
        : bell.other > 0
          ? (needsNow
              ? needsNow + ' in the rental queue' + (queueBits.length ? ' (' + queueBits.join(', ') + ')' : '') + '. The bell shows ' + bell.total + ' because it also lists ' + bell.other + ' other item' + (bell.other === 1 ? '' : 's') + ': deposits to refund, reviews, support chats, and record checks.'
              : 'Nothing in the rental queue. The bell shows ' + bell.total + ' other item' + (bell.total === 1 ? '' : 's') + ': deposits to refund, reviews, support chats, and record checks.')
          : needsNow + ' in the rental queue' + (queueBits.length ? ' (' + queueBits.join(', ') + ')' : '') + '. The bell shows the same ' + bell.total + '.';
      const peso = n => '₱' + (Number(n) || 0).toLocaleString();
    %>

    <div class="ov-hero">
      <div>
        <div class="ov-hi"><%= greet.greeting %></div>
        <div class="ov-hi-sub"><%= greet.line %> · Rentals, money and stock.</div>
      </div>
      <div class="ov-health <%= needsNow ? 'busy' : 'ok' %>">
        <span class="ov-health-ic"><%= needsNow ? '🔔' : '✅' %></span>
        <div>
          <div class="ov-health-t"><%= needsNow ? needsNow + (needsNow === 1 ? ' thing needs you' : ' things need you') : 'All clear' %></div>
          <div class="ov-health-s"><%= bellNote %></div>
        </div>
      </div>
    </div>

    <div class="ov-kpis">
      <button type="button" class="ov-kpi <%= needsNow ? 'hot' : '' %>" onclick="document.getElementById('ov-needs').scrollIntoView({behavior:'smooth',block:'start'})">
        <div class="ov-kpi-l">Needs you now</div>
        <div class="ov-kpi-v" style="<%= needsNow ? 'color:#ff8a8a' : '' %>"><%= needsNow %></div>
        <div class="ov-kpi-d ov-flat"><%= needsNow ? 'Rental queue, not the bell' : 'Nothing waiting' %></div>
      </button>
      <button type="button" class="ov-kpi" onclick="dashOpen({tab:'orders', chip:'out'})">
        <div class="ov-kpi-l">Out on rent</div>
        <div class="ov-kpi-v"><%= activeCustomers.length %></div>
        <div class="ov-kpi-d ov-flat"><%= reservationCustomersNow.length %> reserved · <%= boughtCustomersNow.length %> bought</div>
      </button>
      <button type="button" class="ov-kpi" onclick="dashGoto('money')">
        <div class="ov-kpi-l">Collected · <%= dashPeriod.label %></div>
        <div class="ov-kpi-v"><%= peso(dashMetrics.collected.total) %></div>
        <div class="ov-kpi-d <%= t ? (t.dir === 'up' ? 'ov-up' : t.dir === 'down' ? 'ov-down' : 'ov-flat') : 'ov-flat' %>">
          <% if (t && t.pct != null) { %><%= t.dir === 'up' ? '↑' : t.dir === 'down' ? '↓' : '→' %> <%= t.pct %>% <%= pace && pace.partial ? 'vs same stretch' : 'vs last' %><% } else if (t && t.dir === 'up') { %>↑ up from nothing<% } else { %><%= dashMetrics.collected.count %> payments<% } %>
        </div>
        <% if (pace && pace.partial) { %>
          <div class="ov-kpi-note"><%= pace.note %> Same stretch: <%= peso(pace.compareTotal) %>.<% if (pace.fullPriorTotal != null) { %> Whole <%= pace.fullPriorLabel %>: <%= peso(pace.fullPriorTotal) %>.<% } %></div>
        <% } %>
      </button>
      <button type="button" class="ov-kpi" onclick="dashGoto('games')">
        <div class="ov-kpi-l">Slot use</div>
        <div class="ov-kpi-v"><%= dashMetrics.slots.pct %>%</div>
        <div class="ov-kpi-d ov-flat"><%= dashMetrics.slots.filled %> of <%= dashMetrics.slots.total %> · <%= dashMetrics.slots.idle %> idle</div>
      </button>
      <button type="button" class="ov-kpi" onclick="dashOpen({tab:'customers'})">
        <div class="ov-kpi-l">Came back</div>
        <div class="ov-kpi-v"><%= dashMetrics.repeat.pct %>%</div>
        <div class="ov-kpi-d ov-flat"><%= dashMetrics.repeat.repeat %> of <%= dashMetrics.repeat.unique %> · by name</div>
      </button>
    </div>

    <div class="row-3">
      <div class="dash-section" id="ov-needs">
        <div class="dash-section-head">
          <span class="dash-section-title">🔔 Needs you now</span>
          <button class="dash-section-link" onclick="dashOpen({tab:'orders', group:'now'})">Do now →</button>
        </div>
        <% nn.forEach(x => { %>
        <div class="dm-row dash-hit" onclick="dashOpen(<%- JSON.stringify(x.dest).replace(/</g, '\\u003c') %>)">
          <span class="dm-row-n"><%= x.ic %> <%= x.lbl %></span>
          <span class="dm-row-v <%= x.hot ? 'hot' : (x.n ? 'y' : '') %>">
            <% if (x.n && x.ic === '🕐' && soonestQr && soonestQr.qr_expires_at) { %>
              <span class="oq-timer" data-expires="<%= soonestQr.qr_expires_at %>">--:--</span>
            <% } else { %><%= x.n %><% } %>
          </span>
        </div>
        <% }) %>
        <% if (needsNow === 0) { %><div class="dm-note" style="margin-top:0.5rem;">Nothing in the rental queue.</div><% } %>
      </div>

      <div class="dash-section">
        <div class="dash-section-head">
          <span class="dash-section-title">🎮 Stock &amp; demand</span>
          <button class="dash-section-link" onclick="dashGoto('games')">Games &amp; slots →</button>
        </div>
        <div class="dm-row dash-hit" onclick="dashOpen({tab:'games', nav:'games', gamesSub:'all', gamesChip:'soldout'})">
          <span class="dm-row-n">🔥 Fully booked</span>
          <span class="dm-row-v <%= dashMetrics.fullyBooked ? 'hot' : '' %>"><%= dashMetrics.fullyBooked %></span>
        </div>
        <div class="dm-note">game<%= dashMetrics.fullyBooked !== 1 ? 's' : '' %> with no free slot. Opens the sold-out filter.</div>
        <% if (dashMetrics.topRequest) { %>
        <div class="dm-row dash-hit" onclick="dashOpen({tab:'games', nav:'requests', gamesSub:'requests'})">
          <span class="dm-row-n">🗳️ <%= dashMetrics.topRequest.title %></span>
          <span class="dm-row-v y"><%= dashMetrics.topRequest.votes %></span>
        </div>
        <div class="dm-note">top request, not stocked</div>
        <% } %>
        <% const worst = dashMetrics.payback.rows[0]; if (worst && worst.multiple < 1) { %>
        <div class="dm-row"><span class="dm-row-n">💸 <%= worst.title %></span>
          <span class="dm-row-v y"><%= worst.multiple %>×</span></div>
        <div class="dm-note">has not earned its cost back</div>
        <% } %>
        <% if (dashMetrics.payback.missingCost) { %>
        <div class="dm-row dash-hit" onclick="dashOpen({tab:'games', nav:'games', gamesSub:'all'})">
          <span class="dm-row-n">➕ <%= dashMetrics.payback.missingCost %> games missing a cost</span>
          <span class="dm-row-v y">Games →</span>
        </div>
        <div class="dm-note">payback cannot be scored without it</div>
        <% } %>
      </div>

      <div class="dash-section">
        <div class="dash-section-head">
          <span class="dash-section-title">🕐 Recent activity</span>
          <button class="dash-section-link" onclick="dashOpen({tab:'orders'})">All orders →</button>
        </div>
        <% if (!dashMetrics.recentActivity.length) { %>
          <div class="dm-empty">No order activity yet.</div>
        <% } else { %>
          <% dashMetrics.recentActivity.forEach(a => { %>
          <div class="ov-act-row">
            <div class="ov-act-ic"><%=
              a.state === 'awaiting_qr' || a.state === 'reserved' ? '✅' :
              a.state === 'active' ? '🎮' :
              a.state === 'verifying_payment' || a.state === 'verifying_return' ? '📄' :
              a.state === 'closed' || a.state === 'awaiting_return' ? '🏁' :
              a.state === 'cancelled' || a.state === 'payment_rejected' ? '🚫' : '🔔' %></div>
            <div class="ov-act-m">
              <div class="ov-act-t"><%= a.label %></div>
              <div class="ov-act-s"><%= a.ref %><%= a.name ? ' · ' + a.name : '' %><%= a.game ? ' · ' + a.game : '' %></div>
            </div>
            <div class="ov-act-when"><%= ago(a.at) %></div>
          </div>
          <% }) %>
        <% } %>
      </div>
    </div>

    <div class="row-3" style="margin-top:0.7rem;">
      <div class="dash-section">
        <div class="dash-section-head">
          <span class="dash-section-title">📈 Most rented</span>
          <span class="dash-period-tag"><%= dashPeriod.label %></span>
        </div>
        <% if (!dashMetrics.topRented.length) { %>
          <div class="dm-empty">No rentals started in this period.</div>
        <% } else { %>
          <% const rentedRows = dashMetrics.topRented; const rmax = rentedRows[0][1]; const rentedShown = rentedRows.slice(0, 4); const rentedRest = rentedRows.slice(4); %>
          <% rentedShown.forEach(([title, n], i) => { %>
          <div class="dm-row"><span class="dm-row-n"><%= i + 1 %>. <%= title %></span>
            <span class="dm-row-v b"><%= n %>×</span></div>
          <div class="dm-bar"><i class="blue" style="width:<%= Math.round((n / rmax) * 100) %>%"></i></div>
          <% }) %>
          <% if (rentedRest.length) { %>
          <details class="dash-more">
            <summary>Show <%= rentedRest.length %> more</summary>
            <% rentedRest.forEach(([title, n], i) => { %>
            <div class="dm-row"><span class="dm-row-n"><%= i + 5 %>. <%= title %></span>
              <span class="dm-row-v b"><%= n %>×</span></div>
            <div class="dm-bar"><i class="blue" style="width:<%= Math.round((n / rmax) * 100) %>%"></i></div>
            <% }) %>
          </details>
          <% } %>
        <% } %>
      </div>

      <div class="dash-section">
        <div class="dash-section-head">
          <span class="dash-section-title">👑 Top customers</span>
          <span class="dash-period-tag"><%= dashPeriod.label %></span>
        </div>
        <% if (!dashMetrics.topSpenders.length) { %>
          <div class="dm-empty">No payments recorded in this period.</div>
        <% } else { %>
          <% const spenders = dashMetrics.topSpenders; const smax = spenders[0].total; const spendShown = spenders.slice(0, 4); const spendRest = spenders.slice(4); %>
          <% spendShown.forEach((c, i) => { %>
          <div class="dm-row"><span class="dm-row-n"><%= i + 1 %>. <%= c.name %></span>
            <span class="dm-row-v g"><%= peso(c.total) %></span></div>
          <div class="dm-bar"><i class="ok" style="width:<%= Math.round((c.total / smax) * 100) %>%"></i></div>
          <% }) %>
          <% if (spendRest.length) { %>
          <details class="dash-more">
            <summary>Show <%= spendRest.length %> more</summary>
            <% spendRest.forEach((c, i) => { %>
            <div class="dm-row"><span class="dm-row-n"><%= i + 5 %>. <%= c.name %></span>
              <span class="dm-row-v g"><%= peso(c.total) %></span></div>
            <div class="dm-bar"><i class="ok" style="width:<%= Math.round((c.total / smax) * 100) %>%"></i></div>
            <% }) %>
          </details>
          <% } %>
        <% } %>
      </div>

      <div class="dash-section">
        <div class="dash-section-head">
          <span class="dash-section-title">🗂️ Accounts</span>
          <button class="dash-section-link" onclick="dashOpen({tab:'accounts'})">Manage →</button>
        </div>
        <% if (!dashMetrics.accountsSlotUse.length) { %>
          <div class="dm-empty">No accounts yet.</div>
        <% } else { %>
          <% const accRows = dashMetrics.accountsSlotUse; const accShown = accRows.slice(0, 4); const accRest = accRows.slice(4); %>
          <% accShown.forEach(a => { %>
          <div class="dm-row"><span class="dm-row-n"><%= a.label %></span>
            <span class="dm-row-v <%= a.idle >= a.total ? 'hot' : a.idle ? 'y' : 'g' %>"><%= a.filled %>/<%= a.total %></span></div>
          <div class="dm-bar"><i class="<%= a.idle ? 'warn' : 'ok' %>" style="width:<%= a.pct %>%"></i></div>
          <% if (a.idle) { %><div class="dm-note"><%= a.idle %> idle slot<%= a.idle !== 1 ? 's' : '' %></div><% } %>
          <% }) %>
          <% if (accRest.length) { %>
          <details class="dash-more">
            <summary>Show <%= accRest.length %> more</summary>
            <% accRest.forEach(a => { %>
            <div class="dm-row"><span class="dm-row-n"><%= a.label %></span>
              <span class="dm-row-v <%= a.idle >= a.total ? 'hot' : a.idle ? 'y' : 'g' %>"><%= a.filled %>/<%= a.total %></span></div>
            <div class="dm-bar"><i class="<%= a.idle ? 'warn' : 'ok' %>" style="width:<%= a.pct %>%"></i></div>
            <% if (a.idle) { %><div class="dm-note"><%= a.idle %> idle slot<%= a.idle !== 1 ? 's' : '' %></div><% } %>
            <% }) %>
          </details>
          <% } %>
          <button type="button" class="dash-section-link" style="margin-top:0.45rem;" onclick="dashGoto('games')">Slot picture on Games &amp; slots →</button>
        <% } %>
      </div>
    </div>

    <div class="dash-section" style="margin-top:0.7rem;">
      <div class="dash-section-head">
        <span class="dash-section-title">💬 Payment reminders</span>
        <span class="dash-period-tag"><%= dashPeriod.label %></span>
      </div>
      <% const prStats = dashMetrics.reminders || { reminded: 0, recovered: 0, pesos: 0 }; %>
      <div class="dm-row"><span class="dm-row-n">Reminded</span><span class="dm-row-v"><%= prStats.reminded %></span></div>
      <div class="dm-row"><span class="dm-row-n">Paid after a reminder</span><span class="dm-row-v g"><%= prStats.recovered %></span></div>
      <div class="dm-row"><span class="dm-row-n">₱ recovered</span><span class="dm-row-v g"><%= peso(prStats.pesos || 0) %></span></div>
      <div class="dm-note">Orders nudged about an unpaid payment, and the ones that paid afterwards. Counted on Manila dates.</div>
    </div>

    <% const px = (typeof todayView !== 'undefined' && todayView && todayView.psplusExpiring) ? todayView.psplusExpiring : null; %>
    <div class="dash-section" style="margin-top:0.7rem;">
      <div class="dash-section-head">
        <span class="dash-section-title">⭐ PS Plus expiring</span>
        <button type="button" class="dash-section-link" onclick="dashOpen({tab:'accounts', nav:'accounts'})">Accounts →</button>
      </div>
      <% if (!px || !px.count) { %>
        <div class="dm-empty">No accounts expire in the next 14 days. Dates stay blank until you add them on Accounts.</div>
      <% } else { %>
        <div class="ov-kpi-v" style="font-size:1.6rem;"><%= px.count %></div>
        <% if (px.soonest) { %><div class="ov-kpi-note">soonest: <%= px.soonest.label %> <%= px.soonest.when %></div><% } %>
        <% px.items.forEach(function (row) { %>
          <div class="dm-row"><span class="dm-row-n"><%= row.label %></span><span class="dm-row-v"><%= row.when %></span></div>
        <% }) %>
      <% } %>
    </div>

    <div class="ov-deeper">
      <span style="font-size:1.5rem;">📊</span>
      <div>
        <div class="ov-deeper-t">Going deeper</div>
        <div class="ov-deeper-s">Money, stock and slots, and traffic each have their own tab.</div>
      </div>
      <div class="ov-deeper-go">
        <button class="ov-deeper-btn" onclick="dashGoto('money')">💰 Money →</button>
        <button class="ov-deeper-btn" onclick="dashGoto('games')">🎮 Games &amp; slots →</button>
        <button class="ov-deeper-btn" onclick="dashGoto('site')">🌐 Traffic →</button>
      </div>
    </div>
  </div>
