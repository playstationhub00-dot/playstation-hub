  <div class="tab-panel" id="tab-dashboard">

    <%# Five sub-tabs rather than one long scroll. Each answers a different
        question, so each is one short screen. "Now" and "Site" ignore the
        period picker: one is live state, the other has its own filters. %>
    <div class="dsub-bar">
      <div class="dsub-pills">
        <button class="dsub-pill" data-dsub="now" onclick="switchDash('now')">🔔 Now<% if (dashMetrics.needsNowTotal) { %> <span class="dsub-n"><%= dashMetrics.needsNowTotal %></span><% } %></button>
        <button class="dsub-pill" data-dsub="money" onclick="switchDash('money')">💰 Money</button>
        <button class="dsub-pill" data-dsub="games" onclick="switchDash('games')">🎮 Games</button>
        <button class="dsub-pill" data-dsub="customers" onclick="switchDash('customers')">👥 Customers</button>
        <button class="dsub-pill" data-dsub="site" onclick="switchDash('site')">🌐 Site</button>
      </div>
      <%# Server-side, like the orders ledger period: one source of truth, and
          the numbers can be asserted in a test rather than recomputed in JS. %>
      <form method="GET" action="/admin" class="dsub-period" id="dsubPeriodForm">
        <input type="hidden" name="tab" value="dashboard">
        <input type="hidden" name="sub" id="dsubPeriodSub" value="money">
        <select name="dperiod" onchange="this.form.submit()" title="Period for Money, Games and Customers">
          <option value="month" <%= dashPeriod.key === 'month' ? 'selected' : '' %>>This month</option>
          <option value="3m" <%= dashPeriod.key === '3m' ? 'selected' : '' %>>Last 3 months</option>
          <option value="year" <%= dashPeriod.key === 'year' ? 'selected' : '' %>>This year</option>
          <option value="all" <%= dashPeriod.key === 'all' ? 'selected' : '' %>>All time</option>
        </select>
      </form>
    </div>

    <%- include('dashboard/now') %>
    <%- include('dashboard/money') %>
    <%- include('dashboard/games') %>
    <%- include('dashboard/customers') %>
    <%- include('dashboard/site') %>

    <style>
      .dsub-bar { display:flex; align-items:center; justify-content:space-between; gap:0.75rem; flex-wrap:wrap; margin-bottom:1rem; padding-bottom:0.85rem; border-bottom:1px solid #191919; }
      .dsub-pills { display:flex; gap:0.35rem; flex-wrap:wrap; }
      .dsub-pill { display:flex; align-items:center; gap:0.4rem; background:#111; border:1px solid #222; border-radius:20px; padding:0.4rem 0.9rem; font-size:0.8rem; font-weight:700; color:#9a9a9a; cursor:pointer; }
      .dsub-pill:hover { color:#fff; border-color:#333; }
      .dsub-pill.active { background:var(--ps-blue); border-color:var(--ps-blue); color:#000; }
      .dsub-n { background:rgba(0,0,0,0.28); border-radius:20px; padding:0 0.4rem; font-size:0.7rem; }
      .dsub-pill:not(.active) .dsub-n { background:#ef4444; color:#fff; }
      .dsub-period select { background:#111; border:1px solid #2a2a2a; border-radius:8px; color:#fff; padding:0.35rem 0.6rem; font-size:0.78rem; font-weight:700; }
      .dash-pane { display:none; }
      .dash-pane.active { display:block; }

      .row-2 { display:grid; grid-template-columns:1fr 1fr; gap:0.65rem; }
      .row-3 { display:grid; grid-template-columns:repeat(3,1fr); gap:0.65rem; }
      .row-4 { display:grid; grid-template-columns:repeat(4,1fr); gap:0.65rem; }
      .dm-tile { background:#0d0d0d; border:1px solid #1e1e1e; border-radius:12px; padding:0.9rem 1rem; }
      .dm-tile.warn { background:#100a00; border-color:#3a2a00; }
      .dm-k { font-size:0.62rem; text-transform:uppercase; letter-spacing:0.5px; color:#555; font-weight:800; }
      .dm-v { font-size:1.5rem; font-weight:900; color:#fff; line-height:1.15; margin-top:0.25rem; }
      .dm-s { font-size:0.64rem; color:#555; margin-top:0.2rem; line-height:1.4; }
      .dm-v.g { color:#22c55e; } .dm-v.b { color:#60a5fa; } .dm-v.p { color:#a78bfa; }
      .dm-v.y { color:var(--ps-blue); } .dm-v.r { color:#ef4444; }
      .dm-row { display:flex; align-items:center; justify-content:space-between; gap:0.75rem; font-size:0.78rem; color:#ccc; margin-top:0.55rem; }
      .dm-row-n { flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
      .dm-row-v { font-weight:800; font-size:0.76rem; color:#aaa; flex-shrink:0; }
      .dm-row-v.g { color:#22c55e; } .dm-row-v.b { color:#60a5fa; } .dm-row-v.y { color:var(--ps-blue); }
      .dm-bar { background:#1a1a1a; border-radius:3px; height:5px; margin-top:0.25rem; overflow:hidden; }
      .dm-bar i { display:block; height:100%; background:var(--ps-blue); border-radius:3px; }
      .dm-bar i.ok { background:#22c55e; } .dm-bar i.warn { background:var(--ps-blue); } .dm-bar i.blue { background:#60a5fa; }
      .dm-note { font-size:0.62rem; color:#4d4d4d; margin-top:0.15rem; }
      .dm-empty { color:#555; font-size:0.78rem; padding:0.9rem 0; line-height:1.6; }
      .dm-empty a { color:var(--ps-blue); text-decoration:none; font-weight:700; }
      @media (max-width: 900px) {
        .row-2, .row-3, .row-4 { grid-template-columns:repeat(2,1fr); }
      }
    </style>

    <script>
    // ── Dashboard sub-tabs ──
    // Same contract as the main tabs: the choice lives in the URL so a reload
    // or a period change lands back where you were, and in localStorage so the
    // next visit does too.
    (function () {
      const DSUB_KEY = 'adminDashSub';
      const SUBS = ['now', 'money', 'games', 'customers', 'site'];

      window.switchDash = function (name) {
        if (!SUBS.includes(name)) name = 'now';
        SUBS.forEach(s => {
          const pane = document.getElementById('dsub-' + s);
          const pill = document.querySelector('[data-dsub=' + s + ']');
          if (pane) pane.classList.toggle('active', s === name);
          if (pill) pill.classList.toggle('active', s === name);
        });
        try { localStorage.setItem(DSUB_KEY, name); } catch (e) {}
        // Carried on the period form too, so submitting it returns to this pane
        // rather than dumping you back on Now.
        const carry = document.getElementById('dsubPeriodSub');
        if (carry) carry.value = name;
        const q = new URLSearchParams(window.location.search);
        q.set('tab', 'dashboard');
        if (name === 'now') q.delete('sub'); else q.set('sub', name);
        q.delete('msg');
        history.replaceState({}, '', '/admin?' + q.toString());
      };

      const params = new URLSearchParams(window.location.search);
      let initial = params.get('sub');
      if (!initial) { try { initial = localStorage.getItem(DSUB_KEY); } catch (e) {} }
      // A month-log save returns with ?month=, which only the Money pane can act on.
      if (params.get('month')) initial = 'money';
      switchDash(SUBS.includes(initial) ? initial : 'now');
    })();
    </script>

  </div><!-- /tab-dashboard -->
