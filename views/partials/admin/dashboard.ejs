    <script>
    // ── Dashboard sub-tabs ── (Overview / Money / Games & slots / Site)
    (function () {
      const DSUB_KEY = 'adminDashSub';
      const SUBS = ['overview', 'money', 'games', 'site'];
      // now and customers were thin panes folded into the overview. games is a
      // real tab again (stock and slots), so old ?sub=games bookmarks land there.
      const LEGACY = { now: 'overview', customers: 'overview' };

      // updateUrl defaults to true for every real switch (a pill click, a
      // card link). The one call that must NOT touch the URL is the initial
      // restore below: this whole script runs on every /admin load, whichever
      // top-level tab is actually active, because the dashboard panel — sub-tabs
      // included — is always in the DOM. Writing tab=dashboard here unconditionally
      // stomped the real tab (and dropped msg, killing the save toast) on every
      // page load, so saving from Customers — or any other tab — silently bounced
      // the owner back to the dashboard.
      window.switchDash = function (name, updateUrl) {
        if (updateUrl === undefined) updateUrl = true;
        name = LEGACY[name] || name;
        if (!SUBS.includes(name)) name = 'overview';
        SUBS.forEach(s => {
          const pane = document.getElementById('dsub-' + s);
          const pill = document.querySelector('[data-dsub=' + s + ']');
          if (pane) pane.classList.toggle('active', s === name);
          if (pill) pill.classList.toggle('active', s === name);
        });
        try { localStorage.setItem(DSUB_KEY, name); } catch (e) {}
        const carry = document.getElementById('dsubPeriodSub');
        if (carry) carry.value = name;
        const root = document.getElementById('tab-dashboard');
        if (root && root.setAttribute) root.setAttribute('data-dsub', name);
        if (!updateUrl) return;
        const q = new URLSearchParams(window.location.search);
        q.set('tab', 'dashboard');
        if (name === 'overview') q.delete('sub'); else q.set('sub', name);
        q.delete('msg');
        history.replaceState({}, '', '/admin?' + q.toString());
      };
      // Jump into the sibling sub-tabs from a card link on the overview.
      window.dashGoto = function (name) { switchDash(name); window.scrollTo({ top: 0, behavior: 'smooth' }); };
      // Open another admin tab on the filtered view a card is describing.
      window.dashOpen = function (dest) {
        dest = dest || {};
        if (dest.dash) { switchDash(dest.dash); window.scrollTo({ top: 0, behavior: 'smooth' }); return; }
        if (typeof switchTab === 'function') switchTab(dest.tab, dest.nav || dest.tab);
        setTimeout(function () {
          if ((dest.chip || dest.group) && window.oqFocus) window.oqFocus({ chip: dest.chip, group: dest.group });
          if (dest.gamesSub && window.gmActivateSubtab) window.gmActivateSubtab(dest.gamesSub);
          if ((dest.gamesChip || dest.gamesQ) && window.gmSetChip) window.gmSetChip(dest.gamesChip, dest.gamesQ);
          if (dest.accStatus && window.accFocus) window.accFocus(dest.accStatus, dest.accType);
          if (dest.anchor) {
            var el = document.getElementById(dest.anchor);
            if (el && el.scrollIntoView) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }, 60);
      };

      const params = new URLSearchParams(window.location.search);
      let initial = params.get('sub');
      if (!initial) { try { initial = localStorage.getItem(DSUB_KEY); } catch (e) {} }
      if (params.get('month')) initial = 'money';
      initial = LEGACY[initial] || initial;
      switchDash(SUBS.includes(initial) ? initial : 'overview', false);
      var loading = document.getElementById('dashLoading');
      if (loading) loading.hidden = true;
    })();
    </script>

  </div><!-- /tab-dashboard -->
