  <div class="tab-panel" id="tab-dashboard" data-dsub="<%= typeof dashSub === 'undefined' ? 'overview' : dashSub %>">

    <%# Overview is the summary. Money keeps the chart and the month drill-down.
        Games & slots is the stock and account picture. Site is unchanged. %>
    <div id="dashLoading" class="dash-loading" role="status" aria-live="polite">
      <div class="dash-loading-t">Loading the dashboard</div>
      <div class="dash-skel-row">
        <div class="dash-skel"></div><div class="dash-skel"></div><div class="dash-skel"></div><div class="dash-skel"></div>
      </div>
    </div>
    <div class="dsub-bar">
      <div class="dsub-pills" role="tablist">
        <button type="button" class="dsub-pill" data-dsub="overview" onclick="switchDash('overview')">Overview<% if (dashMetrics.needsNowTotal) { %> <span class="dsub-n"><%= dashMetrics.needsNowTotal %></span><% } %></button>
        <button type="button" class="dsub-pill" data-dsub="money" onclick="switchDash('money')">Money</button>
        <button type="button" class="dsub-pill" data-dsub="games" onclick="switchDash('games')"><span class="dsub-long">Games &amp; slots</span><span class="dsub-short">Games</span></button>
        <button type="button" class="dsub-pill" data-dsub="site" onclick="switchDash('site')">Site</button>
      </div>
      <form method="GET" action="/admin" class="dsub-period" id="dsubPeriodForm">
        <input type="hidden" name="tab" value="dashboard">
        <input type="hidden" name="sub" id="dsubPeriodSub" value="<%= (typeof dashSub === 'undefined' || dashSub === 'overview') ? 'overview' : dashSub %>">
        <span class="dsub-period-k">Summary period</span>
        <div class="dsub-rng" role="group" aria-label="Summary period">
          <% [['month','This month'],['3m','3 months'],['year','This year'],['all','All time']].forEach(([key, label]) => { %>
          <button type="submit" name="dperiod" value="<%= key %>" class="<%= dashPeriod.key === key ? 'on' : '' %>"><%= label %></button>
          <% }) %>
        </div>
        <span class="dsub-period-site">Does not change Site.</span>
      </form>
    </div>

    <%- include('dashboard/overview') %>
    <%- include('dashboard/money') %>
    <%- include('dashboard/games') %>
    <%- include('dashboard/site') %>

    <style>
      .dash-loading { margin-bottom:14px; }
      .dash-loading-t { font-size:13px; font-weight:700; color:#d0d0d0; margin-bottom:8px; }
      .dash-skel-row { display:grid; grid-template-columns:repeat(4,1fr); gap:12px; }
      .dash-skel { height:84px; border-radius:14px; background:linear-gradient(90deg,#171717 25%,#2a2a2a 50%,#171717 75%); background-size:200% 100%; animation:dashShimmer 1.1s linear infinite; }
      @keyframes dashShimmer { from { background-position:100% 0; } to { background-position:-100% 0; } }
      .dsub-bar { display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; margin-bottom:14px; }
      .dsub-pills { display:flex; gap:4px; background:#141414; border:1px solid #2a2a2a; border-radius:12px; padding:4px; width:fit-content; max-width:100%; }
      .dsub-pill { display:flex; align-items:center; justify-content:center; gap:6px; background:transparent; border:0; border-radius:9px; padding:8px 16px; font-size:14px; font-weight:700; color:#aaa; cursor:pointer; white-space:nowrap; }
      .dsub-pill:hover { color:#fff; }
      .dsub-pill.active { background:#F5B800; color:#0a0a0a; }
      .dsub-n { background:rgba(0,0,0,0.18); border-radius:999px; padding:0 7px; font-size:11px; }
      .dsub-pill:not(.active) .dsub-n { background:#3a1212; color:#ff8a8a; }
      .dsub-short { display:none; }
      .dsub-period { display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin:0; }
      .dsub-period-k { font-size:12px; font-weight:700; color:#b5b5b5; }
      .dsub-rng { display:flex; border:1px solid #333; border-radius:10px; overflow:hidden; }
      .dsub-rng button { background:#141414; color:#ddd; border:0; border-right:1px solid #333; padding:7px 12px; font-weight:700; font-size:13px; cursor:pointer; }
      .dsub-rng button:last-child { border-right:0; }
      .dsub-rng button.on { background:#F5B800; color:#0a0a0a; }
      .dsub-period-site { display:none; font-size:12px; color:#b5b5b5; }
      #tab-dashboard[data-dsub="site"] .dsub-period-site { display:inline; }
      .dash-scope { font-size:12.5px; color:#c8c8c8; margin:0 0 12px; }
      .dash-hit { width:100%; background:transparent; border:0; color:inherit; font:inherit; text-align:left; cursor:pointer; }
      .dash-hit:hover .dm-row-n { color:#fff; }
      .dash-more { margin-top:6px; }
      .dash-more > summary { cursor:pointer; font-size:12.5px; font-weight:700; color:#F5B800; }
      .dash-period-tag { font-size:12px; color:#b5b5b5; }
      .dm-row-v.hot { color:#ff8a8a; }
      .ov-kpi { text-align:left; font:inherit; color:inherit; cursor:pointer; width:100%; }
      .ov-kpi-note { font-size:12px; color:#c8c8c8; margin-top:6px; line-height:1.4; font-weight:600; }
      .gs-grid { display:grid; grid-template-columns:1.15fr 1fr 1fr; gap:12px; }
      .gs-donut { display:flex; gap:14px; align-items:center; }
      .gs-legend { flex:1; min-width:0; }
      .gs-swatch { display:inline-block; width:10px; height:10px; border-radius:3px; margin-right:6px; vertical-align:-1px; }
      .gs-sub { font-size:11.5px; text-transform:uppercase; letter-spacing:.8px; color:#b5b5b5; font-weight:700; margin:12px 0 6px; }
      .gs-toggle { display:flex; gap:6px; margin-bottom:8px; }
      .gs-toggle button { font-size:12px; font-weight:700; border-radius:999px; padding:3px 10px; border:1px solid #333; color:#ccc; background:transparent; cursor:pointer; }
      .gs-toggle button.on { background:#F5B800; color:#0a0a0a; border-color:#F5B800; }
      .gs-mini { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; margin-bottom:8px; }
      .gs-mini div { background:#121212; border:1px solid #262626; border-radius:10px; padding:8px 10px; font-size:12px; color:#b5b5b5; }
      .gs-mini b { display:block; font-size:19px; color:#fff; }
      .gs-split { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
      .dash-year { display:flex; align-items:center; gap:8px; font-size:13px; font-weight:700; color:#d0d0d0; }
      .dash-year select { background:#161616; border:1px solid #3a3a3a; border-radius:8px; color:#fff; padding:6px 8px; font-size:13px; font-weight:700; }
      .dash-year-note { font-size:12.5px; color:#c8c8c8; margin:0 0 10px; }
      .dash-bars { display:flex; align-items:flex-end; gap:6px; }
      .dash-bar { flex:1; display:flex; flex-direction:column; align-items:center; min-width:0; }
      .dash-bar-plot { height:140px; width:100%; display:flex; align-items:flex-end; }
      .dash-bar-fill { width:100%; border-radius:4px 4px 0 0; min-height:3px; cursor:pointer; }
