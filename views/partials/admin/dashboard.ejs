      body.light-mode .dsub-period-k, body.light-mode .dsub-period-site, body.light-mode .dash-scope, body.light-mode .ov-kpi-note, body.light-mode .dash-year-note { color:#4b5259; }
      body.light-mode .gs-mini div { background:#f7f8fa; border-color:#e6e9ec; color:#5b636c; }
      body.light-mode .gs-mini b { color:#14171a; }
      body.light-mode .dash-year select { background:#fff; border-color:#d5dbe1; color:#14171a; }
      body.light-mode .dash-bar-lbl, body.light-mode .dash-bar-val { color:#2b3138; }
      body.light-mode .gs-donut text { fill:#14171a; }
      body.light-mode .dash-skel { background:linear-gradient(90deg,#eee 25%,#f7f7f7 50%,#eee 75%); background-size:200% 100%; }

      body.light-mode .dm-tile { background:#fff; border-color:#e6e9ec; }
