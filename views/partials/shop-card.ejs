<%# Buy card. Outer class stays shop-card so the catalog tests can find it.
    Inner layout matches the proposal: cover, stock badge, NT and Trophy prices. %>
<a href="<%= seo.isPsplusDeluxeTitle(g.title) ? '/ps-plus' : '/game/' + g.slug + '?mode=buy' %>" class="shop-card">
  <span class="shop-cover art">
    <% if (g.cover) { %><img <%- imgCard(g.cover) %> alt="<%= g.title %>" loading="lazy" decoding="async" style="object-position: <%= g.fx != null ? g.fx : 50 %>% <%= g.fy != null ? g.fy : 50 %>%;"><% } else { %><span class="shop-nocover"><%= g.title %></span><% } %>
    <span class="shop-stock <%= g.ready ? 'shop-in' : 'shop-wait' %>"><%= g.ready ? 'In stock' : 'Set up on order' %></span>
    <% if (rank) { %><span class="shop-rank shop-rank-<%= rank %>"<%= hideRank ? ' hidden' : '' %>>#<%= rank %></span><% } %>
  </span>
  <span class="shop-body body">
    <span class="shop-meta"><%= g.platform %><%= g.genre ? ' · ' + g.genre : '' %></span>
    <span class="shop-title"><%= g.title %></span>
    <span class="shop-price">₱<%= g.price.toLocaleString('en-US') %><% if (g.was) { %> <s>₱<%= g.was.toLocaleString('en-US') %></s><% } %></span>
    <% if (g.ntPrice || g.trPrice) { %>
    <span class="shop-tiers price"><% if (g.ntPrice) { %>NT <b>₱<%= g.ntPrice.toLocaleString('en-US') %></b><% } %><% if (g.ntPrice && g.trPrice) { %> · <% } %><% if (g.trPrice) { %>Trophy <span class="tr">₱<%= g.trPrice.toLocaleString('en-US') %></span><% } %></span>
    <% } %>
    <span class="rcta">Buy</span>
  </span>
</a>
