<%#
  Trailer + screenshots block that takes the place of the static poster on a game
  page (see lib/game-psn-view.js). The first item shows; thumbnails and swipe
  (public/js/game-media.js) switch. A trailer is a <video preload="none">, so no
  video bytes load until the visitor taps play.

  Locals: items [{ type: 'video'|'image', src, poster? }], title
%>
<div class="gpm<%= items.length > 4 ? ' gpm-many' : '' %>" id="gpMedia" data-count="<%= items.length %>">
  <% if (items.length > 4) { %>
  <button type="button" class="gpm-arrow gpm-arrow-prev" id="gpmPrev" aria-label="Previous screenshots">‹</button>
  <button type="button" class="gpm-arrow gpm-arrow-next" id="gpmNext" aria-label="Next screenshots">›</button>
  <% } %>
  <div class="gpm-stage" id="gpmStage">
    <% items.forEach((m, i) => { %>
    <div class="gpm-slide"<%= i === 0 ? '' : ' hidden' %>>
      <% if (m.type === 'video') { %>
      <video controls playsinline preload="none"<% if (m.poster) { %> poster="<%= m.poster %>"<% } %>><source src="<%= m.src %>" type="video/mp4"></video>
      <button type="button" class="gpm-play" id="gpmPlay" aria-label="Play trailer"><span aria-hidden="true"></span></button>
      <span class="gpm-badge">▶ TRAILER</span>
      <% } else { %>
      <button type="button" class="gpm-open" data-index="<%= i %>" aria-label="<%= title %> screenshot <%= i + 1 %>">
        <img src="<%= m.src %>" alt="<%= title %> screenshot <%= i + 1 %>" width="1280" height="720" decoding="async"<% if (i > 0) { %> loading="lazy"<% } %>>
      </button>
      <% } %>
    </div>
    <% }) %>
    <% if (items.length > 1) { %><span class="gpm-count" id="gpmCount">1 / <%= items.length %></span><% } %>
  </div>
  <% if (items.length > 1) { %>
  <div class="gpm-thumbs" id="gpmThumbs">
    <% items.forEach((m, i) => { %>
    <button type="button" class="gpm-thumb<%= i === 0 ? ' on' : '' %><%= m.type === 'video' ? ' gpm-thumb-v' : '' %>" aria-label="<%= m.type === 'video' ? 'Trailer' : 'Screenshot' %> <%= i + 1 %>">
      <% const th = m.type === 'video' ? m.poster : m.src; %>
      <% if (th) { %><img <%- imgThumb(th) %> width="160" height="90" alt="" loading="lazy" decoding="async"><% } %>
    </button>
    <% }) %>
  </div>
  <% } %>
  <dialog class="gpm-lb" id="gpmLightbox" aria-label="Screenshots">
    <div class="gpm-lb-frame">
      <div class="gpm-lb-bar">
        <span id="gpmLbCount"></span>
        <button type="button" class="gpm-lb-x" id="gpmLbClose">Close</button>
      </div>
      <button type="button" class="gpm-lb-nav gpm-lb-prev" id="gpmLbPrev" aria-label="Previous image">‹</button>
      <img id="gpmLbImg" alt="" width="1280" height="720">
      <button type="button" class="gpm-lb-nav gpm-lb-next" id="gpmLbNext" aria-label="Next image">›</button>
      <div class="gpm-lb-thumbs" id="gpmLbThumbs"></div>
    </div>
  </dialog>
</div>
