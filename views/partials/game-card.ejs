<%
  // ── Availability: from linked accounts (phase 2) or legacy per-game counts, per slot type ──
  // accountSummaryMap (built once per request by the route) avoids recomputing the
  // accounts summary from scratch for every card; falls back to a direct lookup for
  // single-game renders (e.g. game-detail doesn't use this partial, but be defensive).
  const gcSum = (typeof accountSummaryMap !== 'undefined' && accountSummaryMap)
    ? (accountSummaryMap[game.id] || null)
    : (typeof gameAccountSummary === 'function' ? gameAccountSummary(game.id) : null);
  const gcAvailability = computeAvailability(game, gcSum, { nt: game.nt_days_left, tr: game.tr_days_left, ps4: game.ps4_days_left });
  const { ntSlots, trSlots, ps4Slots, showPs4, hasTrophy, allUnavail, totalSlots } = gcAvailability;
  const ntDaysLeft = gcAvailability.ntNext, trDaysLeft = gcAvailability.trNext, ps4DaysLeft = gcAvailability.ps4Next;
  const isLastSlot = totalSlots === 1;
  const noSlot = totalSlots === 0;
  const buyNt = game.buy_nt_price || 0;
  const buyTr = game.buy_tr_price || 0;
  const hasBuy = buyNt > 0 || buyTr > 0;
  const gameSlug = game.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  const modalArgs = `'${game.title.replace(/'/g,"\\'")}',${game.nt_price_10d||0},${game.nt_price_15d||0},${game.nt_price_30d||0},${game.tr_price_10d||0},${game.tr_price_15d||0},${game.tr_price_30d||0},${hasTrophy?'true':'false'},true,${buyNt},${buyTr}`;
  // Promo discount per duration — same math as the game-detail order summary, so the
  // card shows the actual final price next to the crossed-out base price, not just a badge.
  const gcPromo = typeof promo !== 'undefined' ? promo : null;
  const gcPromoPct = (d) => (typeof getPromoDiscountPct === 'function') ? getPromoDiscountPct(gcPromo, d) : 0;
  const gcFinal = (base, d) => { const pct = gcPromoPct(d); return pct > 0 ? base - Math.round(base * pct / 100) : base; };
  // Lowest final (promo-applied) price across every duration/type this game offers —
  // shown as "From ₱X" on the card when showPriceStart is passed in (homepage only;
  // Browse shows this per-category instead, see browse.ejs).
  const gcAllPrices = [[game.nt_price_10d,10],[game.nt_price_15d,15],[game.nt_price_30d,30],
    ...(hasTrophy ? [[game.tr_price_10d,10],[game.tr_price_15d,15],[game.tr_price_30d,30]] : [])]
    .filter(([base]) => base > 0).map(([base, d]) => gcFinal(base, d));
  const gcStartPrice = gcAllPrices.length ? Math.min(...gcAllPrices) : null;
  // NEW badge lasts a fixed 11 days from created_at — same window used by the Admin
  // "Added" column and the New Arrivals poster group (server.js NEW_GAME_WINDOW_DAYS).
  const gcDaysSinceAdded = game.created_at ? Math.floor((Date.now() - new Date(game.created_at).getTime()) / 86400000) : null;
  const gcIsNew = gcDaysSinceAdded !== null && gcDaysSinceAdded < 11;
  const gcNewDaysLeft = gcIsNew ? 11 - gcDaysSinceAdded : null;
  const gcNeverRented = (game.renters || 0) === 0;
%>
<div class="game-card" style="cursor:default;">

  <!-- Clickable cover → game detail page -->
  <a href="/game/<%= gameSlug %>" class="game-card-link" style="display:block;text-decoration:none;">
    <div class="gc-cover-wrap">
      <% if (game.cover_image) { %>
        <img src="<%= game.cover_image %>" alt="<%= game.title %>" class="game-cover" loading="lazy" decoding="async" style="object-position: <%= game.cover_focal_x != null ? game.cover_focal_x : 50 %>% <%= game.cover_focal_y != null ? game.cover_focal_y : 50 %>%;">
      <% } else { %>
        <div class="game-cover-placeholder">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>
          </svg>
          <span>No Image</span>
        </div>
      <% } %>
      <span class="gc-platform-badge"><%= game.platform %></span>
      <% if (isLastSlot) { %>
        <div class="gc-slot-banner gc-slot-banner-last">🔥 Last Slot</div>
      <% } else if (noSlot) { %>
        <div class="gc-slot-banner gc-slot-banner-none">Sold Out</div>
      <% } %>
      <% if (hasBuy) { %>
        <div style="position:absolute;bottom:6px;left:6px;background:linear-gradient(135deg,#7b2ff7,#f107a3);color:#fff;font-size:0.75rem;font-weight:800;padding:0.18rem 0.45rem;border-radius:20px;letter-spacing:0.3px;">♾️ BUY</div>
      <% } %>
      <% if (gcIsNew) { %>
        <div class="gc-new-badge">✨ NEW</div>
      <% } %>
    </div>
  </a>

  <% if (gcIsNew && gcNeverRented) { %>
    <div class="gc-new-days-left">⏳ <%= gcNewDaysLeft %> Day<%= gcNewDaysLeft !== 1 ? 's' : '' %> Left!</div>
  <% } %>

  <div class="game-info">
    <a href="/game/<%= gameSlug %>" style="text-decoration:none;color:inherit;"><div class="game-title"><%= game.title %></div></a>
    <% if (typeof showPriceStart !== 'undefined' && showPriceStart && gcStartPrice) { %>
      <div class="gc-price-start">Price Starts at ₱<%= gcStartPrice %></div>
    <% } %>
    <div class="gc-reveal-hint">👆 Tap to see price &amp; rent</div>

    <!-- Hidden by default — hover (desktop) or tap the card (mobile) to reveal price/availability + Rent/Buy -->
    <div class="gc-reveal">
    <% if (game.genre) { %><div class="gc-genre"><%= game.genre.toUpperCase() %></div><% } %>

    <!-- Pricing columns side by side -->
    <div class="gc-price-table">

      <!-- Non-Trophy column wrapper -->
      <div class="gc-col-wrap">
        <div class="gc-days-left-spacer">
          <% if (ntSlots <= 0 && ntDaysLeft != null && ntDaysLeft > 0) { %>
          <span class="gc-days-left">🎮 Available in <%= ntDaysLeft %>d</span>
          <% } %>
        </div>
        <div class="gc-col gc-col-nt">
          <div class="gc-col-head">
            <span class="gc-col-icon">🎮</span>
            <span class="gc-col-label">NON-TROPHY</span>
          </div>
          <div class="gc-slot-count">
            <% if (ntSlots > 0) { %>
              <span class="gc-avail gc-avail-yes"><%= ntSlots %> slot<%= ntSlots !== 1 ? 's' : '' %> left</span>
            <% } else { %>
              <span class="gc-avail gc-avail-no">RENTED</span>
            <% } %>
          </div>
          <div class="gc-price-rows">
            <% [[10, game.nt_price_10d], [15, game.nt_price_15d], [30, game.nt_price_30d]].forEach(([d, base]) => { const pct = gcPromoPct(d); %>
            <div class="gc-price-row">
              <span class="gc-dur"><%= d %>D</span>
              <span class="gc-price-wrap">
                <% if (pct > 0) { %><span class="gc-price-orig">₱<%= base %></span><% } %>
                <span class="gc-price">₱<%= gcFinal(base, d) %></span>
              </span>
            </div>
            <% }) %>
          </div>
        </div>
      </div>

      <!-- Trophy / PS4 Primary column wrapper -->
      <% if (hasTrophy || showPs4) { %>
      <div class="gc-col-wrap">
        <div class="gc-days-left-spacer">
          <% if (hasTrophy && trSlots <= 0 && trDaysLeft != null && trDaysLeft > 0) { %>
          <span class="gc-days-left gc-days-left-tr">🏆 Available in <%= trDaysLeft %>d</span>
          <% } else if (showPs4 && ps4Slots <= 0 && ps4DaysLeft != null && ps4DaysLeft > 0) { %>
          <span class="gc-days-left gc-days-left-ps4">🕹️ PS4 in <%= ps4DaysLeft %>d</span>
          <% } %>
        </div>
        <div class="gc-col gc-col-tr">
          <div class="gc-col-head">
            <span class="gc-col-icon">🏆</span>
            <span class="gc-col-label">TROPHY</span>
          </div>
          <% if (hasTrophy) { %>
          <div class="gc-slot-count">
            <% if (trSlots > 0) { %>
              <span class="gc-avail gc-avail-tr"><%= trSlots %> slot<%= trSlots !== 1 ? 's' : '' %></span>
            <% } else { %>
              <span class="gc-avail gc-avail-no">RENTED</span>
            <% } %>
          </div>
          <% } %>
          <% if (showPs4) { %>
          <div class="gc-slot-count">
            <span class="gc-slot-type-label">PS4</span>
            <% if (ps4Slots > 0) { %>
              <span class="gc-avail gc-avail-ps4"><%= ps4Slots %> slot<%= ps4Slots !== 1 ? 's' : '' %></span>
            <% } else { %>
              <span class="gc-avail gc-avail-no">RENTED</span>
            <% } %>
          </div>
          <% } %>
          <% if (hasTrophy) { %>
          <div class="gc-price-rows">
            <% [[10, game.tr_price_10d], [15, game.tr_price_15d], [30, game.tr_price_30d]].forEach(([d, base]) => { const pct = gcPromoPct(d); %>
            <div class="gc-price-row">
              <span class="gc-dur"><%= d %>D</span>
              <span class="gc-price-wrap">
                <% if (pct > 0) { %><span class="gc-price-orig">₱<%= base %></span><% } %>
                <span class="gc-price gc-price-tr">₱<%= gcFinal(base, d) %></span>
              </span>
            </div>
            <% }) %>
          </div>
          <% } %>
        </div>
      </div>
      <% } %>

    </div>

    <!-- Action buttons -->
    <% if (allUnavail) { %>
    <a href="/game/<%= gameSlug %>" class="rent-btn rent-btn-reserve" style="display:block;text-align:center;text-decoration:none;">Reserve a Slot →</a>
    <% } else { %>
    <div style="display:flex;gap:0.4rem;">
      <a href="/game/<%= gameSlug %>" class="rent-btn" style="flex:1;text-align:center;text-decoration:none;">⏱️ Rent</a>
      <% if (hasBuy) { %>
      <a href="/game/<%= gameSlug %>?mode=buy" class="rent-btn" style="flex:1;text-align:center;text-decoration:none;background:linear-gradient(135deg,#7b2ff7,#f107a3);border-color:transparent;">♾️ Buy</a>
      <% } %>
    </div>
    <% } %>
    </div><!-- /gc-reveal -->
  </div>
</div>
