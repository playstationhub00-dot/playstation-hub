<%
  // ── Availability: from linked accounts (phase 2) or legacy per-game counts, per slot type ──
  // accountSummaryMap (built once per request by the route) avoids recomputing the
  // accounts summary from scratch for every card; falls back to a direct lookup for
  // single-game renders (e.g. game-detail doesn't use this partial, but be defensive).
  const gcSum = (typeof accountSummaryMap !== 'undefined' && accountSummaryMap)
    ? (accountSummaryMap[game.id] || null)
    : (typeof gameAccountSummary === 'function' ? gameAccountSummary(game.id) : null);
  const gcAvailability = computeAvailability(game, gcSum, { nt: game.nt_days_left, tr: game.tr_days_left, ps4: game.ps4_days_left });
  const { ntSlots, trSlots, ps4Slots, showPs4, hasTrophy, allUnavail, totalSlots } = gcAvailability;
  const ntDaysLeft = gcAvailability.ntNext, trDaysLeft = gcAvailability.trNext, ps4DaysLeft = gcAvailability.ps4Next;
  const isLastSlot = totalSlots === 1;
  const noSlot = totalSlots === 0;
  const gcWaits = [ntDaysLeft, trDaysLeft, showPs4 ? ps4DaysLeft : null].filter(d => d != null && Number(d) > 0).map(Number);
  const gcSoonest = gcWaits.length ? Math.min.apply(null, gcWaits) : null;
  let gcPill = 'Available', gcPillClass = 'st-avail';
  if (!totalSlots) { gcPill = 'Full'; gcPillClass = 'st-full'; }
  else if (isLastSlot) { gcPill = 'Last slot'; gcPillClass = 'st-last'; }
  const gcState = n => n > 1 ? { cls: 'ok', text: 'Available' } : n === 1 ? { cls: 'last', text: 'Last slot' } : { cls: 'full', text: 'Full' };
  const gcNt = gcState(ntSlots), gcTr = gcState(trSlots), gcPs4 = gcState(ps4Slots);
  // Gated on slot state for the same reason as the detail page: a card must never
  // advertise "Buy ₱X" for an account that has already been sold, since the detail
  // page it links to will (correctly) refuse to offer it.
  const buyNt = (buyTypeSellable(gcSum, 'non_trophy') ? (game.buy_nt_price || 0) : 0);
  const buyTr = (buyTypeSellable(gcSum, 'trophy') ? (game.buy_tr_price || 0) : 0);
  const hasBuy = buyNt > 0 || buyTr > 0;
  const modalArgs = `'${game.title.replace(/'/g,"\\'")}',${game.nt_price_7d||0},${game.nt_price_30d||0},${game.tr_price_7d||0},${game.tr_price_30d||0},${hasTrophy?'true':'false'},true,${buyNt},${buyTr}`;
  // Promo discount per duration — same math as the game-detail order summary, so the
  // card shows the actual final price next to the crossed-out base price, not just a badge.
  const gcPromo = typeof promo !== 'undefined' ? promo : null;
  // The game's own discount if it has one, else the site promo's (lib/game-discount.js).
  const gcPromoPct = (d) => (typeof gameDiscountPct === 'function') ? gameDiscountPct(game, d, gcPromo)
    : ((typeof getPromoDiscountPct === 'function') ? getPromoDiscountPct(gcPromo, d) : 0);
  // A discount bigger than the site promo gets its own line on the card; the
  // homepage "Special deals" row (gcShowDealPrice) also prices the card at it.
  const gcDealRaw = (typeof gameSpecialDeal === 'function') ? gameSpecialDeal(game, gcPromo) : null;
  // a deal on a duration with no usable price is not a real deal
  const gcDeal = (gcDealRaw && (game['nt_price_' + gcDealRaw.days + 'd'] > 0 || (hasTrophy && game['tr_price_' + gcDealRaw.days + 'd'] > 0))) ? gcDealRaw : null;
  const gcShowDealPrice = typeof dealPrice !== 'undefined' && dealPrice && gcDeal;
  const gcFinal = (base, d) => { const pct = gcPromoPct(d); return pct > 0 ? base - Math.round(base * pct / 100) : base; };
  // Lowest final (promo-applied) price across every duration/type this game offers,
  // plus that same entry's pre-promo base price (for the crossed-out "was" price) —
  // the card shows this one summary price instead of the full price table; the full
  // table lives on the game page.
  const gcAllPricePairs = [[game.nt_price_7d,7],[game.nt_price_30d,30],
    ...(hasTrophy ? [[game.tr_price_7d,7],[game.tr_price_30d,30]] : [])]
    .filter(([base]) => base > 0).map(([base, d]) => ({ base, final: gcFinal(base, d), days: d }));
  const gcCheapest = gcAllPricePairs.length ? gcAllPricePairs.reduce((a, b) => b.final < a.final ? b : a) : null;
  const gcStartPrice = gcCheapest ? gcCheapest.final : null;
  const gcStartWas = gcCheapest && gcCheapest.final < gcCheapest.base ? gcCheapest.base : null;
  // NEW badge lasts a fixed 11 days from created_at by default — same window used by
  // the Admin "Added" column and the New Arrivals poster group (server.js
  // NEW_GAME_WINDOW_DAYS), overridable per game via game.new_window_days.
  const gcWindowDays = game.new_window_days || 11;
  const gcDaysSinceAdded = game.created_at ? Math.floor((Date.now() - new Date(game.created_at).getTime()) / 86400000) : null;
  const gcIsNew = gcDaysSinceAdded !== null && gcDaysSinceAdded < gcWindowDays;
  const gcNewDaysLeft = gcIsNew ? gcWindowDays - gcDaysSinceAdded : null;
  const gcNeverRented = (game.renters || 0) === 0;
  const gcShowDaysLeft = gcIsNew && gcNeverRented;
  const gcBundle = resolveBundleInfo(game);
  // The game's tier pill (lib/tier-style.js) — bundles already say "Bundle · N games".
  const gcTier = (!game.is_bundle && typeof gameTier === 'function') ? gameTier(game) : null;
  const gcBundleParent = findBundleContaining(game);
  const gcBuyFrom = [buyNt, buyTr].filter(p => p > 0).length ? Math.min(...[buyNt, buyTr].filter(p => p > 0)) : null;
  const gcPromoBadge = (typeof promoBadgeFor === 'function') ? promoBadgeFor(game.id) : null;
  const basketTypes = [];
  if ((ntSlots > 0) && ((game.nt_price_7d || 0) > 0 || (game.nt_price_30d || 0) > 0)) basketTypes.push('nt');
  if (hasTrophy && trSlots > 0 && ((game.tr_price_7d || 0) > 0 || (game.tr_price_30d || 0) > 0)) basketTypes.push('tr');
  if (showPs4 && ps4Slots > 0 && ((game.tr_price_7d || 0) > 0 || (game.nt_price_7d || 0) > 0 || (game.tr_price_30d || 0) > 0 || (game.nt_price_30d || 0) > 0)) basketTypes.push('ps4');
  const basketId = game.id != null && game.id !== '' ? game.id : ((typeof seo !== 'undefined' && seo.isPsplusDeluxeTitle(game.title)) ? 'psplus' : '');
  const basketLead = basketTypes[0] || 'nt';
  const basketWeek = basketLead === 'nt' ? (game.nt_price_7d || 0) : ((game.tr_price_7d || 0) || (game.nt_price_7d || 0));
  const basketDays = basketWeek > 0 ? 7 : 30;
  const gcBandName = String((gcTier && gcTier.name) || '');
  const gcBandKey = /ps\s*plus|playstation plus/i.test(gcBandName) ? 'psplus'
    : /gta|ultimate/i.test(gcBandName) ? 'ultimate'
    : /new games/i.test(gcBandName) ? 'new'
    : /deluxe/i.test(gcBandName) ? 'deluxe'
    : /special/i.test(gcBandName) ? 'special'
    : /regular/i.test(gcBandName) ? 'regular'
    : (gcTier ? 'other' : '');
  const gcBandLabel = gcBandKey === 'ultimate' ? 'ULTIMATE'
    : gcBandKey === 'psplus' ? 'PS PLUS DELUXE'
    : gcBandKey === 'new' ? 'NEW GAMES'
    : gcBandKey === 'deluxe' ? 'DELUXE'
    : gcBandKey === 'special' ? 'SPECIAL'
    : gcBandKey === 'regular' ? 'REGULAR'
    : gcBandName.toUpperCase();
  const gcWeekBases = [game.nt_price_7d, hasTrophy ? game.tr_price_7d : 0].filter(p => p > 0);
  const gcMonthBases = [game.nt_price_30d, hasTrophy ? game.tr_price_30d : 0].filter(p => p > 0);
  const gcWeekShow = gcWeekBases.length ? Math.min.apply(null, gcWeekBases.map(b => gcFinal(b, 7))) : null;
  const gcMonthShow = gcMonthBases.length ? Math.min.apply(null, gcMonthBases.map(b => gcFinal(b, 30))) : null;
%>
<a href="<%= seo.rentPath(game.title) %>" class="game-card gc2-card rcard<%= allUnavail ? ' full gc2-full' : '' %>">
  <div class="art gc2-art">
    <% if (game.cover_image) { %>
      <img <%- imgCard(game.cover_image) %> width="480" height="720" alt="<%= game.title %>" class="gc2-cover" loading="lazy" decoding="async" style="object-position: <%= game.cover_focal_x != null ? game.cover_focal_x : 50 %>% <%= game.cover_focal_y != null ? game.cover_focal_y : 50 %>%;">
    <% } else { %>
      <div class="gc2-cover-placeholder">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>
        </svg>
        <span>No cover</span>
      </div>
    <% } %>

    <span class="st-badge <%= gcPillClass %>"><% if (gcPillClass !== 'st-full') { %><i class="gc-dot" aria-hidden="true"></i><% } %><%= gcPill %></span>
    <% if (allUnavail) { %>
    <div class="gc-full-mark"><b>FULL</b><% if (gcSoonest) { %><span>Next slot in <%= gcSoonest %> day<%= gcSoonest === 1 ? '' : 's' %></span><% } %></div>
    <% } %>
    <% if (!isLastSlot && allUnavail) { %>
      <%# The corner ribbon replaces the old "No slots" pill rather than joining
          it — two labels saying the same thing crowded the card, and this is the
          same band a sold-out Coming Soon card uses, so every full card on the
          site now reads identically. %>
      <div class="card-ribbon">Full</div>
    <% } %>
    <% if (gcIsNew || gcPromoBadge) { %>
    <div class="gc2-badges">
      <% if (gcPromoBadge) { %><div class="gc2-badge gc2-badge-promo"><%= gcPromoBadge.text %></div><% } %>
      <% if (gcIsNew) { %><div class="gc2-badge gc2-badge-new">Just added</div><% } %>
    </div>
    <% } %>
  </div>

  <div class="body gc2-body">
    <% if (gcTier) { %>
    <div class="gc-band gc-band-<%= gcBandKey %>">
      <span class="gc-band-ico" aria-hidden="true">
        <% if (gcBandKey === 'special') { %><svg viewBox="0 0 16 16"><path d="M8 1.5l1.7 3.6 4 .5-2.9 2.7.8 3.9L8 10.3 4.4 12.2l.8-3.9L2.3 5.6l4-.5z"/></svg>
        <% } else if (gcBandKey === 'deluxe') { %><svg viewBox="0 0 16 16"><circle cx="8" cy="8" r="3.2"/><path d="M8 1.2v2.2M8 12.6v2.2M1.2 8h2.2M12.6 8h2.2"/></svg>
        <% } else if (gcBandKey === 'new') { %><svg viewBox="0 0 16 16"><path d="M8 1.4l1.1 3.2 3.2 1.1-3.2 1.1L8 10l-1.1-3.2L3.7 5.7l3.2-1.1zM12.2 10.2l.5 1.4 1.4.5-1.4.5-.5 1.4-.5-1.4-1.4-.5 1.4-.5z"/></svg>
        <% } else if (gcBandKey === 'ultimate') { %><svg viewBox="0 0 16 16"><path d="M8 1.2l2 4.6 4.8.6-3.5 3.3.9 4.7L8 12.2 3.8 14.4l.9-4.7L1.2 6.4l4.8-.6z"/></svg>
        <% } else if (gcBandKey === 'psplus') { %><svg viewBox="0 0 16 16"><path d="M8 2.2v11.6M2.2 8h11.6"/></svg>
        <% } else { %><svg viewBox="0 0 16 16"><rect x="2" y="2" width="5" height="5" rx="1"/><rect x="9" y="2" width="5" height="5" rx="1"/><rect x="2" y="9" width="5" height="5" rx="1"/><rect x="9" y="9" width="5" height="5" rx="1"/></svg>
        <% } %>
      </span>
      <span><%= gcBandLabel %></span>
    </div>
    <% } %>
    <div class="gc2-title<%= allUnavail ? ' gc2-title-muted' : '' %>" title="<%= game.title %>"><span class="gc-title-text"><%= game.title %></span></div>
    <div class="gc2-tags">
      <% if (gcWeekShow || gcMonthShow) { %>
      <div class="gc-split-price">
        <% if (gcWeekShow) { %><div class="gc-week"><span>Weekly from</span><b>₱<%= gcWeekShow %></b></div><% } %>
        <% if (gcMonthShow) { %><div class="gc-month"><span>Monthly</span><b>₱<%= gcMonthShow %></b></div><% } %>
      </div>
      <% } else if (gcBundle && gcStartPrice) { %>
      <div class="gc2-price"><%= gcBundle.count %> games from <b>₱<%= gcStartPrice %></b></div>
      <% } else if (gcStartPrice) { %>
      <div class="gc2-price">from <b>₱<%= gcStartPrice %></b></div>
      <% } else { %>
      <div class="gc2-price">See pricing</div>
      <% } %>
      <% if (gcDeal) { %>
      <div class="gc2-deal">🔥 <%= gcDeal.pct %>% OFF · <%= gcDeal.days === 30 ? 'Monthly' : 'Weekly' %></div>
      <% } %>
      <div class="slots gc-slots">
        <% if (hasTrophy) { %><div class="slot slot-tr"><span class="gc-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4zM7 6H5a3 3 0 0 0 3 3M17 6h2a3 3 0 0 1-3 3"/></svg></span><span>Trophy</span><span class="gc-st <%= gcTr.cls %>"><i class="gc-dot" aria-hidden="true"></i><%= gcTr.text %></span></div><% } %>
        <div class="slot slot-nt"><span class="gc-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="2" y="7" width="20" height="11" rx="4"/><path d="M7 12h4M9 10v4M16.5 11h.01M18.5 13.5h.01"/></svg></span><span>Non-Trophy</span><span class="gc-st <%= gcNt.cls %>"><i class="gc-dot" aria-hidden="true"></i><%= gcNt.text %></span></div>
        <% if (showPs4) { %><div class="slot slot-ps4"><span class="gc-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="7" width="18" height="11" rx="2.5"/><path d="M8 12h.01M11 12h.01M14.5 10.5h.01M16.8 13h.01"/><path d="M7 7l2-3h6l2 3"/></svg></span><span>PS4 Primary</span><span class="gc-st <%= gcPs4.cls %>"><i class="gc-dot" aria-hidden="true"></i><%= gcPs4.text %></span></div><% } %>
      </div>
      <div class="gc-actions">
        <% if (!allUnavail && basketTypes.length && basketId !== '') { %>
        <button type="button" class="basket-add" data-basket-id="<%= basketId %>" data-basket-days="<%= basketDays %>" data-basket-type="<%= basketTypes[0] %>" aria-label="Add <%= game.title %> to basket">Add to basket</button>
        <% } %>
        <span class="rcta <%= allUnavail ? 'line' : 'rent' %> gc-cta"><%= allUnavail ? 'Join the line' : 'Rent now' %></span>
      </div>
    </div>
  </div>
</a>
