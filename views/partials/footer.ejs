<script>
document.addEventListener('submit', function (e) {
  var form = e.target;
  if (!form || (form.id !== 'gdOrderForm' && form.id !== 'reserveForm')) return;
  try { if (typeof fbq === 'function') fbq('track', 'InitiateCheckout'); } catch (err) {}
  try {
    if (typeof gtag === 'function') gtag('event', form.id === 'reserveForm' ? 'reserve_click' : 'rent_click');
  } catch (err) {}
}, true);
</script>

