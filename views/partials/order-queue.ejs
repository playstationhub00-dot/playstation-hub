<%
  const PERIOD_LABEL = p => {
    if (p === 'all') return 'All time';
    if (/^\d{4}$/.test(p)) return p;
    const [y, m] = p.split('-');
    return new Date(Number(y), Number(m) - 1, 1)
      .toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
  };
  const periodLabel = orderPeriod ? PERIOD_LABEL(orderPeriod) : 'Last 3 months';
%>

<div class="oq-stats">
  <div class="oq-stat">
    <div class="oq-stat-k">Needs you</div>
    <div class="oq-stat-v" style="color:var(--ps-blue);"><%= ledgerStats.needsYou %></div>
    <div class="oq-stat-s"><%= ledgerStats.qrLive ? ledgerStats.qrLive + ' QR waiting' : 'Nothing waiting' %></div>
  </div>
  <div class="oq-stat">
    <div class="oq-stat-k">Out on rent</div>
    <div class="oq-stat-v" style="color:#22c55e;"><%= ledgerStats.out %></div>
    <div class="oq-stat-s">Paid, not returned yet</div>
  </div>
  <div class="oq-stat">
    <div class="oq-stat-k">Completed · <%= periodLabel %></div>
    <div class="oq-stat-v" style="color:#7c8794;"><%= ledgerStats.paidCount %></div>
    <div class="oq-stat-s">₱<%= ledgerStats.paidTotal.toLocaleString() %> collected</div>
  </div>
  <div class="oq-stat">
    <div class="oq-stat-k">Didn't pay · 7d</div>
    <div class="oq-stat-v" style="color:#f59e0b;"><%= abandonedCount %></div>
    <div class="oq-stat-s">
      of <%= startedCount %> started<% if (orderStartRate !== null) { %> · <%= orderStartRate %>% of game views<% } %>
    </div>
  </div>
</div>
<%
  const QUEUE_ACTION = {
    verifying_payment: 'Payment confirmed',
    qr_pending: 'Signed them in',
    verifying_return: 'Return confirmed'
  };
  const QUEUE_LABEL = {
    verifying_payment: 'Check payment',
    qr_pending: 'Scan QR',
    verifying_return: 'Check return'
  };
  // Reservation downpayments settle into 'reserved' rather than moving on to
  // a console sign-in — the button text and post-confirm action differ from
  // a normal rental order's, even though both sit in verifying_payment.
  const queueAction = o => (o.is_reservation && o.state === 'verifying_payment') ? 'Reservation confirmed' : QUEUE_ACTION[o.state];
  // Live QR windows first — they are the only rows with a deadline.
  const sortedQueue = [...orderQueue].sort((a, b) => {
    if (a.state === 'qr_pending' && b.state !== 'qr_pending') return -1;
    if (b.state === 'qr_pending' && a.state !== 'qr_pending') return 1;
    return new Date(a.created_at) - new Date(b.created_at);
  });
%>

<%
  // Gateway status. Only rendered once a key is configured — a site not using
  // PayMongo at all should not carry a badge about it.
  const pmMode = typeof paymongoMode !== 'undefined' ? paymongoMode : 'none';
  const pmH = (typeof paymongoHealth !== 'undefined' && paymongoHealth) ? paymongoHealth : null;
  const pmFails = pmH ? (pmH.fail_count || 0) : 0;
  const pmOks = pmH ? (pmH.ok_count || 0) : 0;
  // Failures only matter if they are the MOST RECENT thing that happened —
  // old ones from before a secret was fixed are history, not a live problem.
  const pmBroken = pmFails > 0 && (!pmH.last_ok_at || String(pmH.last_fail_at || '') > String(pmH.last_ok_at || ''));
  const pmWhen = t => { if (!t) return 'never'; const d = new Date(t); return isNaN(d) ? 'never' : d.toLocaleString('en-US', { month:'short', day:'numeric', hour:'numeric', minute:'2-digit' }); };
%>
<% if (pmMode !== 'none') { %>
<div class="oq-pm <%= pmMode === 'live' ? 'oq-pm-live' : '' %><%= pmBroken ? ' oq-pm-bad' : '' %>">
  <span class="oq-pm-badge"><%= pmMode === 'live' ? '🔴 LIVE — real money' : pmMode === 'test' ? '🧪 TEST mode' : '⚠ Unrecognised key' %></span>
  <span class="oq-pm-sub">
    <% if (pmBroken) { %>
      ⚠ <%= pmFails %> webhook signature failure<%= pmFails === 1 ? '' : 's' %>, last <%= pmWhen(pmH.last_fail_at) %> — PAYMONGO_WEBHOOK_SECRET likely doesn't match this mode, so paid orders won't advance on their own.
    <% } else if (pmOks > 0) { %>
      Webhook healthy · <%= pmOks %> verified · last <%= pmWhen(pmH.last_ok_at) %>
    <% } else { %>
      No webhook received yet — the first real payment will confirm it works.
    <% } %>
  </span>
</div>
<% } %>

<%# Sits beside the gateway health badge because it answers the same question:
    is the plumbing behind this page actually working? Alerts are the thing the
    owner cannot verify by looking — nothing arriving looks identical to nothing
    happening. %>
<div class="oq-alert-test">
  <button type="button" id="oqTestAlert" class="oq-alert-btn">🔔 Send test alert</button>
  <span class="oq-alert-msg" id="oqTestAlertMsg">Checks that sign-in alerts reach your Telegram.</span>
</div>

<form method="POST" action="/admin/online" class="oq-online-form">
  <label class="oq-online-toggle">
    <input type="checkbox" name="online" onchange="this.form.submit()" <%= settings.owner_online ? 'checked' : '' %>>
    <span>I'm online now — show a live banner to customers waiting to send a QR</span>
  </label>
</form>

<script>
(function () {
  var btn = document.getElementById('oqTestAlert');
  var out = document.getElementById('oqTestAlertMsg');
  if (!btn || !out) return;
  btn.addEventListener('click', function () {
    btn.disabled = true;
    out.className = 'oq-alert-msg';
    out.textContent = 'Sending…';
    fetch('/admin/test-alert', { method: 'POST', headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (d && d.ok) {
          out.className = 'oq-alert-msg oq-alert-ok';
          out.textContent = 'Sent — check Telegram. If it arrived, alerts are working.';
          return;
        }
        out.className = 'oq-alert-msg oq-alert-bad';
        // Say what to fix, not just that it failed.
        if (d && d.reason === 'not_configured') {
          out.textContent = 'Not set up yet — missing ' + (d.missing || []).join(' and ') + ' in Railway.';
        } else if (d && d.reason === 'api') {
          out.textContent = 'Telegram refused it: ' + (d.description || ('HTTP ' + d.status))
            + (/unauthorized/i.test(d.description || '') ? ' — the bot token is wrong or was revoked.' : '')
            + (/chat not found/i.test(d.description || '') ? ' — the chat ID is wrong, or you have not messaged the bot yet.' : '');
        } else {
          out.textContent = 'Could not reach Telegram: ' + ((d && d.description) || 'unknown error');
        }
      })
      .catch(function (e) {
        out.className = 'oq-alert-msg oq-alert-bad';
        out.textContent = 'Request failed: ' + e.message;
      })
      .then(function () { btn.disabled = false; });
  });
})();
</script>

<!-- ── Manual Messenger order ──────────────────────────────────────────────
     For a customer who never touches the site: you sent them your own
     GCash/Maya QR in chat and already got paid there. This just records the
     order and hands back its link — the same invoice + review page any
     site order gets — to paste back into that same thread. -->
<details class="oq-manual-order">
  <summary>➕ Create order for a Messenger customer (already paid)</summary>
  <form id="oqManualForm" class="oq-manual-form" data-no-loading="1">
    <div class="oq-manual-grid">
      <label class="oq-manual-field oq-manual-full">
        <span>Facebook name</span>
        <input type="text" name="fb_name" placeholder="Their Facebook name" required>
      </label>
      <label class="oq-manual-field oq-manual-full">
        <span>Game</span>
        <select name="game_id" required>
          <option value="">— Select a game —</option>
          <% games.forEach(g => { %>
          <option value="<%= g.id %>"><%= g.title %> (<%= g.platform %>)</option>
          <% }) %>
        </select>
      </label>
      <label class="oq-manual-field">
        <span>Type</span>
        <select name="mode" id="oqManualMode">
          <option value="rent">Rent</option>
          <option value="buy">Buy (permanent)</option>
        </select>
      </label>
      <label class="oq-manual-field">
        <span>Account</span>
        <select name="account_type" id="oqManualType">
          <option value="nt">Non-Trophy</option>
          <option value="tr">Trophy</option>
          <option value="ps4">PS4 Primary</option>
        </select>
      </label>
      <label class="oq-manual-field" id="oqManualDaysWrap">
        <span>Duration</span>
        <select name="days">
          <option value="7">Weekly</option>
          <option value="30">Monthly</option>
        </select>
      </label>
      <label class="oq-manual-field">
        <span>Paid via</span>
        <select name="method">
          <option value="gcash">GCash</option>
          <option value="maya">Maya</option>
        </select>
      </label>
    </div>
    <button type="submit" class="oq-btn-go" id="oqManualSubmit">Create order &amp; get link</button>
    <div class="oq-manual-result" id="oqManualResult" hidden></div>
  </form>
</details>
<script>
(function(){
  var modeSel = document.getElementById('oqManualMode');
  var typeSel = document.getElementById('oqManualType');
  var daysWrap = document.getElementById('oqManualDaysWrap');
  var ps4Opt = typeSel ? typeSel.querySelector('option[value="ps4"]') : null;
  function syncMode() {
    var isBuy = modeSel.value === 'buy';
    daysWrap.hidden = isBuy;
    // PS4 Primary is a rent-only account type — a one-time purchase route
    // (POST /order/buy's own single-game branch) never accepted it either.
    if (ps4Opt) ps4Opt.hidden = isBuy;
    if (isBuy && typeSel.value === 'ps4') typeSel.value = 'nt';
  }
  if (modeSel) { modeSel.addEventListener('change', syncMode); syncMode(); }

  var form = document.getElementById('oqManualForm');
  var result = document.getElementById('oqManualResult');
  var submitBtn = document.getElementById('oqManualSubmit');
  if (!form) return;
  form.addEventListener('submit', function(e){
    e.preventDefault();
    submitBtn.disabled = true;
    var original = submitBtn.textContent;
    submitBtn.textContent = '… creating';
    result.hidden = true;
    fetch('/admin/orders/create-manual', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams(new FormData(form))
    })
      .then(function(r){ return r.json().then(function(body){ return { ok: r.ok, body: body }; }); })
      .then(function(res){
        submitBtn.disabled = false;
        submitBtn.textContent = original;
        result.hidden = false;
        if (!res.ok || !res.body.ok) {
          result.className = 'oq-manual-result oq-manual-err';
          result.textContent = '⚠ Could not create that order — check the game has a price set for this type/duration.';
          return;
        }
        result.className = 'oq-manual-result oq-manual-ok';
        result.innerHTML = '✅ ' + res.body.ref + ' created — ₱' + res.body.total + '. <button type="button" class="btn-copy rem-copy" data-msg="' +
          res.body.url.replace(/"/g, '&quot;') + '">📋 Copy link</button>';
      })
      .catch(function(){
        submitBtn.disabled = false;
        submitBtn.textContent = original;
        result.hidden = false;
        result.className = 'oq-manual-result oq-manual-err';
        result.textContent = '⚠ Something went wrong — try again.';
      });
  });
})();
</script>

<div class="oq-zone oq-zone-act">Needs you <span class="oq-zone-n"><%= sortedQueue.length %></span></div>

<% if (!sortedQueue.length) { %>
  <div class="oq-empty">Nothing waiting on you right now.</div>
<% } else { %>
  <% sortedQueue.forEach(o => { %>
  <div class="oq-row oq-sv-act oq-<%= o.state %>">
    <div class="oq-main">
      <div class="oq-top">
        <span class="oq-ref"><%= o.ref %></span>
        <% if (o.is_reservation) { %>
        <span class="oq-badge" style="background:#3a1a5c;color:#c9a4ff;"><%= o.upcoming_game_id ? '🔜 Coming Soon reservation' : '⭐ Priority reservation' %></span>
        <% } %>
        <% if (o.is_buy) { %>
        <span class="oq-badge" style="background:#2a0a3a;color:#d9a7f0;">♾️ Purchase</span>
        <% } %>
        <span class="oq-badge"><%= QUEUE_LABEL[o.state] %></span>
        <% if (o.state === 'qr_pending' && o.qr_expires_at) { %>
        <span class="oq-timer" data-expires="<%= o.qr_expires_at %>">--:--</span>
        <% } %>
      </div>
      <div class="oq-meta">
        <%= o.game_title %> · <%= o.account_type === 'tr' ? 'Trophy' : o.account_type === 'ps4' ? 'PS4 Primary' : 'Non-Trophy' %>
        · <%= o.is_buy ? 'One-time purchase' : (o.days === 7 ? 'Weekly' : 'Monthly') %> · ₱<%= (o.amount_due || 0) + (o.deposit_due || 0) %><%= o.is_reservation ? (o.upcoming_game_id ? ' downpayment (₱' + (o.remaining_due || 0) + ' on release)' : ' priority fee (₱' + (o.remaining_due || 0) + ' when slot opens)') : '' %>
      </div>
      <div class="oq-fb">
        FB: <strong><%= o.fb_name %></strong>
        <% if (o.psid) { %>
          <a class="oq-thread" href="https://www.facebook.com/messages/t/<%= o.psid %>" target="_blank" rel="noopener">open chat →</a>
        <% } %>
      </div>
      <% if (o.state === 'verifying_payment') { %>
        <div class="oq-proof">
          <% if (o.payment_method) { %><span class="oq-method"><%= o.payment_method.toUpperCase() %></span><% } %>
          <% if (o.paypal_expected) { %><span class="oq-expected">expect ₱<%= o.paypal_expected %></span><% } %>
          <% if (o.payment_proof) { %>
            <a href="<%= o.payment_proof %>" target="_blank" rel="noopener">View receipt →</a>
          <% } else { %>
            <span class="oq-via-fb">Says they sent it on Messenger — check your inbox</span>
          <% } %>
        </div>
      <% } %>
      <% if (o.state === 'qr_pending' && o.qr_code) { %>
        <%# Typed codes go straight into the PlayStation App, so the code itself
            is the thing the owner needs — big enough to read at a glance and
            one tap to copy, rather than a link to open. %>
        <div class="oq-proof oq-signin-code">
          <code class="oq-code"><%= o.qr_code %></code>
          <button type="button" class="rem-copy oq-code-copy" data-msg="<%= o.qr_code %>" title="Copy this sign-in code">📋 Copy</button>
        </div>
      <% } else if (o.state === 'qr_pending' && o.qr_image) { %>
        <div class="oq-proof"><a href="<%= o.qr_image %>" target="_blank" rel="noopener">Open QR to scan →</a></div>
      <% } %>
      <% if (o.state === 'verifying_return' && o.return_proof) { %>
        <div class="oq-proof"><a href="<%= o.return_proof %>" target="_blank" rel="noopener">View return proof →</a></div>
      <% } %>
    </div>
    <div class="oq-actions">
      <form method="POST" action="/admin/orders/<%= o.ref %>/advance">
        <button type="submit" class="oq-btn-go"><%= queueAction(o) %></button>
      </form>
      <% if (o.state === 'verifying_payment') { %>
      <form method="POST" action="/admin/orders/<%= o.ref %>/reject">
        <button type="submit" class="oq-btn-no">Can't find it</button>
      </form>
      <% } %>
      <form method="POST" action="/admin/orders/<%= o.ref %>/delete" onsubmit="return confirm('Permanently delete order ' + <%= JSON.stringify(o.ref) %> + '? This cannot be undone.');">
        <button type="submit" class="oq-btn-no">Delete</button>
      </form>
    </div>
  </div>
  <% }) %>
<% } %>

<!-- ── All orders ledger ────────────────────────────────────────────────── -->
<div class="oq-zone oq-zone-all">
  All orders
  <span class="oq-zone-n"><%= ledgerStats.total %></span>
  <span class="oq-zone-sub"><%= periodLabel %></span>
</div>

<div class="oq-ledger-bar">
  <form method="GET" action="/admin" class="oq-period">
    <input type="hidden" name="tab" value="orders">
    <label for="oqPeriod">Period</label>
    <select name="operiod" id="oqPeriod" onchange="this.form.submit()">
      <option value="" <%= orderPeriod === '' ? 'selected' : '' %>>Last 3 months</option>
      <option value="all" <%= orderPeriod === 'all' ? 'selected' : '' %>>All time</option>
      <% if (orderYears.length) { %>
      <optgroup label="By year">
        <% orderYears.forEach(y => { %>
        <option value="<%= y %>" <%= orderPeriod === y ? 'selected' : '' %>><%= y %></option>
        <% }) %>
      </optgroup>
      <optgroup label="By month">
        <% orderPeriods.forEach(p => { %>
        <option value="<%= p %>" <%= orderPeriod === p ? 'selected' : '' %>><%= PERIOD_LABEL(p) %></option>
        <% }) %>
      </optgroup>
      <% } %>
    </select>
  </form>
  <input type="text" id="oqSearch" class="oq-search" placeholder="Search ref, name or game…" oninput="oqFilter()">
</div>

<div class="oq-chips">
  <button type="button" class="oq-chip oq-chip-on" data-g="all" onclick="oqChip('all')">All <span class="oq-chip-n"><%= ledgerStats.total %></span></button>
  <button type="button" class="oq-chip" data-g="out" onclick="oqChip('out')">🎮 Out on rent <span class="oq-chip-n"><%= ledgerStats.out %></span></button>
  <button type="button" class="oq-chip" data-g="paid" onclick="oqChip('paid')">✅ Completed <span class="oq-chip-n"><%= ledgerStats.paidCount %></span></button>
  <button type="button" class="oq-chip" data-g="unpaid" onclick="oqChip('unpaid')">⚠ Didn't pay <span class="oq-chip-n"><%= ledgerStats.unpaid %></span></button>
  <button type="button" class="oq-chip" data-g="cancelled" onclick="oqChip('cancelled')">🚫 Cancelled <span class="oq-chip-n"><%= ledgerStats.cancelled %></span></button>
</div>

<% if (!ledgerGroups.length) { %>
  <div class="oq-empty">No orders in this period.</div>
<% } else { %>
<div class="oq-tw">
  <table class="oq-tbl" id="oqLedger">
    <thead>
      <tr>
        <th>Ref</th><th>Customer</th><th>Game</th><th>Rental</th>
        <th>Dates</th><th>Total</th><th>Status</th><th></th>
      </tr>
    </thead>
    <tbody>
      <%
        // Flattened view of orders currently loaded for this ledger period — used
        // only to flag possible duplicate slot claims below (see Fix 6 note: this
        // is limited to orders in the currently selected period, not the full DB).
        const allLedgerOrders = ledgerGroups.flatMap(gr => gr.orders);
      %>
      <% ledgerGroups.forEach(g => { %>
      <tr class="oq-grp" data-grp="<%= g.key %>">
        <td colspan="8">
          <%= PERIOD_LABEL(g.key) %>
          <span class="oq-grp-sum"><%= g.paidCount %> completed · ₱<%= g.paidTotal.toLocaleString() %></span>
        </td>
      </tr>
      <% g.orders.forEach(o => {
           const paid = !['awaiting_payment','verifying_payment','payment_rejected','cancelled'].includes(o.state);
           const out = ['awaiting_qr','qr_pending','active','awaiting_return','verifying_return'].includes(o.state);
           const grp = o.state === 'cancelled' ? 'cancelled'
                     : ['awaiting_payment','payment_rejected'].includes(o.state) ? 'unpaid'
                     : out ? 'out' : 'paid';
           const typeLbl = o.account_type === 'tr' ? 'Trophy' : o.account_type === 'ps4' ? 'PS4 Primary' : 'Non-Trophy';
           const durLbl = o.is_buy ? 'One-time purchase' : (o.days === 7 ? 'Weekly' : 'Monthly');
           const total = (o.amount_due || 0) + (o.deposit_due || 0);
           const fmt = d => d ? new Date(d + 'T00:00:00').toLocaleDateString('en-US', { month:'short', day:'numeric' }) : '';
           const dates = o.start_date ? fmt(o.start_date) + (o.end_date ? ' – ' + fmt(o.end_date) : '') : '—';
           const stCls = grp === 'cancelled' ? 'oq-st-dead' : grp === 'unpaid' ? 'oq-st-wait' : out ? 'oq-st-live' : 'oq-st-done';
           const stLbl = o.state === 'cancelled' ? 'Cancelled'
                       : o.state === 'payment_rejected' ? 'Payment rejected'
                       : o.state === 'awaiting_payment' ? 'Awaiting payment'
                       : o.state === 'closed' ? 'Completed'
                       : o.state === 'reserved' ? (o.upcoming_game_id ? 'Reserved — awaiting release' : 'Priority — awaiting a slot')
                       : out ? 'Out on rent' : 'Completed';
           // Fix 6: bundle slots aren't locked until an order reaches 'active', so
           // two customers can both pay for the same slot before we notice — flag
           // it here for manual review rather than trying to prevent it.
           const dupSlotCount = (o.is_buy && o.account_id && o.slot_type)
             ? allLedgerOrders.filter(x => x.ref !== o.ref && x.account_id === o.account_id && x.slot_type === o.slot_type
                 && !['closed','cancelled','payment_rejected'].includes(x.state)).length
             : 0;
      %>
      <tr class="oq-lr" data-g="<%= grp %>"
          data-s="<%= (o.ref + ' ' + (o.fb_name||'') + ' ' + (o.game_title||'')).toLowerCase() %>">
        <td class="oq-lref"><%= o.ref %></td>
        <td class="oq-lcust"><%= o.fb_name %></td>
        <td class="oq-lgame"><%= o.game_title %></td>
        <td class="oq-lmeta"><%= typeLbl %> · <%= durLbl %></td>
        <td class="oq-lnum"><%= dates %></td>
        <td class="oq-lnum oq-ltot">₱<%= total.toLocaleString() %></td>
        <td>
          <span class="oq-st <%= stCls %>"><span class="oq-st-dot"></span><%= stLbl %></span>
          <% if (paid && (o.deposit_due || 0) > 0) { %>
            <div class="oq-dep <%= o.deposit_refunded ? 'oq-dep-ok' : '' %>">
              <%= o.deposit_refunded ? 'Deposit refunded' : 'Deposit not refunded' %>
            </div>
          <% } %>
          <% if (dupSlotCount > 0) { %>
            <div class="oq-dep" title="Multiple live orders are claiming the same slot — verify before fulfilling and refund manually if needed.">
              ⚠ Duplicate slot claim — <%= dupSlotCount %> other order<%= dupSlotCount > 1 ? 's' : '' %> for this slot
            </div>
          <% } %>
        </td>
        <td class="oq-lact">
          <%# Only present on orders that can actually be reviewed and haven't
              been yet — server.js attaches review_msg, and its absence is the
              whole condition. %>
          <% if (o.review_msg) { %>
          <button type="button" class="rem-copy" data-msg="<%= o.review_msg %>" title="Copy a review request for this customer">📋</button>
          <% } %>
          <form method="POST" action="/admin/orders/<%= o.ref %>/delete" onsubmit="return confirm('Delete order ' + <%= JSON.stringify(o.ref) %> + '? Use this to clear out test orders or accidental duplicates. This cannot be undone.');">
            <button type="submit" class="oq-lact-del" title="Delete this order">🗑</button>
          </form>
        </td>
      </tr>
      <% }) %>
      <% }) %>
    </tbody>
  </table>
</div>
<div class="oq-empty" id="oqNoMatch" style="display:none;">No orders match that search.</div>
<% } %>

<% if (refundsOwed.length) { %>
<div class="oq-refunds">
  <div class="oq-refunds-title">Deposits to refund (<%= refundsOwed.length %>)</div>
  <% refundsOwed.forEach(o => { %>
  <div class="oq-refund-row">
    <div>
      <span class="oq-ref"><%= o.ref %></span>
      <span class="oq-refund-amt">₱<%= o.deposit_due %></span>
      <div class="oq-fb">FB: <strong><%= o.fb_name %></strong> · <%= o.game_title %></div>
    </div>
    <form method="POST" action="/admin/orders/<%= o.ref %>/refunded">
      <button type="submit" class="oq-btn-go">Sent it</button>
    </form>
  </div>
  <% }) %>
</div>
<% } %>

<% if (abandonedOrders && abandonedOrders.length) { %>
<div class="oq-abandoned">
  <div class="oq-abandoned-title">⚠ Started but didn't pay (<%= abandonedOrders.length %>)</div>
  <%
    const enabledMethods = (settings.payment_methods || []).filter(m => m.enabled).map(m => m.label);
    const payLine = enabledMethods.length
      ? 'We accept ' + enabledMethods.join(' and ') + ' — just reply here and we\'ll send you the QR and get you set up right away.'
      : 'Just reply here and we\'ll help you get set up.';
    const sortedAbandoned = [...abandonedOrders].sort((a, b) => new Date(b.created_at) - new Date(a.created_at));
  %>
  <% sortedAbandoned.forEach(o => {
    const abTypeLabel = o.account_type === 'tr' ? 'Trophy' : o.account_type === 'ps4' ? 'PS4 Primary' : 'Non-Trophy';
    const abDurLabel = o.is_buy ? 'One-time purchase' : (o.days === 7 ? 'Weekly' : 'Monthly');
    const abTotal = (o.amount_due || 0) + (o.deposit_due || 0);
    const firstName = (o.fb_name || '').trim().split(/\s+/)[0] || 'there';
    const followUpMsg = '👋 Hi ' + firstName + '! Saw you started an order with us —\n\n'
      + '🎮 ' + o.game_title + ' (' + abTypeLabel + ')\n'
      + (o.is_buy ? '🛒 One-time purchase\n' : '⏱ ' + abDurLabel + ' rental\n')
      + '💰 Total: ₱' + abTotal + (o.deposit_due > 0 ? ' (₱' + (o.amount_due || 0) + ' rent + ₱' + o.deposit_due + ' refundable deposit)' : '') + '\n'
      + '🔖 Reference: ' + o.ref + '\n\n'
      + 'Still want it? ' + payLine + '\n\n'
      + 'No worries if you changed your mind, just let us know!';
  %>
  <div class="oq-ab-row oq-sv-wait">
    <div>
      <span class="oq-ref"><%= o.ref %></span>
      <span class="oq-ab-name"><%= o.fb_name %></span>
      <div class="oq-meta">
        <%= o.game_title %> · <%= abTypeLabel %>
        · <%= abDurLabel %> · ₱<%= abTotal %>
        <% if (o.state === 'payment_rejected') { %>· <span class="oq-ab-rejected">payment rejected</span><% } %>
      </div>
    </div>
    <div class="oq-ab-right">
      <span class="oq-ab-age" data-created="<%= o.created_at %>">--</span>
      <div class="oq-ab-btns">
        <button type="button" class="btn-copy rem-copy" data-msg="<%= followUpMsg %>" title="Copy follow-up message">📋 Copy</button>
        <% if (process.env.PAYMONGO_SECRET_KEY) { %>
        <button type="button" class="btn-copy oq-paylink" data-ref="<%= o.ref %>" title="Create a PayMongo checkout link and copy it — paste into Messenger">💳 Payment link</button>
        <% } %>
        <form method="POST" action="/admin/orders/<%= o.ref %>/mark-paid" onsubmit="return confirm('Mark order ' + <%= JSON.stringify(o.ref) %> + ' as paid? Use this when the customer paid outside the site (e.g. Messenger). They\'ll still need to send their sign-in QR.');">
          <button type="submit" class="oq-btn-go" title="Confirm this order was paid outside the site">✅ Mark paid</button>
        </form>
        <form method="POST" action="/admin/orders/<%= o.ref %>/cancel" onsubmit="return confirm('Cancel order ' + <%= JSON.stringify(o.ref) %> + '? The customer said no or never followed up. The record is kept, unlike Delete.');">
          <button type="submit" class="oq-btn-no" title="Cancel this order — the customer declined or never paid">Cancel</button>
        </form>
        <form method="POST" action="/admin/orders/<%= o.ref %>/delete" onsubmit="return confirm('Delete order ' + <%= JSON.stringify(o.ref) %> + '? Use this to clear out duplicate or accidental orders. This cannot be undone.');">
          <button type="submit" class="oq-btn-no" title="Delete this order (e.g. a duplicate from the customer re-ordering)">Delete</button>
        </form>
      </div>
    </div>
  </div>
  <% }) %>
</div>
<% } %>

<% if (waitlistOrders && waitlistOrders.length) { %>
<div class="oq-abandoned">
  <div class="oq-abandoned-title">👥 Waiting for a slot (<%= waitlistOrders.length %>)</div>
  <%
    // Queue order, not recency: oldest first, matching what the customer is
    // told on the game page. Sorting newest-first (as this did) meant serving
    // from the top of this list served the most recently joined person while
    // the site told them they were last. Positions are per game + account type,
    // because that is the scope a slot actually opens in.
    const sortedWaitlist = [...waitlistOrders].sort((a, b) => {
      const da = Date.parse(a.created_at || '') || 0;
      const db = Date.parse(b.created_at || '') || 0;
      if (da !== db) return da - db;
      return String(a.ref).localeCompare(String(b.ref));
    });
    const wlSeen = {};
  %>
  <% sortedWaitlist.forEach(o => {
    const wlTypeLabel = o.account_type === 'tr' ? 'Trophy' : o.account_type === 'ps4' ? 'PS4 Primary' : 'Non-Trophy';
    const wlDurLabel = o.days === 7 ? 'Weekly' : 'Monthly';
    const wlFirstName = (o.fb_name || '').trim().split(/\s+/)[0] || 'there';
    const wlMsg = '👋 Hi ' + wlFirstName + '! A slot just opened up for ' + o.game_title + ' (' + wlTypeLabel + ', ' + wlDurLabel + ') —\n\n'
      + 'Still want it? Reply here and we\'ll get you set up.\n\n'
      + '🔖 Reference: ' + o.ref;
    const wlKey = String(o.game_id) + '|' + o.account_type;
    wlSeen[wlKey] = (wlSeen[wlKey] || 0) + 1;
    const wlPos = wlSeen[wlKey];
  %>
  <div class="oq-ab-row oq-sv-wait">
    <div>
      <span class="oq-wl-pos">#<%= wlPos %></span>
      <span class="oq-ref"><%= o.ref %></span>
      <span class="oq-ab-name"><%= o.fb_name %></span>
      <div class="oq-meta">
        <%= o.game_title %> · <%= wlTypeLabel %> · <%= wlDurLabel %> · Free entry
      </div>
    </div>
    <div class="oq-ab-right">
      <span class="oq-ab-age" data-created="<%= o.created_at %>">--</span>
      <div class="oq-ab-btns">
        <button type="button" class="btn-copy rem-copy" data-msg="<%= wlMsg %>" title="Copy slot-open message">📋 Copy</button>
        <form method="POST" action="/admin/orders/<%= o.ref %>/cancel" onsubmit="return confirm('Remove ' + <%= JSON.stringify(o.ref) %> + ' from the waiting list?');">
          <button type="submit" class="oq-btn-no" title="Remove this waitlist entry">Remove</button>
        </form>
      </div>
    </div>
  </div>
  <% }) %>
</div>
<% } %>

<script>
(function(){
  function tick() {
    document.querySelectorAll('.oq-timer').forEach(function(el){
      var left = new Date(el.dataset.expires).getTime() - Date.now();
      if (left <= 0) { el.textContent = 'expired'; el.classList.add('oq-timer-dead'); return; }
      var m = Math.floor(left / 60000), s = Math.floor((left % 60000) / 1000);
      el.textContent = m + ':' + String(s).padStart(2, '0') + ' left';
    });
  }
  tick();
  setInterval(tick, 1000);

  // Ledger chip + search filtering. Both narrow the rows already loaded for the
  // selected period; changing the period itself reloads from the server.
  var _oqGroup = 'all';
  window.oqChip = function(g) {
    _oqGroup = g;
    document.querySelectorAll('.oq-chip').forEach(function(c){
      c.classList.toggle('oq-chip-on', c.dataset.g === g);
    });
    oqFilter();
  };
  window.oqFilter = function() {
    var el = document.getElementById('oqSearch');
    var q = (el ? el.value : '').toLowerCase().trim();
    var shown = 0;
    document.querySelectorAll('.oq-lr').forEach(function(r){
      var ok = (_oqGroup === 'all' || r.dataset.g === _oqGroup) &&
               (!q || r.dataset.s.indexOf(q) !== -1);
      r.style.display = ok ? '' : 'none';
      if (ok) shown++;
    });
    // A month header with every row filtered out is noise, so hide it too.
    document.querySelectorAll('.oq-grp').forEach(function(h){
      var n = h.nextElementSibling, any = false;
      while (n && !n.classList.contains('oq-grp')) {
        if (n.classList.contains('oq-lr') && n.style.display !== 'none') { any = true; break; }
        n = n.nextElementSibling;
      }
      h.style.display = any ? '' : 'none';
    });
    var empty = document.getElementById('oqNoMatch');
    if (empty) empty.style.display = shown ? 'none' : '';
  };

  function formatAge() {
    document.querySelectorAll('.oq-ab-age').forEach(function(el){
      var ms = Date.now() - new Date(el.dataset.created).getTime();
      var mins = Math.floor(ms / 60000);
      if (mins < 60) { el.textContent = mins + 'm ago'; return; }
      var hrs = Math.floor(mins / 60);
      if (hrs < 24) { el.textContent = hrs + 'h ago'; return; }
      el.textContent = Math.floor(hrs / 24) + 'd ago';
    });
  }
  formatAge();

  // "💳 Payment link" — asks the server for a fresh PayMongo checkout session
  // for this order, then copies the URL the same way the .rem-copy buttons
  // copy a message (see the fallbackCopy handler in admin/customers.ejs,
  // which is attached globally and reused here rather than duplicated).
  document.addEventListener('click', function(e) {
    var btn = e.target.closest('.oq-paylink');
    if (!btn) return;
    var original = btn.textContent;
    btn.disabled = true;
    btn.textContent = '… creating link';
    fetch('/admin/orders/' + encodeURIComponent(btn.dataset.ref) + '/payment-link', { method: 'POST' })
      .then(function(r) { return r.json().then(function(body) { return { ok: r.ok, body: body }; }); })
      .then(function(res) {
        btn.disabled = false;
        if (!res.ok || !res.body.ok) {
          btn.textContent = res.body && res.body.reason === 'stale' ? '⚠ already paid/stale' : '⚠ failed — retry';
          setTimeout(function() { btn.textContent = original; }, 2500);
          return;
        }
        // Reuse the .rem-copy click handler (defined in admin/customers.ejs)
        // by copying its own logic inline: a synthetic .rem-copy element
        // would need its own DOM node, so instead copy directly here and
        // fall back to the same visible-textarea trick on an insecure context.
        var url = res.body.url;
        function flashDone() {
          btn.textContent = '✅ Copied — paste in Messenger';
          setTimeout(function() { btn.textContent = original; }, 2500);
        }
        function fallback() {
          var ta = document.createElement('textarea');
          ta.value = url;
          ta.style.cssText = 'position:fixed;left:1rem;right:1rem;bottom:1rem;height:4rem;z-index:9999;font-size:0.8rem;';
          document.body.appendChild(ta);
          ta.select();
          var ok = false;
          try { ok = document.execCommand('copy'); } catch (err) { ok = false; }
          if (ok) { ta.remove(); flashDone(); }
          else { btn.textContent = '⬇ copy from the box'; setTimeout(function() { ta.remove(); btn.textContent = original; }, 15000); }
        }
        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(url).then(flashDone).catch(fallback);
        } else {
          fallback();
        }
      })
      .catch(function() {
        btn.disabled = false;
        btn.textContent = '⚠ failed — retry';
        setTimeout(function() { btn.textContent = original; }, 2500);
      });
  });
})();
</script>
