<%
  const hhGames = (typeof games !== 'undefined' && games) ? games : [];
  const hhPromo = (typeof promo !== 'undefined' && promo) ? promo : {};
  const hhDeposit = hhPromo.deposit != null && hhPromo.deposit !== '' ? Number(hhPromo.deposit) : 100;
  const hhLate = hhPromo.late_fee_per_day != null && hhPromo.late_fee_per_day !== '' ? Number(hhPromo.late_fee_per_day) : 20;
  function hhMin(keys) {
    const vals = [];
    hhGames.forEach(function (g) {
      if (/ps plus|playstation plus/i.test(g.title || '')) return;
      keys.forEach(function (k) {
        const n = Number(g[k]) || 0;
        if (n > 0) vals.push(n);
      });
    });
    return vals.length ? Math.min.apply(null, vals) : null;
  }
  const hhNt = hhMin(['nt_price_7d']);
  const hhTr = hhMin(['tr_price_7d']);
  const hhQuotes = (reviews || []).filter(function (r) { return r && String(r.text || '').trim(); });
  const hhNew = (home && home.newGames && home.newGames.length) ? home.newGames.slice(0, 6) : hhGames.slice(0, 6);
  const hhMonthly = home && home.powerUp && home.powerUp.days === 30 ? home.powerUp.pct : 0;
%>
<%- include('announcement-banner') %>
<div class="wrap home-search-band" id="find">
  <h1 class="hm-tagline hm-sr">Rent the latest PS5 &amp; PS4 games. Sign in by QR — no password.</h1>
  <div class="search">
    <%- include('home-search', { featured: typeof featured !== 'undefined' ? featured : [], compact: true }) %>
  </div>
</div>
<% if (hhMonthly) { %>
<div class="promo-bar">Monthly rentals are <b><%= hhMonthly %>% off</b> while this promo is on. One use per customer. The code is on the game page.</div>
<% } %>

<section class="section" id="newReleasesSection">
  <div class="wrap">
    <div class="row-head">
      <div>
        <h2>New releases</h2>
        <p class="lede">Each card shows that game’s weekly and monthly price, plus Trophy and Non-Trophy status.</p>
      </div>
      <a href="/browse?tab=new">View all ›</a>
    </div>
    <div class="card-grid">
      <% hhNew.forEach(function (g) { %>
        <%- include('game-card', { game: g, showWeekly: true }) %>
      <% }) %>
    </div>
  </div>
</section>

<%
  const hhToday = new Date().toISOString().slice(0, 10);
  const hhSeenSoon = {};
  const hhSoon = [];
  (typeof upcoming !== 'undefined' && upcoming ? upcoming : []).forEach(function (g) {
    if (!g || hhSeenSoon[g.id]) return;
    if (g.release_date && g.release_date !== 'TBA' && g.release_date < hhToday) return;
    hhSeenSoon[g.id] = true;
    hhSoon.push(g);
  });
  hhSoon.sort(function (a, b) {
    const da = (!a.release_date || a.release_date === 'TBA') ? '9999-99-99' : a.release_date;
    const db = (!b.release_date || b.release_date === 'TBA') ? '9999-99-99' : b.release_date;
    return da < db ? -1 : da > db ? 1 : String(a.title).localeCompare(String(b.title));
  });
  const hhSoonShow = hhSoon.slice(0, 6);
  function hhReleaseLabel(ymd) {
    const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(ymd || ''));
    if (!m) return 'Date TBA';
    const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    return months[Number(m[2]) - 1] + ' ' + Number(m[3]) + ', ' + m[1];
  }
%>
<% if (hhSoonShow.length) { %>
<section class="section" id="comingSoon">
  <div class="wrap">
    <div class="row-head">
      <div>
        <h2>Coming soon</h2>
        <p class="lede">Reserve now and we’ll hold your spot in line on Messenger.</p>
      </div>
      <a href="/browse?tab=coming-soon">View all ›</a>
    </div>
    <div class="card-grid hh-soon-grid">
      <% hhSoonShow.forEach(function (g) {
        const hhDated = g.release_date && g.release_date !== 'TBA';
        const hhPlat = g.platform || 'PS5';
      %>
      <article class="hh-soon">
        <a class="hh-soon-cover" href="/upcoming/<%= seo.slug(g.title) %>-<%= g.id %>">
          <% if (g.cover_image) { %>
          <img src="<%= g.cover_image %>" alt="" width="480" height="720" loading="lazy" decoding="async">
          <% } else { %><span class="hh-soon-ph">No cover</span><% } %>
          <% if (hhDated) { %>
          <span class="hh-count" data-release="<%= g.release_date %>T00:00:00">
            <span><b>0</b><small>DAYS</small></span>
            <span><b>0</b><small>HRS</small></span>
            <span><b>0</b><small>MIN</small></span>
          </span>
          <% } else { %><span class="hh-count hh-count-tba">Date TBA</span><% } %>
          <span class="hh-soon-veil" aria-hidden="true">
            <span class="hh-soon-bell"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 3.2a1 1 0 0 1 1 1V5.2a5.2 5.2 0 0 1 4.2 5.1v3.2l1.2 2a1 1 0 0 1-.85 1.5H6.45a1 1 0 0 1-.85-1.5l1.2-2V10.3A5.2 5.2 0 0 1 11 5.2V4.2a1 1 0 0 1 1-1zm0 16.3a2 2 0 0 0 1.9-1.4h-3.8A2 2 0 0 0 12 19.5z"/></svg></span>
            <span class="hh-soon-veil-t">Reserve now and we'll hold your spot</span>
            <span class="hh-soon-veil-more">View details ›</span>
          </span>
        </a>
        <div class="hh-soon-band">Coming soon</div>
        <a class="hh-soon-title gc2-title" href="/upcoming/<%= seo.slug(g.title) %>-<%= g.id %>" title="<%= g.title %>"><span class="gc-title-text"><%= g.title %></span></a>
        <p class="hh-soon-when">Releases <%= hhReleaseLabel(g.release_date) %> · <%= hhPlat %></p>
        <a class="hh-soon-go" href="/upcoming/<%= seo.slug(g.title) %>-<%= g.id %>">Reserve a slot<span class="hh-soon-arr" aria-hidden="true">→</span></a>
      </article>
      <% }) %>
    </div>
  </div>
</section>
<script src="/js/home-soon.js?v=<%= typeof assetV !== 'undefined' ? assetV : '' %>" defer></script>
<% } %>

<section class="section" id="how" style="padding-top:0">
  <div class="wrap">
    <h2>How renting works</h2>
    <p class="lede">Ready in minutes. You never share a password.</p>
    <div class="steps">
      <div class="step"><div class="num">01</div><h3>Pick a game</h3><p>Choose from the PS5 and PS4 library. Weekly or monthly — longer rentals cost less per day. Prices depend on the game.</p></div>
      <div class="step"><div class="num">02</div><h3>Pay your way</h3><p>GCash or Maya for local customers, PayPal for international customers. QR Ph is on the order page when it is switched on. Bank transfer stays on Messenger. Card checkout is not live yet.</p></div>
      <div class="step"><div class="num">03</div><h3>Sign in by QR</h3><p>Scan a QR code from your own screen and send it on Messenger. Our account signs in. Your password never leaves your hands.</p></div>
    </div>
  </div>
</section>

<section class="section" id="players" style="padding-top:0">
  <div class="wrap">
    <h2>Choose your account type</h2>
    <p class="lede">Not sure which one fits? Here’s the simple comparison. Exact weekly and monthly prices are on each game’s page.</p>
    <div class="accounts">
      <div class="account">
        <div class="tier">NON-TROPHY</div>
        <div class="price"><% if (hhNt) { %>From ₱<%= hhNt %> <% } %><span>/ week</span></div>
        <ul>
          <li>Play on our account</li>
          <li>Free 3-hour try before you pay</li>
          <li>No deposit, no late fee</li>
          <li>Trophies do not go to your profile</li>
        </ul>
        <p class="fine">Exact weekly and monthly prices depend on the game.</p>
      </div>
      <div class="account">
        <div class="tier">TROPHY</div>
        <div class="price"><% if (hhTr) { %>From ₱<%= hhTr %> <% } %><span>/ week</span></div>
        <ul>
          <li>Play on your own PSN profile</li>
          <li>Trophies and saves stay yours</li>
          <li>₱<%= hhDeposit %> refundable deposit</li>
          <li>₱<%= hhLate %> per late day, from the deposit</li>
        </ul>
        <p class="fine">Exact weekly and monthly prices depend on the game.</p>
      </div>
      <div class="account">
        <div class="tier regular">PS4 PRIMARY</div>
        <div class="price"><% if (hhTr) { %>From ₱<%= hhTr %> <% } %><span>/ week</span></div>
        <ul>
          <li>Same starting weekly price as Trophy</li>
          <li>For games that support PS4</li>
          <li>Play on your own PSN profile</li>
          <li>₱<%= hhDeposit %> refundable deposit, ₱<%= hhLate %> late fee</li>
        </ul>
        <p class="fine">Ask about PS4 Primary on a PS4 or PS4/PS5 game.</p>
      </div>
    </div>
  </div>
</section>

<section class="section" id="reviewsSection" style="padding-top:0">
  <div class="wrap">
    <h2>What players actually say</h2>
    <p class="lede">Real reviews from people who already rented with us. Each quote is shown once.</p>
    <% if (hhQuotes.length) { %>
    <div class="reviews">
      <% hhQuotes.forEach(function (r) { %>
      <div class="quote"><p>“<%= r.text %>”</p><cite><%= reviewDisplayName(r) %></cite></div>
      <% }) %>
    </div>
    <% } %>
    <a class="fb-link" href="https://facebook.com/PlaystationHub00">More reviews on our Facebook Page →</a>
  </div>
</section>
