<%
  const bannerFeed = (typeof announcementFeed !== 'undefined' && announcementFeed) ? announcementFeed : null;
  const bannerSlides = bannerFeed && bannerFeed.banner ? bannerFeed.banner : [];
  const bannerMany = bannerSlides.length > 1;
%>
<% if (bannerSlides.length) { %>
<section class="ann-banner" id="annBanner" aria-label="Highlights"<% if (bannerMany) { %> role="region" aria-roledescription="carousel" tabindex="0"<% } %>>
  <%- include('theme-decor') %>
  <% bannerSlides.forEach(function (slide, i) { %>
  <article class="ann-banner-slide<%= i === 0 ? ' on' : '' %> ann-aud-<%= slide.audience %> ann-dev-<%= slide.device %>" data-audience="<%= slide.audience %>" data-device="<%= slide.device %>"<% if (bannerMany) { %> aria-roledescription="slide" aria-label="<%= i + 1 %> of <%= bannerSlides.length %>"<% } %><% if (i !== 0) { %> aria-hidden="true"<% } %>>
    <% if (slide.image || slide.imageMobile) { %>
    <div class="ann-banner-media">
      <picture>
        <% if (slide.imageMobile) { %><source media="(max-width: 820px)" srcset="<%= slide.imageMobile %>"><% } %>
        <img <%- imgHero(slide.image || slide.imageMobile) %> alt="" width="1400" height="788" decoding="async"<% if (i === 0) { %> fetchpriority="high"<% } %>>
      </picture>
    </div>
    <% } %>
    <div class="ann-banner-copy">
      <% if (slide.label) { %><span class="ann-banner-label"><svg class="ann-banner-ico" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="5" width="17" height="15.5" rx="2"/><path d="M8 3.5V7M16 3.5V7M3.5 10h17"/></svg><%= slide.label %></span><% } %>
      <% if (slide.title) { %><h2 class="ann-banner-title"><%= slide.title %><% if (slide.titleAccent) { %> <span class="ann-banner-accent"><%= slide.titleAccent %></span><% } %></h2><% } %>
      <% if (slide.text) { %><p class="ann-banner-text"><%= slide.text %></p><% } %>
      <div class="ann-banner-actions">
        <% if (slide.buttonUrl) { %>
        <a class="ann-banner-cta" href="<%= slide.buttonUrl %>"<% if (slide.external) { %> target="_blank" rel="noopener"<% } %>><%= slide.buttonLabel || 'Learn more' %> →</a>
        <% } %>
        <% if (slide.button2Url) { %>
        <a class="ann-banner-cta ann-banner-cta-ghost" href="<%= slide.button2Url %>"<% if (slide.button2External) { %> target="_blank" rel="noopener"<% } %>><%= slide.button2Label || 'Learn more' %></a>
        <% } %>
      </div>
      <% if (slide.countdown) { %>
      <p class="ann-banner-count" data-countdown="<%= slide.countdown.at %>"><span class="ann-banner-glass" aria-hidden="true">⏳</span> Countdown: <b data-part="d"><%= slide.countdown.days %></b> days</p>
      <% } %>
    </div>
  </article>
  <% }) %>
  <% if (bannerMany) { %>
  <div class="ann-banner-dots" role="group" aria-label="Banner slides">
    <% bannerSlides.forEach(function (slide, i) { %>
    <button type="button" class="ann-dot<%= i === 0 ? ' on' : '' %>" data-index="<%= i %>" aria-label="Banner <%= i + 1 %> of <%= bannerSlides.length %>"<% if (i === 0) { %> aria-current="true"<% } %>></button>
    <% }) %>
  </div>
  <% } %>
</section>
<script>
(function () {
  var root = document.getElementById('annBanner');
  if (!root || !window.phAnnOk) return;
  var slides = root.querySelectorAll('.ann-banner-slide');
  var dots = root.querySelectorAll('.ann-dot');
  var first = -1;
  for (var i = 0; i < slides.length; i++) {
    var ok = window.phAnnOk(slides[i]);
    slides[i].classList.remove('on');
    slides[i].setAttribute('aria-hidden', 'true');
    if (ok && first < 0) first = i;
    if (dots[i]) dots[i].hidden = !ok;
  }
  if (first < 0) { root.setAttribute('hidden', ''); return; }
  slides[first].classList.add('on');
  slides[first].removeAttribute('aria-hidden');
  if (dots[first]) { dots[first].classList.add('on'); dots[first].setAttribute('aria-current', 'true'); }
})();
</script>
<% } %>
