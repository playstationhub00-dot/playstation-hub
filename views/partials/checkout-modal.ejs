<div class="ck-modal" id="checkoutModal" hidden data-upcoming="<%= upcoming ? '1' : '0' %>" data-game-id="<%= gameId %>" data-title="<%= title %>" data-cover="<%= cover %>" data-buy-nt="<%= typeof buyNt !== 'undefined' ? buyNt : 0 %>" data-buy-tr="<%= typeof buyTr !== 'undefined' ? buyTr : 0 %>">
  <div class="ck-sheet" role="dialog" aria-modal="true" aria-labelledby="ckTitle">
    <button type="button" class="ck-x" onclick="checkoutClose()" aria-label="Close">×</button>
    <div class="ck-hold" id="ckHold" hidden>Slot held for you · <b id="ckClock">15:00</b></div>
    <h2 id="ckTitle">Confirm reservation</h2>
    <div id="ckSummary"></div>
    <div id="ckLine" hidden>
      <div class="ck-line-picks" id="ckLinePicks" role="radiogroup" aria-label="How to join the line"></div>
      <p class="ck-line-sub" id="ckLineSub"></p>
      <p class="ck-line-pill" id="ckLinePill"></p>
      <div class="ck-line-game" id="ckLineGame"></div>
      <div class="ck-seg" id="ckLineTypes" role="group" aria-label="Account"></div>
      <div class="ck-seg" id="ckLinePlans" role="group" aria-label="Plan"></div>
      <div class="ck-line-place" id="ckLinePlace"></div>
      <div class="ck-line-fees" id="ckLineFees" hidden></div>
      <label class="ck-name">Facebook name <span class="ck-req">required</span>
        <input id="ckLineName" autocomplete="off" placeholder="Your Facebook name">
      </label>
      <label class="ck-name" id="ckLineNoteWrap">Messenger note <span class="ck-opt">optional</span>
        <input id="ckLineNote" autocomplete="off" placeholder="Anything we should know — e.g. a Messenger nickname">
      </label>
      <button type="button" class="ck-go ck-line-go" id="ckLineGo">Join the line</button>
      <div id="ckLineChoices" hidden></div>
      <p class="ck-line-foot" id="ckLineFoot"></p>
    </div>
    <label class="ck-name" id="ckNameWrap">Facebook name
      <input id="ckName" autocomplete="off" placeholder="Your Facebook name">
    </label>
    <div id="ckChoices">
      <button type="button" class="ck-choice" id="ckPay" onclick="checkoutPay()">
        <b>Pay on the website</b>
        <span>GCash, Maya, QR Ph, PayPal or bank transfer. Then upload a screenshot.</span>
      </button>
      <button type="button" class="ck-choice" id="ckMsg" onclick="checkoutMessenger()">
        <b>Message us on Messenger</b>
        <span>We save the reservation first, then open Messenger.</span>
      </button>
      <button type="button" class="ck-go" id="ckJoin" hidden onclick="checkoutJoin()">Join the line — free</button>
    </div>
    <div id="ckMethods" hidden></div>
    <div id="ckPayBox" hidden>
      <p class="ck-pay-sub">Send the exact amount, then upload a screenshot.</p>
      <button type="button" class="ck-change" id="ckChange" onclick="checkoutChangeMethod()">← Change payment method</button>
      <p class="ck-hold-note" id="ckHoldNote">The 15-minute hold keeps running.</p>
      <div id="ckPayDetail"></div>
      <label class="ck-drop" id="ckDrop">
        <input id="ckFile" type="file" accept="image/jpeg,image/png,image/webp,image/gif">
        <span class="ck-drop-empty" id="ckDropEmpty">
          <span class="ck-drop-ico" aria-hidden="true">▣</span>
          <b>Upload a screenshot of your payment</b>
          <span>PNG, JPG, or WebP · Choose a file</span>
        </span>
        <span class="ck-preview" id="ckPreview" hidden></span>
      </label>
      <button type="button" class="ck-go" id="ckSubmit" disabled onclick="checkoutSubmit()">Submit payment</button>
      <p class="ck-submit-note" id="ckSubmitNote">Submit stays unavailable until a screenshot is attached.</p>
      <button type="button" class="ck-instead" onclick="checkoutMessenger()">Prefer to chat? <u>Message us on Messenger instead</u></button>
      <p class="ck-instead-note">Switches to the Message us path · the order ref is kept</p>
    </div>
    <div id="ckDone" hidden></div>
    <p class="ck-err" id="ckErr" hidden></p>
  </div>
  <div class="ck-light" id="ckLight" hidden>
    <button type="button" class="ck-light-x" id="ckLightX" aria-label="Close">×</button>
    <div class="ck-light-card" id="ckLightCard">
      <div class="ck-light-name" id="ckLightName"></div>
      <img id="ckLightImg" alt="">
      <div class="ck-light-meta" id="ckLightMeta"></div>
    </div>
    <button type="button" class="ck-go ck-light-dl" id="ckLightDl">Download QR</button>
    <p class="ck-light-hint" id="ckLightHint"></p>
  </div>
</div>
