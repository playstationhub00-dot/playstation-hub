<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Poster Generator — <%= settings.title %></title>
  <link rel="icon" href="<%= settings.favicon_path %>" type="image/svg+xml">
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js" integrity="sha384-ZZ1pncU3bQe8y31yfZdMFdSpttDoPmOZg2wguVK9almUodir1PghgT0eY7Mrty8H" crossorigin="anonymous"></script>
  <style>
    .pg-wrap { max-width: 1300px; margin: 0 auto; padding: 1.5rem; }
    .pg-cat-tabs { display: flex; gap: 8px; flex-wrap: wrap; margin: 1rem 0 1.5rem; }
    .pg-cat-tab { padding: 0.6rem 1.1rem; border-radius: 10px; border: 1px solid #2a2a35; background: #15151d; color: #ccc; font-weight: 700; font-size: 0.85rem; cursor: pointer; }
    .pg-cat-tab.active { background: var(--ps-blue); color: #000; border-color: var(--ps-blue); }
    .pg-cat-tab .cnt { opacity: 0.65; font-weight: 500; margin-left: 4px; }
    .pg-cat-panel { display: none; }
    .pg-cat-panel.active { display: block; }
    .pg-warn { background: rgba(251,191,36,0.1); border: 1px solid rgba(251,191,36,0.3); color: #fbbf24; padding: 0.75rem 1rem; border-radius: 10px; margin-bottom: 1.25rem; font-size: 0.85rem; line-height: 1.6; }
    .pg-warn strong { color: #fff; }
    .pg-msg { background: rgba(34,197,94,0.1); border: 1px solid rgba(34,197,94,0.3); color: #4ade80; padding: 0.7rem 1rem; border-radius: 10px; margin-bottom: 1.25rem; font-size: 0.85rem; }
    .pg-bg-section { background: #111119; border: 1px solid #23232e; border-radius: 12px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; }
    .pg-bg-row { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
    .pg-bg-preview { width: 90px; height: 112px; border-radius: 8px; object-fit: cover; border: 1px solid #2a2a35; background: #1a1a24; }
    .pg-bg-form { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .pg-bg-form input[type="file"] { font-size: 0.78rem; color: #ccc; }
    .pg-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 1.5rem; }
    .pg-btn { background: var(--ps-blue); color: #000; border: none; border-radius: 8px; padding: 0.65rem 1.2rem; font-weight: 800; font-size: 0.85rem; cursor: pointer; }
    .pg-btn.outline { background: transparent; border: 1px solid #333; color: #ccc; }
    .pg-btn.purple { background: linear-gradient(135deg,#7b2ff7,#f107a3); color: #fff; }
    .pg-page-block { margin-bottom: 2rem; }
    .pg-page-label { font-size: 0.8rem; color: #888; margin-bottom: 0.6rem; font-weight: 700; }
    .pg-preview-scaler { width: 340px; height: 425px; overflow: hidden; border-radius: 10px; border: 1px solid #23232e; position: relative; }
    .pg-preview-scaler .poster { transform: scale(0.3148); transform-origin: top left; }

    /* ── Poster (1080x1350, rendered at native size; scaled only for on-screen preview) ── */
    .poster { width: 1080px; height: 1350px; background: linear-gradient(170deg,#080818 0%,#100228 45%,#07101a 100%); color: #fff; font-family: Arial, sans-serif; padding: 50px 54px; box-sizing: border-box; position: relative; overflow: hidden; }
    .poster-header { text-align: center; margin-bottom: 22px; }
    .poster-logo { width: 100px; mix-blend-mode: screen; margin-bottom: 8px; }
    .poster-cat-title { font-size: 40px; font-weight: 900; color: #FFD700; letter-spacing: 1px; }
    .poster-cat-sub { font-size: 18px; color: rgba(255,255,255,0.55); margin-top: 4px; }
    .poster-promo { background: linear-gradient(90deg,#3730a3,#6d28d9); border-radius: 12px; padding: 14px 22px; text-align: center; font-size: 20px; font-weight: 800; margin-bottom: 12px; }
    .poster-promo .pct { color: #fbbf24; }
    .poster-price-start-wrap { text-align: center; margin-bottom: 24px; }
    .poster-price-start { display: inline-block; background: rgba(255,215,0,0.12); border: 1px solid rgba(255,215,0,0.4); border-radius: 10px; padding: 8px 20px; font-size: 17px; font-weight: 700; color: #FFD700; }
    .poster-grid { display: grid; gap: 16px; height: 900px; }
    .poster-grid.compact { grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(4, 1fr); }
    .poster-grid.large { grid-template-columns: repeat(2, 1fr); grid-template-rows: repeat(2, 1fr); }
    .poster-tile { position: relative; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; overflow: hidden; }
    .poster-tile-cover { position: absolute; inset: 0; background-size: cover; background-position: top center; background-color: #1a1a24; display: flex; align-items: center; justify-content: center; }
    .poster-tile-cover.placeholder { font-size: 40px; opacity: 0.3; }
    .poster-tile-title-wrap { position: absolute; left: 8px; right: 8px; bottom: 8px; text-align: center; }
    .poster-tile-title { display: -webkit-inline-box; background: rgba(10,5,20,0.82); border: 1px solid rgba(255,255,255,0.12); border-radius: 8px; padding: 6px 12px; font-size: 15px; font-weight: 700; line-height: 1.25; max-width: 100%; overflow: hidden; text-overflow: ellipsis; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
    .poster-grid.large .poster-tile-title { font-size: 21px; padding: 8px 16px; }
    .poster-footer { position: absolute; bottom: 40px; left: 54px; right: 54px; text-align: center; }
    .poster-footer .site { font-size: 20px; font-weight: 800; color: #FFD700; margin-bottom: 6px; }
    .poster-footer .trial { font-size: 14px; color: #22c55e; font-weight: 700; margin-bottom: 8px; }
    .poster-badges { display: flex; justify-content: center; gap: 10px; }
    .poster-badge { background: rgba(255,255,255,0.08); border-radius: 8px; padding: 5px 14px; font-size: 12px; font-weight: 600; color: rgba(255,255,255,0.8); }
  </style>
</head>
<body>

<nav>
  <a href="/" class="logo"><img src="<%= settings.logo_path %>" alt="<%= settings.title %>" /></a>
  <div class="nav-links">
    <a href="/admin" class="admin-btn">Admin Panel</a>
  </div>
</nav>

<div class="pg-wrap">
  <a href="/admin" class="back-link">← Back to Admin</a>
  <h1>📸 Poster Generator</h1>
  <p style="color:#888;font-size:0.85rem;">Auto-generated from your live catalog. Prices only — no slot availability, so posted images stay accurate. Pick a category, then download.</p>

  <% if (msg === 'bg_saved') { %><div class="pg-msg">✅ Custom background updated — applied to every poster below.</div><% } %>
  <% if (msg === 'bg_removed') { %><div class="pg-msg">✅ Custom background removed — posters use the default look again.</div><% } %>
  <% if (msg === 'error') { %><div class="pg-warn"><strong>⚠️ No file selected.</strong> Choose an image first.</div><% } %>

  <div class="pg-bg-section">
    <label style="display:block;font-weight:700;font-size:0.85rem;margin-bottom:0.6rem;">🎨 Custom Poster Background <span style="color:#666;font-weight:500;font-size:0.75rem;">— applies to every category poster below, replacing the plain gradient</span></label>
    <div class="pg-bg-row">
      <% if (settings.poster_background_path) { %>
        <img src="<%= settings.poster_background_path %>" alt="Current poster background" class="pg-bg-preview">
      <% } else { %>
        <div class="pg-bg-preview" style="display:flex;align-items:center;justify-content:center;color:#555;font-size:0.68rem;text-align:center;padding:4px;">No custom background set</div>
      <% } %>
      <form method="POST" action="/admin/posters/background" enctype="multipart/form-data" class="pg-bg-form">
        <input type="file" name="poster_background" accept="image/*" required>
        <button type="submit" class="pg-btn">⬆ Upload</button>
      </form>
      <% if (settings.poster_background_path) { %>
      <form method="POST" action="/admin/posters/background/remove" onsubmit="return confirm('Remove the custom background and go back to the default plain look?');">
        <button type="submit" class="pg-btn outline">Remove</button>
      </form>
      <% } %>
    </div>
  </div>

  <div class="pg-quality-row" style="display:flex;align-items:center;gap:0.5rem;margin:0.8rem 0 1.2rem;">
    <label for="pgQuality" style="font-weight:700;font-size:0.85rem;">🖼️ Download Quality</label>
    <select id="pgQuality" class="pg-quality-select">
      <option value="1">Standard (1080×1350)</option>
      <option value="2">HD (2160×2700)</option>
      <option value="3" selected>Ultra HD (3240×4050)</option>
    </select>
  </div>

  <div class="pg-cat-tabs">
    <% posterGroups.forEach((grp, gi) => { %>
      <button type="button" class="pg-cat-tab<%= gi===0 ? ' active' : '' %>" onclick="showCat(<%= gi %>)"><%= grp.name %> <span class="cnt">(<%= grp.count %>)</span></button>
    <% }) %>
  </div>

  <% posterGroups.forEach((grp, gi) => { %>
  <div class="pg-cat-panel<%= gi===0 ? ' active' : '' %>" id="catPanel<%= gi %>">

    <% if (grp.missingCovers.length) { %>
    <div class="pg-warn">
      <strong>⚠️ <%= grp.missingCovers.length %> game<%= grp.missingCovers.length!==1?'s':'' %> missing cover art</strong> — will show a placeholder tile on the poster: <%= grp.missingCovers.join(', ') %>
    </div>
    <% } %>

    <div class="pg-actions">
      <button type="button" class="pg-btn" onclick="downloadCategory(<%= gi %>)">⬇ Download All Pages (<%= grp.pages.length %>)</button>
    </div>

    <% grp.pages.forEach((pageGames, pi) => { %>
    <div class="pg-page-block">
      <div class="pg-page-label">
        <%= grp.name %><% if (grp.pages.length > 1) { %> — Page <%= pi+1 %>/<%= grp.pages.length %><% } %>
        <button type="button" class="pg-btn outline" style="margin-left:10px;padding:0.3rem 0.7rem;font-size:0.72rem;" onclick="downloadPoster('poster-<%= gi %>-<%= pi %>')">⬇ Download</button>
      </div>
      <%
        const posterBgStyle = settings.poster_background_path
          ? `background-image: linear-gradient(rgba(6,4,20,0.55), rgba(10,2,30,0.7)), url('${settings.poster_background_path}'); background-size: cover; background-position: center;`
          : '';
      %>
      <div class="pg-preview-scaler">
        <div class="poster" id="poster-<%= gi %>-<%= pi %>" style="<%= posterBgStyle %>">
          <div class="poster-header">
            <img class="poster-logo" src="<%= settings.logo_path %>" alt="logo">
            <div class="poster-cat-title"><%= grp.name %></div>
            <div class="poster-cat-sub">PS5 &amp; PS4 Digital Game Rentals</div>
          </div>
          <% if (activePromos.length === 1) { %>
          <div class="poster-promo">🔥 <span class="pct"><%= activePromos[0].pct %>% OFF</span> on <%= activePromos[0].days %>-Day Rentals — Limited Time!</div>
          <% } else if (activePromos.length > 1) { %>
          <div class="poster-promo">🔥 <span class="pct">UP TO <%= Math.max(...activePromos.map(p => p.pct)) %>% OFF</span> — <%= activePromos.map(p => p.days + 'D').join(' / ') %> Promos Active!</div>
          <% } %>
          <%
            const pagePrices = pageGames.filter(g => g.fromPrice).map(g => g.fromPrice);
            const startPrice = pagePrices.length ? Math.min(...pagePrices) : null;
          %>
          <% if (startPrice) { %>
          <div class="poster-price-start-wrap"><div class="poster-price-start">🎮 Price Starts at ₱<%= startPrice %></div></div>
          <% } %>
          <div class="poster-grid <%= grp.density %>">
            <% pageGames.forEach(g => { %>
              <div class="poster-tile">
                <% if (g.cover_image) { %>
                  <div class="poster-tile-cover" style="background-image:url('<%= g.cover_image %>');background-position:<%= g.cover_focal_x != null ? g.cover_focal_x : 50 %>% <%= g.cover_focal_y != null ? g.cover_focal_y : 50 %>%;"></div>
                <% } else { %>
                  <div class="poster-tile-cover placeholder">🎮</div>
                <% } %>
                <div class="poster-tile-title-wrap"><div class="poster-tile-title"><%= g.title %></div></div>
              </div>
            <% }) %>
          </div>
          <div class="poster-footer">
            <div class="site">playstation-hub.com</div>
            <div class="trial">🎮 3 hours FREE trial — try before you rent or buy!</div>
            <div class="poster-badges">
              <span class="poster-badge">GCash</span>
              <span class="poster-badge">Maya</span>
              <span class="poster-badge">Message Us on Facebook</span>
            </div>
          </div>
        </div>
      </div>
    </div>
    <% }) %>

  </div>
  <% }) %>

</div>

<script>
function showCat(idx) {
  document.querySelectorAll('.pg-cat-panel').forEach((el, i) => el.classList.toggle('active', i === idx));
  document.querySelectorAll('.pg-cat-tab').forEach((el, i) => el.classList.toggle('active', i === idx));
}
function slugify(s) { return s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''); }
function downloadPoster(id) {
  const node = document.getElementById(id);
  // The live preview shrinks this node via CSS transform:scale for on-screen display.
  // html2canvas bakes that transform into the capture, so it must be neutralized
  // (via a higher-specificity inline style) right before rendering, then restored.
  const prevTransform = node.style.transform;
  node.style.transform = 'none';
  const scale = parseInt(document.getElementById('pgQuality').value, 10) || 3;
  return html2canvas(node, { scale, backgroundColor: '#0a0518', useCORS: true, width: 1080, height: 1350, windowWidth: 1080, windowHeight: 1350 })
    .then(canvas => {
      node.style.transform = prevTransform;
      const a = document.createElement('a');
      a.download = 'pshub-poster-' + id + '.png';
      a.href = canvas.toDataURL('image/png');
      a.click();
    })
    .catch(err => { node.style.transform = prevTransform; throw err; });
}
async function downloadCategory(gi) {
  const panel = document.getElementById('catPanel' + gi);
  const posters = [...panel.querySelectorAll('.poster')];
  for (let i = 0; i < posters.length; i++) {
    await downloadPoster(posters[i].id);
    await new Promise(r => setTimeout(r, 400));
  }
}
</script>

<%- include('partials/footer') %>
</body>
</html>
