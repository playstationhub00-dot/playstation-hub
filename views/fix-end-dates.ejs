<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fix End Dates — Playstation Hub Admin</title>
  <link rel="icon" href="<%= settings.favicon_path %>" type="image/svg+xml">
  <link rel="stylesheet" href="/css/style.css?v=<%= assetV %>">
</head>
<body style="background:#0a0a0a;color:#eee;font-family:ui-sans-serif,system-ui,sans-serif;">
<div style="max-width:760px;margin:0 auto;padding:2rem 1.25rem 4rem;">
  <a href="/admin?tab=customers" style="color:#888;text-decoration:none;font-size:0.85rem;">← Back to Customers</a>

  <h1 style="font-size:1.4rem;font-weight:800;margin:1rem 0 0.4rem;">Fix end dates — one-time correction</h1>
  <p style="color:#888;font-size:0.85rem;line-height:1.6;margin:0 0 1.5rem;">
    A timezone bug in the auto-fill script shifted every computed end date one day early
    (e.g. a 30-day rental starting Jul 11 showed Aug 9 instead of Aug 10). This page only
    lists renting customers whose stored end date exactly matches what that specific bug
    would have produced from their own start date and duration — nothing else is touched,
    and a manually-typed date that happens to coincide is left alone.
  </p>

  <% if (!affected.length) { %>
    <div style="background:#0d0d0d;border:1px solid #222;border-radius:12px;padding:1.5rem;text-align:center;color:#22c55e;font-weight:700;">
      ✅ Nothing to fix — no renting customer currently matches the bug's pattern.
    </div>
  <% } else { %>
    <div style="background:#0d0d0d;border:1px solid #222;border-radius:12px;overflow:hidden;margin-bottom:1.5rem;">
      <table style="width:100%;border-collapse:collapse;font-size:0.85rem;">
        <thead>
          <tr style="background:#111;text-align:left;">
            <th style="padding:0.6rem 0.9rem;color:#666;font-size:0.72rem;text-transform:uppercase;letter-spacing:0.5px;">Customer</th>
            <th style="padding:0.6rem 0.9rem;color:#666;font-size:0.72rem;text-transform:uppercase;letter-spacing:0.5px;">Game</th>
            <th style="padding:0.6rem 0.9rem;color:#666;font-size:0.72rem;text-transform:uppercase;letter-spacing:0.5px;">Days</th>
            <th style="padding:0.6rem 0.9rem;color:#666;font-size:0.72rem;text-transform:uppercase;letter-spacing:0.5px;">Start</th>
            <th style="padding:0.6rem 0.9rem;color:#666;font-size:0.72rem;text-transform:uppercase;letter-spacing:0.5px;">Current end</th>
            <th style="padding:0.6rem 0.9rem;color:#666;font-size:0.72rem;text-transform:uppercase;letter-spacing:0.5px;">Corrected end</th>
          </tr>
        </thead>
        <tbody>
          <% affected.forEach(({ c, shifted }) => { %>
          <tr style="border-top:1px solid #1a1a1a;">
            <td style="padding:0.6rem 0.9rem;font-weight:700;"><%= c.customer_name %></td>
            <td style="padding:0.6rem 0.9rem;color:#aaa;"><%= c.game_title %></td>
            <td style="padding:0.6rem 0.9rem;color:#aaa;"><%= c.days %></td>
            <td style="padding:0.6rem 0.9rem;color:#aaa;"><%= c.start_date %></td>
            <td style="padding:0.6rem 0.9rem;color:#ef4444;"><%= c.end_date %></td>
            <td style="padding:0.6rem 0.9rem;color:#22c55e;font-weight:700;"><%= shifted %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <form method="POST" action="/admin/fix-end-dates" onsubmit="return confirm('Add 1 day to the end date of these ' + <%= affected.length %> + ' customer(s)? This cannot be undone from this page.');">
      <button type="submit" style="background:var(--ps-blue);color:#fff;border:0;border-radius:10px;padding:0.85rem 1.4rem;font-weight:800;font-size:0.9rem;cursor:pointer;">
        ✅ Apply correction to <%= affected.length %> customer<%= affected.length !== 1 ? 's' : '' %>
      </button>
    </form>
  <% } %>
</div>
</body>
</html>
