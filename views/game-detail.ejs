<%
  var gdSeo = seo.gamePage({
    game: game,
    promo: (typeof promo !== 'undefined' ? promo : null),
    availability: (typeof computeAvailability === 'function')
      ? computeAvailability(game, typeof accountSummary !== 'undefined' ? accountSummary : null)
      : null
  });
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', {
    title: gdSeo.title,
    description: gdSeo.description,
    canonicalPath: gdSeo.canonicalPath,
    image: gdSeo.image,
    type: gdSeo.type,
    jsonLd: gdSeo.jsonLd
  }) %>
  <link rel="stylesheet" href="/css/style.css?v=<%= assetV %>">
  <link rel="stylesheet" href="/css/game-psn.css?v=<%= assetV %>">
  <link rel="stylesheet" href="/css/game-page.css?v=<%= assetV %>">
</head>
<body class="gd-page-booking-v2 gp-redesign">
<%- include('partials/announcement') %>
<%- include('partials/nav', { active: 'browse' }) %>

<%
  // ── Availability: from linked accounts (phase 2) or legacy per-game counts, per slot type ──
  const sum = typeof accountSummary !== 'undefined' ? accountSummary : null;
  const availability = computeAvailability(game, sum);
  const gdPsn = typeof psnView !== 'undefined' && psnView ? psnView : { hasPsn: false, media: [], hideGallery: false, info: [], genre: game.genre || '' };
  const { ntSlots, trSlots, ps4Slots, ntAvail, trAvail, ps4Avail, hasTrophy, showPs4, allUnavail, hasTrophyAcc, hasNtAcc, hasPs4Acc, totalSlots } = availability;
  const isLastSlot = totalSlots === 1;
  const noSlot = totalSlots === 0;
  const trLeft = trSlots, ntLeft = ntSlots, ps4Left = ps4Slots;
  const trNext = availability.trNext, ntNext = availability.ntNext, ps4Next = availability.ps4Next;
  // Not-yet-stocked: this game has never been rented AND no real account is linked
  // for this specific type — the account only gets created after the first booking.
  // Both conditions are required (renters===0 alone would misfire on a game that was
  // pre-stocked with a real account before ever being rented).
  const neverRented = !game.renters && !game.stocked;
  const trNotStocked = neverRented && !hasTrophyAcc;
  const ntNotStocked = neverRented && !hasNtAcc;
  const ps4NotStocked = neverRented && !hasPs4Acc;
  // The "Be the first to rent this" banner is for a game with nothing stocked at all.
  // One type being unstocked (e.g. no Trophy account yet) is already said by that type's
  // own "Set up on order" label, and must not make a stocked game look brand new.
  // A game with any open slot (even a legacy, unlinked one) is stocked too.
  const noneStocked = neverRented && !hasTrophyAcc && !hasNtAcc && (!showPs4 || !hasPs4Acc) && totalSlots === 0;
  // Every type with a permanent price can be bought (lib/availability.js
  // buyOption). One with no slot to hand over now — every slot rented out,
  // sold or offline — is a new slot: the owner adds one after the sale, so its
  // card says so instead of being greyed out. The checkout (POST /order/buy)
  // judges the same rule again and marks the order new_slot.
  const buyNtOpt = buyOption(sum, 'non_trophy', { everStocked: !ntNotStocked, avail: ntAvail }, game.buy_nt_price);
  const buyTrOpt = buyOption(sum, 'trophy', { everStocked: !trNotStocked, avail: trAvail }, game.buy_tr_price);
  const buyNt = buyNtOpt.buyable ? Number(game.buy_nt_price) : 0;
  const buyTr = buyTrOpt.buyable ? Number(game.buy_tr_price) : 0;
  const buyNtNew = buyNtOpt.newSlot;
  const buyTrNew = buyTrOpt.newSlot && hasTrophy;
  const hasBuy = buyNt > 0 || buyTr > 0;
  const buyPromo = promo.buy_promo_enabled && promo.buy_promo_pct > 0;
  const buyNtFinal = buyPromo ? Math.round(buyNt * (1 - promo.buy_promo_pct / 100)) : buyNt;
  const buyTrFinal = buyPromo ? Math.round(buyTr * (1 - promo.buy_promo_pct / 100)) : buyTr;
  // Cheapest live BUY price (permanent access), for the price header / sticky
  // bar to show before a buy type is picked — must never fall back to the
  // rent "From" price, which is a different (and usually much lower) figure.
  const gdBuyFromPrice = [buyNtFinal, buyTrFinal].filter(p => p > 0).length
    ? Math.min(...[buyNtFinal, buyTrFinal].filter(p => p > 0))
    : 0;
  // Cheapest live rent price across every available type/duration combo — the
  // "From ₱X" the price header shows before a type+duration are both picked.
  // Same base data and discount math as game-card.ejs's gcAllPricePairs, kept
  // in sync deliberately: this header must never show a different number
  // than the card that linked here.
  const gdPricePairs = [
    [game.nt_price_7d, 7], [game.nt_price_30d, 30],
    ...(hasTrophy ? [[game.tr_price_7d, 7], [game.tr_price_30d, 30]] : [])
  ].filter(([base]) => base > 0).map(([base, d]) => {
    const pct = gameDiscountPct(game, d, promo);
    return { base, final: pct > 0 ? base - Math.round(base * pct / 100) : base };
  });
  const gdFromPrice = gdPricePairs.length ? gdPricePairs.reduce((a, b) => b.final < a.final ? b : a).final : 0;
%>

<div class="gd-page">
  <% const gdhGallery = (game.gallery || []).filter(Boolean); %>
  <% const gpShots = (gdPsn.media || []).filter(m => m && m.type === 'image').map(m => m.src); %>
  <% const gpFilm = gdPsn.hideGallery ? gpShots : gdhGallery; %>
  <% const gdTier = (!game.is_bundle && typeof gameTier === 'function') ? gameTier(game) : null; %>
  <% const gdPromoBadge = (typeof promoBadgeFor === 'function') ? promoBadgeFor(game.id) : null; %>
  <% const gpInfo = (gdPsn.info || []); %>
  <% const gpInfoValue = (label) => { const row = gpInfo.find(r => r.label === label); return row ? row.value : ''; }; %>

  <div class="gd-back gp-crumb">
    <a href="/browse">← Back to Catalog</a>
    <span> · </span>
    <a href="/browse">Rent</a>
    <% if (game._category_name) { %><span> · <%= game._category_name %></span><% } %>
    <span> · <b><%= game.title %></b></span>
  </div>

  <div class="gp-grid">
    <div class="gp-hero">
    <div class="gd-cover-col">
      <% if (gdPsn.media.length) { %>
        <%- include('partials/game-psn-media', { items: gdPsn.media, title: game.title }) %>
      <% } else if (game.cover_image) { %>
        <% const gdhFocal = 'object-position: ' + (game.cover_focal_x != null ? game.cover_focal_x : 50) + '% ' + (game.cover_focal_y != null ? game.cover_focal_y : 50) + '%;'; %>
        <img src="<%= game.cover_image %>" alt="<%= game.title %>" class="gd-cover gdh-poster" width="760" height="1140" style="<%= gdhFocal %>">
      <% } else { %>
        <div class="gd-cover gd-cover-placeholder">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width:64px;height:64px;opacity:0.3;">
            <rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>
          </svg>
        </div>
      <% } %>
      <% if (isLastSlot) { %>
        <div class="gc-slot-banner gc-slot-banner-last" style="z-index:3;">🔥 Last Slot</div>
      <% } else if (noSlot) { %>
        <div class="gc-slot-banner gc-slot-banner-none" style="z-index:3;">Sold Out</div>
      <% } %>
    </div>
    <div class="gp-title">
      <div class="gp-tags">
        <% if (isLastSlot) { %><span class="gp-tag gp-tag-y">🔥 Last slot</span><% } %>
        <% if (noSlot) { %><span class="gp-tag">Sold out</span><% } %>
        <% if (game.platform) { %><span class="gp-tag"><%= game.platform %></span><% } %>
        <% if (gdTier) { %><span class="tier-pill tier-<%= gdTier.color %> usd-tier-pill"><%= gdTier.name %></span><% } %>
        <% if (gdPromoBadge) { %><span class="usd-badge usd-badge-promo"><%= gdPromoBadge.text %></span><% } %>
        <% if (gdPsn.genre) { gdPsn.genre.split('/').forEach(g => { %><span class="gp-tag"><%= g.trim() %></span><% }) } %>
      </div>
      <%# One h1. "Rent … in the Philippines" stays in the title tag, meta description, and JSON-LD. %>
      <h1 class="usd-title"><%= game.title %></h1>
      <% if (gdPsn.hasPsn) { %><%- include('partials/game-psn-headline', { psnView: gdPsn }) %><% } %>
      <% if (game.description && !gdPsn.hasPsn) { %><p class="gd-desc gdh-poster-desc"><%= game.description %></p><% } %>
      <% if (gdPsn.hasPsn && gdPsn.about) { %>
        <p class="gp-clamp"><%= gdPsn.aboutParas[0] || gdPsn.about %></p>
        <% if (gdPsn.readMore || (gdPsn.aboutParas && gdPsn.aboutParas.length > 1)) { %><button type="button" class="gp-more" onclick="gpTab('gpPaneDetails', document.getElementById('gpTabDetails'))">Read more ›</button><% } %>
      <% } %>
      <% if (gpInfo.length) { %>
      <div class="gp-chips">
        <% ['Release date', 'Genre', 'Publisher', 'Age rating'].forEach(label => { const value = gpInfoValue(label); if (!value) return; %>
        <span><b><%= label === 'Release date' ? 'Released' : label === 'Age rating' ? 'Rating' : label %></b><%= value %></span>
        <% }) %>
      </div>
      <% } %>
      <% if (game.link_url) { %><a href="<%= game.link_url %>" target="_blank" rel="noopener" class="spotlight-link">🔗 <%= game.link_label || 'Learn More' %> →</a><% } %>
    </div>
    </div>

    <!-- RIGHT: rental panel -->
    <div class="gd-detail-col gp-panel">


      <%
        const gdBundle = resolveBundleInfo(game);
      %>
      <% if (gdBundle) { %>
      <details class="gd-bundle-details">
        <summary class="gd-bundle-summary">See the <%= gdBundle.count %> games included</summary>
        <div class="bundle-game-grid" style="margin-top:0.75rem;">
          <% gdBundle.games.forEach(g => { %>
          <div class="bundle-game-tile">
            <% if (g.cover_image) { %><img <%- imgCard(g.cover_image) %> alt="<%= g.title %>" class="bundle-game-cover" loading="lazy">
            <% } else { %><div class="bundle-game-cover buy-cover-placeholder"></div><% } %>
            <div class="bundle-game-title"><%= g.title %></div>
          </div>
          <% }) %>
        </div>
      </details>
      <% } %>

      <!-- Booking card: everything a customer interacts with to place an order
           lives in one contained surface, matching the reservation page. -->
      <div class="gdh-card">

      <!-- ══ TOP TOGGLE: Rent / Buy Permanent ══ -->
      <div class="gp-mode">
        <button type="button" id="toggleRent" class="on" onclick="setMode('rent')">⏱️ Rent</button>
        <% if (hasBuy) { %>
        <button type="button" id="toggleBuy" onclick="setMode('buy')">♾️ Buy permanent</button>
        <% } %>
      </div>

      <!-- ══ PRICE HEADER: shared by rent and buy modes ══ -->
      <div class="gd-price-header">
        <div>
          <div class="gd-ph-kicker" id="phKicker" data-default-kicker="From">From</div>
          <div class="gd-ph-amount">
            <span id="phAmount" data-default-amount="<%= gdFromPrice %>" data-default-buy-amount="<%= gdBuyFromPrice %>">₱<%= gdFromPrice %></span>
          </div>
          <div class="gd-ph-rider" id="phRider" style="display:none;"></div>
        </div>
        <div class="gd-ph-save-wrap">
          <span class="gd-ph-was" id="phWas" style="display:none;"></span>
          <span class="gd-ph-save" id="phSave" style="display:none;"></span>
        </div>
      </div>

      <%- include('partials/account-guide-link') %>

      <!-- ════════════════════════════════
           RENT PANEL
           ════════════════════════════════ -->
      <div id="rentPanel">

        <!-- SELECT RENTAL TYPE -->
        <% if (noneStocked) { %>
        <!-- NOT-YET-STOCKED banner -->
        <div class="gd-notstocked-banner">
          <span class="gd-notstocked-icon">⚡</span>
          <div>
            <div class="gd-notstocked-title">Be the first to rent this</div>
            <div class="gd-notstocked-sub">Nobody has rented this yet, so the account isn't made. Book it and we'll have it ready within a few hours — same day.</div>
          </div>
        </div>
        <% } %>

        <div class="gd-type-options" id="typeOptions">

          <% if (hasTrophy) { %>
          <label class="gd-type-card gd-type-pill" id="label-tr">
            <input type="radio" name="rentalType" value="tr" class="gd-type-radio" onchange="onTypeChange(this)">
            <span class="gd-type-icon">🏆</span>
            <span class="gd-type-name">Trophy</span>
            <% if (hasTrophyAcc && trAvail) { %><span class="gd-slots-left"><%= trLeft %> slot<%= trLeft !== 1 ? 's' : '' %> left</span><% } %>
            <span class="gd-type-status <%= trNotStocked ? 'gd-status-notstocked' : (trAvail ? 'gd-status-avail' : 'gd-status-rented') %>"><%= trNotStocked ? 'Set up on order' : (trAvail ? 'Available' : 'Full Slot') %></span>
          </label>
          <% } %>

          <label class="gd-type-card gd-type-pill" id="label-nt">
            <input type="radio" name="rentalType" value="nt" class="gd-type-radio" onchange="onTypeChange(this)">
            <span class="gd-type-icon">🎮</span>
            <span class="gd-type-name">Non-Trophy</span>
            <% if (hasNtAcc && ntAvail) { %><span class="gd-slots-left"><%= ntLeft %> slot<%= ntLeft !== 1 ? 's' : '' %> left</span><% } %>
            <span class="gd-type-status <%= ntNotStocked ? 'gd-status-notstocked' : (ntAvail ? 'gd-status-avail' : 'gd-status-rented') %>"><%= ntNotStocked ? 'Set up on order' : (ntAvail ? 'Available' : 'Full Slot') %></span>
          </label>

          <% if (showPs4) { %>
          <label class="gd-type-card gd-type-pill" id="label-ps4">
            <input type="radio" name="rentalType" value="ps4" class="gd-type-radio" onchange="onTypeChange(this)">
            <span class="gd-type-icon">🕹️</span>
            <span class="gd-type-name">PS4 Primary</span>
            <% if (hasPs4Acc && ps4Avail) { %><span class="gd-slots-left"><%= ps4Left %> slot<%= ps4Left !== 1 ? 's' : '' %> left</span><% } %>
            <span class="gd-type-status <%= ps4NotStocked ? 'gd-status-notstocked' : (ps4Avail ? 'gd-status-avail' : 'gd-status-rented') %>"><%= ps4NotStocked ? 'Set up on order' : (ps4Avail ? 'Available' : 'Full Slot') %></span>
          </label>
          <% } %>

        </div>

        <%
          // How long until a full type frees up, surfaced right under the type
          // cards rather than left buried inside the "How setup works" accordion
          // below — the moment someone sees "Full Slot" is the moment they want
          // to know when that changes. Only shown when the date is actually
          // known (a linked account's slot carries its renter's end date; a
          // legacy-only game has nothing to count down to) and only for a type
          // that has genuinely been rented before — "set up on order" already
          // covers the type nobody has stocked yet.
          //
          // One slot per VISIBLE type card, in the same order and behind the
          // same hasTrophy/showPs4 gates #typeOptions uses above — not just one
          // entry per type that happens to be soon. flex-grow on .gd-avail-soon
          // divides the row across however many items THIS row has, with no
          // knowledge of the cards row above it; if Trophy alone is full, a
          // one-item row would stretch that single pill across the full width
          // and center it between both cards instead of sitting under Trophy's
          // own column. Keeping one slot per card (blank ones invisible but
          // still occupying their flex share) makes the two rows divide the
          // same width into the same number of pieces, so every pill lands
          // under the card it describes regardless of which types are full.
          const soonSlots = [];
          if (hasTrophy) soonSlots.push((!trAvail && !trNotStocked && trNext != null && trNext > 0) ? { icon: '🏆', days: trNext } : null);
          soonSlots.push((!ntAvail && !ntNotStocked && ntNext != null && ntNext > 0) ? { icon: '🎮', days: ntNext } : null);
          if (showPs4) soonSlots.push((!ps4Avail && !ps4NotStocked && ps4Next != null && ps4Next > 0) ? { icon: '🕹️', days: ps4Next } : null);
        %>
        <% if (soonSlots.some(s => s)) { %>
        <div class="gd-avail-soon-row">
          <% soonSlots.forEach(s => { %>
          <% if (s) { %>
          <span class="gd-avail-soon"><%= s.icon %> Available in <strong><%= s.days %> day<%= s.days !== 1 ? 's' : '' %></strong></span>
          <% } else { %>
          <span class="gd-avail-soon" aria-hidden="true" style="visibility:hidden;"></span>
          <% } %>
          <% }) %>
        </div>
        <% } %>

        <!-- Shared setup guide. Each type's original copy is preserved verbatim;
             only the selected type's block is shown, so nothing is lost by
             consolidating the three per-card accordions into one. -->
        <button type="button" class="gd-setup-toggle" id="setupToggle" aria-expanded="false" onclick="toggleSetupPanel()">
          <span>How setup works</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="gd-type-setup" id="typeSetupWrap" data-open="0">
          <% if (hasTrophy) { %>
          <div class="gd-setup-block" id="setup-tr">
            <p>✅ Play our games on <strong>YOUR OWN account</strong> and earn trophies on your profile.</p>
            <p style="color:#22c55e;">Setup: Settings → Users and Accounts → Other → Console Sharing and Offline Play → <strong>Enable</strong></p>
            <% const trSoon = trNext != null && trNext > 0 ? trNext : null; %>
            <% if (!trAvail && trSoon != null && trSoon > 0) { %>
            <p class="gd-avail-soon">📅 Next available in <strong><%= trSoon %> day<%= trSoon !== 1 ? 's' : '' %></strong></p>
            <% } %>
            <% if (trNotStocked) { %>
            <p class="gd-notstocked-note">Not stocked yet — we create the account after you book. Ready the same day.</p>
            <% } %>
          </div>
          <% } %>
          <div class="gd-setup-block" id="setup-nt">
            <p>🎮 Play the game on <strong>OUR account</strong> only. Trophies <strong>won't</strong> count on your own profile.</p>
            <p style="color:#888;">Setup: Settings → Users and Accounts → Other → Console Sharing and Offline Play → <strong>leave disabled</strong></p>
            <p style="color:#888;">On PS4, choose <strong>Do Not Activate</strong> if you are prompted.</p>
            <% const ntSoon = ntNext != null && ntNext > 0 ? ntNext : null; %>
            <% if (!ntAvail && ntSoon != null && ntSoon > 0) { %>
            <p class="gd-avail-soon">📅 Next available in <strong><%= ntSoon %> day<%= ntSoon !== 1 ? 's' : '' %></strong></p>
            <% } %>
            <% if (ntNotStocked) { %>
            <p class="gd-notstocked-note">Not stocked yet — we create the account after you book. Ready the same day.</p>
            <% } %>
          </div>
          <% if (showPs4) { %>
          <div class="gd-setup-block" id="setup-ps4">
            <p>🕹️ Set our account as <strong>PS4 primary</strong> — play on your PS4 and earn trophies on your own profile.</p>
            <p style="color:#22c55e;">Setup: Settings → Account Management → Activate as Your Primary PS4 → <strong>Activate</strong></p>
            <% if (!ps4Avail && ps4Next != null && ps4Next > 0) { %>
            <p class="gd-avail-soon">📅 Next available in <strong><%= ps4Next %> day<%= ps4Next !== 1 ? 's' : '' %></strong></p>
            <% } %>
            <% if (ps4NotStocked) { %>
            <p class="gd-notstocked-note">Not stocked yet — we create the account after you book. Ready the same day.</p>
            <% } %>
          </div>
          <% } %>
        </div>

        <!-- SELECT DURATION -->
        <div class="gd-duration-grid" id="durationGrid" style="margin-top:0.75rem;">
          <% RENTAL_DURATIONS.forEach(({ days: d, label: durLabel }) => { const pct = gameDiscountPct(game, d, promo); %>
          <button class="gd-dur-btn" data-days="<%= d %>" onclick="onDurChange(this)">
            <span class="gd-dur-days"><%= d === 7 ? 'Weekly · 7 days' : 'Monthly · 30 days' %></span>
            <span class="gd-dur-price" id="price-<%= d %>"><%- rentPriceHtml(game, 'nt', d, promo) %></span>
            <% if (pct > 0) { %><span class="gd-dur-promo"><%= pct %>% OFF</span><% } %>
          </button>
          <% }) %>
        </div>

        <% if (typeof voucherHint !== 'undefined' && voucherHint) { %>
        <div class="gp-hint" id="voucherHint">Renting monthly? Use <code><%= voucherHint.code %></code> for <%= voucherHint.pct %>% off.</div>
        <% } %>
        <div class="vc" id="voucherBox" data-game-id="<%= game.id %>" data-error="<%= typeof voucher_error !== 'undefined' ? voucher_error : '' %>">
          <div class="lb" id="voucherLabel">Have a promo code?</div>
          <div class="vok" id="voucherApplied" hidden></div>
          <button type="button" class="vmore" id="voucherAnother" hidden>Enter another code</button>
          <div class="vrow" id="voucherEntry">
            <input class="vin" id="voucherInput" maxlength="24" placeholder="Enter code" autocomplete="off" aria-label="Promo code">
            <button type="button" class="vbtn dis" id="voucherApply" disabled>Apply</button>
          </div>
          <div class="verr" id="voucherError" hidden></div>
          <div class="vfine" id="voucherFine">One code per order. Codes can't be combined with other vouchers or Rewards.</div>
        </div>

        <!-- TOTAL BREAKDOWN. Visible with the voucher box so the figure matches
             the order before the website form is opened. -->
        <div class="gd-total-box" id="totalBox">
          <div class="gd-total-label">Total</div>
          <div class="gd-total-rows" id="totalRows"></div>
          <div class="gd-total-final">
            <span>Total to send</span>
            <span id="totalFinal"></span>
          </div>
          <div class="gd-total-refund" id="totalRefund" style="display:none;"></div>
          <div class="gd-total-hint" id="totalHint" style="display:none;"></div>
          <% const gdPromoLines = (typeof promoCheckoutLines === 'function') ? promoCheckoutLines(game.id, null) : []; %>
          <% if (gdPromoLines.length) { %>
          <div class="gd-promo-note" id="gdPromoNote" data-game-id="<%= game.id %>">
            <%- include('partials/promo-lines', { items: gdPromoLines }) %>
          </div>
          <script src="/js/promo-checkout.js?v=<%= assetV %>" defer></script>
          <% } %>
        </div>

        <!-- PRIMARY: Messenger. It always opens, whatever has (or has not) been
             picked; a picked type and duration just fill in the message.
             Hidden when what they're looking at is fully booked: the "get in
             line" card below is the main action then, with its own small
             Messenger link (public/js/game-detail.js updateReserveLinks). -->
        <div id="ctaMsgWrap"<%= allUnavail ? ' hidden' : '' %>>
        <a href="http://m.me/PlaystationHub00" target="_blank" rel="noopener" class="gd-msg-primary" id="ctaMsgPrimary" data-track-source="game">
          <span class="gd-msg-main" id="ctaMsgMain"><%= allUnavail ? '💬 Ask us about this game' : '💬 Message us about this game' %></span>
          <span class="gd-msg-sub" id="ctaMsgSub"><%= allUnavail ? "We'll tell you when it frees up — or suggest a similar one" : 'Opens Messenger · we reply fastest there' %></span>
        </a>
        <div class="gd-msg-preview">
          <div class="gd-msg-preview-label">YOUR MESSAGE WILL SAY</div>
          <div class="gd-msg-preview-text" id="ctaMsgPreview"></div>
        </div>
        </div><!-- /ctaMsgWrap -->
        <% if (!allUnavail) { %>
        <!-- SECONDARY: order on the website. Tapping opens the price summary,
             name field and pay button below. -->
        <button type="button" class="gd-alt-order" id="orderToggle" aria-expanded="<%= order_error === '1' || order_error === 'code' ? 'true' : 'false' %>" aria-controls="gdOrderBlock" onclick="toggleOrderBlock()">
          Or order here on the website
          <small><%- include('partials/pay-note').trim() %></small>
        </button>
        <div id="gdOrderBlock"<%= order_error === '1' || order_error === 'code' ? '' : ' hidden' %>>
        <% } %>

        <% if (!allUnavail) { %>
        <!-- Website order: the name field and the price button run as one
             action. Lives inside #gdOrderBlock, opened by #orderToggle. -->
        <form method="POST" action="/order/create" class="gd-order-form" id="gdOrderForm" data-order-once>
          <input type="hidden" name="game_id" value="<%= game.id %>">
          <%- include('partials/order-token') %>
          <input type="hidden" name="account_type" id="orderType" value="">
          <input type="hidden" name="days" id="orderDays" value="">
          <input type="hidden" name="promo_code" id="orderPromoCode" value="">
          <input type="text" name="fb_name" id="orderFbName" class="gd-order-name" placeholder="Your Facebook name" required autocomplete="off">
          <button type="submit" class="gd-order-btn gd-cta-wait" id="ctaBtn" disabled>Pick an account type</button>
          <div class="gd-order-sub" id="ctaSub" style="display:none;"><%- include('partials/pay-note').trim() %></div>
        </form>
        </div><!-- /gdOrderBlock -->

        <div id="ctaValidationMsg" style="display:none;text-align:center;margin-top:0.5rem;font-size:0.82rem;color:#ef4444;font-weight:600;"></div>
        <% if (order_error === '1') { %>
        <div class="gd-order-error">⚠️ Please pick an account type and duration, and enter your Facebook name, before continuing.</div>
        <% } else if (order_error === 'code') { %>
        <div class="gd-order-error">That promo code couldn't be applied, so the order wasn't created. Check the message above and try again.</div>
        <% } %>

        <!-- The picked type has no slot: one "get in line" card -->
        <div id="reserveSection" style="display:none;">
          <%- include('partials/queue-line', { queues: queues, activeType: 'tr', selfRef: null, suffix: '', hideStrip: true }) %>
          <%- include('partials/noslot-options', { game_id: game.id, suffix: '', resValMsgId: 'reserveValidationMsg2', variant: 'card' }) %>
        </div>
        <% } else { %>
        <!-- Every type is full: the "get in line" card shown directly -->
        <div id="reserveSectionAll">
        <%- include('partials/queue-line', { queues: queues, activeType: (trAvail ? 'tr' : (ntAvail ? 'nt' : 'tr')), selfRef: null, suffix: 'All', hideStrip: true }) %>
        <%- include('partials/noslot-options', { game_id: game.id, suffix: 'All', resValMsgId: 'reserveValidationMsg1', variant: 'card' }) %>
        </div>
        <% } %>

      </div><!-- /rentPanel -->

      <!-- ════════════════════════════════
           BUY PERMANENT PANEL
           ════════════════════════════════ -->
      <% if (hasBuy) { %>
      <div id="buyPanel" style="display:none;">

        <!-- Promo badge -->
        <% if (buyPromo) { %>
        <div style="background:linear-gradient(135deg,#7b2ff7,#f107a3);color:#fff;border-radius:10px;padding:0.6rem 1rem;font-size:0.85rem;font-weight:800;text-align:center;margin-bottom:1.25rem;letter-spacing:0.3px;">
          🎉 <%= promo.buy_promo_pct %>% OFF Permanent Access — Limited Time!
        </div>
        <% } %>

        <div class="gd-section-label" style="margin-top:0;">SELECT ACCOUNT TYPE</div>

        <!-- NT Buy card — tagged as a new slot when every Non-Trophy slot is taken -->
        <% if (buyNt > 0) { %>
        <div class="gd-type-card" id="buyNtCard" onclick="selectBuyType('nt')" style="cursor:pointer;margin-bottom:0.75rem;border-color:#222;">
          <div style="display:none;"><input type="radio" name="buyType" value="nt" id="buyRadioNt"></div>
          <div class="gd-type-body">
            <div class="gd-type-header">
              <span class="gd-type-icon">🎮</span>
              <span class="gd-type-name">Non-Trophy — Permanent Access</span>
            </div>
            <% if (buyNtNew) { %>
            <div class="gd-type-desc">Our Non-Trophy slots are all taken — we'll add a brand-new one just for you.</div>
            <% } else { %>
            <div class="gd-type-desc">Played on our account. No trophy tracking. One-time payment, lifetime access.</div>
            <% } %>
            <div style="display:flex;align-items:center;gap:0.75rem;margin-top:0.75rem;">
              <% if (buyPromo) { %>
                <span style="font-size:0.85rem;color:#555;text-decoration:line-through;">₱<%= buyNt %></span>
              <% } %>
              <span style="font-size:1.5rem;font-weight:900;color:#22c55e;">₱<%= buyNtFinal %></span>
              <span style="font-size:0.72rem;color:#555;background:#1a1a1a;padding:0.2rem 0.5rem;border-radius:20px;">ONE-TIME</span>
            </div>
          </div>
        </div>
        <% } %>

        <!-- TR Buy card — tagged as a new slot when every Trophy slot is taken -->
        <% if (buyTr > 0 && hasTrophy) { %>
        <div class="gd-type-card" id="buyTrCard" onclick="selectBuyType('tr')" style="cursor:pointer;margin-bottom:0.75rem;background:#1a1400;border-color:rgba(255,196,0,0.2);">
          <div style="display:none;"><input type="radio" name="buyType" value="tr" id="buyRadioTr"></div>
          <div class="gd-type-body">
            <div class="gd-type-header">
              <span class="gd-type-icon">🏆</span>
              <span class="gd-type-name" style="color:#ffc400;">Trophy Account — Permanent Access</span>
            </div>
            <% if (buyTrNew) { %>
            <div class="gd-type-desc" style="color:#886600;">Our Trophy slots are all taken — we'll add a brand-new one just for you.</div>
            <% } else { %>
            <div class="gd-type-desc" style="color:#886600;">Earn trophies on your own PSN account. Play at your own pace forever.</div>
            <% } %>
            <div style="display:flex;align-items:center;gap:0.75rem;margin-top:0.75rem;">
              <% if (buyPromo) { %>
                <span style="font-size:0.85rem;color:#664d00;text-decoration:line-through;">₱<%= buyTr %></span>
              <% } %>
              <span style="font-size:1.5rem;font-weight:900;color:#ffc400;">₱<%= buyTrFinal %></span>
              <span style="font-size:0.72rem;color:#664d00;background:rgba(255,196,0,0.1);padding:0.2rem 0.5rem;border-radius:20px;">ONE-TIME</span>
            </div>
          </div>
        </div>
        <% } %>

        <!-- What you get -->
        <div style="background:#0d0d0d;border:1px solid #1a1a1a;border-radius:10px;padding:0.85rem 1rem;margin-bottom:1.25rem;">
          <div style="font-size:0.72rem;font-weight:700;color:#555;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.6rem;">What You Get</div>
          <div style="display:flex;flex-direction:column;gap:0.4rem;font-size:0.82rem;color:#aaa;">
            <!-- A full type is a new slot: shown by selectBuyType for the picked type only -->
            <% if (buyNtNew) { %>
            <div class="gd-newslot-note" style="margin:0;" id="buyNewSlotNote-nt" hidden>🆕 <strong>Set up on order:</strong> we buy a fresh Non-Trophy slot for this game after you pay, then message you on Facebook when it's ready. Same price, yours forever.</div>
            <% } %>
            <% if (buyTrNew) { %>
            <div class="gd-newslot-note" style="margin:0;" id="buyNewSlotNote-tr" hidden>🆕 <strong>Set up on order:</strong> we buy a fresh Trophy slot for this game after you pay, then message you on Facebook when it's ready. Same price, yours forever.</div>
            <% } %>
            <div>♾️ &nbsp;Permanent access — no time limit</div>
            <div>🔓 &nbsp;Play anytime, as many times as you want</div>
            <div>💳 &nbsp;<%- include('partials/pay-note').trim() %></div>
          </div>
        </div>

        <!-- Buy CTA: order on the site — only when a type is actually sellable.
             With every type full there is nothing selectedBuyType could ever
             become, so the button would just repeat "pick a type" forever. -->
        <% if (buyNt > 0 || buyTr > 0) { %>
        <form method="POST" action="/order/buy" class="gd-order-form" id="gdBuyForm" data-order-once>
          <input type="hidden" name="kind" value="game">
          <%- include('partials/order-token') %>
          <input type="hidden" name="game_id" value="<%= game.id %>">
          <input type="hidden" name="account_type" id="buyOrderType" value="">
          <input type="text" name="fb_name" id="buyFbName" class="gd-order-name" placeholder="Your Facebook name" required autocomplete="off">
          <button type="submit" class="gd-order-btn" id="buyCtaBtn" onclick="return handleBuyClick(event)">
            📘 Buy Permanent Access
          </button>
          <div class="gd-order-sub"><%- include('partials/pay-note').trim() %></div>
        </form>
        <div id="buyValidationMsg" style="display:none;text-align:center;margin-top:0.5rem;font-size:0.82rem;color:#ef4444;font-weight:600;"></div>
        <% } else { %>
        <div class="gd-noslot-banner" style="margin-top:0.25rem;">
          <span class="gd-noslot-icon">⏳</span>
          <div>
            <div class="gd-noslot-title">Nothing to buy right now</div>
            <div class="gd-noslot-sub">Every account type is currently rented out. Message us and we'll let you know the moment one opens up for sale.</div>
          </div>
        </div>
        <% } %>

        <!-- Secondary: Messenger, always one tap away -->
        <a href="http://m.me/PlaystationHub00" target="_blank" rel="noopener" class="gd-cta-link" style="display:block;text-align:center;margin-top:0.5rem;">or message us on Facebook instead</a>

      </div><!-- /buyPanel -->
      <% } %>

      </div><!-- /gdh-card -->

    </div>

    <%- include('partials/game-film', { images: gpFilm, title: game.title, filmClass: gdPsn.hideGallery ? 'gp-gal' : 'rsv-gallery-section' }) %>

    <div class="gp-tabs" id="gpTabs">
      <div class="gp-tablist" role="tablist">
        <button type="button" class="gp-tab on" id="gpTabBefore" role="tab" aria-selected="true" onclick="gpTab('gpPaneBefore', this)">Before you rent</button>
        <button type="button" class="gp-tab" id="gpTabDetails" role="tab" aria-selected="false" onclick="gpTab('gpPaneDetails', this)">Details</button>
        <button type="button" class="gp-tab" role="tab" aria-selected="false" onclick="gpTab('gpPaneFaq', this)">FAQ<% if (gdSeo.faqs && gdSeo.faqs.length) { %> (<%= gdSeo.faqs.length %>)<% } %></button>
        <%# Shared pool on every game (lib/reviews.js). A number here is the shop-wide "renters asked" total, which read as reviews of this title. %>
        <button type="button" class="gp-tab" role="tab" aria-selected="false" onclick="gpTab('gpPaneReviews', this)">Customer reviews</button>
      </div>
      <div class="gp-pane" id="gpPaneBefore">
        <div class="gp-before">
          <div class="gp-bi"><span>🌐</span><p><b>Online play</b>Needs your own PS Plus.</p></div>
          <% if (hasTrophy) { %><div class="gp-bi"><span>🏆</span><p><b>Trophy</b>Your account. Turn Console Sharing <b>on</b>.</p></div><% } %>
          <div class="gp-bi"><span>🎮</span><p><b>Non-Trophy</b>Our account. Leave Console Sharing off.</p></div>
          <% if (showPs4) { %><div class="gp-bi"><span>🕹️</span><p><b>PS4 Primary</b>Your PS4. Activate as primary.</p></div><% } %>
        </div>
        <p class="gp-before-ft">
          <% if (typeof recommend !== 'undefined' && recommend && recommend.total > 0) { %><b><%= recommend.pct %>%</b> would recommend us · <%= recommend.up %> of <%= recommend.total %> renters asked<% } %>
          <% if (typeof renterCount !== 'undefined' && renterCount && renterCount.n > 0) { %> · <%= renterCount.n.toLocaleString() %><%= renterCount.plus ? '+' : '' %> renters served<% } %>
          · <a href="/guides/trophy-vs-non-trophy-vs-ps4-primary">Setup guide ›</a>
        </p>
      </div>
      <div class="gp-pane" id="gpPaneDetails" hidden>
        <% if (gdPsn.hasPsn) { %><%- include('partials/game-psn-about', { psnView: gdPsn }) %><% } %>
        <% if (!gdPsn.hasPsn && game.description) { %><p class="gp-details-copy"><%= game.description %></p><% } %>
        <% if (!gdPsn.hasPsn) { %>
        <p class="gp-details-copy"><%= game.platform %><% if (game.genre) { %> · <%= game.genre %><% } %></p>
        <% } %>
      </div>
      <div class="gp-pane" id="gpPaneFaq" hidden>
        <% if (gdSeo.faqs && gdSeo.faqs.length) { %>
        <section class="gd-faq" id="game-faq">
          <h2 class="gd-faq-title"><%= game.title %> rental FAQ</h2>
          <div class="faq-list">
            <%- include('partials/faq-items', { items: gdSeo.faqs }) %>
          </div>
          <p class="gd-faq-more">Deposit, payment, and how to sign in are on the <a href="/faq">FAQ</a>.</p>
        </section>
        <% } else { %>
        <p class="gp-details-copy">Deposit, payment, and how to sign in are on the <a href="/faq">FAQ</a>.</p>
        <% } %>
      </div>
      <div class="gp-pane" id="gpPaneReviews" hidden>
        <%- include('partials/review-block', { reviews: reviews, reviewStats: reviewStats, recommend: (typeof recommend !== 'undefined' ? recommend : null), reviewBadge: reviewBadge, reviewDisplayName: reviewDisplayName }) %>
      </div>
    </div>

    <% const gpRelated = (typeof related !== 'undefined' && related) ? related : []; %>
    <% if (gpRelated.length) { %>
    <div class="gp-related">
      <div class="gp-related-h">
        <h2><span class="gp-o">○</span> You might also like</h2>
        <a href="/browse">See all games ›</a>
      </div>
      <div class="gp-related-row">
        <% gpRelated.forEach(item => { %>
        <a class="gp-rel" href="<%= item.href %>">
          <% if (item.cover) { %><img src="<%= item.cover %>" alt="" width="46" height="60" loading="lazy" decoding="async"><% } else { %><span class="gp-rel-ph"></span><% } %>
          <span><b><%= item.title %></b><small><%= item.status %></small></span>
        </a>
        <% }) %>
      </div>
    </div>
    <% } %>
  </div>

  <!-- ══ MOBILE STICKY BAR (≤820px) ══ -->
  <div class="gd-sticky-bar" id="gdStickyBar">
    <div class="gd-sb-info">
      <div class="gd-sb-kicker" id="gdSbKicker">From</div>
      <div class="gd-sb-amount" id="gdSbAmount">₱<%= gdFromPrice %></div>
      <div class="gd-sb-code" id="gdSbCode"></div>
    </div>
    <button type="button" class="gd-sb-btn" id="gdSbBtn" onclick="handleStickyBarClick()"><%= allUnavail ? '💬 Ask us' : '💬 Message us' %></button>
  </div>
</div>

<%- include('partials/footer') %>

<script>const RENTAL_DURATIONS = <%- JSON.stringify(RENTAL_DURATIONS.map(d => d.days)) %>;</script>
<script>
const PRICES = {
  nt: { 7: <%= game.nt_price_7d %>, 30: <%= game.nt_price_30d %> },
  tr: { 7: <%= game.tr_price_7d || game.nt_price_7d %>, 30: <%= game.tr_price_30d || game.nt_price_30d %> },
  ps4: { 7: <%= game.tr_price_7d || game.nt_price_7d %>, 30: <%= game.tr_price_30d || game.nt_price_30d %> }
};
const BUY_PRICES = { nt: <%= buyNtFinal %>, tr: <%= buyTrFinal %> };
// This game's own discount per duration, or the site promo's when it has none
// (lib/game-discount.js) — already resolved, so it is always "enabled".
const PROMO = {
  enabled: true,
  discounts: { 7: <%= gameDiscountPct(game, 7, promo) %>, 30: <%= gameDiscountPct(game, 30, promo) %> },
  deposit: <%= promo.deposit %>
};
const AVAIL = { nt: <%= ntAvail ? 'true' : 'false' %>, tr: <%= trAvail ? 'true' : 'false' %>, ps4: <%= ps4Avail ? 'true' : 'false' %> };
// When every type is full, #gdOrderForm and #ctaBtn are never rendered at
// all (see the `<% if (!allUnavail) %>` split around the CTA) — there is no
// "order directly" path to offer. #totalBox has no such split, so it needs
// its own flag rather than following ctaBtn's existence.
const ALL_UNAVAIL = <%= allUnavail ? 'true' : 'false' %>;
// Days until each account type frees up (null when unknown), for the "get in
// line" card's "Fully booked · frees up in about N days" line.
const NEXT_DAYS = <%- JSON.stringify({ tr: trNext != null ? trNext : null, nt: ntNext != null ? ntNext : null, ps4: ps4Next != null ? ps4Next : null }) %>;
const gameTitle = '<%= game.title.replace(/'/g, "\'") %>';
const gdSlideCount = <%= gpFilm.length %>;
</script>
<% if (gdPsn.media.length || gdPsn.about) { %><script src="/js/game-media.js?v=<%= assetV %>" defer></script><% } %>
<script src="/js/messenger-text.js?v=<%= assetV %>"></script>
<script src="/js/game-film.js?v=<%= assetV %>"></script>
<script src="/js/game-detail.js?v=<%= assetV %>"></script>
<script src="/js/voucher-box.js?v=<%= assetV %>"></script>
</body>
</html>
