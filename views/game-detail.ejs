<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= game.title %> — Playstation Hub</title>
  <link rel="icon" href="<%= settings.favicon_path %>" type="image/svg+xml">
  <link rel="stylesheet" href="/css/style.css?v=<%= assetV %>">
  <meta name="facebook-domain-verification" content="noj6ccmsehjq0v2oeq2e716fgyaqq0" />
</head>
<body class="gd-page-booking-v2">
<%- include('partials/announcement') %>
<%- include('partials/nav', { active: 'browse' }) %>

<%
  // ── Availability: from linked accounts (phase 2) or legacy per-game counts, per slot type ──
  const sum = typeof accountSummary !== 'undefined' ? accountSummary : null;
  const availability = computeAvailability(game, sum);
  const { ntSlots, trSlots, ps4Slots, ntAvail, trAvail, ps4Avail, hasTrophy, showPs4, allUnavail, hasTrophyAcc, hasNtAcc, hasPs4Acc, totalSlots } = availability;
  const isLastSlot = totalSlots === 1;
  const noSlot = totalSlots === 0;
  const trLeft = trSlots, ntLeft = ntSlots, ps4Left = ps4Slots;
  const trNext = availability.trNext, ntNext = availability.ntNext, ps4Next = availability.ps4Next;
  // Not-yet-stocked: this game has never been rented AND no real account is linked
  // for this specific type — the account only gets created after the first booking.
  // Both conditions are required (renters===0 alone would misfire on a game that was
  // pre-stocked with a real account before ever being rented).
  const neverRented = !game.renters && !game.stocked;
  const trNotStocked = neverRented && !hasTrophyAcc;
  const ntNotStocked = neverRented && !hasNtAcc;
  const ps4NotStocked = neverRented && !hasPs4Acc;
  const anyNotStocked = trNotStocked || ntNotStocked || ps4NotStocked;
  // Buy is gated on slot state, not just on a price being set: an account already
  // sold (or taken offline) must stop being offered, the same way it already stops
  // being rentable. Each tier is judged against its own slot type.
  const buyNt = (buyTypeSellable(sum, 'non_trophy') ? (game.buy_nt_price || 0) : 0);
  const buyTr = (buyTypeSellable(sum, 'trophy') ? (game.buy_tr_price || 0) : 0);
  const hasBuy = buyNt > 0 || buyTr > 0;
  const buyPromo = promo.buy_promo_enabled && promo.buy_promo_pct > 0;
  const buyNtFinal = buyPromo ? Math.round(buyNt * (1 - promo.buy_promo_pct / 100)) : buyNt;
  const buyTrFinal = buyPromo ? Math.round(buyTr * (1 - promo.buy_promo_pct / 100)) : buyTr;
  // Cheapest live BUY price (permanent access), for the price header / sticky
  // bar to show before a buy type is picked — must never fall back to the
  // rent "From" price, which is a different (and usually much lower) figure.
  const gdBuyFromPrice = [buyNtFinal, buyTrFinal].filter(p => p > 0).length
    ? Math.min(...[buyNtFinal, buyTrFinal].filter(p => p > 0))
    : 0;
  // Cheapest live rent price across every available type/duration combo — the
  // "From ₱X" the price header shows before a type+duration are both picked.
  // Same base data and discount math as game-card.ejs's gcAllPricePairs, kept
  // in sync deliberately: this header must never show a different number
  // than the card that linked here.
  const gdPricePairs = [
    [game.nt_price_7d, 7], [game.nt_price_30d, 30],
    ...(hasTrophy ? [[game.tr_price_7d, 7], [game.tr_price_30d, 30]] : [])
  ].filter(([base]) => base > 0).map(([base, d]) => {
    const pct = getPromoDiscountPct(promo, d);
    return { base, final: pct > 0 ? base - Math.round(base * pct / 100) : base };
  });
  const gdFromPrice = gdPricePairs.length ? gdPricePairs.reduce((a, b) => b.final < a.final ? b : a).final : 0;
%>

<div class="gd-page">
  <div class="gd-back"><a href="/browse">← Back to Catalog</a></div>

  <%
    // Branded banner, sharing the reservation page's .usd-hero classes so the two
    // detail pages stay visually identical by construction rather than by two
    // copies that can drift apart.
    const gdhStatus = allUnavail
      ? { label: 'Sold Out', cls: 'usd-badge-off' }
      : (isLastSlot ? { label: 'Last Slot', cls: 'usd-badge-warn' }
                    : { label: 'Available', cls: 'usd-badge-ok' });
    // Urgency first, release date otherwise — the bar earns its space on the
    // games where a customer needs to hurry, and falls back to the date (or a
    // slot count, so it is never half-empty) on everything else.
    let gdhBarText, gdhBarUrgent = false;
    if (allUnavail) { gdhBarText = 'Sold out — all slots rented'; gdhBarUrgent = true; }
    else if (isLastSlot) { gdhBarText = 'Only 1 slot left'; gdhBarUrgent = true; }
    else if (game.release_date && game.release_date !== 'TBA') {
      gdhBarText = 'Released ' + new Date(game.release_date + 'T00:00:00').toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
    } else {
      gdhBarText = totalSlots + ' slot' + (totalSlots !== 1 ? 's' : '') + ' available';
    }
  %>
  <div class="usd-hero gdh-hero">
    <div class="usd-hero-placeholder"></div>
    <div class="usd-hero-scrim"></div>
    <div class="usd-hero-in">
      <div class="usd-badge-row">
        <span class="usd-badge <%= gdhStatus.cls %>"><%= gdhStatus.label %></span>
        <span class="usd-plat-chip"><%= game.platform %></span>
        <% if (game.genre) { game.genre.split('/').forEach(g => { %><span class="usd-plat-chip"><%= g.trim() %></span><% }) } %>
      </div>
      <h1 class="usd-title"><%= game.title %></h1>
      <div class="usd-hero-foot">
        <div class="gdh-bar-text<%= gdhBarUrgent ? ' gdh-bar-urgent' : '' %>"><%= gdhBarText %></div>
        <img src="<%= settings.logo_path %>" alt="" aria-hidden="true" class="usd-hero-brand">
      </div>
    </div>
  </div>

  <div class="gd-layout">

    <!-- LEFT: Cover + Gameplay Slider -->
    <%
      const slides = [];
      if (game.cover_image) slides.push(game.cover_image);
      (game.gallery || []).forEach(img => { if (img) slides.push(img); });
    %>
    <div class="gd-cover-col">
      <% if (slides.length) { %>
        <div class="gd-slider" id="gdSlider">
          <div class="gd-slider-track" id="gdSliderTrack">
            <% slides.forEach((img, i) => { %>
              <% const isCover = i === 0 && game.cover_image && img === game.cover_image; %>
              <% const focalStyle = isCover ? ('object-position: ' + (game.cover_focal_x != null ? game.cover_focal_x : 50) + '% ' + (game.cover_focal_y != null ? game.cover_focal_y : 50) + '%;') : ''; %>
              <div class="gd-slide"><img src="<%= img %>" alt="<%= game.title %> screenshot <%= i+1 %>" class="gd-cover" <%= i === 0 ? '' : 'loading="lazy" decoding="async"' %> style="<%= focalStyle %>"></div>
            <% }) %>
          </div>
          <div class="gd-platform-badge"><%= game.platform %></div>
          <% if (isLastSlot) { %>
            <div class="gc-slot-banner gc-slot-banner-last" style="z-index:3;">🔥 Last Slot</div>
          <% } else if (noSlot) { %>
            <div class="gc-slot-banner gc-slot-banner-none" style="z-index:3;">Sold Out</div>
          <% } %>
          <% if (slides.length > 1) { %>
            <button type="button" class="gd-slider-arrow gd-slider-prev" onclick="gdMove(-1)" aria-label="Previous">‹</button>
            <button type="button" class="gd-slider-arrow gd-slider-next" onclick="gdMove(1)" aria-label="Next">›</button>
            <div class="gd-slider-dots" id="gdSliderDots">
              <% slides.forEach((img, i) => { %>
                <button type="button" class="gd-dot<%= i===0 ? ' active' : '' %>" onclick="gdGo(<%= i %>)" aria-label="Go to image <%= i+1 %>"></button>
              <% }) %>
            </div>
          <% } %>
        </div>
        <% if (slides.length > 1) { %>
        <div class="gd-thumbs" id="gdThumbs">
          <% slides.forEach((img, i) => { %>
            <button type="button" class="gd-thumb<%= i===0 ? ' active' : '' %>" onclick="gdGo(<%= i %>)"><img src="<%= img %>" alt="thumbnail <%= i+1 %>" loading="lazy" decoding="async"></button>
          <% }) %>
        </div>
        <% } %>
      <% } else { %>
        <div class="gd-cover gd-cover-placeholder" style="position:relative;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width:64px;height:64px;opacity:0.3;">
            <rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>
          </svg>
          <div class="gd-platform-badge"><%= game.platform %></div>
          <% if (isLastSlot) { %>
            <div class="gc-slot-banner gc-slot-banner-last" style="z-index:3;">🔥 Last Slot</div>
          <% } else if (noSlot) { %>
            <div class="gc-slot-banner gc-slot-banner-none" style="z-index:3;">Sold Out</div>
          <% } %>
        </div>
      <% } %>
    </div>

    <!-- RIGHT: Detail + Rental Form -->
    <div class="gd-detail-col">

      <!-- Genre, title and release date now render in the branded banner above
           .gd-layout — moved, not duplicated, so the page shows one title. -->
      <% if (game.description) { %><p class="gd-desc"><%= game.description %></p><% } %>
      <% if (game.link_url) { %><a href="<%= game.link_url %>" target="_blank" rel="noopener" class="spotlight-link" style="display:inline-block;margin-bottom:1.25rem;">🔗 <%= game.link_label || 'Learn More' %> →</a><% } %>

      <%
        const gdBundle = resolveBundleInfo(game);
      %>
      <% if (gdBundle) { %>
      <details class="gd-bundle-details">
        <summary class="gd-bundle-summary">See the <%= gdBundle.count %> games included</summary>
        <div class="bundle-game-grid" style="margin-top:0.75rem;">
          <% gdBundle.games.forEach(g => { %>
          <div class="bundle-game-tile">
            <% if (g.cover_image) { %><img src="<%= g.cover_image %>" alt="<%= g.title %>" class="bundle-game-cover" loading="lazy">
            <% } else { %><div class="bundle-game-cover buy-cover-placeholder"></div><% } %>
            <div class="bundle-game-title"><%= g.title %></div>
          </div>
          <% }) %>
        </div>
      </details>
      <% } %>

      <!-- Booking card: everything a customer interacts with to place an order
           lives in one contained surface, matching the reservation page. -->
      <div class="gdh-card">

      <!-- ══ TOP TOGGLE: Rent / Buy Permanent ══ -->
      <div style="display:flex;background:#111;border:1px solid #222;border-radius:12px;padding:4px;margin-bottom:1.5rem;gap:4px;">
        <button id="toggleRent" onclick="setMode('rent')"
          style="flex:1;padding:0.7rem;border-radius:9px;border:none;cursor:pointer;font-weight:800;font-size:0.9rem;background:var(--ps-blue);color:#000;transition:all 0.15s;letter-spacing:0.3px;">
          ⏱️ Rent
        </button>
        <% if (hasBuy) { %>
        <button id="toggleBuy" onclick="setMode('buy')"
          style="flex:1;padding:0.7rem;border-radius:9px;border:none;cursor:pointer;font-weight:800;font-size:0.9rem;background:transparent;color:#555;transition:all 0.15s;letter-spacing:0.3px;">
          ♾️ Buy Permanent
        </button>
        <% } %>
      </div>

      <!-- ══ PRICE HEADER: shared by rent and buy modes ══ -->
      <div class="gd-price-header">
        <div>
          <div class="gd-ph-kicker" id="phKicker" data-default-kicker="From">From</div>
          <div class="gd-ph-amount">
            <span id="phAmount" data-default-amount="<%= gdFromPrice %>" data-default-buy-amount="<%= gdBuyFromPrice %>">₱<%= gdFromPrice %></span>
          </div>
          <div class="gd-ph-rider" id="phRider" style="display:none;"></div>
        </div>
        <div class="gd-ph-save-wrap">
          <span class="gd-ph-was" id="phWas" style="display:none;"></span>
          <span class="gd-ph-save" id="phSave" style="display:none;"></span>
        </div>
      </div>

      <!-- ════════════════════════════════
           RENT PANEL
           ════════════════════════════════ -->
      <div id="rentPanel">

        <% if (allUnavail) { %>
        <!-- NO SLOT banner -->
        <div class="gd-noslot-banner">
          <span class="gd-noslot-icon">⏳</span>
          <div>
            <div class="gd-noslot-title">No Slots Available Right Now</div>
            <div class="gd-noslot-sub">All slots for this game are currently rented. Pick your preferred type and duration, then choose how you'd like to get in line.</div>
          </div>
        </div>
        <% } %>

        <!-- SELECT RENTAL TYPE -->
        <% if (anyNotStocked) { %>
        <!-- NOT-YET-STOCKED banner -->
        <div class="gd-notstocked-banner">
          <span class="gd-notstocked-icon">⚡</span>
          <div>
            <div class="gd-notstocked-title">Be the first to rent this</div>
            <div class="gd-notstocked-sub">Nobody has rented this yet, so the account isn't made. Book it and we'll have it ready within a few hours — same day.</div>
          </div>
        </div>
        <% } %>

        <div class="gd-section-label" style="margin-top:<%= allUnavail ? '1.25rem' : '0' %>;">SELECT RENTAL TYPE</div>
        <div class="gd-type-options" id="typeOptions">

          <% if (hasTrophy) { %>
          <label class="gd-type-card gd-type-pill" id="label-tr">
            <input type="radio" name="rentalType" value="tr" class="gd-type-radio" onchange="onTypeChange(this)">
            <span class="gd-type-icon">🏆</span>
            <span class="gd-type-name">Trophy</span>
            <% if (hasTrophyAcc && trAvail) { %><span class="gd-slots-left"><%= trLeft %> slot<%= trLeft !== 1 ? 's' : '' %> left</span><% } %>
            <span class="gd-type-status <%= trNotStocked ? 'gd-status-notstocked' : (trAvail ? 'gd-status-avail' : 'gd-status-rented') %>"><%= trNotStocked ? 'Set up on order' : (trAvail ? 'Available' : 'Full Slot') %></span>
          </label>
          <% } %>

          <label class="gd-type-card gd-type-pill" id="label-nt">
            <input type="radio" name="rentalType" value="nt" class="gd-type-radio" onchange="onTypeChange(this)">
            <span class="gd-type-icon">🎮</span>
            <span class="gd-type-name">Non-Trophy</span>
            <% if (hasNtAcc && ntAvail) { %><span class="gd-slots-left"><%= ntLeft %> slot<%= ntLeft !== 1 ? 's' : '' %> left</span><% } %>
            <span class="gd-type-status <%= ntNotStocked ? 'gd-status-notstocked' : (ntAvail ? 'gd-status-avail' : 'gd-status-rented') %>"><%= ntNotStocked ? 'Set up on order' : (ntAvail ? 'Available' : 'Full Slot') %></span>
          </label>

          <% if (showPs4) { %>
          <label class="gd-type-card gd-type-pill" id="label-ps4">
            <input type="radio" name="rentalType" value="ps4" class="gd-type-radio" onchange="onTypeChange(this)">
            <span class="gd-type-icon">🕹️</span>
            <span class="gd-type-name">PS4 Primary</span>
            <% if (hasPs4Acc && ps4Avail) { %><span class="gd-slots-left"><%= ps4Left %> slot<%= ps4Left !== 1 ? 's' : '' %> left</span><% } %>
            <span class="gd-type-status <%= ps4NotStocked ? 'gd-status-notstocked' : (ps4Avail ? 'gd-status-avail' : 'gd-status-rented') %>"><%= ps4NotStocked ? 'Set up on order' : (ps4Avail ? 'Available' : 'Full Slot') %></span>
          </label>
          <% } %>

        </div>

        <!-- Shared setup guide. Each type's original copy is preserved verbatim;
             only the selected type's block is shown, so nothing is lost by
             consolidating the three per-card accordions into one. -->
        <button type="button" class="gd-setup-toggle" id="setupToggle" aria-expanded="false" onclick="toggleSetupPanel()">
          <span>How setup works</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
        </button>
        <div class="gd-type-setup" id="typeSetupWrap" data-open="0">
          <% if (hasTrophy) { %>
          <div class="gd-setup-block" id="setup-tr">
            <p>✅ Play our games on <strong>YOUR OWN account</strong> and earn trophies on your profile.</p>
            <p style="color:#22c55e;">Setup: Settings → Users and Accounts → Other → Console Sharing and Offline Play → <strong>Enable</strong></p>
            <% const trSoon = trNext != null && trNext > 0 ? trNext : null; %>
            <% if (!trAvail && trSoon != null && trSoon > 0) { %>
            <p class="gd-avail-soon">📅 Next available in <strong><%= trSoon %> day<%= trSoon !== 1 ? 's' : '' %></strong></p>
            <% } %>
            <% if (trNotStocked) { %>
            <p class="gd-notstocked-note">Not stocked yet — we create the account after you book. Ready the same day.</p>
            <% } %>
          </div>
          <% } %>
          <div class="gd-setup-block" id="setup-nt">
            <p>🎮 Play the game on <strong>OUR account</strong> only. Trophies <strong>won't</strong> count on your own profile.</p>
            <p style="color:#888;">Setup: Settings → Users and Accounts → Other → Console Sharing and Offline Play → <strong>leave disabled</strong></p>
            <% const ntSoon = ntNext != null && ntNext > 0 ? ntNext : null; %>
            <% if (!ntAvail && ntSoon != null && ntSoon > 0) { %>
            <p class="gd-avail-soon">📅 Next available in <strong><%= ntSoon %> day<%= ntSoon !== 1 ? 's' : '' %></strong></p>
            <% } %>
            <% if (ntNotStocked) { %>
            <p class="gd-notstocked-note">Not stocked yet — we create the account after you book. Ready the same day.</p>
            <% } %>
          </div>
          <% if (showPs4) { %>
          <div class="gd-setup-block" id="setup-ps4">
            <p>🕹️ Set our account as <strong>PS4 primary</strong> — play on your PS4 and earn trophies on your own profile.</p>
            <p style="color:#22c55e;">Setup: Settings → Account Management → Activate as Your Primary PS4 → <strong>Activate</strong></p>
            <% if (!ps4Avail && ps4Next != null && ps4Next > 0) { %>
            <p class="gd-avail-soon">📅 Next available in <strong><%= ps4Next %> day<%= ps4Next !== 1 ? 's' : '' %></strong></p>
            <% } %>
            <% if (ps4NotStocked) { %>
            <p class="gd-notstocked-note">Not stocked yet — we create the account after you book. Ready the same day.</p>
            <% } %>
          </div>
          <% } %>
        </div>

        <!-- SELECT DURATION -->
        <div class="gd-section-label" style="margin-top:1.5rem;">SELECT DURATION</div>
        <div class="gd-duration-grid" id="durationGrid">
          <% RENTAL_DURATIONS.forEach(({ days: d, label: durLabel }) => { const pct = promo.enabled ? ((promo.discounts && promo.discounts[d]) || 0) : 0; %>
          <button class="gd-dur-btn" data-days="<%= d %>" onclick="onDurChange(this)">
            <span class="gd-dur-days"><%= durLabel %></span>
            <span class="gd-dur-price" id="price-<%= d %>">—</span>
            <% if (pct > 0) { %><span class="gd-dur-promo"><%= pct %>% OFF</span><% } %>
          </button>
          <% }) %>
        </div>

        <!-- TOTAL BREAKDOWN -->
        <div class="gd-total-box" id="totalBox">
          <div class="gd-total-label">ORDER SUMMARY</div>
          <div class="gd-total-rows" id="totalRows"></div>
          <div class="gd-total-final">
            <span>To send now</span>
            <span id="totalFinal" style="color:var(--ps-blue);font-size:1.2rem;font-weight:900;"></span>
          </div>
          <div class="gd-total-refund" id="totalRefund" style="display:none;"></div>
          <div class="gd-total-hint" id="totalHint" style="display:none;"></div>
        </div>

        <% if (!allUnavail) { %>
        <!-- Primary: order on the site. Runs the name field and the price
             button as one action — no separate "or" section. -->
        <form method="POST" action="/order/create" class="gd-order-form" id="gdOrderForm">
          <input type="hidden" name="game_id" value="<%= game.id %>">
          <input type="hidden" name="account_type" id="orderType" value="">
          <input type="hidden" name="days" id="orderDays" value="">
          <input type="text" name="fb_name" id="orderFbName" class="gd-order-name" placeholder="Your Facebook name" required>
          <button type="submit" class="gd-order-btn gd-cta-wait" id="ctaBtn" disabled>Pick an account type</button>
          <div class="gd-order-sub" id="ctaSub" style="display:none;">Pay via GCash or Maya · no account needed</div>
        </form>

        <!-- Secondary: Messenger, always one tap away -->
        <a href="#" class="gd-cta-link" id="ctaMsgLink" onclick="return handleMessageUs(event)">or message us on Facebook instead</a>
        <div class="gd-cta-hint" id="ctaHint" style="display:none;">Send us: <strong>Game name · Days · Trophy or Non-Trophy</strong></div>

        <div id="ctaValidationMsg" style="display:none;text-align:center;margin-top:0.5rem;font-size:0.82rem;color:#ef4444;font-weight:600;"></div>
        <% if (order_error === '1') { %>
        <div class="gd-order-error">⚠️ Please pick an account type and duration, and enter your Facebook name, before continuing.</div>
        <% } %>

        <!-- CTA: Reserve options (no slot) -->
        <div id="reserveSection" style="display:none;">
          <div class="gd-noslot-banner" style="margin-top:0.5rem;">
            <span class="gd-noslot-icon">⏳</span>
            <div>
              <div class="gd-noslot-title">This type has no slot right now</div>
              <div class="gd-noslot-sub">Choose how you'd like to get in line for this account type.</div>
            </div>
          </div>
          <div class="gd-section-label" style="margin-top:1rem;">CHOOSE YOUR OPTION</div>
          <div style="background:linear-gradient(135deg,#150a26,#1c0d33);border:1px solid rgba(168,85,247,0.3);border-radius:14px;padding:0.85rem 0.9rem;text-align:center;margin-bottom:0.5rem;">
            <div style="font-size:1.1rem;margin-bottom:0.2rem;">⭐</div>
            <div style="font-weight:800;font-size:0.85rem;color:#fff;margin-bottom:0.15rem;">Priority Reservation — ₱100 fee</div>
            <div style="font-size:0.7rem;color:#888;margin-bottom:0.55rem;">Deducted from your total rent once a slot opens. We'll message you when it's your turn.</div>
            <form method="POST" action="/order/reserve" id="reserveForm" onsubmit="return handleReserveFormSubmit(event)">
              <input type="hidden" name="game_id" value="<%= game.id %>">
              <input type="hidden" name="account_type" id="resType" value="">
              <input type="hidden" name="days" id="resDays" value="">
              <input type="text" name="fb_name" id="resFbName" class="gd-order-name" placeholder="Your Facebook name" required style="max-width:230px;margin:0 auto 0.4rem;">
              <button type="submit" style="display:block;width:100%;max-width:230px;margin:0 auto;background:linear-gradient(135deg,#6d28d9,#a855f7);color:#fff;font-weight:800;padding:0.55rem 1.1rem;border-radius:50px;border:none;font-size:0.78rem;cursor:pointer;">
                Reserve Now — ₱100 →
              </button>
            </form>
            <a id="reserveLink" href="http://m.me/PlaystationHub00" target="_blank" rel="noopener" onclick="return handleReserveClick(event,'reserve')" style="display:block;margin-top:0.4rem;font-size:0.68rem;color:#888;text-decoration:underline;">
              or message us on Facebook instead
            </a>
          <div style="border-top:1px solid rgba(255,255,255,0.08);margin:0.55rem 0 0.45rem;"></div>
            <div style="font-size:0.68rem;color:#888;">Not ready to pay? <a id="queueLink" href="http://m.me/PlaystationHub00" target="_blank" rel="noopener" onclick="return handleReserveClick(event,'queue')" style="color:#93c5fd;text-decoration:underline;">Join the free waitlist →</a></div>
