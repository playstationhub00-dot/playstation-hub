          <input type="hidden" name="account_type" id="buyOrderType" value="">
          <input type="text" name="fb_name" id="buyFbName" class="gd-order-name" placeholder="Your Facebook name" required>
          <button type="submit" class="gd-order-btn" id="buyCtaBtn" onclick="return handleBuyClick(event)">
            📘 Buy Permanent Access
          </button>
          <div class="gd-order-sub">Pay via GCash or Maya · no account needed</div>
