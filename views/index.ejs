<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Playstation Hub — PS5/PS4 Game Rentals</title>
  <link rel="icon" href="<%= settings.favicon_path %>" type="image/svg+xml">
  <link rel="stylesheet" href="/css/style.css?v=<%= assetV %>">
  <meta name="facebook-domain-verification" content="noj6ccmsehjq0v2oeq2e716fgyaqq0" />
</head>
<body class="home-page" style="--section-gap: <%= settings.section_gap || 4 %>rem;">

<%- include('partials/announcement') %>
<%- include('partials/popup') %>
<%- include('partials/nav', { active: 'home' }) %>

<%
  // How the shop actually takes money, read from settings rather than written
  // out here. Two things drive it: whichever payment_methods the owner has
  // switched on, and whether the gateway key is configured at all.
  //
  // The site cannot know which methods PayMongo has approved on the account —
  // that lives on PayMongo's side — so the online badge names QRPh, which is
  // what a customer actually scans, rather than listing wallets that may or may
  // not be active yet.
  const PAY_ICONS = { gcash: '💙', maya: '💚', paypal: '🅿️' };
  const payManual = (settings.payment_methods || []).filter(m => m && m.enabled);
  const payBadges = [];
  if (typeof payViaGateway !== 'undefined' && payViaGateway) {
    payBadges.push({
      icon: '💳', primary: true,
      label: 'Pay online',
      note: 'Card, or QRPh scanned with GCash, Maya or any bank app'
    });
  }
  payManual.forEach(m => {
    payBadges.push({
      icon: PAY_ICONS[m.key] || '💸',
      label: m.label,
      note: m.key === 'paypal' ? 'For customers outside the Philippines' : 'Send it manually, then upload the receipt'
    });
  });
  // The one-line version, for the Why Rent From Us card.
  const payNames = payManual.map(m => m.label);
  const payWhyDesc = payBadges.length
    ? ((payBadges[0].primary ? 'Secure online checkout' : '')
        + (payBadges[0].primary && payNames.length ? ', or ' : '')
        + (payNames.length ? payNames.join(' / ') : '')
        + '. Refundable deposit on trophy accounts only.').replace(/^, or /, '')
    : 'Payment details are sent with every order. Refundable deposit on trophy accounts only.';
%>
<% const heroSlides = settings.hero_slides && settings.hero_slides.length > 0 ? settings.hero_slides : null; %>
<% if (heroSlides) { %>
<section class="hero-slideshow" id="heroSlideshow">
  <div class="hero-slides-track" id="heroTrack">
    <% heroSlides.forEach((sl, i) => { %>
    <div class="hero-slide <%= i === 0 ? 'active' : '' %>">
      <img src="<%= sl.path %>" alt="<%= sl.caption || 'Promo' %>">
      <% if (sl.caption) { %>
      <div class="hero-slide-caption"><%= sl.caption %></div>
      <% } %>
      <% if (sl.link) { %>
      <a href="<%= sl.link %>" class="hero-slide-link"></a>
      <% } %>
    </div>
    <% }) %>
  </div>
  <% if (heroSlides.length > 1) { %>
  <button class="hero-slide-arrow hero-slide-prev" onclick="heroSlide(-1)" aria-label="Previous">&#8249;</button>
  <button class="hero-slide-arrow hero-slide-next" onclick="heroSlide(1)" aria-label="Next">&#8250;</button>
  <div class="hero-slide-dots" id="heroDots">
    <% heroSlides.forEach((sl, i) => { %>
    <button class="hero-dot <%= i === 0 ? 'active' : '' %>" onclick="heroGoTo(<%= i %>)" aria-label="Slide <%= i+1 %>"></button>
    <% }) %>
  </div>
  <% } %>
</section>
<script>
(function(){
  let cur = 0;
  const slides = document.querySelectorAll('.hero-slide');
  const dots = document.querySelectorAll('.hero-dot');
  function goTo(n) {
    slides[cur].classList.remove('active');
    if (dots[cur]) dots[cur].classList.remove('active');
    cur = (n + slides.length) % slides.length;
    slides[cur].classList.add('active');
    if (dots[cur]) dots[cur].classList.add('active');
  }
  window.heroSlide = d => goTo(cur + d);
  window.heroGoTo = goTo;
  if (slides.length > 1) setInterval(() => goTo(cur + 1), 5000);
})();
</script>
<div class="hero-trust-strip">
  <div class="hero-trust-item"><b>Instant Setup</b>Delivered in minutes</div>
  <div class="hero-trust-item"><b>Trophy Accounts</b>Earn on your profile</div>
  <div class="hero-trust-item"><b>GCash · Maya</b>Pay how you want</div>
</div>
<% } else { %>
<%
  // Real games for the auto-rotating showcase panel — newest releases first, cover
  // art required. Falls back to Most Popular (featured) if no game has a release
  // date set yet, so the hero never goes empty while release_date is backfilling.
  const heroSource = (newReleases && newReleases.length) ? newReleases : featured;
  const heroGames = heroSource.filter(g => g.cover_image).slice(0, 6).map(g => {
    const sum = accountSummaryMap[g.id] || null;
    const avail = computeAvailability(g, sum, { nt: g.nt_days_left, tr: g.tr_days_left, ps4: g.ps4_days_left });
    const openSlots = avail.ntSlots + avail.trSlots + (avail.showPs4 ? avail.ps4Slots : 0);
    const pct = getPromoDiscountPct(promo, RENTAL_DURATIONS[0].days);
    const base = g.nt_price_7d || g.tr_price_7d || 0;
    const final = pct > 0 ? base - Math.round(base * pct / 100) : base;
    const typeLabel = (avail.hasTrophy && avail.trSlots > 0) ? 'Trophy' : (avail.ntSlots > 0 ? 'Non-Trophy' : (avail.showPs4 && avail.ps4Slots > 0 ? 'PS4 Primary' : 'Trophy'));
    const slotLabel = openSlots > 0 ? openSlots + ' slot' + (openSlots !== 1 ? 's' : '') + ' left' : 'Fully booked';
    return { title: g.title, cover: g.cover_image, focalX: g.cover_focal_x, focalY: g.cover_focal_y, price: final, meta: typeLabel + ' · ' + slotLabel };
  });
%>
<% if (settings.hero_bg.type !== 'default' && settings.hero_bg.path) { %>
<section class="hero hero-custom-bg">
  <% if (settings.hero_bg.type === 'image') { %>
    <div class="hero-bg-media" style="background-image:url('<%= settings.hero_bg.path %>');background-size:cover;background-position:center;"></div>
  <% } else { %>
    <video class="hero-bg-media" autoplay muted loop playsinline><source src="<%= settings.hero_bg.path %>"></video>
  <% } %>
  <div class="hero-bg-overlay" style="opacity:<%= (settings.hero_bg.overlay || 50) / 100 %>;"></div>
  <div class="hero-grid no-showcase">
    <div class="hero-content">
      <% const ht = settings.hero_text; %>
      <h1 style="font-size:<%= ht.title_size %>px;">
        <%= ht.line1 %><% if (ht.line1 && ht.line2) { %><br><% } %><span style="color:<%= ht.highlight_color %>;"><%= ht.highlight %></span><% if (ht.line2) { %> <%= ht.line2 %><% } %>
      </h1>
      <p style="color:<%= ht.subtitle_color %>;"><%= ht.subtitle %></p>
      <div class="hero-actions">
        <a href="/browse" class="btn btn-primary">Browse All Games</a>
        <a href="#how" class="btn btn-outline">How It Works</a>
      </div>
      <div class="hero-trust-row">
        <div class="hero-trust-item"><b>Instant Setup</b>Delivered in minutes</div>
              <div class="hero-trust-item"><b>Trophy Accounts</b>Earn on your profile</div>
      </div>
      <div class="hero-pay-methods">
        <span class="pay-badge pay-gcash">GCash</span>
        <span class="pay-badge pay-maya">Maya</span>
        <span class="pay-badge pay-qrph"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 14h3v3h-3zM20 14v3M14 20h3M20 20v.01"/></svg>QR Ph</span>
        <span class="pay-badge pay-bank"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 10l9-6 9 6M4 10v9M20 10v9M8 10v9M16 10v9M2 21h20"/></svg>Bank Transfer</span>
      </div>
      <div class="hero-stats">
        <div class="hero-stat">
          <div class="hero-stat-num"><%= games.length %>+</div>
          <div class="hero-stat-label">Games Available</div>
        </div>
        <div class="hero-stat">
          <% const allPricesCb = games.flatMap(g => [g.nt_price_7d, g.nt_price_30d, g.tr_price_7d, g.tr_price_30d].filter(Boolean)); const lowestPriceCb = allPricesCb.length ? Math.min(...allPricesCb) : 99; %>
          <div class="hero-stat-num">₱<%= lowestPriceCb %></div>
          <div class="hero-stat-label">Starting Price</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-num"><%= activeRenters %>+</div>
          <div class="hero-stat-label">Active Renters</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-num"><%= gamesPurchased %>+</div>
          <div class="hero-stat-label">Games Purchased</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-num">100%</div>
          <div class="hero-stat-label">Digital Games</div>
        </div>
      </div>
    </div>
  </div>
</section>
<% } else { %>
<section class="hero hero-v2">
  <% if (heroGames.length) { %>
  <div class="hero-photo" id="heroPhoto">
    <% heroGames.forEach((g, i) => { %>
    <img class="<%= i === 0 ? 'active' : '' %>" data-idx="<%= i %>" src="<%= g.cover %>" alt="<%= g.title %>" style="object-position: <%= g.focalX != null ? g.focalX : 50 %>% <%= g.focalY != null ? g.focalY : 50 %>%;">
    <% }) %>
  </div>
  <div class="hero-glow"></div>
  <% if (heroGames.length > 1) { %>
  <div class="hero-cover-picker" id="heroCoverPicker">
    <% heroGames.forEach((g, i) => { %>
    <button type="button" class="hero-cover-thumb<%= i === 0 ? ' active' : '' %>" data-idx="<%= i %>" aria-label="Show <%= g.title %>">
      <img src="<%= g.cover %>" alt="" style="object-position: <%= g.focalX != null ? g.focalX : 50 %>% <%= g.focalY != null ? g.focalY : 50 %>%;">
    </button>
    <% }) %>
  </div>
  <% } %>
  <% } %>
  <div class="hero-inner">
    <div class="hero-content">
      <% const ht = settings.hero_text; %>
      <h1 style="font-size:<%= ht.title_size %>px;">
        <%= ht.line1 %><% if (ht.line1 && ht.line2) { %><br><% } %><span style="color:<%= ht.highlight_color %>;"><%= ht.highlight %></span><% if (ht.line2) { %> <%= ht.line2 %><% } %>
      </h1>
      <p style="color:<%= ht.subtitle_color %>;"><%= ht.subtitle %></p>
      <div class="hero-actions">
        <a href="/browse" class="btn btn-primary">Browse All Games</a>
        <a href="#how" class="btn btn-outline">How It Works</a>
      </div>
      <div class="hero-trust-row">
        <div class="hero-trust-item"><b>Instant Setup</b>Delivered in minutes</div>
              <div class="hero-trust-item"><b>Trophy Accounts</b>Earn on your profile</div>
      </div>
      <div class="hero-pay-methods">
        <span class="pay-badge pay-gcash">GCash</span>
        <span class="pay-badge pay-maya">Maya</span>
        <span class="pay-badge pay-qrph"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 14h3v3h-3zM20 14v3M14 20h3M20 20v.01"/></svg>QR Ph</span>
        <span class="pay-badge pay-bank"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 10l9-6 9 6M4 10v9M20 10v9M8 10v9M16 10v9M2 21h20"/></svg>Bank Transfer</span>
      </div>
      <div class="hero-stats">
        <div class="hero-stat">
          <div class="hero-stat-num"><%= games.length %>+</div>
          <div class="hero-stat-label">Games Available</div>
        </div>
        <div class="hero-stat">
          <% const allPrices = games.flatMap(g => [g.nt_price_7d, g.nt_price_30d, g.tr_price_7d, g.tr_price_30d].filter(Boolean)); const lowestPrice = allPrices.length ? Math.min(...allPrices) : 99; %>
          <div class="hero-stat-num">₱<%= lowestPrice %></div>
          <div class="hero-stat-label">Starting Price</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-num"><%= activeRenters %>+</div>
          <div class="hero-stat-label">Active Renters</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-num"><%= gamesPurchased %>+</div>
          <div class="hero-stat-label">Games Purchased</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-num">100%</div>
          <div class="hero-stat-label">Digital Games</div>
        </div>
      </div>
    </div>
  </div>
  <% if (heroGames.length > 1) { %>
    <script>
    (function(){
      const cards = document.querySelectorAll('#heroPhoto img');
      const thumbs = document.querySelectorAll('#heroCoverPicker .hero-cover-thumb');
      if (cards.length < 2) return;
      let cur = 0, timer;
      function goTo(n) {
        cards[cur].classList.remove('active');
        if (thumbs[cur]) thumbs[cur].classList.remove('active');
        cur = n;
        cards[cur].classList.add('active');
        if (thumbs[cur]) thumbs[cur].classList.add('active');
      }
      function start() { timer = setInterval(function(){ goTo((cur + 1) % cards.length); }, 3500); }
      function restart() { clearInterval(timer); start(); }
      thumbs.forEach(function(t){
        t.addEventListener('click', function(){
          goTo(parseInt(t.dataset.idx, 10));
          restart();
        });
      });
      start();
    })();
    </script>
    <% } %>
</section>
<% } %>
<% } %>

<!-- NEW RELEASES SLIDER —————————————————————————————————————————————————
     Most recently released games, by publisher release_date. Deliberately not
     the same as the ✨ NEW badge, which marks what we stocked in the last 11
     days (created_at). Hidden entirely until at least 4 games have a
     release_date set, so a half-backfilled field never shows a thin section. -->
<% if (newReleases && newReleases.length >= 4) { %>
<div class="section" id="newReleasesSection">
  <h2 class="section-title">New Releases <a href="/browse" class="section-viewall">View All <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></a></h2>
  <div class="upcoming-slider-wrap">
    <button class="slider-arrow slider-arrow-left" onclick="slideSection('newReleasesSlider',-1)" aria-label="Previous">&#8249;</button>
    <div class="upcoming-slider" id="newReleasesSlider">
      <% newReleases.forEach(game => { %><div class="slider-card-wrap" style="min-width:200px;max-width:200px;flex-shrink:0;scroll-snap-align:start;"><%- include('partials/game-card', { game, showPriceStart: true }) %></div><% }) %>
    </div>
    <button class="slider-arrow slider-arrow-right" onclick="slideSection('newReleasesSlider',1)" aria-label="Next">&#8250;</button>
  </div>
</div>
<% } %>

<!-- UPCOMING GAMES (COMING SOON) -->
<%- include('partials/upcoming-section', { upcoming: upcoming.slice(0, 10), noBorderTop: true, viewAllHref: '/browse#comingSoon' }) %>

<!-- PRICE TIERS -->
<% if (priceCategories && priceCategories.length) { %>
<%
  const tierData = priceCategories.map(cat => {
    const catGames = games.filter(g => g.price_category_id === cat.id);
    let min = null;
    catGames.forEach(g => {
      RENTAL_DURATIONS.forEach(({ days: d }) => {
        const pct = getPromoDiscountPct(promo, d);
        ['nt_price_', 'tr_price_'].forEach(prefix => {
          const base = g[prefix + d + 'd'];
          if (base > 0) {
            const final = pct > 0 ? base - Math.round(base * pct / 100) : base;
            if (min === null || final < min) min = final;
          }
        });
      });
    });
    return { id: cat.id, name: cat.name, count: catGames.length, min, cat };
  }).filter(t => t.count > 0);
%>
<% if (tierData.length) { %>
<div class="tier-section">
  <h2 class="section-title">Browse by Price Tier</h2>
  <div class="tier-grid">
    <% tierData.forEach(t => {
      const cat = t.cat;
      const n = t.name.toLowerCase();
      const tierIcon = n.includes('new') ? '✨' : n.includes('deluxe') ? '👑' : n.includes('special') ? '⭐' : n.includes('regular') ? '🎮' : n.includes('budget') || n.includes('value') ? '💸' : '🕹️';
      // Split Art layout: bg_color is now the accent used for the price, not a card fill.
      const accentColor = cat.bg_color || '#F0A500';
      const titleColor = cat.title_color || '#ffffff';
      const titleSize = cat.title_size != null ? cat.title_size : 18;
      const artWidth = cat.image_width != null ? cat.image_width : 52;
      const artOpacity = cat.image_opacity != null ? cat.image_opacity : 100;
    %>
    <a href="/browse#cat-section-<%= t.id %>" class="tier-card" style="--tier-accent:<%= accentColor %>;">
      <% if (cat.image) { %>
      <div class="tier-card-art" style="width:<%= artWidth %>%;">
        <img src="<%= cat.image %>" alt="" loading="lazy" decoding="async"<% if (artOpacity !== 100) { %> style="opacity:<%= artOpacity / 100 %>;"<% } %>>
      </div>
      <% } else { %>
      <div class="tier-card-art-fallback"><%= tierIcon %></div>
      <% } %>
      <div class="tier-card-glow"></div>
      <div class="tier-card-top">
        <div class="tier-card-name" style="color:<%= titleColor %>;font-size:<%= titleSize %>px;"><%= t.name %></div>
        <div class="tier-card-count"><%= t.count %> title<%= t.count !== 1 ? 's' : '' %></div>
        <% if (t.min) { %><div class="tier-card-price" style="color:<%= accentColor %>;">Starts at ₱<%= t.min %></div><% } %>
      </div>
      <div class="tier-card-go"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></div>
    </a>
    <% }) %>
  </div>
</div>
<% } %>
<% } %>

<!-- SPOTLIGHT: MOST RENTED GAME -->
<% if (featured.length && featured[0].renters > 0) { %>
<%
  const spotGame = featured[0];
  const spotSum = accountSummaryMap[spotGame.id] || null;
  const spotAvail = computeAvailability(spotGame, spotSum, { nt: spotGame.nt_days_left, tr: spotGame.tr_days_left, ps4: spotGame.ps4_days_left });
  const spotOpenSlots = spotAvail.ntSlots + spotAvail.trSlots + (spotAvail.showPs4 ? spotAvail.ps4Slots : 0);
  const spotPct = getPromoDiscountPct(promo, RENTAL_DURATIONS[0].days);
  const spotBase = spotGame.nt_price_7d || spotGame.tr_price_7d || 0;
  const spotFinal = spotPct > 0 ? spotBase - Math.round(spotBase * spotPct / 100) : spotBase;
  const spotSlug = spotGame.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
%>
<div class="spotlight-section">
  <div class="spotlight-card">
    <div class="spotlight-cover">
      <% if (spotGame.cover_image) { %>
        <img src="<%= spotGame.cover_image %>" alt="<%= spotGame.title %>" loading="lazy" decoding="async" style="object-position: <%= spotGame.cover_focal_x != null ? spotGame.cover_focal_x : 50 %>% <%= spotGame.cover_focal_y != null ? spotGame.cover_focal_y : 50 %>%;">
      <% } %>
    </div>
    <div>
      <div class="spotlight-tag">Most Rented This Month</div>
      <h2 class="spotlight-title"><%= spotGame.title %></h2>
      <% if (spotGame.description) { %><p class="spotlight-desc"><%= spotGame.description %></p><% } %>
      <div class="spotlight-price">₱<%= spotFinal %><% if (spotPct > 0) { %><span style="font-size:1rem;color:var(--text-secondary);text-decoration:line-through;margin-left:0.5rem;font-weight:500;">₱<%= spotBase %></span><% } %></div>
      <% if (spotOpenSlots > 0) { %>
      <div class="spotlight-avail"><%= spotOpenSlots %> slot<%= spotOpenSlots !== 1 ? 's' : '' %> available now</div>
      <% } else { %>
      <div class="spotlight-avail" style="color:#ef4444;">No open slots right now</div>
      <% } %>
      <div style="display:flex;gap:0.75rem;align-items:center;flex-wrap:wrap;">
        <a href="/game/<%= spotSlug %>" class="btn btn-primary">Rent This Game</a>
        <% if (spotGame.link_url) { %>
        <a href="<%= spotGame.link_url %>" target="_blank" rel="noopener" class="spotlight-link">🔗 <%= spotGame.link_label || 'Learn More' %> →</a>
        <% } %>
      </div>
    </div>
  </div>
</div>
<% } %>

<!-- MOST POPULAR SLIDER -->
<div class="section" id="mostPopularSection">
  <h2 class="section-title">Most Popular <a href="/browse" class="section-viewall">View All <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></a></h2>
  <div class="upcoming-slider-wrap">
    <button class="slider-arrow slider-arrow-left" onclick="slideSection('popularSlider',-1)" aria-label="Previous">&#8249;</button>
    <div class="upcoming-slider" id="popularSlider">
      <% featured.forEach(game => { %><div class="slider-card-wrap" style="min-width:200px;max-width:200px;flex-shrink:0;scroll-snap-align:start;"><%- include('partials/game-card', { game, showPriceStart: true }) %></div><% }) %>
    </div>
    <button class="slider-arrow slider-arrow-right" onclick="slideSection('popularSlider',1)" aria-label="Next">&#8250;</button>
  </div>
</div>

<!-- MOST PLAYED IN PS PLUS SLIDER -->
<% if (psplusPopular.length > 0) { %>
<div class="section" id="mostPlayedPsplusSection">
  <h2 class="section-title">
    <span style="background:linear-gradient(135deg,#FFD700,#ffa500);-webkit-background-clip:text;-webkit-text-fill-color:transparent;">★</span>
    Most Played in PS Plus
    <a href="/ps-plus" class="section-viewall">View All <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></a>
    <button type="button" class="section-toggle-btn" onclick="toggleCollapsible('psplusBody', this)" aria-label="Collapse Most Played in PS Plus">▾</button>
  </h2>
  <div class="collapsible-body" id="psplusBody">
  <div class="upcoming-slider-wrap">
    <button class="slider-arrow slider-arrow-left" onclick="slideSection('psplusSlider',-1)" aria-label="Previous">&#8249;</button>
    <div class="upcoming-slider" id="psplusSlider">
    <% psplusPopular.forEach((game, idx) => { %>
    <div class="slider-card-wrap" style="min-width:200px;max-width:200px;flex-shrink:0;scroll-snap-align:start;">
