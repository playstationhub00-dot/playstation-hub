<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Playstation Hub — PS5/PS4 Game Rentals</title>
  <link rel="icon" href="<%= settings.favicon_path %>" type="image/svg+xml">
  <link rel="stylesheet" href="/css/style.css?v=<%= assetV %>">
  <meta name="facebook-domain-verification" content="noj6ccmsehjq0v2oeq2e716fgyaqq0" />
</head>
<body class="home-page" style="--section-gap: <%= settings.section_gap || 4 %>rem;">

<%- include('partials/announcement') %>
<%- include('partials/popup') %>
<%- include('partials/nav', { active: 'home' }) %>

<%
  // How the shop actually takes money, read from settings rather than written
  // out here. Two things drive it: whichever payment_methods the owner has
  // switched on, and whether the gateway key is configured at all.
  //
  // The site cannot know which methods PayMongo has approved on the account —
  // that lives on PayMongo's side — so the online badge names QRPh, which is
  // what a customer actually scans, rather than listing wallets that may or may
  // not be active yet.
  const PAY_ICONS = { gcash: '💙', maya: '💚', paypal: '🅿️' };
  const payManual = (settings.payment_methods || []).filter(m => m && m.enabled);
  const payBadges = [];
  if (typeof payViaGateway !== 'undefined' && payViaGateway) {
    payBadges.push({
      icon: '💳', primary: true,
      label: 'Pay online',
      note: 'Card, or QRPh scanned with GCash, Maya or any bank app'
    });
  }
  payManual.forEach(m => {
    payBadges.push({
      icon: PAY_ICONS[m.key] || '💸',
      label: m.label,
      note: m.key === 'paypal' ? 'For customers outside the Philippines' : 'Send it manually, then upload the receipt'
    });
  });
  // The one-line version, for the Why Rent From Us card.
  const payNames = payManual.map(m => m.label);
  const payWhyDesc = payBadges.length
    ? ((payBadges[0].primary ? 'Secure online checkout' : '')
        + (payBadges[0].primary && payNames.length ? ', or ' : '')
        + (payNames.length ? payNames.join(' / ') : '')
        + '. Refundable deposit on trophy accounts only.').replace(/^, or /, '')
    : 'Payment details are sent with every order. Refundable deposit on trophy accounts only.';

  // Entry prices per account type, for the explainer below the hero. Derived
  // from the live catalogue rather than written down, so a price change never
  // leaves the explainer quoting a number the game cards disagree with.
  const cheapestOf = keys => {
    const v = games.flatMap(g => keys.map(k => g[k]).filter(p => p > 0));
    return v.length ? Math.min(...v) : 0;
  };
  const ntFrom = cheapestOf(['nt_price_7d', 'nt_price_30d']);
  const trFrom = cheapestOf(['tr_price_7d', 'tr_price_30d']);
  const buyFrom = cheapestOf(['buy_nt_price', 'buy_tr_price']);
  const depositAmt = (promo && promo.deposit) || 0;

  // The slideshow hero shows a text trust strip rather than chips, so it needs
  // the same information in a sentence. Derived from the same source as the
  // chips — this line read "GCash · Maya" long after checkout, PayPal and the
  // rest arrived, and it was the last hardcoded payment copy on the site.
  const heroPayParts = [];
  if (typeof payViaGateway !== 'undefined' && payViaGateway) heroPayParts.push('Card & QR Ph');
  payManual.forEach(m => heroPayParts.push(m.label));
  const heroPayLine = heroPayParts.length ? heroPayParts.join(', ') : 'Details sent with your order';
%>
<% const heroSlides = settings.hero_slides && settings.hero_slides.length > 0 ? settings.hero_slides : null; %>
<% if (heroSlides) { %>
<section class="hero-slideshow" id="heroSlideshow">
  <div class="hero-slides-track" id="heroTrack">
    <% heroSlides.forEach((sl, i) => { %>
    <div class="hero-slide <%= i === 0 ? 'active' : '' %>">
      <img src="<%= sl.path %>" alt="<%= sl.caption || 'Promo' %>">
      <% if (sl.caption) { %>
      <div class="hero-slide-caption"><%= sl.caption %></div>
      <% } %>
      <% if (sl.link) { %>
      <a href="<%= sl.link %>" class="hero-slide-link"></a>
      <% } %>
    </div>
    <% }) %>
  </div>
  <% if (heroSlides.length > 1) { %>
  <button class="hero-slide-arrow hero-slide-prev" onclick="heroSlide(-1)" aria-label="Previous">&#8249;</button>
  <button class="hero-slide-arrow hero-slide-next" onclick="heroSlide(1)" aria-label="Next">&#8250;</button>
  <div class="hero-slide-dots" id="heroDots">
    <% heroSlides.forEach((sl, i) => { %>
    <button class="hero-dot <%= i === 0 ? 'active' : '' %>" onclick="heroGoTo(<%= i %>)" aria-label="Slide <%= i+1 %>"></button>
    <% }) %>
  </div>
  <% } %>
</section>
<script src="/js/index-1.js?v=<%= assetV %>"></script>
<div class="hero-trust-strip">
  <div class="hero-trust-item"><b>Instant Setup</b>Delivered in minutes</div>
  <div class="hero-trust-item"><b>Trophy Accounts</b>Earn on your profile</div>
  <div class="hero-trust-item"><b>Flexible Payment</b><%= heroPayLine %></div>
</div>
<% } else { %>
<%
  // Real games for the auto-rotating showcase panel — newest releases first, cover
  // art required. Falls back to Most Popular (featured) if no game has a release
  // date set yet, so the hero never goes empty while release_date is backfilling.
  const heroSource = (newReleases && newReleases.length) ? newReleases : featured;
  const heroGames = heroSource.filter(g => g.cover_image).slice(0, 6).map(g => {
    const sum = accountSummaryMap[g.id] || null;
    const avail = computeAvailability(g, sum, { nt: g.nt_days_left, tr: g.tr_days_left, ps4: g.ps4_days_left });
    const openSlots = avail.ntSlots + avail.trSlots + (avail.showPs4 ? avail.ps4Slots : 0);
    const pct = getPromoDiscountPct(promo, RENTAL_DURATIONS[0].days);
    const base = g.nt_price_7d || g.tr_price_7d || 0;
    const final = pct > 0 ? base - Math.round(base * pct / 100) : base;
    const typeLabel = (avail.hasTrophy && avail.trSlots > 0) ? 'Trophy' : (avail.ntSlots > 0 ? 'Non-Trophy' : (avail.showPs4 && avail.ps4Slots > 0 ? 'PS4 Primary' : 'Trophy'));
    const slotLabel = openSlots > 0 ? openSlots + ' slot' + (openSlots !== 1 ? 's' : '') + ' left' : 'Fully booked';
    return { title: g.title, cover: g.cover_image, focalX: g.cover_focal_x, focalY: g.cover_focal_y, price: final, meta: typeLabel + ' · ' + slotLabel };
  });
%>
<% if (settings.hero_bg.type !== 'default' && settings.hero_bg.path) { %>
<section class="hero hero-custom-bg">
  <% if (settings.hero_bg.type === 'image') { %>
    <div class="hero-bg-media" style="background-image:url('<%= settings.hero_bg.path %>');background-size:cover;background-position:center;"></div>
  <% } else { %>
    <video class="hero-bg-media" autoplay muted loop playsinline><source src="<%= settings.hero_bg.path %>"></video>
  <% } %>
  <div class="hero-bg-overlay" style="opacity:<%= (settings.hero_bg.overlay || 50) / 100 %>;"></div>
  <div class="hero-grid no-showcase">
    <div class="hero-content">
      <% const ht = settings.hero_text; %>
      <h1 style="font-size:<%= ht.title_size %>px;">
        <%= ht.line1 %><% if (ht.line1 && ht.line2) { %><br><% } %><span style="color:<%= ht.highlight_color %>;"><%= ht.highlight %></span><% if (ht.line2) { %> <%= ht.line2 %><% } %>
      </h1>
      <p style="color:<%= ht.subtitle_color %>;"><%= ht.subtitle %></p>
      <div class="hero-actions">
        <a href="/browse" class="btn btn-primary">Browse All Games</a>
        <a href="#how" class="btn btn-outline">How It Works</a>
      </div>
      <div class="hero-trust-row">
        <div class="hero-trust-item"><b>Instant Setup</b>Delivered in minutes</div>
              <div class="hero-trust-item"><b>Trophy Accounts</b>Earn on your profile</div>
      </div>
      <div class="hero-pay-methods">
        <%# Driven from settings, like the footer. Online checkout leads because
            it is the route that confirms itself; the rest are whatever the owner
            has switched on, so a method enabled or disabled in admin appears and
            disappears here without an edit. %>
        <% if (typeof payViaGateway !== 'undefined' && payViaGateway) { %>
        <%- include('partials/pay-chip', { key: 'qrph', label: 'Card & QR Ph' }) %>
        <% } %>
        <% payManual.forEach(m => { %>
        <%- include('partials/pay-chip', { key: m.key, label: m.label }) %>
        <% }) %>
      </div>
      <div class="hero-stats">
        <div class="hero-stat">
          <div class="hero-stat-num"><%= games.length %>+</div>
          <div class="hero-stat-label">Games Available</div>
        </div>
        <div class="hero-stat">
          <% const allPricesCb = games.flatMap(g => [g.nt_price_7d, g.nt_price_30d, g.tr_price_7d, g.tr_price_30d].filter(Boolean)); const lowestPriceCb = allPricesCb.length ? Math.min(...allPricesCb) : 99; %>
          <div class="hero-stat-num">₱<%= lowestPriceCb %></div>
          <div class="hero-stat-label">Starting Price</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-num"><%= renterCount && renterCount.n ? renterCount.n.toLocaleString() + (renterCount.plus ? '+' : '') : activeRenters + '+' %></div>
          <div class="hero-stat-label">Total Renters</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-num">100%</div>
          <div class="hero-stat-label">Digital Games</div>
        </div>
      </div>
    </div>
  </div>
</section>
<% } else { %>
<section class="hero hero-v2">
  <% if (heroGames.length) { %>
  <div class="hero-photo" id="heroPhoto">
    <% heroGames.forEach((g, i) => { %>
    <img class="<%= i === 0 ? 'active' : '' %>" data-idx="<%= i %>" src="<%= g.cover %>" alt="<%= g.title %>" style="object-position: <%= g.focalX != null ? g.focalX : 50 %>% <%= g.focalY != null ? g.focalY : 50 %>%;">
    <% }) %>
  </div>
  <div class="hero-glow"></div>
  <% if (heroGames.length > 1) { %>
  <div class="hero-cover-picker" id="heroCoverPicker">
    <% heroGames.forEach((g, i) => { %>
    <button type="button" class="hero-cover-thumb<%= i === 0 ? ' active' : '' %>" data-idx="<%= i %>" aria-label="Show <%= g.title %>">
      <img src="<%= g.cover %>" alt="" style="object-position: <%= g.focalX != null ? g.focalX : 50 %>% <%= g.focalY != null ? g.focalY : 50 %>%;">
    </button>
    <% }) %>
  </div>
  <% } %>
  <% } %>
  <div class="hero-inner">
    <div class="hero-content">
      <% const ht = settings.hero_text; %>
      <h1 style="font-size:<%= ht.title_size %>px;">
        <%= ht.line1 %><% if (ht.line1 && ht.line2) { %><br><% } %><span style="color:<%= ht.highlight_color %>;"><%= ht.highlight %></span><% if (ht.line2) { %> <%= ht.line2 %><% } %>
      </h1>
      <p style="color:<%= ht.subtitle_color %>;"><%= ht.subtitle %></p>
      <div class="hero-actions">
        <a href="/browse" class="btn btn-primary">Browse All Games</a>
        <a href="#how" class="btn btn-outline">How It Works</a>
      </div>
      <div class="hero-trust-row">
        <div class="hero-trust-item"><b>Instant Setup</b>Delivered in minutes</div>
              <div class="hero-trust-item"><b>Trophy Accounts</b>Earn on your profile</div>
      </div>
      <div class="hero-pay-methods">
        <%# Driven from settings, like the footer. Online checkout leads because
            it is the route that confirms itself; the rest are whatever the owner
            has switched on, so a method enabled or disabled in admin appears and
            disappears here without an edit. %>
        <% if (typeof payViaGateway !== 'undefined' && payViaGateway) { %>
        <%- include('partials/pay-chip', { key: 'qrph', label: 'Card & QR Ph' }) %>
        <% } %>
        <% payManual.forEach(m => { %>
        <%- include('partials/pay-chip', { key: m.key, label: m.label }) %>
        <% }) %>
      </div>
      <div class="hero-stats">
        <div class="hero-stat">
          <div class="hero-stat-num"><%= games.length %>+</div>
          <div class="hero-stat-label">Games Available</div>
        </div>
        <div class="hero-stat">
          <% const allPrices = games.flatMap(g => [g.nt_price_7d, g.nt_price_30d, g.tr_price_7d, g.tr_price_30d].filter(Boolean)); const lowestPrice = allPrices.length ? Math.min(...allPrices) : 99; %>
          <div class="hero-stat-num">₱<%= lowestPrice %></div>
          <div class="hero-stat-label">Starting Price</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-num"><%= renterCount && renterCount.n ? renterCount.n.toLocaleString() + (renterCount.plus ? '+' : '') : activeRenters + '+' %></div>
          <div class="hero-stat-label">Total Renters</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-num">100%</div>
          <div class="hero-stat-label">Digital Games</div>
        </div>
      </div>
    </div>
  </div>
  <% if (heroGames.length > 1) { %>
    <script>
    (function(){
      const cards = document.querySelectorAll('#heroPhoto img');
      const thumbs = document.querySelectorAll('#heroCoverPicker .hero-cover-thumb');
      if (cards.length < 2) return;
      let cur = 0, timer;
      function goTo(n) {
        cards[cur].classList.remove('active');
        if (thumbs[cur]) thumbs[cur].classList.remove('active');
        cur = n;
        cards[cur].classList.add('active');
        if (thumbs[cur]) thumbs[cur].classList.add('active');
      }
      function start() { timer = setInterval(function(){ goTo((cur + 1) % cards.length); }, 3500); }
      function restart() { clearInterval(timer); start(); }
      thumbs.forEach(function(t){
        t.addEventListener('click', function(){
          goTo(parseInt(t.dataset.idx, 10));
          restart();
        });
      });
      start();
    })();
    </script>
    <% } %>
</section>
<% } %>
<% } %>

<!-- NEW RELEASES SLIDER —————————————————————————————————————————————————
     Most recently released games, by publisher release_date. Deliberately not
     the same as the ✨ NEW badge, which marks what we stocked in the last 11
     days (created_at). Hidden entirely until at least 4 games have a
     release_date set, so a half-backfilled field never shows a thin section. -->
<% if (newReleases && newReleases.length >= 4) { %>
<%# Directly under the hero, before any game card. Every price on this page is
    labelled Trophy or Non-Trophy, and until now the only explanation lived on
    /how-it-works — so a first-time visitor met the labels on a price before
    anything told them what they meant. Prices here come from the catalogue, so
    they cannot disagree with the cards below. %>
<div class="acct-section">
  <h2 class="section-title">Which account type is for you?</h2>
  <div class="acct-grid">
    <div class="acct-card acct-card-tr">
      <div class="acct-head">
        <span class="acct-badge acct-badge-tr">Trophy</span>
        <% if (trFrom) { %><span class="acct-price">from ₱<%= trFrom %></span><% } %>
      </div>
      <div class="acct-title">Play on your own profile</div>
      <div class="acct-desc">
        Trophies and save data land on your own PSN account and stay there after the rental ends.
        <% if (depositAmt) { %> Includes a refundable ₱<%= depositAmt %> deposit.<% } %>
      </div>
      <div class="acct-for">Best if you care about trophies</div>
    </div>
    <div class="acct-card">
      <div class="acct-head">
        <span class="acct-badge acct-badge-nt">Non-Trophy</span>
        <% if (ntFrom) { %><span class="acct-price">from ₱<%= ntFrom %></span><% } %>
      </div>
      <div class="acct-title">Play on our account</div>
      <div class="acct-desc">
        The cheapest way to play. Your progress stays on our account, and there's no deposit to pay.
      </div>
      <div class="acct-for">Best if you just want to play the game</div>
    </div>
  </div>
  <p class="acct-foot">Either way you never give us your password — you sign our account into your console using a code from your own screen. <a href="/how-it-works">See how it works</a></p>
</div>

<div class="section" id="newReleasesSection">
  <h2 class="section-title">New Releases <a href="/browse" class="section-viewall">View All <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></a></h2>
  <div class="upcoming-slider-wrap">
    <button class="slider-arrow slider-arrow-left" onclick="slideSection('newReleasesSlider',-1)" aria-label="Previous">&#8249;</button>
    <div class="upcoming-slider" id="newReleasesSlider">
      <%# Sliced here, not where newReleases is built: the hero above picks its
          six slides from this same list but only from games that have cover art,
          so a shared cap would leave it short whenever one of the top six has none. %>
      <% newReleases.slice(0, 6).forEach(game => { %><div class="slider-card-wrap" style="min-width:200px;max-width:200px;flex-shrink:0;scroll-snap-align:start;"><%- include('partials/game-card', { game, showPriceStart: true }) %></div><% }) %>
    </div>
    <button class="slider-arrow slider-arrow-right" onclick="slideSection('newReleasesSlider',1)" aria-label="Next">&#8250;</button>
  </div>
</div>
<% } %>

<!-- UPCOMING GAMES (COMING SOON) -->
<%# Six on the homepage, looping. The rest are a click away behind View All,
    and a row long enough to need scrolling stops reading as a highlight reel. %>
<%- include('partials/upcoming-section', { upcoming: upcoming.slice(0, 6), noBorderTop: true, viewAllHref: '/browse#comingSoon' }) %>

<!-- PRICE TIERS -->
<% if (priceCategories && priceCategories.length) { %>
<%
  const tierData = priceCategories.map(cat => {
    const catGames = games.filter(g => g.price_category_id === cat.id);
    let min = null;
    catGames.forEach(g => {
      RENTAL_DURATIONS.forEach(({ days: d }) => {
        const pct = getPromoDiscountPct(promo, d);
        ['nt_price_', 'tr_price_'].forEach(prefix => {
          const base = g[prefix + d + 'd'];
          if (base > 0) {
            const final = pct > 0 ? base - Math.round(base * pct / 100) : base;
            if (min === null || final < min) min = final;
          }
        });
      });
    });
    return { id: cat.id, name: cat.name, count: catGames.length, min, cat };
  }).filter(t => t.count > 0);
%>
<% if (tierData.length) { %>
<div class="tier-section">
  <h2 class="section-title">Browse by Price Tier</h2>
  <div class="tier-grid">
    <% tierData.forEach(t => {
      const cat = t.cat;
      const n = t.name.toLowerCase();
      const tierIcon = n.includes('new') ? '✨' : n.includes('deluxe') ? '👑' : n.includes('special') ? '⭐' : n.includes('regular') ? '🎮' : n.includes('budget') || n.includes('value') ? '💸' : '🕹️';
      // Split Art layout: bg_color is now the accent used for the price, not a card fill.
      const accentColor = cat.bg_color || '#F0A500';
      const titleColor = cat.title_color || '#ffffff';
      const titleSize = cat.title_size != null ? cat.title_size : 18;
      const artWidth = cat.image_width != null ? cat.image_width : 52;
      const artOpacity = cat.image_opacity != null ? cat.image_opacity : 100;
    %>
    <a href="/browse#cat-section-<%= t.id %>" class="tier-card" style="--tier-accent:<%= accentColor %>;">
      <% if (cat.image) { %>
      <div class="tier-card-art" style="width:<%= artWidth %>%;">
        <img src="<%= cat.image %>" alt="" loading="lazy" decoding="async"<% if (artOpacity !== 100) { %> style="opacity:<%= artOpacity / 100 %>;"<% } %>>
      </div>
      <% } else { %>
      <div class="tier-card-art-fallback"><%= tierIcon %></div>
      <% } %>
      <div class="tier-card-glow"></div>
      <div class="tier-card-top">
        <div class="tier-card-name" style="color:<%= titleColor %>;font-size:<%= titleSize %>px;"><%= t.name %></div>
        <div class="tier-card-count"><%= t.count %> title<%= t.count !== 1 ? 's' : '' %></div>
        <% if (t.min) { %><div class="tier-card-price" style="color:<%= accentColor %>;">Starts at ₱<%= t.min %></div><% } %>
      </div>
      <div class="tier-card-go"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></div>
    </a>
    <% }) %>
  </div>
</div>
<% } %>
<% } %>

<!-- SPOTLIGHT: MOST RENTED GAME -->
<% if (featured.length && featured[0].renters > 0) { %>
<%
  const spotGame = featured[0];
  const spotSum = accountSummaryMap[spotGame.id] || null;
  const spotAvail = computeAvailability(spotGame, spotSum, { nt: spotGame.nt_days_left, tr: spotGame.tr_days_left, ps4: spotGame.ps4_days_left });
  const spotOpenSlots = spotAvail.ntSlots + spotAvail.trSlots + (spotAvail.showPs4 ? spotAvail.ps4Slots : 0);
  const spotPct = getPromoDiscountPct(promo, RENTAL_DURATIONS[0].days);
  const spotBase = spotGame.nt_price_7d || spotGame.tr_price_7d || 0;
  const spotFinal = spotPct > 0 ? spotBase - Math.round(spotBase * spotPct / 100) : spotBase;
  const spotSlug = spotGame.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
%>
<div class="spotlight-section">
  <div class="spotlight-card">
    <div class="spotlight-cover">
      <% if (spotGame.cover_image) { %>
        <img src="<%= spotGame.cover_image %>" alt="<%= spotGame.title %>" loading="lazy" decoding="async" style="object-position: <%= spotGame.cover_focal_x != null ? spotGame.cover_focal_x : 50 %>% <%= spotGame.cover_focal_y != null ? spotGame.cover_focal_y : 50 %>%;">
      <% } %>
    </div>
    <div>
      <div class="spotlight-tag">Most Rented This Month</div>
      <h2 class="spotlight-title"><%= spotGame.title %></h2>
      <% if (spotGame.description) { %><p class="spotlight-desc"><%= spotGame.description %></p><% } %>
      <div class="spotlight-price">₱<%= spotFinal %><% if (spotPct > 0) { %><span style="font-size:1rem;color:var(--text-secondary);text-decoration:line-through;margin-left:0.5rem;font-weight:500;">₱<%= spotBase %></span><% } %></div>
      <% if (spotOpenSlots > 0) { %>
      <div class="spotlight-avail"><%= spotOpenSlots %> slot<%= spotOpenSlots !== 1 ? 's' : '' %> available now</div>
      <% } else { %>
      <div class="spotlight-avail" style="color:#ef4444;">No open slots right now</div>
      <% } %>
      <div style="display:flex;gap:0.75rem;align-items:center;flex-wrap:wrap;">
        <a href="/game/<%= spotSlug %>" class="btn btn-primary">Rent This Game</a>
        <% if (spotGame.link_url) { %>
        <a href="<%= spotGame.link_url %>" target="_blank" rel="noopener" class="spotlight-link">🔗 <%= spotGame.link_label || 'Learn More' %> →</a>
        <% } %>
      </div>
    </div>
  </div>
</div>
<% } %>

<!-- MOST POPULAR SLIDER -->
<div class="section" id="mostPopularSection">
  <h2 class="section-title">Most Popular <a href="/browse" class="section-viewall">View All <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></a></h2>
  <div class="upcoming-slider-wrap">
    <button class="slider-arrow slider-arrow-left" onclick="slideSection('popularSlider',-1)" aria-label="Previous">&#8249;</button>
    <div class="upcoming-slider" id="popularSlider">
      <% featured.forEach(game => { %><div class="slider-card-wrap" style="min-width:200px;max-width:200px;flex-shrink:0;scroll-snap-align:start;"><%- include('partials/game-card', { game, showPriceStart: true }) %></div><% }) %>
    </div>
    <button class="slider-arrow slider-arrow-right" onclick="slideSection('popularSlider',1)" aria-label="Next">&#8250;</button>
  </div>
</div>

<!-- MOST PLAYED IN PS PLUS SLIDER -->
<% if (psplusPopular.length > 0) { %>
<div class="section" id="mostPlayedPsplusSection">
  <h2 class="section-title">
    <span style="background:linear-gradient(135deg,#FFD700,#ffa500);-webkit-background-clip:text;-webkit-text-fill-color:transparent;">★</span>
    Most Played in PS Plus
    <a href="/ps-plus" class="section-viewall">View All <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></a>
    <button type="button" class="section-toggle-btn" onclick="toggleCollapsible('psplusBody', this)" aria-label="Collapse Most Played in PS Plus">▾</button>
  </h2>
  <div class="collapsible-body" id="psplusBody">
  <div class="upcoming-slider-wrap">
    <button class="slider-arrow slider-arrow-left" onclick="slideSection('psplusSlider',-1)" aria-label="Previous">&#8249;</button>
    <div class="upcoming-slider" id="psplusSlider">
    <% psplusPopular.forEach((game, idx) => { %>
    <div class="slider-card-wrap" style="min-width:200px;max-width:200px;flex-shrink:0;scroll-snap-align:start;">
    <%- include('partials/psplus-card', { game, idx, href: psplusSlug ? '/game/' + psplusSlug : '/game/17' }) %>
    </div>
    <% }) %>
    </div>
    <button class="slider-arrow slider-arrow-right" onclick="slideSection('psplusSlider',1)" aria-label="Next">&#8250;</button>
  </div>
  </div>
</div>
<script src="/js/index-2.js?v=<%= assetV %>"></script>
<% } %>

<!-- PROMO LADDER -->
<%
  const activeDurations = promo.enabled ? RENTAL_DURATIONS.map(d => d.days).filter(d => getPromoDiscountPct(promo, d) > 0) : [];
  const bestPromoDuration = activeDurations.length
    ? activeDurations.reduce((best, d) => getPromoDiscountPct(promo, d) > getPromoDiscountPct(promo, best) ? d : best, activeDurations[0])
    : null;
  const promoEndsValid = promo.ends_at && new Date(promo.ends_at).getTime() > Date.now();
%>
<% if (activeDurations.length) { %>
<div class="promo-section">
  <div class="promo2<%= promo.media_path ? '' : ' promo2-nomedia' %>">
    <div class="promo2-head">
      <span class="promo2-flag">Limited Time</span>
      <% if (promoEndsValid) { %>
      <span class="promo2-count" id="promoCountdown" data-ends="<%= new Date(promo.ends_at).getTime() %>"></span>
      <% } %>
    </div>
    <div class="promo2-grid<%= promo.media_path ? '' : ' nomedia' %>">
      <% if (promo.media_path) { %>
      <div class="promo2-media">
        <% if (promo.media_type === 'video') { %>
        <video src="<%= promo.media_path %>" autoplay muted loop playsinline></video>
        <% } else { %>
        <img src="<%= promo.media_path %>" alt="Promo" loading="lazy" decoding="async">
        <% } %>
      </div>
      <% } %>
      <div>
        <h2 class="promo2-title"><%= promo.title || 'Rent Longer. Save More.' %></h2>
        <p class="promo2-sub"><%= promo.text || 'Discount applied automatically at checkout — no code needed.' %></p>
        <div class="ladder">
          <% activeDurations.forEach(d => { const pct = getPromoDiscountPct(promo, d); %>
          <div class="rung<%= d === bestPromoDuration ? ' best' : '' %>">
            <span class="days"><%= d %> Days</span>
            <span class="pct"><%= pct %>% Off</span>
            <% if (d === bestPromoDuration && activeDurations.length > 1) { %>
            <span class="best-tag">Best Value</span>
            <% } %>
          </div>
          <% }) %>
        </div>
        <div class="promo2-cta">
          <a href="/browse" class="btn btn-primary">See Discounted Games</a>
          <a href="http://m.me/PlaystationHub00" target="_blank" rel="noopener" class="btn-ghost">Message Us</a>
        </div>
      </div>
    </div>
  </div>
</div>
<% if (promoEndsValid) { %>
<script src="/js/index-3.js?v=<%= assetV %>"></script>
<% } %>
<% } %>

<!-- WHY RENT FROM US -->
<%# Three products sit in the nav with nothing saying which one a given customer
    wants. Prices are derived; a product with no price configured still renders,
    because the choice matters even before the number does. %>
<div class="ways-section">
  <h2 class="section-title">Three ways to play</h2>
  <div class="ways-grid">
    <a href="/browse" class="ways-card">
      <div class="ways-name">Rent</div>
      <div class="ways-price"><% if (ntFrom) { %>from ₱<%= ntFrom %> · <% } %>7 or 30 days</div>
      <div class="ways-desc">One game for a set stretch of time. Return it when you're done and the slot frees up for someone else.</div>
      <div class="ways-go">Browse games →</div>
    </a>
    <a href="/buy" class="ways-card">
      <div class="ways-name">Buy</div>
      <div class="ways-price"><% if (buyFrom) { %>from ₱<%= buyFrom %> · <% } %>one-time</div>
      <div class="ways-desc">Keep access permanently. No return date, no deposit, no reminders from us.</div>
      <div class="ways-go">See what's for sale →</div>
    </a>
    <a href="/ps-plus" class="ways-card">
      <div class="ways-name">PS Plus</div>
      <div class="ways-price">hundreds of games</div>
      <div class="ways-desc">One rental gets you a whole catalogue instead of a single title. Best if you play lots of different things.</div>
      <div class="ways-go">Browse the catalogue →</div>
    </a>
  </div>
</div>

<div class="why-section">
  <h2 class="section-title">Why Rent From Us</h2>
  <div class="why-grid">
    <div class="why-card">
      <div class="why-icon">🏆</div>
      <div class="why-title">Your Own Account</div>
      <div class="why-desc">Trophy rentals run on your profile, so progress and trophies stay yours.</div>
    </div>
    <div class="why-card">
      <div class="why-icon">⏱️</div>
      <div class="why-title">Try It Free First</div>
      <div class="why-desc">Three hours on our account before you commit to a rental or a buy.</div>
    </div>
    <div class="why-card">
      <div class="why-icon">💾</div>
      <div class="why-title">Fully Digital</div>
      <div class="why-desc">No discs, no meetups, no shipping. Set up over Messenger in minutes.</div>
    </div>
    <div class="why-card">
      <div class="why-icon">💳</div>
      <div class="why-title">Pay Locally</div>
      <div class="why-desc"><%= payWhyDesc %></div>
    </div>
  </div>
</div>

<%# Rendered from what is actually switched on, never written out by hand. The
    card above used to read "GCash and Maya" and was still saying it months
    after online checkout went live — deriving it means enabling PayPal or a new
    method updates this page on its own. Hidden entirely when nothing is on,
    rather than showing an empty promise. %>
<% if (payBadges.length) { %>
<div class="paysec">
  <h2 class="section-title">Ways to Pay</h2>
  <div class="paysec-strip">
    <% payBadges.forEach(b => { %>
    <div class="paysec-item<%= b.primary ? ' paysec-item-main' : '' %>">
      <span class="paysec-icon"><%= b.icon %></span>
      <span>
        <span class="paysec-label"><%= b.label %></span>
        <span class="paysec-note"><%= b.note %></span>
      </span>
    </div>
    <% }) %>
  </div>
  <p class="paysec-foot">Refundable deposit on trophy accounts only — you get it back when you return the account.</p>
</div>
<% } %>

<section class="how-section" id="how">
  <div class="how-inner">
    <h2>How It Works</h2>
    <div class="steps">
      <div class="step">
        <div class="step-num">1</div>
        <h3>Browse & Pick</h3>
        <p>Choose from our PS5 and PS4 digital game library.</p>
      </div>
      <div class="step">
        <div class="step-num">2</div>
        <h3>Choose Duration</h3>
        <p>Pick Weekly or Monthly — flexible pricing to fit your schedule.</p>
      </div>
      <div class="step">
        <div class="step-num">3</div>
        <h3>Get Access</h3>
        <p>We'll set up your digital access within 24 hours.</p>
      </div>
      <div class="step">
        <div class="step-num">4</div>
        <h3>Play & Return</h3>
        <p>Enjoy the game and the slot is released when your rental ends.</p>
      </div>
    </div>
  </div>
</section>

<%# The objections that stop a first order from a stranger, answered before
    anyone has to open Messenger and wait for a reply. Collapsed by default, so
    an already-long homepage gains five lines rather than five paragraphs.
    Every answer here is one the site's own behaviour backs up. %>
<div class="faq-section">
  <h2 class="section-title">Common questions</h2>
  <div class="faq-list">
    <details class="faq-item">
      <summary>Do I need to give you my PSN password?</summary>
      <p>No, and we never ask for it. You bring up the sign-in screen on your own console and send us the code from it — that signs <em>our</em> account into <em>your</em> console. Your password never leaves your hands.</p>
    </details>
    <details class="faq-item">
      <summary>Can I try a game before I pay?</summary>
      <p>Yes — three hours free, on our account, before you commit to renting or buying. Message us and we'll set it up.</p>
    </details>
    <% if (depositAmt) { %>
    <details class="faq-item">
      <summary>When do I get my ₱<%= depositAmt %> deposit back?</summary>
      <p>As soon as you return the account at the end of your rental. It only applies to Trophy accounts. If you return late, ₱<%= (promo && promo.late_fee_per_day) || 0 %> a day comes out of it — return on time and you get the full amount back.</p>
    </details>
    <% } %>
    <details class="faq-item">
      <summary>What happens when my rental ends?</summary>
      <p>You sign our account out of your console and send us a quick screenshot to confirm. That frees the slot for the next person, and releases your deposit if you paid one.</p>
    </details>
    <details class="faq-item">
      <summary>What if there are no slots left for the game I want?</summary>
      <p>You can join the line for free and we'll message you the moment one opens, or pay a small priority fee to move ahead of everyone on the free list. Either way you keep your place — you can see exactly where you are in the queue.</p>
    </details>
  </div>
</div>

<!-- Reviews Section -->
<%# `reviews` is only the ones with something written; `recommend` counts every
    review submitted. A run of one-tap 👍 with no comments would leave the first
    empty and the second full, and gating solely on quotes would throw away the
    "100% would recommend us" bar — the most persuasive thing on the page. %>
<% if ((reviews && reviews.length > 0) || (typeof recommend !== 'undefined' && recommend && recommend.total > 0)) { %>
<section class="section" id="reviewsSection" style="padding-bottom:var(--section-gap);">
  <h2 class="section-title" style="color:#fff;margin-bottom:1.75rem;">
    <span style="display:inline-flex;align-items:center;gap:0.5rem;">
      <span style="background:linear-gradient(135deg,#f59e0b,#ef4444);-webkit-background-clip:text;-webkit-text-fill-color:transparent;font-size:1.1em;">⭐</span>
      What Our Customers Say
    </span>
    <span style="font-size:0.8rem;font-weight:500;color:#666;margin-left:0.5rem;">From renters who paid</span>
  </h2>
  <%# The same strip every game, Buy, PS Plus and Requests page shows. The
      homepage used to carry its own card grid saying the same thing in a
      different shape; sharing the partial means the rating, the review count
      and the renters-served figure can never drift between pages. The strip's
      own header carries the count, so the heading above no longer repeats it. %>
  <%- include('partials/review-block', { reviews: reviews, reviewStats: reviewStats, recommend: (typeof recommend !== 'undefined' ? recommend : null), reviewBadge: reviewBadge, reviewDisplayName: reviewDisplayName, renterCount: renterCount }) %>
</section>
<% } %>

<%- include('partials/footer') %>

<!-- RESERVE MODAL -->
<div class="modal-overlay" id="reserveModal">
  <div class="modal">
    <div style="font-size:1.5rem;margin-bottom:0.5rem;">🔔</div>
    <h2>Reserve a Slot</h2>
    <div id="reserveGameTitle" style="font-weight:700;font-size:1rem;color:#a855f7;margin:0.5rem 0 1rem;"></div>
    <div style="background:#111;border:1px solid #222;border-radius:10px;padding:1rem;margin-bottom:1.25rem;text-align:left;">
      <div style="font-size:0.82rem;color:#bbb;line-height:1.7;margin-bottom:0.75rem;">
        This game is not yet available but you can <strong style="color:#fff;">reserve your slot now</strong>. Message us on Facebook to lock in your reservation!
      </div>
      <div style="font-size:0.78rem;color:var(--ps-blue);font-weight:700;margin-bottom:0.25rem;">📘 Message us on Facebook:</div>
      <div style="font-size:0.8rem;color:#888;">Include the game name and your preferred rental duration.</div>
    </div>
    <div class="modal-actions">
      <button class="btn btn-outline" onclick="closeReserveModal()" style="flex:1;">Cancel</button>
      <a href="http://m.me/PlaystationHub00" target="_blank" rel="noopener"
        class="btn" style="flex:1;text-align:center;background:linear-gradient(135deg,#4a0080,#7b2ff7);color:#fff;font-weight:700;border-radius:50px;padding:0.75rem 1.75rem;text-decoration:none;"
        onclick="closeReserveModal()">📘 Message Us</a>
    </div>
  </div>
</div>

<%- include('partials/rent-modal') %>

<script>
// Promo config from server
const _rentPromo = { enabled: <%- promo.enabled ? 'true' : 'false' %>, discounts: { 10: <%= (promo.discounts && promo.discounts[10]) || 0 %>, 15: <%= (promo.discounts && promo.discounts[15]) || 0 %>, 30: <%= (promo.discounts && promo.discounts[30]) || 0 %> } };
const _buyPromo  = { enabled: <%- promo.buy_promo_enabled ? 'true' : 'false' %>, pct: <%= promo.buy_promo_pct || 0 %> };
</script>
<script src="/js/index-4.js?v=<%= assetV %>"></script>
</body>
</html>




