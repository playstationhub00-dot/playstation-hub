<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Playstation Hub — PS5/PS4 Game Rentals</title>
  <link rel="icon" href="<%= settings.favicon_path %>" type="image/svg+xml">
  <link rel="stylesheet" href="/css/style.css">
  <meta name="facebook-domain-verification" content="noj6ccmsehjq0v2oeq2e716fgyaqq0" />
</head>
<body class="home-page" style="--section-gap: <%= settings.section_gap || 4 %>rem;">

<%- include('partials/announcement') %>
<%- include('partials/popup') %>
<%- include('partials/nav', { active: 'home' }) %>

<% const heroSlides = settings.hero_slides && settings.hero_slides.length > 0 ? settings.hero_slides : null; %>
<% if (heroSlides) { %>
<section class="hero-slideshow" id="heroSlideshow">
  <div class="hero-slides-track" id="heroTrack">
    <% heroSlides.forEach((sl, i) => { %>
    <div class="hero-slide <%= i === 0 ? 'active' : '' %>">
      <img src="<%= sl.path %>" alt="<%= sl.caption || 'Promo' %>">
      <% if (sl.caption) { %>
      <div class="hero-slide-caption"><%= sl.caption %></div>
      <% } %>
      <% if (sl.link) { %>
      <a href="<%= sl.link %>" class="hero-slide-link"></a>
      <% } %>
    </div>
    <% }) %>
  </div>
  <% if (heroSlides.length > 1) { %>
  <button class="hero-slide-arrow hero-slide-prev" onclick="heroSlide(-1)" aria-label="Previous">&#8249;</button>
  <button class="hero-slide-arrow hero-slide-next" onclick="heroSlide(1)" aria-label="Next">&#8250;</button>
  <div class="hero-slide-dots" id="heroDots">
    <% heroSlides.forEach((sl, i) => { %>
    <button class="hero-dot <%= i === 0 ? 'active' : '' %>" onclick="heroGoTo(<%= i %>)" aria-label="Slide <%= i+1 %>"></button>
    <% }) %>
  </div>
  <% } %>
</section>
<script>
(function(){
  let cur = 0;
  const slides = document.querySelectorAll('.hero-slide');
  const dots = document.querySelectorAll('.hero-dot');
  function goTo(n) {
    slides[cur].classList.remove('active');
    if (dots[cur]) dots[cur].classList.remove('active');
    cur = (n + slides.length) % slides.length;
    slides[cur].classList.add('active');
    if (dots[cur]) dots[cur].classList.add('active');
  }
  window.heroSlide = d => goTo(cur + d);
  window.heroGoTo = goTo;
  if (slides.length > 1) setInterval(() => goTo(cur + 1), 5000);
})();
</script>
<div class="hero-trust-strip">
  <div class="hero-trust-item"><b>Instant Setup</b>Delivered in minutes</div>
  <div class="hero-trust-item"><b>Try Before You Rent</b>3 free hours</div>
  <div class="hero-trust-item"><b>Trophy Accounts</b>Earn on your profile</div>
  <div class="hero-trust-item"><b>GCash · Maya</b>Pay how you want</div>
</div>
<% } else { %>
<%
  // Real games for the auto-rotating showcase panel — top-rented first, cover art required.
  const heroGames = featured.filter(g => g.cover_image).slice(0, 6).map(g => {
    const sum = accountSummaryMap[g.id] || null;
    const avail = computeAvailability(g, sum, { nt: g.nt_days_left, tr: g.tr_days_left, ps4: g.ps4_days_left });
    const openSlots = avail.ntSlots + avail.trSlots + (avail.showPs4 ? avail.ps4Slots : 0);
    const pct = getPromoDiscountPct(promo, 10);
    const base = g.nt_price_10d || g.tr_price_10d || 0;
    const final = pct > 0 ? base - Math.round(base * pct / 100) : base;
    const typeLabel = (avail.hasTrophy && avail.trSlots > 0) ? 'Trophy' : (avail.ntSlots > 0 ? 'Non-Trophy' : (avail.showPs4 && avail.ps4Slots > 0 ? 'PS4 Primary' : 'Trophy'));
    const slotLabel = openSlots > 0 ? openSlots + ' slot' + (openSlots !== 1 ? 's' : '') + ' left' : 'Fully booked';
    return { title: g.title, cover: g.cover_image, focalX: g.cover_focal_x, focalY: g.cover_focal_y, price: final, meta: typeLabel + ' · ' + slotLabel };
  });
%>
<section class="hero<%= settings.hero_bg.type !== 'default' ? ' hero-custom-bg' : '' %>">
  <% if (settings.hero_bg.type === 'image' && settings.hero_bg.path) { %>
    <div class="hero-bg-media" style="background-image:url('<%= settings.hero_bg.path %>');background-size:cover;background-position:center;"></div>
    <div class="hero-bg-overlay" style="opacity:<%= (settings.hero_bg.overlay || 50) / 100 %>;"></div>
  <% } else if (settings.hero_bg.type === 'video' && settings.hero_bg.path) { %>
    <video class="hero-bg-media" autoplay muted loop playsinline>
      <source src="<%= settings.hero_bg.path %>">
    </video>
    <div class="hero-bg-overlay" style="opacity:<%= (settings.hero_bg.overlay || 50) / 100 %>;"></div>
  <% } %>
  <div class="hero-grid<%= heroGames.length ? '' : ' no-showcase' %>">
    <div class="hero-content">
      <div class="hero-trust-tag">🎮 3-Hour Free Trial</div>
      <% const ht = settings.hero_text; %>
      <h1 style="font-size:<%= ht.title_size %>px;">
        <%= ht.line1 %><% if (ht.line1 && ht.line2) { %><br><% } %><span style="color:<%= ht.highlight_color %>;"><%= ht.highlight %></span><% if (ht.line2) { %> <%= ht.line2 %><% } %>
      </h1>
      <p style="color:<%= ht.subtitle_color %>;"><%= ht.subtitle %></p>
      <div class="hero-actions">
        <a href="/browse" class="btn btn-primary">Browse All Games</a>
        <a href="#how" class="btn btn-outline">How It Works</a>
      </div>
      <div class="hero-trust-row">
        <div class="hero-trust-item"><b>Instant Setup</b>Delivered in minutes</div>
        <div class="hero-trust-item"><b>Try Before You Rent</b>3 free hours</div>
        <div class="hero-trust-item"><b>Trophy Accounts</b>Earn on your profile</div>
        <div class="hero-trust-item"><b>GCash · Maya</b>Pay how you want</div>
      </div>
    </div>
    <% if (heroGames.length) { %>
    <div class="hero-showcase" id="heroShowcase">
      <% heroGames.forEach((g, i) => { %>
      <div class="hero-showcase-card<%= i === 0 ? ' active' : '' %>">
        <img src="<%= g.cover %>" alt="<%= g.title %>" style="object-position: <%= g.focalX != null ? g.focalX : 50 %>% <%= g.focalY != null ? g.focalY : 50 %>%;">
        <div class="hero-showcase-info">
          <div>
            <div class="hero-showcase-title"><%= g.title %></div>
            <div class="hero-showcase-meta"><%= g.meta %></div>
          </div>
          <div class="hero-showcase-price">₱<%= g.price %></div>
        </div>
      </div>
      <% }) %>
      <% if (heroGames.length > 1) { %>
      <div class="hero-showcase-thumbs" id="heroShowcaseThumbs">
        <% heroGames.forEach((g, i) => { %>
        <button type="button" class="hero-showcase-thumb<%= i === 0 ? ' active' : '' %>" data-idx="<%= i %>" aria-label="Show <%= g.title %>">
          <img src="<%= g.cover %>" alt="" style="object-position: <%= g.focalX != null ? g.focalX : 50 %>% <%= g.focalY != null ? g.focalY : 50 %>%;">
        </button>
        <% }) %>
      </div>
      <% } %>
    </div>
    <script>
    (function(){
      const cards = document.querySelectorAll('#heroShowcase .hero-showcase-card');
      const thumbs = document.querySelectorAll('#heroShowcase .hero-showcase-thumb');
      if (cards.length < 2) return;
      let cur = 0, timer;
      function goTo(n) {
        cards[cur].classList.remove('active');
        if (thumbs[cur]) thumbs[cur].classList.remove('active');
        cur = n;
        cards[cur].classList.add('active');
        if (thumbs[cur]) thumbs[cur].classList.add('active');
      }
      function start() { timer = setInterval(function(){ goTo((cur + 1) % cards.length); }, 3500); }
      function restart() { clearInterval(timer); start(); }
      thumbs.forEach(function(t){
        t.addEventListener('click', function(){
          goTo(parseInt(t.dataset.idx, 10));
          restart();
        });
      });
      start();
    })();
    </script>
    <% } %>
  </div>
</section>
<% } %>

<div class="stats-bar">
  <div class="stat">
    <div class="stat-num"><%= games.length %>+</div>
    <div class="stat-label">Games Available</div>
  </div>
  <div class="stat">
    <% const allPrices = games.flatMap(g => [g.nt_price_10d, g.nt_price_15d, g.nt_price_30d, g.tr_price_10d, g.tr_price_15d, g.tr_price_30d].filter(Boolean)); const lowestPrice = allPrices.length ? Math.min(...allPrices) : 99; %>
    <div class="stat-num">₱<%= lowestPrice %></div>
    <div class="stat-label">Starting Price</div>
  </div>
  <div class="stat">
    <div class="stat-num"><%= activeRenters %>+</div>
    <div class="stat-label">Active Renters</div>
  </div>
  <div class="stat">
    <div class="stat-num"><%= gamesPurchased %>+</div>
    <div class="stat-label">Games Purchased</div>
  </div>
  <div class="stat">
    <div class="stat-num">100%</div>
    <div class="stat-label">Digital Games</div>
  </div>
</div>

<!-- PRICE TIERS -->
<% if (priceCategories && priceCategories.length) { %>
<%
  const tierData = priceCategories.map(cat => {
    const catGames = games.filter(g => g.price_category_id === cat.id);
    let min = null;
    catGames.forEach(g => {
      [10, 15, 30].forEach(d => {
        const pct = getPromoDiscountPct(promo, d);
        ['nt_price_', 'tr_price_'].forEach(prefix => {
          const base = g[prefix + d + 'd'];
          if (base > 0) {
            const final = pct > 0 ? base - Math.round(base * pct / 100) : base;
            if (min === null || final < min) min = final;
          }
        });
      });
    });
    return { id: cat.id, name: cat.name, count: catGames.length, min };
  }).filter(t => t.count > 0);
%>
<% if (tierData.length) { %>
<div class="tier-section">
  <h2 class="section-title">Browse by Price Tier</h2>
  <div class="tier-grid">
    <% tierData.forEach(t => {
      const n = t.name.toLowerCase();
      const tierIcon = n.includes('new') ? '✨' : n.includes('deluxe') ? '👑' : n.includes('special') ? '⭐' : n.includes('regular') ? '🎮' : n.includes('budget') || n.includes('value') ? '💸' : '🕹️';
    %>
    <a href="/browse#cat-section-<%= t.id %>" class="tier-card">
      <div>
        <div class="tier-card-head">
          <div class="tier-card-icon"><%= tierIcon %></div>
          <div class="tier-card-name"><%= t.name %></div>
        </div>
        <div class="tier-card-count"><%= t.count %> title<%= t.count !== 1 ? 's' : '' %></div>
      </div>
      <% if (t.min) { %><div class="tier-card-price">Price Starts at ₱<%= t.min %></div><% } %>
      <div class="tier-card-go">→</div>
    </a>
    <% }) %>
  </div>
</div>
<% } %>
<% } %>

<!-- SPOTLIGHT: MOST RENTED GAME -->
<% if (featured.length && featured[0].renters > 0) { %>
<%
  const spotGame = featured[0];
  const spotSum = accountSummaryMap[spotGame.id] || null;
  const spotAvail = computeAvailability(spotGame, spotSum, { nt: spotGame.nt_days_left, tr: spotGame.tr_days_left, ps4: spotGame.ps4_days_left });
  const spotOpenSlots = spotAvail.ntSlots + spotAvail.trSlots + (spotAvail.showPs4 ? spotAvail.ps4Slots : 0);
  const spotPct = getPromoDiscountPct(promo, 10);
  const spotBase = spotGame.nt_price_10d || spotGame.tr_price_10d || 0;
  const spotFinal = spotPct > 0 ? spotBase - Math.round(spotBase * spotPct / 100) : spotBase;
  const spotSlug = spotGame.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
%>
<div class="spotlight-section">
  <div class="spotlight-card">
    <div class="spotlight-cover">
      <% if (spotGame.cover_image) { %>
        <img src="<%= spotGame.cover_image %>" alt="<%= spotGame.title %>" loading="lazy" decoding="async" style="object-position: <%= spotGame.cover_focal_x != null ? spotGame.cover_focal_x : 50 %>% <%= spotGame.cover_focal_y != null ? spotGame.cover_focal_y : 50 %>%;">
      <% } %>
    </div>
    <div>
      <div class="spotlight-tag">Most Rented This Month</div>
      <h2 class="spotlight-title"><%= spotGame.title %></h2>
      <% if (spotGame.description) { %><p class="spotlight-desc"><%= spotGame.description %></p><% } %>
      <div class="spotlight-price">₱<%= spotFinal %><% if (spotPct > 0) { %><span style="font-size:1rem;color:var(--text-secondary);text-decoration:line-through;margin-left:0.5rem;font-weight:500;">₱<%= spotBase %></span><% } %></div>
      <% if (spotOpenSlots > 0) { %>
      <div class="spotlight-avail"><%= spotOpenSlots %> slot<%= spotOpenSlots !== 1 ? 's' : '' %> available now</div>
      <% } else { %>
      <div class="spotlight-avail" style="color:#ef4444;">No open slots right now</div>
      <% } %>
      <div style="display:flex;gap:0.75rem;align-items:center;flex-wrap:wrap;">
        <a href="/game/<%= spotSlug %>" class="btn btn-primary">Rent This Game</a>
        <% if (spotGame.link_url) { %>
        <a href="<%= spotGame.link_url %>" target="_blank" rel="noopener" class="spotlight-link">🔗 <%= spotGame.link_label || 'Learn More' %> →</a>
        <% } %>
      </div>
    </div>
  </div>
</div>
<% } %>

<!-- MOST POPULAR SLIDER -->
<div class="section" id="mostPopularSection">
  <h2 class="section-title">Most Popular <a href="/browse" style="font-size:0.8rem;font-weight:500;color:var(--ps-blue);text-decoration:none;margin-left:0.5rem;">View All →</a></h2>
  <div class="upcoming-slider-wrap">
    <button class="slider-arrow slider-arrow-left" onclick="slideSection('popularSlider',-1)" aria-label="Previous">&#8249;</button>
    <div class="upcoming-slider" id="popularSlider">
      <% featured.forEach(game => { %><div class="slider-card-wrap" style="min-width:240px;max-width:240px;flex-shrink:0;scroll-snap-align:start;"><%- include('partials/game-card', { game, showPriceStart: true }) %></div><% }) %>
    </div>
    <button class="slider-arrow slider-arrow-right" onclick="slideSection('popularSlider',1)" aria-label="Next">&#8250;</button>
  </div>
</div>

<!-- UPCOMING GAMES (COMING SOON) -->
<%- include('partials/upcoming-section', { upcoming: upcoming.slice(0, 10), noBorderTop: true }) %>

<!-- MOST PLAYED IN PS PLUS SLIDER -->
<% if (psplusPopular.length > 0) { %>
<div class="section" id="mostPlayedPsplusSection">
  <h2 class="section-title">
    <span style="background:linear-gradient(135deg,#FFD700,#ffa500);-webkit-background-clip:text;-webkit-text-fill-color:transparent;">★</span>
    Most Played in PS Plus
    <a href="/ps-plus" style="font-size:0.8rem;font-weight:500;color:var(--ps-blue);text-decoration:none;margin-left:0.5rem;">View All →</a>
    <button type="button" class="section-toggle-btn" onclick="toggleCollapsible('psplusBody', this)" aria-label="Collapse Most Played in PS Plus">▾</button>
  </h2>
  <div class="collapsible-body" id="psplusBody">
  <div class="upcoming-slider-wrap">
    <button class="slider-arrow slider-arrow-left" onclick="slideSection('psplusSlider',-1)" aria-label="Previous">&#8249;</button>
    <div class="upcoming-slider" id="psplusSlider">
    <% psplusPopular.forEach((game, idx) => { %>
    <div class="slider-card-wrap" style="min-width:240px;max-width:240px;flex-shrink:0;scroll-snap-align:start;">
    <a href="<%= psplusSlug ? '/game/' + psplusSlug : '/game/17' %>" class="game-card psplus-popular-card game-card-link">
      <div style="position:relative;">
        <% if (game.cover_image) { %>
          <img src="<%= game.cover_image %>" alt="<%= game.title %>" class="game-cover" loading="lazy" decoding="async" style="object-position: <%= game.cover_focal_x != null ? game.cover_focal_x : 50 %>% <%= game.cover_focal_y != null ? game.cover_focal_y : 50 %>%;">
        <% } else { %>
          <div class="game-cover-placeholder" style="background:linear-gradient(135deg,#0a0800,#1a1400);">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
            <span>No Image</span>
          </div>
        <% } %>
        <div class="psplus-popular-rank">#<%= game.rank || idx + 1 %></div>
      </div>
      <div class="game-info">
        <div class="game-platform"><%= game.platform %></div>
        <div class="game-title"><%= game.title %></div>
        <% if (game.genre) { %><div style="font-size:0.75rem;color:#555;"><%= game.genre %></div><% } %>
        <span class="rent-btn" style="background:linear-gradient(135deg,#856200,#FFD700);color:#000;font-weight:800;width:100%;text-align:center;">
          📘 Rent via PS Plus
        </span>
      </div>
    </a>
    </div>
    <% }) %>
    </div>
    <button class="slider-arrow slider-arrow-right" onclick="slideSection('psplusSlider',1)" aria-label="Next">&#8250;</button>
  </div>
  </div>
</div>
<script>
window.toggleCollapsible = window.toggleCollapsible || function(id, btn) {
  const body = document.getElementById(id);
  if (!body) return;
  const collapsed = body.classList.toggle('collapsed');
  if (btn) btn.classList.toggle('collapsed', collapsed);
};
</script>
<% } %>

<!-- PROMO LADDER -->
<%
  const activeDurations = promo.enabled ? [10, 15, 30].filter(d => getPromoDiscountPct(promo, d) > 0) : [];
  const bestPromoDuration = activeDurations.length
    ? activeDurations.reduce((best, d) => getPromoDiscountPct(promo, d) > getPromoDiscountPct(promo, best) ? d : best, activeDurations[0])
    : null;
  // Cheapest advertised base price per duration across the whole catalog, so the
  // ladder shows a real ₱ before/after instead of a made-up example.
  const promoLadderPrices = {};
  activeDurations.forEach(d => {
    const prices = games.map(g => [g['nt_price_' + d + 'd'], g['tr_price_' + d + 'd']]).flat().filter(p => p > 0);
    promoLadderPrices[d] = prices.length ? Math.min(...prices) : null;
  });
  const promoEndsValid = promo.ends_at && new Date(promo.ends_at).getTime() > Date.now();
%>
<% if (activeDurations.length) { %>
<div class="promo-section">
  <div class="promo2<%= promo.media_path ? '' : ' promo2-nomedia' %>">
    <div class="promo2-head">
      <span class="promo2-flag">Limited Time</span>
      <% if (promoEndsValid) { %>
      <span class="promo2-count" id="promoCountdown" data-ends="<%= new Date(promo.ends_at).getTime() %>"></span>
      <% } %>
    </div>
    <div class="promo2-grid<%= promo.media_path ? '' : ' nomedia' %>">
      <% if (promo.media_path) { %>
      <div class="promo2-media">
        <% if (promo.media_type === 'video') { %>
        <video src="<%= promo.media_path %>" autoplay muted loop playsinline></video>
        <% } else { %>
        <img src="<%= promo.media_path %>" alt="Promo" loading="lazy" decoding="async">
        <% } %>
      </div>
      <% } %>
      <div>
        <h2 class="promo2-title">Rent Longer. Save More.</h2>
        <p class="promo2-sub">Discount applied automatically at checkout — no code needed.</p>
        <div class="ladder">
          <% activeDurations.forEach(d => { const pct = getPromoDiscountPct(promo, d); const base = promoLadderPrices[d]; const final = base ? base - Math.round(base * pct / 100) : null; %>
          <div class="rung<%= d === bestPromoDuration ? ' best' : '' %>">
            <span class="days"><%= d %> Days</span>
            <span class="pct"><%= pct %>% Off</span>
            <% if (base) { %>
            <span class="price"><s>₱<%= base %></s><b>₱<%= final %></b></span>
            <% } %>
            <% if (d === bestPromoDuration && activeDurations.length > 1) { %>
            <span class="best-tag">Best Value</span>
            <% } %>
          </div>
          <% }) %>
        </div>
        <div class="promo2-cta">
          <a href="/browse" class="btn btn-primary">See Discounted Games</a>
          <a href="http://m.me/PlaystationHub00" target="_blank" rel="noopener" class="btn-ghost">Message Us</a>
        </div>
      </div>
    </div>
  </div>
</div>
<% if (promoEndsValid) { %>
<script>
(function(){
  const el = document.getElementById('promoCountdown');
  if (!el) return;
  const endsAt = parseInt(el.dataset.ends, 10);
  function tick() {
    const diff = endsAt - Date.now();
    if (diff <= 0) { el.textContent = ''; return; }
    const d = Math.floor(diff / 86400000);
    const h = Math.floor((diff % 86400000) / 3600000);
    const m = Math.floor((diff % 3600000) / 60000);
    el.textContent = d > 0 ? `Ends in ${d}d ${h}h` : (h > 0 ? `Ends in ${h}h ${m}m` : `Ends in ${m}m`);
  }
  tick();
  setInterval(tick, 60000);
})();
</script>
<% } %>
<% } %>

<!-- WHY RENT FROM US -->
<div class="why-section">
  <h2 class="section-title">Why Rent From Us</h2>
  <div class="why-grid">
    <div class="why-card">
      <div class="why-icon">🏆</div>
      <div class="why-title">Your Own Account</div>
      <div class="why-desc">Trophy rentals run on your profile, so progress and trophies stay yours.</div>
    </div>
    <div class="why-card">
      <div class="why-icon">⏱️</div>
      <div class="why-title">Try It Free First</div>
      <div class="why-desc">Three hours on our account before you commit to a rental or a buy.</div>
    </div>
    <div class="why-card">
      <div class="why-icon">💾</div>
      <div class="why-title">Fully Digital</div>
      <div class="why-desc">No discs, no meetups, no shipping. Set up over Messenger in minutes.</div>
    </div>
    <div class="why-card">
      <div class="why-icon">💳</div>
      <div class="why-title">Pay Locally</div>
      <div class="why-desc">GCash and Maya. Refundable deposit on trophy accounts only.</div>
    </div>
  </div>
</div>

<section class="how-section" id="how">
  <div class="how-inner">
    <h2>How It Works</h2>
    <div class="steps">
      <div class="step">
        <div class="step-num">1</div>
        <h3>Browse & Pick</h3>
        <p>Choose from our PS5 and PS4 digital game library.</p>
      </div>
      <div class="step">
        <div class="step-num">2</div>
        <h3>Choose Duration</h3>
        <p>Pick 10, 15, or 30 days — flexible pricing to fit your schedule.</p>
      </div>
      <div class="step">
        <div class="step-num">3</div>
        <h3>Get Access</h3>
        <p>We'll set up your digital access within 24 hours.</p>
      </div>
      <div class="step">
        <div class="step-num">4</div>
        <h3>Play & Return</h3>
        <p>Enjoy the game and the slot is released when your rental ends.</p>
      </div>
    </div>
  </div>
</section>

<!-- Reviews Section -->
<% if (reviews && reviews.length > 0) { %>
<section class="section" id="reviewsSection" style="padding-bottom:var(--section-gap);">
  <h2 class="section-title" style="color:#fff;margin-bottom:1.75rem;">
    <span style="display:inline-flex;align-items:center;gap:0.5rem;">
      <span style="background:linear-gradient(135deg,#f59e0b,#ef4444);-webkit-background-clip:text;-webkit-text-fill-color:transparent;font-size:1.1em;">⭐</span>
      What Our Customers Say
    </span>
    <span style="font-size:0.8rem;font-weight:500;color:#666;margin-left:0.5rem;">Real reviews from Facebook</span>
  </h2>
  <div class="reviews-grid">
    <% reviews.forEach(r => { %>
    <div class="review-card">
      <div class="review-stars"><%= '⭐'.repeat(r.rating) %></div>
      <p class="review-text">"<%= r.text %>"</p>
      <div class="review-footer">
        <div class="review-avatar"><%= r.name.charAt(0).toUpperCase() %></div>
        <div>
          <div class="review-name"><%= r.name %></div>
          <% if (r.game_rented) { %><div class="review-game">🎮 <%= r.game_rented %></div><% } %>
        </div>
        <div class="review-fb-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="#1877F2"><path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.41c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.97h-1.513c-1.491 0-1.956.93-1.956 1.886v2.267h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/></svg>
          Facebook
        </div>
      </div>
    </div>
    <% }) %>
  </div>
</section>
<% } %>

<%- include('partials/footer') %>

<!-- RESERVE MODAL -->
<div class="modal-overlay" id="reserveModal">
  <div class="modal">
    <div style="font-size:1.5rem;margin-bottom:0.5rem;">🔔</div>
    <h2>Reserve a Slot</h2>
    <div id="reserveGameTitle" style="font-weight:700;font-size:1rem;color:#a855f7;margin:0.5rem 0 1rem;"></div>
    <div style="background:#111;border:1px solid #222;border-radius:10px;padding:1rem;margin-bottom:1.25rem;text-align:left;">
      <div style="font-size:0.82rem;color:#bbb;line-height:1.7;margin-bottom:0.75rem;">
        This game is not yet available but you can <strong style="color:#fff;">reserve your slot now</strong>. Message us on Facebook to lock in your reservation!
      </div>
      <div style="font-size:0.78rem;color:var(--ps-blue);font-weight:700;margin-bottom:0.25rem;">📘 Message us on Facebook:</div>
      <div style="font-size:0.8rem;color:#888;">Include the game name and your preferred rental duration.</div>
    </div>
    <div class="modal-actions">
      <button class="btn btn-outline" onclick="closeReserveModal()" style="flex:1;">Cancel</button>
      <a href="http://m.me/PlaystationHub00" target="_blank" rel="noopener"
        class="btn" style="flex:1;text-align:center;background:linear-gradient(135deg,#4a0080,#7b2ff7);color:#fff;font-weight:700;border-radius:50px;padding:0.75rem 1.75rem;text-decoration:none;"
        onclick="closeReserveModal()">📘 Message Us</a>
    </div>
  </div>
</div>

<%- include('partials/rent-modal') %>

<script>
function slideSection(id, dir) {
  const slider = document.getElementById(id);
  if (!slider) return;
  const card = slider.querySelector('[style*="min-width"]') || slider.querySelector('.game-card');
  const cardW = card ? card.offsetWidth + 20 : 260;
  slider.scrollBy({ left: dir * cardW * 2, behavior: 'smooth' });
}

function openReserveModal(title) {
  document.getElementById('reserveGameTitle').textContent = title;
  document.getElementById('reserveModal').classList.add('active');
}
function closeReserveModal() { document.getElementById('reserveModal').classList.remove('active'); }
document.getElementById('reserveModal').addEventListener('click', e => { if (e.target === e.currentTarget) closeReserveModal(); });

// Promo config from server
const _rentPromo = { enabled: <%- promo.enabled ? 'true' : 'false' %>, discounts: { 10: <%= (promo.discounts && promo.discounts[10]) || 0 %>, 15: <%= (promo.discounts && promo.discounts[15]) || 0 %>, 30: <%= (promo.discounts && promo.discounts[30]) || 0 %> } };
const _buyPromo  = { enabled: <%- promo.buy_promo_enabled ? 'true' : 'false' %>, pct: <%= promo.buy_promo_pct || 0 %> };

function switchModalTab(tab) {
  const isRent = tab === 'rent';
  document.getElementById('modalRentPanel').style.display = isRent ? 'block' : 'none';
  document.getElementById('modalBuyPanel').style.display  = isRent ? 'none'  : 'block';
  document.getElementById('modalTabRent').style.background = isRent ? 'var(--ps-blue)' : 'transparent';
  document.getElementById('modalTabRent').style.color      = isRent ? '#000' : '#555';
  document.getElementById('modalTabBuy').style.background  = isRent ? 'transparent' : 'var(--ps-blue)';
  document.getElementById('modalTabBuy').style.color       = isRent ? '#555' : '#000';
}

function openRentModal(title, nt10, nt15, nt30, tr10, tr15, tr30, hasTrophy, hasNt, buyNt, buyTr) {
  document.getElementById('modalGameTitle').textContent = title;
  // Rent prices
  document.getElementById('modalNtP10').textContent = '₱' + nt10;
  document.getElementById('modalNtP15').textContent = '₱' + nt15;
  document.getElementById('modalNtP30').textContent = '₱' + nt30;
  document.getElementById('modalTrP10').textContent = '₱' + tr10;
  document.getElementById('modalTrP15').textContent = '₱' + tr15;
  document.getElementById('modalTrP30').textContent = '₱' + tr30;
  document.getElementById('modalNtSection').style.display = hasNt ? 'block' : 'none';
  document.getElementById('modalTrophySection').style.display = hasTrophy ? 'block' : 'none';
  // Buy prices
  const hasBuyNt = buyNt > 0;
  const hasBuyTr = buyTr > 0 && hasTrophy;
  document.getElementById('modalBuyNtSection').style.display = hasBuyNt ? 'block' : 'none';
  document.getElementById('modalBuyTrSection').style.display = hasBuyTr ? 'block' : 'none';
  // Apply buy promo
  if (_buyPromo.enabled && _buyPromo.pct > 0) {
    document.getElementById('modalBuyPromoBadge').style.display = 'block';
    document.getElementById('modalBuyPromoText').textContent = _buyPromo.pct + '%';
    if (hasBuyNt) {
      const disc = Math.round(buyNt * (1 - _buyPromo.pct / 100));
      document.getElementById('modalBuyNtOriginal').textContent = '₱' + buyNt;
      document.getElementById('modalBuyNtOriginal').style.display = 'block';
      document.getElementById('modalBuyNtPrice').textContent = '₱' + disc;
    }
    if (hasBuyTr) {
      const disc = Math.round(buyTr * (1 - _buyPromo.pct / 100));
      document.getElementById('modalBuyTrOriginal').textContent = '₱' + buyTr;
      document.getElementById('modalBuyTrOriginal').style.display = 'block';
      document.getElementById('modalBuyTrPrice').textContent = '₱' + disc;
    }
  } else {
    document.getElementById('modalBuyPromoBadge').style.display = 'none';
    document.getElementById('modalBuyNtOriginal').style.display = 'none';
    document.getElementById('modalBuyTrOriginal').style.display = 'none';
    document.getElementById('modalBuyNtPrice').textContent = hasBuyNt ? '₱' + buyNt : '—';
    document.getElementById('modalBuyTrPrice').textContent = hasBuyTr ? '₱' + buyTr : '—';
  }
  // Show/hide buy tab
  document.getElementById('modalTabBuy').style.display = (hasBuyNt || hasBuyTr) ? '' : 'none';
  switchModalTab('rent');
  document.getElementById('rentModal').classList.add('active');
}
function closeRentModal() { document.getElementById('rentModal').classList.remove('active'); }
document.getElementById('rentModal').addEventListener('click', e => { if (e.target === e.currentTarget) closeRentModal(); });
</script>
</body>
</html>




