<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= game.title %> — Coming Soon — Playstation Hub</title>
  <link rel="icon" href="<%= settings.favicon_path %>" type="image/svg+xml">
  <link rel="stylesheet" href="/css/style.css?v=<%= assetV %>">
  <meta name="facebook-domain-verification" content="noj6ccmsehjq0v2oeq2e716fgyaqq0" />
</head>
<body>
<%- include('partials/announcement') %>
<%- include('partials/nav', { active: 'browse' }) %>

<%
  const hasNt = !!(game.nt_price_7d || game.nt_price_30d);
  const hasTr = !!(game.tr_price_7d || game.tr_price_30d) && (game.trophy_slots || 0) >= 0;
  const showTr = hasTr;

  const udIsTba = !game.release_date || game.release_date === 'TBA';
  let udDaysLeft = null;
  if (!udIsTba) {
    const udReleaseDate = new Date(game.release_date + 'T00:00:00');
    const udToday0 = new Date(); udToday0.setHours(0,0,0,0);
    udDaysLeft = Math.ceil((udReleaseDate - udToday0) / 86400000);
  }
  let displayDate = 'TBA';
  if (!udIsTba) {
    const d = new Date(game.release_date + 'T00:00:00');
    displayDate = d.toLocaleDateString('en-US', { year:'numeric', month:'long', day:'numeric' });
  }

  const ntSlots = game.non_trophy_slots || 0;
  const trSlots = game.trophy_slots || 0;
  const totalSlots = ntSlots + trSlots;
  const allFull = totalSlots === 0;

  // Permanent pre-order. Same 50%-now / 50%-on-release model as a reservation,
  // so it rides the existing reserve flow rather than /order/buy (which only
  // knows about already-released catalogue rows).
  const udBuyNt = game.buy_nt_price || 0;
  const udBuyTr = game.buy_tr_price || 0;
  const udHasBuy = udBuyNt > 0 || udBuyTr > 0;
%>

<div class="usd-page">
  <div class="usd-back"><a href="/browse">← Back to Catalog</a></div>

  <!-- Branded hero: a fixed brand gradient rather than the game's own art. The
       sharp, uncropped poster below carries the game's identity, so this band
       only has to sit behind the title — which means no cover image can ever
       be cropped, blurred, or muddy here, and every Coming Soon page matches. -->
  <div class="usd-hero">
    <div class="usd-hero-placeholder"></div>
    <div class="usd-hero-scrim"></div>
    <div class="usd-hero-in">
      <div class="usd-badge-row">
        <span class="usd-badge">🔜 Coming Soon</span>
        <span class="usd-plat-chip"><%= game.platform %></span>
        <% if (game.genre) { %><span class="usd-plat-chip"><%= game.genre %></span><% } %>
      </div>
      <h1 class="usd-title"><%= game.title %></h1>
      <div class="usd-hero-foot">
        <div class="usd-cd-row">
          <% if (udIsTba) { %>
            <span class="usd-cd-n" style="font-size:1.4rem;">Date TBA</span>
          <% } else if (udDaysLeft > 0) { %>
            <span class="usd-cd-n"><%= udDaysLeft %></span>
            <span class="usd-cd-u">day<%= udDaysLeft !== 1 ? 's' : '' %> until release</span>
            <span class="usd-cd-date"><%= displayDate %></span>
          <% } else { %>
            <span class="usd-cd-n" style="font-size:1.4rem;">Any day now</span>
          <% } %>
        </div>
        <img src="<%= settings.logo_path %>" alt="" aria-hidden="true" class="usd-hero-brand">
      </div>
    </div>
  </div>

  <div class="usd-body">
    <% if (allFull) { %>
    <div class="rsv-full-banner">
      <span class="rsv-full-icon">🚫</span>
      <div>
        <div class="rsv-full-title">All Slots Full</div>
        <div class="rsv-full-sub">You can still request a slot with a downpayment below, or join the free waitlist.</div>
      </div>
    </div>
    <% } %>

    <!-- Same layout primitives as the rent page (.gd-layout / .gd-cover-col /
         .gd-detail-col), not a parallel grid — that is what makes the poster
         column and card the same width on both pages, and keeps them that way
         if either is ever resized. -->
    <div class="gd-layout">

      <div class="gd-cover-col">
        <% if (game.cover_image) { %>
          <img src="<%= game.cover_image %>" alt="<%= game.title %>" class="gd-cover gdh-poster">
        <% } %>
        <!-- Description only, matching the rent page. The release countdown used
             to repeat here, but the banner directly above already states it
             verbatim ("16 DAYS UNTIL RELEASE · September 15, 2026"). -->
        <% if (game.description) { %>
          <p class="gd-desc gdh-poster-desc"><%= game.description %></p>
        <% } %>
      </div>

      <div class="gd-detail-col">
        <!-- Shares the rent page's card classes (.gdh-card / .gd-type-pill /
             .gd-duration-grid) rather than a parallel .rsv-* set, so the two
             detail pages stay identical by construction and any future change
             to one automatically applies to the other. -->
        <div class="gdh-card">

          <!-- Same Rent/Buy toggle markup as the rent page, including when this
               game has no permanent price: that page still renders the bar with
               a single button rather than dropping it, so this one does too. -->
          <div style="display:flex;background:#111;border:1px solid #222;border-radius:12px;padding:4px;margin-bottom:1.5rem;gap:4px;">
            <button type="button" id="udToggleRent" onclick="setUpcomingMode('rent')"
              style="flex:1;padding:0.7rem;border-radius:9px;border:none;cursor:pointer;font-weight:800;font-size:0.9rem;background:var(--ps-blue);color:#000;transition:all 0.15s;letter-spacing:0.3px;">
              ⏱️ Rent
            </button>
            <% if (udHasBuy) { %>
            <button type="button" id="udToggleBuy" onclick="setUpcomingMode('buy')"
              style="flex:1;padding:0.7rem;border-radius:9px;border:none;cursor:pointer;font-weight:800;font-size:0.9rem;background:transparent;color:#555;transition:all 0.15s;letter-spacing:0.3px;">
              ♾️ Buy Permanent
            </button>
            <% } %>
          </div>

          <% if (hasNt || showTr) { %>
          <div class="gd-type-options" id="typeOptions">
            <% if (showTr) { %>
            <label class="gd-type-card gd-type-pill" id="typeCard-tr">
              <input type="radio" name="rental_type" value="tr" class="gd-type-radio" id="type-tr" onchange="onTypeChange()" <%= (!hasNt) ? 'checked' : '' %>>
              <span class="gd-type-icon">🏆</span>
              <span class="gd-type-name">Trophy</span>
              <% if (trSlots > 0) { %><span class="gd-slots-left"><%= trSlots %> slot<%= trSlots !== 1 ? 's' : '' %> left</span><% } %>
              <span class="gd-type-status <%= trSlots > 0 ? 'gd-status-avail' : 'gd-status-rented' %>"><%= trSlots > 0 ? 'Available' : 'Full Slot' %></span>
            </label>
            <% } %>
            <% if (hasNt) { %>
            <label class="gd-type-card gd-type-pill" id="typeCard-nt">
              <input type="radio" name="rental_type" value="nt" class="gd-type-radio" id="type-nt" onchange="onTypeChange()" checked>
              <span class="gd-type-icon">🎮</span>
              <span class="gd-type-name">Non-Trophy</span>
              <% if (ntSlots > 0) { %><span class="gd-slots-left"><%= ntSlots %> slot<%= ntSlots !== 1 ? 's' : '' %> left</span><% } %>
              <span class="gd-type-status <%= ntSlots > 0 ? 'gd-status-avail' : 'gd-status-rented' %>"><%= ntSlots > 0 ? 'Available' : 'Full Slot' %></span>
            </label>
            <% } %>
          </div>
          <% } %>

          <!-- Same "How setup works" disclosure as the rent page, reusing its
               #setupToggle / #typeSetupWrap ids so one set of CSS and one pair
               of JS handlers cover both pages. The copy is that page's Trophy /
               Non-Trophy explanation verbatim, minus its stock-specific lines
               ("next available in N days", "not stocked yet") — neither means
               anything before a game has released. -->
          <button type="button" class="gd-setup-toggle" id="setupToggle" aria-expanded="false" onclick="toggleSetupPanel()">
            <span>How setup works</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
          </button>
          <div class="gd-type-setup" id="typeSetupWrap" data-open="0">
            <% if (showTr) { %>
            <div class="gd-setup-block" id="setup-tr">
              <p>✅ Play our games on <strong>YOUR OWN account</strong> and earn trophies on your profile.</p>
              <p style="color:#22c55e;">Setup: Settings → Users and Accounts → Other → Console Sharing and Offline Play → <strong>Enable</strong></p>
            </div>
            <% } %>
            <% if (hasNt) { %>
            <div class="gd-setup-block" id="setup-nt">
              <p>🎮 Play the game on <strong>OUR account</strong> only. Trophies <strong>won't</strong> count on your own profile.</p>
              <p style="color:#888;">Setup: Settings → Users and Accounts → Other → Console Sharing and Offline Play → <strong>leave disabled</strong></p>
            </div>
            <% } %>
          </div>

          <div id="udDurWrap"><div class="gd-duration-grid" id="durGrid" style="margin-top:0.75rem;"></div></div>

          <!-- Same summary box as the rent page down to the last element: always
               visible, rows on top, a "To send now" final line, the green rider
               beneath it and the grey hint below that. Only the rows themselves
               differ, because a reservation splits into a downpayment now and a
               balance on release day. -->
          <div class="gd-total-box" id="orderSummary">
            <div class="gd-total-label">ORDER SUMMARY</div>
            <div class="gd-total-rows" id="sumRows"></div>
            <div class="gd-total-final">
              <span>To send now</span>
              <span id="sumFinal" style="color:var(--ps-blue);font-size:1.2rem;font-weight:900;"></span>
            </div>
            <div class="gd-total-refund" id="sumRider" style="display:none;"></div>
            <div class="gd-total-hint" id="sumHint" style="display:none;"></div>
          </div>

          <!-- Same closing stack as the rent page: name field and button inside
               one form, a sub-line under the button, then the Messenger link.
               The separate "Reserve a Slot / 50% Downpayment / Total • Pay now
               • Remaining" header block that used to sit here is gone — every
               figure it carried now reads off the summary box directly above. -->
          <div id="ctaReserve">
            <form method="POST" action="/order/reserve" class="gd-order-form" id="reserveForm" onsubmit="return handleReserveSubmit(event)">
              <input type="hidden" name="game_id" value="<%= game.id %>">
              <input type="hidden" name="account_type" id="reserveType" value="">
              <input type="hidden" name="days" id="reserveDays" value="">
              <input type="hidden" name="kind" id="reserveKind" value="">
              <input type="text" name="fb_name" id="reserveFbName" class="gd-order-name" placeholder="Your Facebook name" required autocomplete="off">
              <button type="submit" id="ctaReserveBtn" class="gd-order-btn">Reserve Now →</button>
              <div class="gd-order-sub" id="ctaReserveSub" style="display:none;">Pay 50% now via GCash or Maya · balance on release day</div>
            </form>
            <a id="reserveLinkSlot" href="http://m.me/PlaystationHub00" target="_blank" rel="noopener"
               onclick="return handleReserveClick(event,'reserve')" class="gd-cta-link">or message us on Facebook instead</a>
            <% if (order_error === '1') { %>
            <div class="gd-order-error">⚠️ Please pick a type and duration, and enter your Facebook name, before continuing.</div>
            <% } %>
          </div>

          <div id="ctaWaitlist" style="display:<%= allFull ? '' : 'none' %>;margin-top:0.75rem;">
            <a id="queueLink" href="http://m.me/PlaystationHub00" target="_blank" rel="noopener"
               class="gd-reserve-card gd-reserve-queue" onclick="return handleReserveClick(event,'queue')">
              <div class="gd-reserve-icon">🎮</div>
              <div class="gd-reserve-name">Fall in Line</div>
              <div class="gd-reserve-fee" style="color:#22c55e;">FREE</div>
              <div class="gd-reserve-note">Join the waitlist at no cost. You'll be notified when a slot opens.</div>
              <div class="gd-reserve-cta">📘 Join Waitlist →</div>
            </a>
          </div>

        </div>
      </div>

    </div>

    <%- include('partials/review-block', { reviews: reviews, reviewStats: reviewStats, reviewBadge: reviewBadge, reviewDisplayName: reviewDisplayName }) %>

    <% const gpGallery = (game.gallery || []).filter(Boolean); %>
    <% if (gpGallery.length) { %>
    <div class="rsv-gallery-section">
      <div class="rsv-gallery-label">Gameplay</div>
      <div class="gd-slider" id="gpSlider">
        <div class="gd-slider-track" id="gpSliderTrack">
          <% gpGallery.forEach((img, i) => { %>
            <div class="gd-slide"><img src="<%= img %>" alt="<%= game.title %> gameplay <%= i+1 %>" class="gd-cover rsv-gallery-img" <%= i === 0 ? '' : 'loading="lazy" decoding="async"' %>></div>
          <% }) %>
        </div>
        <% if (gpGallery.length > 1) { %>
          <button type="button" class="gd-slider-arrow gd-slider-prev" onclick="gpMove(-1)" aria-label="Previous">‹</button>
          <button type="button" class="gd-slider-arrow gd-slider-next" onclick="gpMove(1)" aria-label="Next">›</button>
          <div class="gd-slider-dots" id="gpSliderDots">
            <% gpGallery.forEach((img, i) => { %>
              <button type="button" class="gd-dot<%= i===0 ? ' active' : '' %>" onclick="gpGo(<%= i %>)" aria-label="Go to image <%= i+1 %>"></button>
            <% }) %>
          </div>
        <% } %>
      </div>
      <% if (gpGallery.length > 1) { %>
      <div class="gd-thumbs" id="gpThumbs">
        <% gpGallery.forEach((img, i) => { %>
          <button type="button" class="gd-thumb<%= i===0 ? ' active' : '' %>" onclick="gpGo(<%= i %>)"><img src="<%= img %>" alt="thumbnail <%= i+1 %>" loading="lazy" decoding="async"></button>
        <% }) %>
      </div>
      <% } %>
    </div>
    <% } %>

  </div><!-- /usd-body -->
</div><!-- /usd-page -->

<%- include('partials/footer') %>

<script>
const GAME_TITLE = '<%= game.title.replace(/'/g, "\\'").replace(/"/g, "&quot;") %>';
const NT_PRICES  = { 7: <%= game.nt_price_7d||0 %>, 30: <%= game.nt_price_30d||0 %> };
const TR_PRICES  = { 7: <%= game.tr_price_7d||0 %>, 30: <%= game.tr_price_30d||0 %> };
const NT_SLOTS   = <%= game.non_trophy_slots||0 %>;
const TR_SLOTS   = <%= game.trophy_slots||0 %>;
const BUY_PRICES = { nt: <%= udBuyNt %>, tr: <%= udBuyTr %> };
const HAS_BUY    = <%= udHasBuy ? 'true' : 'false' %>;
</script>
<script>const RENTAL_DURATIONS = <%- JSON.stringify(RENTAL_DURATIONS.map(d => d.days)) %>;</script>
<script>

let selectedType = document.querySelector('input[name="rental_type"]:checked')?.value || 'nt';
let selectedDays = null;
// 'rent' = reserve a rental (duration-based). 'buy' = pre-order permanent
// access (no duration). Both submit through /order/reserve; the buy branch is
// distinguished by the hidden `kind` field.
let upcomingMode = 'rent';

function setUpcomingMode(mode) {
  upcomingMode = mode === 'buy' ? 'buy' : 'rent';
  const rentBtn = document.getElementById('udToggleRent');
  const buyBtn  = document.getElementById('udToggleBuy');
  // Guarded separately, not as a pair: the toggle bar now renders on every
  // Coming Soon page the way it does on the rent page, so the Rent button is
  // always present while the Buy button only exists when a permanent price is
  // set. A combined `rentBtn && buyBtn` check would skip both in that case.
  const on = 'var(--ps-blue)', onText = '#000', offText = '#555';
  if (rentBtn) {
    rentBtn.style.background = upcomingMode === 'rent' ? on : 'transparent';
    rentBtn.style.color      = upcomingMode === 'rent' ? onText : offText;
  }
  if (buyBtn) {
    buyBtn.style.background = upcomingMode === 'buy' ? on : 'transparent';
    buyBtn.style.color      = upcomingMode === 'buy' ? onText : offText;
  }
  // A permanent purchase has no rental length, so the duration picker is
  // irrelevant in buy mode.
  const durWrap = document.getElementById('udDurWrap');
  if (durWrap) durWrap.style.display = upcomingMode === 'buy' ? 'none' : '';
  const kindEl = document.getElementById('reserveKind');
  if (kindEl) kindEl.value = upcomingMode === 'buy' ? 'buy' : '';
  updateSummary();
  updateCta();
  updateLinks();
}

// Permanent price for the selected type, 0 when that type isn't sold outright.
function getBuyPrice() { return (selectedType === 'tr' ? BUY_PRICES.tr : BUY_PRICES.nt) || 0; }

// Setup-panel handlers, same behaviour as the rent page's: the disclosure
// opens once and shows whichever type is currently selected, rather than each
// pill carrying its own accordion.
function toggleSetupPanel() {
  const panel = document.getElementById('typeSetupWrap');
  const btn = document.getElementById('setupToggle');
  if (!panel || !btn) return;
  const open = panel.dataset.open === '1';
  panel.dataset.open = open ? '0' : '1';
  btn.setAttribute('aria-expanded', String(!open));
}

function syncSetupPanel() {
  document.querySelectorAll('#typeSetupWrap .gd-setup-block').forEach(b => {
    b.style.display = (b.id === 'setup-' + selectedType) ? '' : 'none';
  });
}

function getPrices() { return selectedType === 'tr' ? TR_PRICES : NT_PRICES; }
function getSlots()  { return selectedType === 'tr' ? TR_SLOTS  : NT_SLOTS; }

function onTypeChange() {
  selectedType = document.querySelector('input[name="rental_type"]:checked')?.value || 'nt';
  // renderDurButtons() below re-picks the preferred default (Monthly, same
  // rule as initial load) every time the type changes, rather than trying to
  // carry the old duration across two potentially different price tables —
  // simpler, and it never leaves the summary blank after a type switch.
  document.querySelectorAll('.gd-type-pill').forEach(c => c.classList.remove('gd-type-selected'));
  const checked = document.querySelector('input[name="rental_type"]:checked');
  if (checked) checked.closest('.gd-type-pill').classList.add('gd-type-selected');
  syncSetupPanel();
  renderDurButtons();
  updateSummary();
  updateCta();
}

function renderDurButtons() {
  const p = getPrices();
  const grid = document.getElementById('durGrid');
  grid.innerHTML = '';
  const durLabelMap = { 7: 'Weekly', 30: 'Monthly' };
  const available = RENTAL_DURATIONS.filter(d => p[d]);

  available.forEach(d => {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'gd-dur-btn';
    btn.dataset.days = d;
    btn.onclick = () => selectDur(d);
    btn.innerHTML = `<span class="gd-dur-days">${durLabelMap[d] || d}</span><span class="gd-dur-price">₱${p[d]}</span>`;
    grid.appendChild(btn);
  });

  // Preselect so the price is visible on load: prefer Monthly (30) when more
  // than one duration exists, otherwise the single available one. Falls back
  // to null (existing "no price set" empty state) when neither is priced.
  const defaultDays = available.includes(30) ? 30 : (available[0] || null);
  if (defaultDays) selectDur(defaultDays);
}

function selectDur(days) {
  selectedDays = days;
  document.querySelectorAll('.gd-dur-btn').forEach(b => b.classList.toggle('active', parseInt(b.dataset.days) === days));
  updateSummary();
  updateCta();
  updateLinks();
}

// Mirrors the rent page's updateTotal(): the box never hides, the rows are
// rebuilt as innerHTML, the final line is what the customer sends right now,
// and the green rider / grey hint sit underneath it. The arithmetic below is
// unchanged from before — only where each figure is printed has moved.
function updateSummary() {
  const rowsEl  = document.getElementById('sumRows');
  const finalEl = document.getElementById('sumFinal');
  const riderEl = document.getElementById('sumRider');
  const hintEl  = document.getElementById('sumHint');
  if (!rowsEl || !finalEl) return;

  if (upcomingMode === 'buy') {
    // Buying the account outright — no rental deposit, nothing to return.
    const bp = getBuyPrice();
    if (!bp) {
      rowsEl.innerHTML = '';
      finalEl.textContent = '—';
      riderEl.style.display = 'none';
      hintEl.textContent = 'Not sold permanently for this type — pick the other one.';
      hintEl.style.display = '';
      return;
    }
    const bDown = Math.ceil(bp * 0.5);
    rowsEl.innerHTML =
      '<div class="gd-total-row"><span>Permanent access</span><span>₱' + bp + '</span></div>' +
      '<div class="gd-total-row"><span>Total</span><span>₱' + bp + '</span></div>';
    finalEl.textContent = '₱' + bDown;
    riderEl.textContent = '↩ Remaining ₱' + (bp - bDown) + ' due when the game releases.';
    riderEl.style.display = '';
    hintEl.style.display = 'none';
    return;
  }

  if (!selectedDays) {
    rowsEl.innerHTML = '';
    finalEl.textContent = '—';
    riderEl.style.display = 'none';
    hintEl.textContent = 'Pick a duration to see your exact total.';
    hintEl.style.display = '';
    return;
  }

  const price     = getPrices()[selectedDays] || 0;
  const isTrophy  = selectedType === 'tr';
  const deposit   = isTrophy ? 100 : 0;
  const total     = price + deposit;
  const downpay   = Math.ceil(total * 0.5);

  rowsEl.innerHTML =
    '<div class="gd-total-row"><span>Base (' + selectedDays + ' days)</span><span>' + (price ? '₱' + price : '—') + '</span></div>' +
    '<div class="gd-total-row gd-total-dep"><span>🔒 Security Deposit (refundable)</span><span>+₱' + deposit + '</span></div>' +
    '<div class="gd-total-row"><span>Total</span><span>' + (total ? '₱' + total : '—') + '</span></div>';
  finalEl.textContent = total ? '₱' + downpay : '—';
  riderEl.textContent = '↩ Remaining ₱' + (total - downpay) + ' due when the game releases.' +
    (deposit ? ' ₱' + deposit + ' of that comes back when you finish.' : '');
  riderEl.style.display = total ? '' : 'none';
  hintEl.style.display = 'none';
}

// The rent page's CTA pattern: one button that either states the missing
// choice and stays disabled, or names the action. The wording that used to
// live in a separate header block above the form now rides on the button's
// sub-line, and its figures come off the summary box above.
// The rent page's updateCtaState() pattern, one for one: while the choice is
// incomplete the button names the missing step, greys out via .gd-cta-wait and
// the sub-line stays hidden; once complete it names the action and carries the
// amount the customer sends right now. Buy mode mirrors that page's buy panel,
// whose button states the action without a figure and leaves the amount to the
// summary box.
function updateCta() {
  const btn = document.getElementById('ctaReserveBtn');
  const sub = document.getElementById('ctaReserveSub');
  if (!btn) return;

  const setWait = (label) => {
    btn.textContent = label;
    btn.disabled = true;
    btn.classList.add('gd-cta-wait');
    if (sub) sub.style.display = 'none';
  };
  const setReady = (label, subText) => {
    btn.textContent = label;
    btn.disabled = false;
    btn.classList.remove('gd-cta-wait');
    if (sub) { sub.textContent = subText; sub.style.display = ''; }
  };

  if (upcomingMode === 'buy') {
    if (!getBuyPrice()) return setWait('Not sold permanently for this type');
    return setReady('📘 Pre-order Permanent Access',
      'Pay 50% now via GCash or Maya · balance on release day');
  }

  if (!selectedDays) return setWait('Pick a duration');

  const price   = getPrices()[selectedDays] || 0;
  const deposit = selectedType === 'tr' ? 100 : 0;
  const downpay = Math.ceil((price + deposit) * 0.5);
  const hasSlot = getSlots() > 0;
  setReady((hasSlot ? '🎮 Reserve now — ₱' : '🎮 Request now — ₱') + downpay,
    hasSlot
      ? 'Pay 50% now via GCash or Maya · balance on release day'
      : 'No slots free right now — pay 50% to request one. We refund you if one never opens.');
}

function updateLinks() {
  const typeNameB = selectedType === 'tr' ? 'Trophy' : 'Non-Trophy';
  // Buy mode has its own figures. updateCta() already wrote the correct
  // permanent downpayment into the fee line, and this function used to
  // overwrite it with the RENTAL downpayment — showing "Pay ₱350" under a
  // "Total ₱1999" summary. It also has no duration to report to Messenger.
  if (upcomingMode === 'buy') {
    const bp = getBuyPrice();
    const bDown = bp ? Math.ceil(bp * 0.5) : 0;
    const buyMsg = encodeURIComponent(
      'Hi! I want to PRE-ORDER PERMANENT ACCESS for:\n' +
      'Game: ' + GAME_TITLE + ' (Coming Soon)\n' +
      'Type: ' + typeNameB + '\n' +
      'Permanent Total: ' + (bp ? '₱' + bp : 'TBD') + '\n' +
      '50% Downpayment: ' + (bDown ? '₱' + bDown : 'TBD')
    );
    const be = document.getElementById('reserveLinkSlot');
    if (be) be.href = 'http://m.me/PlaystationHub00?text=' + buyMsg;
    return;
  }
  if (!selectedDays) return;
  const typeName = selectedType === 'tr' ? 'Trophy' : 'Non-Trophy';
  const price    = getPrices()[selectedDays] || 0;
  const deposit  = selectedType === 'tr' ? 100 : 0;
  const total    = price + deposit;
  const downpay2 = total ? Math.ceil(total * 0.5) : 0;
  const priceStr = total ? '₱' + total : 'TBD';
  const dpStr    = downpay2 ? '₱' + downpay2 : 'TBD';
  const hasSlot  = getSlots() > 0;

  const msg = encodeURIComponent(
    'Hi! I want to ' + (hasSlot ? 'RESERVE' : 'REQUEST') + ' a slot for:\n' +
    'Game: ' + GAME_TITLE + ' (Coming Soon)\n' +
    'Type: ' + typeName + '\n' +
    'Duration: ' + selectedDays + ' Days\n' +
    'Total: ' + priceStr + '\n' +
    '50% Downpayment: ' + dpStr
  );
  const el = document.getElementById('reserveLinkSlot');
  if (el) el.href = 'http://m.me/PlaystationHub00?text=' + msg;

  const queueMsg = encodeURIComponent(
    'Hi! I want to JOIN THE WAITLIST for:\n' +
    'Game: ' + GAME_TITLE + ' (Coming Soon)\n' +
    'Type: ' + typeName + '\n' +
    'Duration: ' + selectedDays + ' Days\n' +
    'Total: ' + priceStr
  );
  const ql = document.getElementById('queueLink');
  if (ql) ql.href = 'http://m.me/PlaystationHub00?text=' + queueMsg;
}

const ALL_FULL = <%= allFull ? 'true' : 'false' %>;

function shakeDurGrid() {
  const grid = document.getElementById('durGrid');
  grid.classList.remove('rsv-dur-row-shake');
  void grid.offsetWidth;
  grid.classList.add('rsv-dur-row-shake');
  setTimeout(() => grid.classList.remove('rsv-dur-row-shake'), 600);
}

function handleReserveClick(e, mode) {
  if (upcomingMode === 'buy') return true;
  if (!ALL_FULL && !selectedDays) {
    e.preventDefault();
    shakeDurGrid();
    return false;
  }
  return true;
}

function handleReserveSubmit(e) {
  // Buy mode has no duration to validate — it is gated on the selected type
  // actually having a permanent price instead.
  if (upcomingMode === 'buy') {
    if (!getBuyPrice()) { e.preventDefault(); return false; }
    document.getElementById('reserveType').value = selectedType;
    document.getElementById('reserveDays').value = '';
    document.getElementById('reserveKind').value = 'buy';
    return true;
  }
  if (!selectedDays) {
    e.preventDefault();
    shakeDurGrid();
    return false;
  }
  document.getElementById('reserveType').value = selectedType;
  document.getElementById('reserveDays').value = selectedDays;
  document.getElementById('reserveKind').value = '';
  return true;
}

// Init
const initChecked = document.querySelector('input[name="rental_type"]:checked');
if (initChecked) initChecked.closest('.gd-type-pill').classList.add('gd-type-selected');
syncSetupPanel();
renderDurButtons();
// renderDurButtons() reaches updateSummary() through selectDur(), but only when
// at least one duration is priced. Calling it here as well means a game with no
// prices set still shows the summary box with its "Pick a duration" hint rather
// than an empty shell.
updateSummary();
updateCta();

// ── Gameplay gallery slider ──
// Deliberately a small standalone copy rather than sharing the rent page's
// gdGo/gdMove — those are intertwined with rent-only overlays (platform
// badge, slot banner, cover focal-point handling) that don't apply here.
let gpIndex = 0;
const gpSlideCount = <%= gpGallery.length %>;
function gpGo(i) {
  if (gpSlideCount <= 1) return;
  gpIndex = (i + gpSlideCount) % gpSlideCount;
  const track = document.getElementById('gpSliderTrack');
  if (track) track.style.transform = 'translateX(-' + (gpIndex * 100) + '%)';
  document.querySelectorAll('#gpSliderDots .gd-dot').forEach((d, di) => d.classList.toggle('active', di === gpIndex));
  const thumbsWrap = document.getElementById('gpThumbs');
  document.querySelectorAll('#gpThumbs .gd-thumb').forEach((t, ti) => {
    t.classList.toggle('active', ti === gpIndex);
    // Horizontal-only, scoped to the thumbnail strip itself — scrollIntoView()
    // can still move the whole page vertically to reveal an element that
    // isn't fully in the viewport, which is exactly what happened here since
    // this gallery sits far down the page during autoplay.
    if (ti === gpIndex && thumbsWrap) {
      const target = t.offsetLeft - (thumbsWrap.clientWidth - t.clientWidth) / 2;
      thumbsWrap.scrollTo({ left: target, behavior: 'smooth' });
    }
  });
}
function gpMove(dir) { gpGo(gpIndex + dir); }
(function() {
  const slider = document.getElementById('gpSlider');
  if (!slider || gpSlideCount <= 1) return;
  let startX = 0;
  slider.addEventListener('touchstart', e => { startX = e.touches[0].clientX; }, { passive: true });
  slider.addEventListener('touchend', e => {
    const dx = e.changedTouches[0].clientX - startX;
    if (Math.abs(dx) > 40) gpMove(dx < 0 ? 1 : -1);
  }, { passive: true });
})();
// Autoplay: loop through the gallery every 4s. Pauses on hover/touch, resumes
// on manual navigation, and stays off for anyone who has asked for reduced
// motion — same pattern as the game detail page's own gallery.
(function() {
  const slider = document.getElementById('gpSlider');
  if (!slider || gpSlideCount <= 1) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  let timer = null;
  function start() { stop(); timer = setInterval(() => gpMove(1), 4000); }
  function stop() { if (timer) { clearInterval(timer); timer = null; } }
  slider.addEventListener('mouseenter', stop);
  slider.addEventListener('mouseleave', start);
  slider.addEventListener('touchstart', stop, { passive: true });
  slider.addEventListener('touchend', () => setTimeout(start, 4000), { passive: true });
  document.querySelectorAll('#gpSliderDots .gd-dot, #gpThumbs .gd-thumb, #gpSlider .gd-slider-arrow').forEach(el => {
    el.addEventListener('click', start);
  });
  start();
})();
</script>
</body>
</html>
