const GAME_TITLE = '<%= game.title.replace(/'/g, "\\'").replace(/"/g, "&quot;") %>';
const PAY_NOTE = <%- JSON.stringify(include('partials/pay-note').trim()) %>;
const NT_PRICES  = { 7: <%= game.nt_price_7d||0 %>, 30: <%= game.nt_price_30d||0 %> };
const TR_PRICES  = { 7: <%= game.tr_price_7d||0 %>, 30: <%= game.tr_price_30d||0 %> };
const NT_SLOTS   = <%= game.non_trophy_slots||0 %>;
const TR_SLOTS   = <%= game.trophy_slots||0 %>;
// Permanent prices after the buy promo, for the "Own it instead" strip (0 = none).
const BUY_FINAL = { nt: <%= udBuyNtFinal %>, tr: <%= showTr ? udBuyTrFinal : 0 %> };
</script>
<script>const RENTAL_DURATIONS = <%- JSON.stringify(RENTAL_DURATIONS.map(d => d.days)) %>;</script>
<script>
const ALL_FULL = <%= allFull ? 'true' : 'false' %>;
const gdSlideCount = <%= udFilm.length %>;
</script>
